+// Opt-in timing trace for the FCEUX DMC/audio CPU-hook model.
+// Without FCEU_DMC_TRACE_PATH, these helpers emit no file and do not alter audio.
+static FILE *DMCTraceFile = nullptr;
+static bool DMCTraceInitialized = false;
+static bool DMCTraceCompact = false;
+static bool DMCTraceInstructionMode = false;
+static uint64 DMCTraceStartCycle = 0;
+static uint64 DMCTraceEndCycle = 0;
+static uint64 DMCTraceSequence = 0;
+static uint64 DMCTraceHook = 0;
+static bool DMCTraceCurrentHookActive = false;
+static int DMCTraceCurrentHookCycles = -1;
+
+static void DMCTraceInit(void)
+{
+ if(DMCTraceInitialized) return;
+ DMCTraceInitialized = true;
+ const char *compact = std::getenv("FCEU_DMC_TRACE_COMPACT");
+ DMCTraceCompact = compact && std::strcmp(compact, "1") == 0;
+ const char *instructions = std::getenv("FCEU_DMC_TRACE_INSTRUCTIONS");
+ DMCTraceInstructionMode = instructions && std::strcmp(instructions, "1") == 0;
+ const char *path = std::getenv("FCEU_DMC_TRACE_PATH");
+ if(!path || !*path) return;
+ const char *start = std::getenv("FCEU_DMC_TRACE_START_CYCLE");
+ const char *end = std::getenv("FCEU_DMC_TRACE_END_CYCLE");
+ if(!start || !end)
+ {
+  fprintf(stderr, "FCEUX DMC trace needs START_CYCLE and END_CYCLE.\n");
+  return;
+ }
+ DMCTraceStartCycle = std::strtoull(start, nullptr, 0);
+ DMCTraceEndCycle = std::strtoull(end, nullptr, 0);
+ if(DMCTraceEndCycle <= DMCTraceStartCycle)
+ {
+  fprintf(stderr, "FCEUX DMC trace END_CYCLE must be greater than START_CYCLE.\n");
+  return;
+ }
+ DMCTraceFile = std::fopen(path, "w");
+ if(!DMCTraceFile)
+ {
+  fprintf(stderr, "FCEUX could not open DMC trace path: %s\n", path);
+  return;
+ }
+ fprintf(DMCTraceFile,
+  "seq,event,hook,pc,hook_cycles,absolute_cycle,timestamp,soundtimestamp,soundtsoffs,soundts,"
+  "dmcacc,dmcperiod,dmcbitcount,dmcaddress,dmcsize,dmcshift,dmchavedma,"
+  "dmchavesample,dmcdmabuf,rawdalatch,fcnt,fhcnt,fhinc,detail_index,"
+  "detail_address,detail_value,detail_extra,prg_offset,prg_bank_8k,opcode\n");
+ fflush(DMCTraceFile);
+}
+
+static void DMCTraceEvent(const char *event, int hookCycles = -1,
+ int detailIndex = -1, uint32 detailAddress = 0,
+ int detailValue = -1, long long detailExtra = 0)
+{
+ DMCTraceInit();
+ const uint64 absoluteCycle = timestampbase + (uint64)timestamp;
+ if(!DMCTraceFile || absoluteCycle < DMCTraceStartCycle || absoluteCycle > DMCTraceEndCycle) return;
+ const bool hookEvent = std::strcmp(event, "HOOK_IN") == 0 || std::strcmp(event, "HOOK_OUT") == 0;
+ if(DMCTraceCompact && event[0] == 'H') return;
+ if(DMCTraceInstructionMode && !hookEvent &&
+    std::strcmp(event, "DMC_REGISTER_WRITE") != 0 &&
+    std::strcmp(event, "DMC_STATUS_WRITE") != 0 &&
+    std::strcmp(event, "FRAME_UPDATE_IN") != 0 &&
+    std::strcmp(event, "FRAME_UPDATE_OUT") != 0 &&
+    std::strcmp(event, "FRAME_UPDATE_CROSSING") != 0 &&
+    std::strcmp(event, "FRAME_UPDATE_RELOAD") != 0 &&
+    std::strcmp(event, "DMC_DMA_OUT") != 0 &&
+    std::strcmp(event, "DMC_BIT_OUT") != 0 &&
+    std::strcmp(event, "PCM_SYNC_IN") != 0)
+  return;
+ if(DMCTraceCompact &&
+    std::strcmp(event, "DMC_REGISTER_WRITE") != 0 &&
+    std::strcmp(event, "DMC_STATUS_WRITE") != 0 &&
+    std::strcmp(event, "FRAME_UPDATE_IN") != 0 &&
+    std::strcmp(event, "FRAME_UPDATE_OUT") != 0 &&
+    std::strcmp(event, "FRAME_UPDATE_CROSSING") != 0 &&
+    std::strcmp(event, "FRAME_UPDATE_RELOAD") != 0 &&
+    std::strcmp(event, "DMC_DMA_OUT") != 0 &&
+    std::strcmp(event, "DMC_BIT_OUT") != 0 &&
+    std::strcmp(event, "PCM_SYNC_IN") != 0)
+  return;
+ const bool alwaysRecord =
+   (DMCTraceInstructionMode && hookEvent) ||
+   std::strcmp(event, "DMC_REGISTER_WRITE") == 0 ||
+   std::strcmp(event, "DMC_STATUS_WRITE") == 0 ||
+   std::strcmp(event, "FRAME_UPDATE_IN") == 0 ||
+   std::strcmp(event, "FRAME_UPDATE_OUT") == 0 ||
+   std::strcmp(event, "FRAME_UPDATE_CROSSING") == 0 ||
+   std::strcmp(event, "FRAME_UPDATE_RELOAD") == 0;
+ if(!DMCTraceCurrentHookActive && !DMCSize && !DMCHaveDMA && !DMCHaveSample && !alwaysRecord)
+  return;
+ const int prgOffset = GetPRGAddress(X.PC);
+ const int prgBank8k = prgOffset >= 0 ? prgOffset / 0x2000 : -1;
+ const unsigned opcode = prgOffset >= 0 ? GetNesPRGPointer(prgOffset)[0] : 0xFF;
+ fprintf(DMCTraceFile,
+  "%llu,%s,%llu,%04X,%d,%llu,%u,%u,%u,%u,%d,%d,%u,%08X,%d,%02X,%d,%d,%02X,%02X,%u,%d,%d,%d,%08X,%d,%lld,%d,%d,%02X\n",
+  (unsigned long long)DMCTraceSequence++, event,
+  (unsigned long long)DMCTraceHook, (unsigned)X.PC, hookCycles,
+  (unsigned long long)absoluteCycle, (unsigned)timestamp, (unsigned)soundtimestamp, (unsigned)soundtsoffs,
+  (unsigned)SOUNDTS, (int)DMCacc, (int)DMCPeriod, (unsigned)DMCBitCount,
+  (unsigned)DMCAddress, (int)DMCSize, (unsigned)DMCShift,
+  (int)DMCHaveDMA, (int)DMCHaveSample, (unsigned)DMCDMABuf,
+  (unsigned)RawDALatch, (unsigned)fcnt, (int)fhcnt, (int)fhinc,
+  detailIndex, (unsigned)detailAddress, detailValue, detailExtra,
+  prgOffset, prgBank8k, opcode);
+ if(DMCTraceInstructionMode || DMCTraceCompact) fflush(DMCTraceFile);
+}
+
+static uint8 DMCTraceRead(uint32 address, int readIndex)
+{
+ uint32 before = timestamp;
+ uint8 value = X6502_DMR(address);
+ DMCTraceEvent("DMR", -1, readIndex, address, value,
+  (long long)(timestamp - before));
+ return value;
+}
 
