--- a/src/ppu.h
+++ b/src/ppu.h
@@ -39,6 +39,7 @@ extern uint8 FASTCALL FFCEUX_PPURead_Default(uint32 A);
 void FFCEUX_PPUWrite_Default(uint32 A, uint8 V);
 
 extern int g_rasterpos;
+extern int scanline;
 extern uint8 PPU[4];
 extern bool DMC_7bit;
 extern bool paldeemphswap;
