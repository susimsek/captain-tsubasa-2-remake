 static void (*DoSQ2)(void)=Dummyfunc;
 
 static uint32 ChannelBC[5];
+
+// Opt-in, bounded per-channel WaveHi input trace for diagnostics. It records
+// channel contributions before nonlinear mixing/filtering; no audio samples
+// are written and the path is unset in ordinary emulator runs.
+struct ChannelWaveHiTraceRecord
+{
+ uint64 cycle;
+ int32 channel[5]; // pulse 1, pulse 2, triangle, noise, DMC
+ int32 rawWaveHi;
+};
+static_assert(sizeof(ChannelWaveHiTraceRecord)==32, "unexpected channel trace record layout");
+static int32 ChannelTraceWaveHi[5][40000];
+static FILE *ChannelWaveHiTraceFile = nullptr;
+static bool ChannelWaveHiTraceInitialized = false;
+static uint64 ChannelWaveHiTraceStartCycle = 0;
+static uint64 ChannelWaveHiTraceEndCycle = 0;
+
+static void InitChannelWaveHiTrace(void)
+{
+ if(ChannelWaveHiTraceInitialized) return;
+ ChannelWaveHiTraceInitialized = true;
+ const char *path = std::getenv("FCEU_CHANNEL_WAVEHI_TRACE_PATH");
+ if(!path || !*path) return;
+ const char *start = std::getenv("FCEU_CHANNEL_WAVEHI_TRACE_START_CYCLE");
+ const char *end = std::getenv("FCEU_CHANNEL_WAVEHI_TRACE_END_CYCLE");
+ if(!start || !end)
+ {
+  fprintf(stderr, "FCEUX channel WaveHi trace needs START_CYCLE and END_CYCLE.\n");
+  return;
+ }
+ ChannelWaveHiTraceStartCycle = std::strtoull(start, nullptr, 0);
+ ChannelWaveHiTraceEndCycle = std::strtoull(end, nullptr, 0);
+ if(ChannelWaveHiTraceEndCycle <= ChannelWaveHiTraceStartCycle)
+ {
+  fprintf(stderr, "FCEUX channel WaveHi trace cycle window is invalid.\n");
+  return;
+ }
+ ChannelWaveHiTraceFile = std::fopen(path, "wb");
+ if(!ChannelWaveHiTraceFile)
+  fprintf(stderr, "Unable to create FCEUX channel WaveHi trace: %s\n", path);
+}
+
+static bool ChannelWaveHiTraceActive(void)
+{
+ return ChannelWaveHiTraceFile && timestampbase >= ChannelWaveHiTraceStartCycle &&
+  timestampbase < ChannelWaveHiTraceEndCycle;
+}
+
+static void WriteChannelWaveHiTrace(void)
+{
+ if(!ChannelWaveHiTraceFile) return;
+ for(uint32 index=soundtsoffs; index<SOUNDTS; ++index)
+ {
+  const uint64 cycle = timestampbase + (index - soundtsoffs);
+  if(cycle < ChannelWaveHiTraceStartCycle || cycle >= ChannelWaveHiTraceEndCycle) continue;
+  ChannelWaveHiTraceRecord record{};
+  record.cycle = cycle;
+  for(int channel=0; channel<5; ++channel)
+   record.channel[channel] = ChannelTraceWaveHi[channel][index];
+  record.rawWaveHi = WaveHi[index];
+  if(std::fwrite(&record, sizeof(record), 1, ChannelWaveHiTraceFile) != 1)
+  {
+   fprintf(stderr, "Failed to write FCEUX channel WaveHi trace row at cycle %llu.\n", (unsigned long long)cycle);
+   std::fclose(ChannelWaveHiTraceFile);
+   ChannelWaveHiTraceFile = nullptr;
+   return;
+  }
+ }
+ std::fflush(ChannelWaveHiTraceFile);
+ if(timestampbase + soundtimestamp >= ChannelWaveHiTraceEndCycle)
+ {
+  std::fclose(ChannelWaveHiTraceFile);
+  ChannelWaveHiTraceFile = nullptr;
+ }
+}
 
 
