; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Captain Tsubasa 2 Remake"
config/description="A desktop reconstruction of the opening and title screen from Captain Tsubasa 2: Super Striker."
config/version="0.1.0"
config/update_channel="development"
config/build_commit=""
config/original_release_date="1990-07-20"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7")
boot_splash/show_image=false
boot_splash/bg_color=Color(0.02, 0.04, 0.06, 1)
config/icon="res://assets/branding/captain-tsubasa-2-icon.png"
config/macos_native_icon="res://assets/branding/captain-tsubasa-2.icns"
config/windows_native_icon="res://assets/branding/captain-tsubasa-2.ico"

[display]

window/size/viewport_width=256
window/size/viewport_height=224
window/size/window_width_override=1024
window/size/window_height_override=896
window/stretch/mode="canvas_items"

[input]

opening_start={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":4194309,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventJoypadButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"button_index":6,"pressure":0.0,"pressed":false,"script":null)
]
}

[rendering]

textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.02, 0.04, 0.06, 1)

[editor_plugins]

enabled=PackedStringArray("res://addons/runtime_source_export/plugin.cfg")
