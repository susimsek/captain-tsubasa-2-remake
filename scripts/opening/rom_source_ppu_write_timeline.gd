extends RefCounted
class_name RomSourcePpuWriteTimeline
## Compact ordered PPU-write events generated by executing the supplied ROM.
## This resource is independent of the ROM/emulator at runtime; FCEUX traces
## validate the source model but are not read here.

const SOURCE_ROM_SHA256 := "4f1f74d495e86025a5ad17fec2c171f37a94541a7d8ff7034c580d7d5111a097"
const TIMELINE_PATH := "res://reference/rom_extract/intro/rom_source_a160_ppu_write_timeline.json"
const CE6_DIAGNOSTIC_TIMELINE_PATH := "res://reference/diagnostics/audio/rom_stepper_opcode_ce6_full_4692_20261026/a160_visual_events_ce6_candidate.json"
const INPUT_TIMELINE_SHA256 := "195743d71b36da01b5148e46e14733988d3e5d21cf308ab09eaa735daf83d2d3"

var last_error := ""
var _events_by_source_frame: Dictionary = {}
var _first_source_frame := -1
var _last_source_frame := -1
var _write_count := 0
var _diagnostic_candidate_enabled := false


func configure(use_ce6_diagnostic_candidate: bool = false) -> bool:
	last_error = ""
	_events_by_source_frame.clear()
	_first_source_frame = -1
	_last_source_frame = -1
	_write_count = 0
	_diagnostic_candidate_enabled = use_ce6_diagnostic_candidate
	var timeline_path := CE6_DIAGNOSTIC_TIMELINE_PATH if use_ce6_diagnostic_candidate else TIMELINE_PATH
	if not FileAccess.file_exists(timeline_path):
		return _fail("ROM-derived PPU-write timeline is missing.")
	var parsed: Variant = JSON.parse_string(FileAccess.get_file_as_string(timeline_path))
	if not parsed is Dictionary:
		return _fail("ROM-derived PPU-write timeline is invalid JSON.")
	var document: Dictionary = parsed
	if use_ce6_diagnostic_candidate:
		if str(document.get("rom_sha256", "")) != SOURCE_ROM_SHA256 \
				or str(document.get("input_timeline_sha256", "")) != INPUT_TIMELINE_SHA256 \
				or not str(document.get("purpose", "")).contains("diagnostics-only ROM-source A160") \
				or bool(document.get("captured_ppu_trace_used_as_execution_input", true)):
			return _fail("CE6 diagnostic timeline provenance does not match the expected ROM-only source model.")
	else:
		if int(document.get("schema", 0)) != 1 \
				or str(document.get("rom_sha256", "")) != SOURCE_ROM_SHA256 \
				or bool(document.get("fceux_ppu_trace_or_visual_capture_used_for_generation", true)):
			return _fail("PPU-write timeline provenance does not match the expected ROM-only source model.")
	var events_variant: Variant = document.get("events", [])
	if not events_variant is Array:
		return _fail("PPU-write timeline has no event array.")
	var previous_frame := -1
	for event_frame_variant: Variant in events_variant:
		if not event_frame_variant is Dictionary:
			return _fail("PPU-write timeline contains a malformed frame record.")
		var frame_record: Dictionary = event_frame_variant
		var source_frame := int(frame_record.get("source_frame", -1))
		var writes_variant: Variant = frame_record.get("writes", [])
		if source_frame <= previous_frame or not writes_variant is Array \
				or writes_variant.size() != 2:
			return _fail("PPU-write frame records must be strictly ordered pairs.")
		var writes: Array[Dictionary] = []
		for write_index in 2:
			var write_variant: Variant = writes_variant[write_index]
			if not write_variant is Dictionary:
				return _fail("PPU-write frame %d contains a malformed store." % source_frame)
			var write: Dictionary = write_variant
			for required_key in ["cpu_cycle", "scanline", "dot", "value"]:
				if not write.has(required_key):
					return _fail("PPU-write frame %d is missing %s." % [source_frame, required_key])
			var value := int(write.get("value", -1))
			var scanline := int(write.get("scanline", -1))
			var dot := int(write.get("dot", -1))
			if value < 0 or value > 0xFF or scanline < 0 or scanline >= 240 \
					or dot < 0 or dot >= 341:
				return _fail("PPU-write frame %d contains an out-of-range source store." % source_frame)
			writes.append(write.duplicate(true))
		if int(writes[0]["cpu_cycle"]) >= int(writes[1]["cpu_cycle"]):
			return _fail("PPU-write frame %d has the wrong source order." % source_frame)
		_events_by_source_frame[source_frame] = writes
		_write_count += writes.size()
		if _first_source_frame < 0:
			_first_source_frame = source_frame
		_last_source_frame = source_frame
		previous_frame = source_frame
	if _write_count != int(document.get("write_count", -1)) \
			or _events_by_source_frame.size() != int(document.get("frame_count", -1)):
		return _fail("PPU-write timeline counts do not match its manifest.")
	return true


func writes_for_source_frame(source_frame: int) -> Array[Dictionary]:
	var result: Array[Dictionary] = []
	var writes_variant: Variant = _events_by_source_frame.get(source_frame, [])
	if writes_variant is Array:
		for write_index in writes_variant.size():
			var write_variant: Variant = writes_variant[write_index]
			if write_variant is Dictionary:
				var write: Dictionary = write_variant.duplicate(true)
				write["source_pc"] = "$A175" if write_index == 0 else "$A178"
				write["register"] = 0x2006
				result.append(write)
	return result


func debug_snapshot() -> Dictionary:
	return {
		"loaded": not _events_by_source_frame.is_empty(),
		"source_frame_range": [_first_source_frame, _last_source_frame],
		"frame_count": _events_by_source_frame.size(),
		"write_count": _write_count,
		"diagnostic_candidate_enabled": _diagnostic_candidate_enabled,
		"runtime_rom_or_emulator_dependency": false,
		"last_error": last_error,
	}


func _fail(message: String) -> bool:
	last_error = message
	return false
