}

## Dark-theme emphasis colors keep outline-button labels readable on dark surfaces.
const BUTTON_STYLES := {
	"primary": {
		"background": "0d6efd", "hover": "0b5ed7", "pressed": "0a58ca",
		"text": "ffffff", "outline_text": "6ea8fe",
