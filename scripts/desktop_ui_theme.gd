static func palette_color(family: StringName, shade: int = 500) -> Color:
	var family_name := String(family)
	if family_name == "gray":
		var gray_hex: String = str(BOOTSTRAP_GRAY_SHADES.get(shade, ""))
		if gray_hex.is_empty():
			push_warning("Bootstrap gray shade must be between 100 and 900 in steps of 100.")
			return Color.TRANSPARENT
		return Color(gray_hex)
	if not BOOTSTRAP_BASE_COLORS.has(family_name):
		push_warning("Unknown Bootstrap color family: %s" % family_name)
		return Color.TRANSPARENT

	var base_color := Color(str(BOOTSTRAP_BASE_COLORS[family_name]))
	if shade == 500 or family_name in ["gray-dark", "white", "black"]:
		return base_color
	if shade < 100 or shade > 900 or shade % 100 != 0:
		push_warning("Bootstrap color shade must be between 100 and 900 in steps of 100.")
		return Color.TRANSPARENT

	var mix_amount := absf(float(shade - 500)) / 500.0
	return base_color.lerp(Color.WHITE, mix_amount) if shade < 500 else base_color.lerp(Color.BLACK, mix_amount)


static func theme_color(name: StringName) -> Color:
	var color_hex: String = str(BOOTSTRAP_THEME_COLORS.get(String(name), ""))
	if color_hex.is_empty():
		push_warning("Unknown Bootstrap theme color: %s" % String(name))
		return Color.TRANSPARENT
	return Color(color_hex)


static func apply_button_style(button: Button, variant: StringName, outlined := false) -> void:
	var variant_name := String(variant)
	var variant_style: Dictionary = BUTTON_STYLES.get(variant_name, {})
	if variant_style.is_empty():
		push_warning("Unknown desktop button variant: %s" % variant_name)
		return

	var is_link := variant_name == "link"
	var base_background := Color(str(variant_style["background"]))
	var hover_background := Color(str(variant_style["hover"]))
	var pressed_background := Color(str(variant_style["pressed"]))
	var foreground := Color(str(variant_style["text"]))
	var hover_foreground := Color(str(variant_style.get("hover_text", variant_style["text"])))
	var normal_background := Color.TRANSPARENT if outlined or is_link else base_background
	var normal_border := Color.TRANSPARENT if is_link else base_background
	var normal_foreground := Color(str(variant_style["outline_text"])) if outlined else foreground
	var hover_border := Color.TRANSPARENT if is_link else (base_background if outlined else hover_background)
	var pressed_border := Color.TRANSPARENT if is_link else (base_background if outlined else pressed_background)
	var actual_hover_background := Color.TRANSPARENT if is_link else (base_background if outlined else hover_background)
	var actual_pressed_background := Color.TRANSPARENT if is_link else (base_background if outlined else pressed_background)
	var actual_hover_foreground := hover_foreground if is_link else (foreground if outlined else hover_foreground)
	var actual_pressed_foreground := foreground if outlined else hover_foreground

	button.custom_minimum_size = Vector2(button.custom_minimum_size.x, BUTTON_HEIGHT)
	button.add_theme_font_size_override("font_size", FONT_BODY)
	button.add_theme_color_override("font_color", normal_foreground)
	button.add_theme_color_override("font_hover_color", actual_hover_foreground)
	button.add_theme_color_override("font_pressed_color", actual_pressed_foreground)
	button.add_theme_color_override("font_disabled_color", _with_alpha(normal_foreground, 0.65))
	var border_width := 0 if is_link else BUTTON_BORDER_WIDTH
	button.add_theme_stylebox_override("normal", _button_style(
		normal_background,
		normal_border,
		border_width
	))
	button.add_theme_stylebox_override("hover", _button_style(
		actual_hover_background,
		hover_border,
		border_width
	))
	button.add_theme_stylebox_override("pressed", _button_style(
		actual_pressed_background,
		pressed_border,
		border_width
	))
	button.add_theme_stylebox_override("disabled", _button_style(
		_with_alpha(normal_background if outlined or is_link else base_background, 0.65),
		_with_alpha(normal_border, 0.65),
		0 if is_link else BUTTON_BORDER_WIDTH
	))
	button.add_theme_stylebox_override("focus", _focus_style())


static func create_dialog_surface(dialog: Window) -> PanelContainer:
	var surface := PanelContainer.new()
	surface.name = "Background"
	surface.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	var style := StyleBoxFlat.new()
	style.bg_color = Color(SURFACE_COLOR)
	surface.add_theme_stylebox_override("panel", style)
	dialog.add_child(surface)
	return surface


static func create_menu_item_style(background_color: Color) -> StyleBoxFlat:
	var style := StyleBoxFlat.new()
	style.bg_color = background_color
	style.set_corner_radius_all(4)
	style.content_margin_left = 8
	style.content_margin_right = 8
	style.content_margin_top = 2
	style.content_margin_bottom = 2
	return style


static func create_progress_style(color: Color) -> StyleBoxFlat:
	var style := StyleBoxFlat.new()
	style.bg_color = color
	style.set_corner_radius_all(3)
	return style


static func _button_style(background_color: Color, border_color: Color, border_width: int) -> StyleBoxFlat:
	var style := StyleBoxFlat.new()
	style.bg_color = background_color
	style.border_color = border_color
	style.set_border_width_all(border_width)
	style.set_corner_radius_all(BUTTON_RADIUS)
	style.content_margin_left = BUTTON_PADDING_HORIZONTAL
	style.content_margin_right = BUTTON_PADDING_HORIZONTAL
	style.content_margin_top = BUTTON_PADDING_VERTICAL
	style.content_margin_bottom = BUTTON_PADDING_VERTICAL
	return style


static func _focus_style() -> StyleBoxFlat:
	var style := StyleBoxFlat.new()
	style.bg_color = Color.TRANSPARENT
	style.border_color = Color(FOCUS_COLOR)
	style.set_border_width_all(FOCUS_BORDER_WIDTH)
	style.set_corner_radius_all(BUTTON_RADIUS)
	style.content_margin_left = BUTTON_PADDING_HORIZONTAL - FOCUS_BORDER_WIDTH
	style.content_margin_right = BUTTON_PADDING_HORIZONTAL - FOCUS_BORDER_WIDTH
	style.content_margin_top = BUTTON_PADDING_VERTICAL - FOCUS_BORDER_WIDTH
	style.content_margin_bottom = BUTTON_PADDING_VERTICAL - FOCUS_BORDER_WIDTH
	return style


static func _with_alpha(color: Color, alpha: float) -> Color:
	var result := color
	result.a = alpha
	return result
