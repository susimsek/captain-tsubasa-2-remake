			context.bank_low, context.bank_high, result_mapper,
			int(mapper_variant.get("select", mapper_variant.get("register_select", -1))))
	if not bool(mapper_replay.get("ok", false)):
		return _fail("PASS descriptor-$0F mapper output differs from its ordered ROM writes: %s." % String(mapper_replay.get("reason", "mapper mismatch")))
