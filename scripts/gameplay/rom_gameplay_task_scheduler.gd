			packet_code_span_seen = packet_code_span_seen \
					or (span_file == "fixed_first_command_packet_code_F015_F15A.bin" \
					and span_sha256 == "df7c650c952fb5dfc9a8a10de43f739c9fc4cbdef343bae7ba70c4921a281dc9")
			field_update_span_seen = field_update_span_seen \
					or (span_file == "fixed_field_update_dispatch_D565_D600.bin" \
					and span_sha256 == "fef8713ab595c20f8a968c5771fcb94ab929e3092349f3d73340462b22be1947")
			waiter_span_seen = waiter_span_seen \
					or (span_file == "fixed_shared_waiter_CC46_CCD2.bin" \
					and span_sha256 == "21a4cd33eb56fe3d4da516e0eff910ff375a8d7c3ff42bfa46dfb691a846d5cc")
	var result_sp := int(registers.get("sp", -1)) & 0xFF
	var yield_call_pc := -1
	for call_variant in calls_variant:
		if call_variant is Dictionary:
			var call: Dictionary = call_variant
			if int(call.get("callsite", -1)) in [0xF018, 0xF0A8, 0xD5BD, 0xCC50, 0xCCA0, 0xCCCE] \
					and int(call.get("target", -1)) == 0xCB0F \
					and int(call.get("sp_after_push", -1)) == result_sp:
				yield_call_pc = int(call["callsite"])
	var yield_call_source_span_seen := packet_code_span_seen \
		if yield_call_pc in [0xF018, 0xF0A8] else \
		(field_update_span_seen if yield_call_pc == 0xD5BD else waiter_span_seen)
	var yield_return_word := yield_call_pc + 2
	if yield_call_pc < 0 or not yield_call_source_span_seen \
			or int(result_stack[(result_sp + 1) & 0xFF]) != (yield_return_word & 0xFF) \
			or int(result_stack[(result_sp + 2) & 0xFF]) != ((yield_return_word >> 8) & 0xFF):
		return _fail("Resumed field packet producer did not preserve its ROM `$CB0F` call frame. " \
			+ JSON.stringify({"yield_call_source_span_seen": yield_call_source_span_seen,
				"yield_call_pc": yield_call_pc,
				"sp": result_sp, "stack_return": [int(result_stack[(result_sp + 1) & 0xFF]),
					int(result_stack[(result_sp + 2) & 0xFF])], "calls": calls_variant}))
	var expected_ram := live_ram.duplicate()
	var expected_stack := live_stack.duplicate()
	var field_slot11_clear_writes := PackedByteArray()
	for write_variant in writes_variant:
		if not write_variant is Dictionary:
			return _fail("Resumed field packet producer write stream contains a malformed event.")
		var write: Dictionary = write_variant
		var address := int(write.get("address", -1))
		var value := int(write.get("value", -1))
		var source_pc := int(write.get("pc", -1))
		var allowed_field_slot11_clear := field_update_clear_call_seen and value == 0 \
				and ((address == 0x0011 and source_pc == 0xD5B7) \
				or (address == 0x0012 and source_pc == 0xD5B9))
		if address < 0 or address >= RAM_SIZE or value < 0 or value > 0xFF \
				or (_is_scheduler_owned_ram_address(address) and not allowed_field_slot11_clear):
			return _fail("Resumed field packet producer write is invalid or scheduler-owned at `$%04X`." % address)
		expected_ram[address] = value
		if allowed_field_slot11_clear:
			field_slot11_clear_writes.append(address)
		if address >= 0x0100 and address < 0x0200:
			expected_stack[address & 0xFF] = value
	if field_update_clear_call_seen and field_slot11_clear_writes != PackedByteArray([0x0011, 0x0012]):
		return _fail("ROM `$D565` field dispatch did not produce its ordered `$0011/$0012` slot-$11 clear.")
	if result_ram != expected_ram or result_stack != expected_stack:
		return _fail("Resumed field packet producer RAM/stack differs from replaying its ordered source writes.")
	var expected_low := int(live_boundary.get("bank_low", -1))
	var expected_high := int(live_boundary.get("bank_high", -1))
	var expected_select := int(context.mapper_state.get("register_select",
		context.mapper_state.get("select", -1)))
	for mapper_write_variant in mapper_writes_variant:
		if not mapper_write_variant is Dictionary:
			return _fail("Resumed field packet producer mapper stream contains a malformed event.")
		var mapper_write: Dictionary = mapper_write_variant
		var mapper_address := int(mapper_write.get("address", -1))
		var mapper_value := int(mapper_write.get("value", -1))
		if mapper_address == 0x8000:
			expected_select = mapper_value & 0x07
		elif mapper_address == 0x8001 and expected_select == 6:
			expected_low = mapper_value
		elif mapper_address == 0x8001 and expected_select == 7:
			expected_high = mapper_value
		else:
			return _fail("Resumed field packet producer mapper write is outside the MMC3 contract.")
	if int(mapper.get("bank_low", -1)) != expected_low \
			or int(mapper.get("bank_high", -1)) != expected_high \
			or int(mapper.get("select", -1)) != expected_select:
		return _fail("Resumed field packet producer mapper state differs from replaying its source writes. " \
			+ JSON.stringify({"expected": {"bank_low": expected_low, "bank_high": expected_high,
				"select": expected_select}, "actual": {"bank_low": mapper.get("bank_low", -1),
				"bank_high": mapper.get("bank_high", -1), "select": mapper.get("select", -1)},
				"source_writes": mapper_writes_variant}))
	var cleared_slot11: TaskContext = _contexts.get(0x11) if field_update_clear_call_seen else null
	if field_update_clear_call_seen:
		if cleared_slot11 != null:
			if _active_task_slot == 0x11 or cleared_slot11.phase == ContextPhase.RUNNING:
				return _fail("ROM `$D565` slot-$11 clear conflicts with a currently running actor task.")
	_ram = expected_ram
	_stack_page = expected_stack
	if cleared_slot11 != null:
		cleared_slot11.ready_delay = 0
		cleared_slot11.stack_pointer = 0
		cleared_slot11.phase = ContextPhase.FINISHED
		cleared_slot11.pending_resume = ResumeKind.NONE
	context.accumulator = int(registers.get("a", -1)) & 0xFF
	context.x_register = int(registers.get("x", -1)) & 0xFF
	context.y_register = int(registers.get("y", -1)) & 0xFF
	context.status_register = int(registers.get("p", context.status_register)) & 0xFF
	context.status_known_mask = int(registers.get("p_known_mask", context.status_known_mask)) & 0xFF
	context.stack_pointer = result_sp
	context.program_counter = 0xCB0F
	context.bank_low = expected_low
	context.bank_high = expected_high
	context.mapper_state = mapper.duplicate(true)
	context.source_label = "ROM-byte scenario-$44 field packet producer yielded at `$%04X->$CB0F`" % yield_call_pc
	_slot05_scenario44_field_entry_yield_in_progress = true
	var saved := yield_at_verified_callsite(0x05, yield_call_pc, context.accumulator,
		(result_sp + 2) & 0xFF, context.x_register, context.y_register,
		context.bank_low, context.bank_high, true)
	_slot05_scenario44_field_entry_yield_in_progress = false
	if not saved:
		return false
	return true


## Adopts the scenario-$44 continuation when its source path enters the shared
## bank-$18 renderer and reaches the ROM `$8886->$C515` worker yield.
func adopt_slot05_scenario44_field_worker_resume_yield(live_boundary: Dictionary,
		previous_worker_result: Dictionary, worker_result: Dictionary) -> bool:
	if not _require_initialized():
		return false
	var context: TaskContext = _contexts.get(0x05)
	var live_ram_variant: Variant = live_boundary.get("ram_image", PackedByteArray())
	var live_stack_variant: Variant = live_boundary.get("stack_page", PackedByteArray())
	var dispatch_variant: Variant = worker_result.get("source_dispatch", {})
	var entry_registers_variant: Variant = worker_result.get("entry_registers", {})
	var entry_mapper_variant: Variant = worker_result.get("entry_mapper", {})
	var registers_variant: Variant = worker_result.get("registers", {})
	var mapper_variant: Variant = worker_result.get("mapper", {})
	var result_ram_variant: Variant = worker_result.get("ram_image", PackedByteArray())
	var result_stack_variant: Variant = worker_result.get("stack_page", PackedByteArray())
	var writes_variant: Variant = worker_result.get("writes", [])
	var mapper_writes_variant: Variant = worker_result.get("mapper_writes", [])
	var calls_variant: Variant = worker_result.get("calls", [])
	var spans_variant: Variant = worker_result.get("executed_source_spans", [])
	var source_boundary_variant: Variant = worker_result.get("source_boundary", {})
	if context == null or not live_ram_variant is PackedByteArray \
			or not live_stack_variant is PackedByteArray or not dispatch_variant is Dictionary \
			or not entry_registers_variant is Dictionary or not entry_mapper_variant is Dictionary \
			or not registers_variant is Dictionary or not mapper_variant is Dictionary \
			or not result_ram_variant is PackedByteArray or not result_stack_variant is PackedByteArray \
			or not writes_variant is Array or not mapper_writes_variant is Array \
			or not calls_variant is Array or not spans_variant is Array \
			or not source_boundary_variant is Dictionary:
		return _fail("Scenario-$44 field-renderer yield omitted its live source state or proof.")
	var live_ram: PackedByteArray = live_ram_variant
	var live_stack: PackedByteArray = live_stack_variant
	var dispatch: Dictionary = dispatch_variant
	var entry_registers: Dictionary = entry_registers_variant
	var entry_mapper: Dictionary = entry_mapper_variant
	var registers: Dictionary = registers_variant
	var mapper: Dictionary = mapper_variant
	var result_ram: PackedByteArray = result_ram_variant
	var result_stack: PackedByteArray = result_stack_variant
	var source_boundary: Dictionary = source_boundary_variant
	var resume_pc := int(dispatch.get("pc", -1))
	var prior_yield_call_pc := -1
	match resume_pc:
		0xF01B: prior_yield_call_pc = 0xF018
		0xF0AB: prior_yield_call_pc = 0xF0A8
		0xD5C0: prior_yield_call_pc = 0xD5BD
		0xCC53: prior_yield_call_pc = 0xCC50
		0xCCA3: prior_yield_call_pc = 0xCCA0
		0xCCD1: prior_yield_call_pc = 0xCCCE
	var expected_context_label := "ROM-byte scenario-$44 field packet producer yielded at `$%04X->$CB0F`" % prior_yield_call_pc
	var previous_registers: Dictionary = previous_worker_result.get("registers", {})
	var previous_calls_variant: Variant = previous_worker_result.get("calls", [])
	var previous_call_seen := false
	if previous_calls_variant is Array:
		for call_variant in previous_calls_variant:
			if call_variant is Dictionary:
				var call: Dictionary = call_variant
				if int(call.get("callsite", -1)) == prior_yield_call_pc \
						and int(call.get("target", -1)) == 0xCB0F \
						and int(call.get("sp_after_push", -1)) == int(previous_registers.get("sp", -2)):
					previous_call_seen = true
	var expected_dispatch_bank := 0x1E if resume_pc in [0xD5C0, 0xCC53, 0xCCA3, 0xCCD1] else 0x1F
	if _active_task_slot != 0x05 or context.phase != ContextPhase.RUNNING \
			or prior_yield_call_pc < 0 or context.program_counter != resume_pc \
			or String(context.source_label) != expected_context_label \
			or int(live_boundary.get("slot_base", -1)) != 0x05 \
			or int(live_boundary.get("active_task_slot", -1)) != 0x05 \
			or int(live_boundary.get("pc", -1)) != resume_pc \
			or int(live_boundary.get("a", -1)) != context.accumulator \
			or int(live_boundary.get("x", -1)) != context.x_register \
			or int(live_boundary.get("y", -1)) != context.y_register \
			or int(live_boundary.get("sp", -1)) != context.stack_pointer \
			or int(live_boundary.get("bank_low", -1)) != 0x1A \
			or int(live_boundary.get("bank_high", -1)) != 0x1B \
			or live_ram.size() != RAM_SIZE or live_stack.size() != STACK_PAGE_SIZE \
			or live_ram.slice(0x0100, 0x0200) != live_stack \
			or _ram != live_ram or _stack_page != live_stack:
		return _fail("Scenario-$44 renderer continuation does not match the live selected slot-$05 state.")
	if not previous_call_seen \
			or String(previous_worker_result.get("rom_sha256", "")) != ROM_SHA256 \
			or String(previous_worker_result.get("source_manifest", "")) != "res://reference/rom_extract/gameplay/fresh_bank18_worker_prefix/manifest.json" \
			or String(previous_worker_result.get("source_manifest_sha256", "")) != FRESH_BANK18_WORKER_MANIFEST_SHA256 \
			or String(previous_worker_result.get("status", "")) not in [ \
				"scenario44_field_entry_source_call_boundary", \
				"scenario44_field_entry_resume_source_call_boundary"] \
			or int(previous_worker_result.get("exit_pc", -1)) != 0xCB0F:
		return _fail("Scenario-$44 renderer entry lacks its previous source-proven `$CB0F` yield.")
	if String(worker_result.get("rom_sha256", "")) != ROM_SHA256 \
			or String(worker_result.get("source_manifest", "")) != "res://reference/rom_extract/gameplay/fresh_bank18_worker_prefix/manifest.json" \
			or String(worker_result.get("source_manifest_sha256", "")) != FRESH_BANK18_WORKER_MANIFEST_SHA256 \
			or String(worker_result.get("status", "")) != "scenario44_field_entry_resume_source_call_boundary" \
			or String(worker_result.get("exit_kind", "")) != "source_call_boundary" \
			or int(worker_result.get("exit_pc", -1)) != 0xC515 \
			or int(worker_result.get("exit_bank", -1)) != 0x1E \
			or String(source_boundary.get("status", "")) != "scenario44_field_entry_resume_source_call_boundary" \
			or int(source_boundary.get("address", -1)) != 0xC515 \
			or String(dispatch.get("rom_sha256", "")) != ROM_SHA256 \
			or int(dispatch.get("slot_base", -1)) != 0x05 \
			or String(dispatch.get("resume_path", "")) != "yielded_rts" \
			or int(dispatch.get("bank", -1)) != expected_dispatch_bank \
			or not bool(dispatch.get("source_dispatch_observed", false)) \
			or int(entry_registers.get("pc", -1)) != resume_pc \
			or int(entry_registers.get("a", -1)) != context.accumulator \
			or int(entry_registers.get("x", -1)) != context.x_register \
			or int(entry_registers.get("y", -1)) != context.y_register \
			or int(entry_registers.get("sp", -1)) != context.stack_pointer \
			or int(registers.get("pc", -1)) != 0xC515 \
			or int(registers.get("sp", -1)) < 0 or int(registers.get("sp", -1)) > 0xFF \
			or entry_mapper.get("bank_low", -1) != context.bank_low \
			or entry_mapper.get("bank_high", -1) != context.bank_high \
			or result_ram.size() != RAM_SIZE or result_stack.size() != STACK_PAGE_SIZE \
			or result_ram.slice(0x0100, 0x0200) != result_stack:
		return _fail("Scenario-$44 ROM renderer result does not match the source-dispatched `$C515` boundary.")
	var renderer_span_seen := false
	var wrapper_span_seen := false
	for span_variant in spans_variant:
		if span_variant is Dictionary:
			var span: Dictionary = span_variant
			var file_name := String(span.get("file", ""))
			var sha256 := String(span.get("sha256", ""))
			if file_name == "bank18_worker_entry_to_yield_call_800C_8889.bin" \
					and sha256 == "3b6cea5d679e0a5aab87d7bd5a721658448463cec6062ad006c3d5d869aeb49e":
				renderer_span_seen = true
			if file_name == "fixed_bank18_wrapper_EF7F_EF99.bin" \
					and sha256 == "8871a231231e221f0a7394c1a1762acdd8fe6d5a68babb454b5bbdb5f5192e0e":
				wrapper_span_seen = true
	if not renderer_span_seen or not wrapper_span_seen:
		return _fail("Scenario-$44 renderer result omits its ROM wrapper or bank-$18 worker source spans.")
	var worker_yield_call_seen := false
	var action_wrapper_call_seen := false
	for call_variant in calls_variant:
		if call_variant is Dictionary:
			var call: Dictionary = call_variant
			if int(call.get("callsite", -1)) == 0x8886 \
					and int(call.get("target", -1)) == 0xC515 \
					and int(call.get("sp_after_push", -1)) == int(registers.get("sp", -2)):
				worker_yield_call_seen = true
			if int(call.get("callsite", -1)) == 0xD5D4 \
					and int(call.get("target", -1)) == 0xEF7F:
				action_wrapper_call_seen = true
	var result_sp := int(registers.get("sp", -1)) & 0xFF
	if not worker_yield_call_seen or not action_wrapper_call_seen \
			or int(result_stack[(result_sp + 1) & 0xFF]) != 0x88 \
			or int(result_stack[(result_sp + 2) & 0xFF]) != 0x88:
		return _fail("Scenario-$44 renderer did not preserve the source `$D5D4->$EF7F->$8886->$C515` call chain.")
	var expected_ram := live_ram.duplicate()
	var expected_stack := live_stack.duplicate()
	for write_variant in writes_variant:
		if not write_variant is Dictionary:
			return _fail("Scenario-$44 renderer RAM write stream contains a malformed event.")
		var write: Dictionary = write_variant
		var address := int(write.get("address", -1))
		var value := int(write.get("value", -1))
		if address < 0 or address >= RAM_SIZE or value < 0 or value > 0xFF \
				or not write.has("pc") or _is_scheduler_owned_ram_address(address):
			return _fail("Scenario-$44 renderer write conflicts with scheduler-owned RAM at `$%04X`." % address)
		expected_ram[address] = value
		if address >= 0x0100 and address < 0x0200:
			expected_stack[address & 0xFF] = value
	if expected_ram != result_ram or expected_stack != result_stack:
		return _fail("Scenario-$44 renderer RAM/stack differs from replaying its ROM write stream.")
	var expected_low := int(live_boundary.get("bank_low", -1))
	var expected_high := int(live_boundary.get("bank_high", -1))
	var expected_select := int(context.mapper_state.get("register_select",
		context.mapper_state.get("select", -1)))
	for mapper_write_variant in mapper_writes_variant:
		if not mapper_write_variant is Dictionary:
			return _fail("Scenario-$44 renderer mapper write stream contains a malformed event.")
		var mapper_write: Dictionary = mapper_write_variant
		var mapper_address := int(mapper_write.get("address", -1))
		var mapper_value := int(mapper_write.get("value", -1))
		if mapper_address == 0x8000:
			expected_select = mapper_value & 0x07
		elif mapper_address == 0x8001 and expected_select == 6:
			expected_low = mapper_value
		elif mapper_address == 0x8001 and expected_select == 7:
			expected_high = mapper_value
		else:
			return _fail("Scenario-$44 renderer mapper write is outside the MMC3 contract.")
	if int(mapper.get("bank_low", -1)) != expected_low \
			or int(mapper.get("bank_high", -1)) != expected_high \
			or int(mapper.get("select", -1)) != expected_select:
		return _fail("Scenario-$44 renderer mapper differs from replaying its ROM register writes.")
	_ram = expected_ram
	_stack_page = expected_stack
	context.accumulator = int(registers.get("a", -1)) & 0xFF
	context.x_register = int(registers.get("x", -1)) & 0xFF
	context.y_register = int(registers.get("y", -1)) & 0xFF
	context.status_register = int(registers.get("p", context.status_register)) & 0xFF
	context.status_known_mask = int(registers.get("p_known_mask", context.status_known_mask)) & 0xFF
	context.stack_pointer = result_sp
	context.program_counter = 0xC515
	context.bank_low = expected_low
	context.bank_high = expected_high
	context.mapper_state = mapper.duplicate(true)
	context.source_label = "ROM-byte scenario-$44 Action renderer worker yielded at `$8886->$C515`"
	return true


## Adopts the ROM-sourced scenario-$36 `$CBC1 RTS->$DB13->$E0DF` handoff.
func adopt_slot05_scenario36_queue_return_state(dispatch: Dictionary,
		boundary: Dictionary, return_result: Dictionary) -> bool:
	if not _require_initialized():
		return false
	var context: TaskContext = _contexts.get(0x05)
	var registers: Variant = return_result.get("registers", {})
	var mapper: Variant = return_result.get("mapper", {})
	var result_ram: Variant = return_result.get("ram_image", PackedByteArray())
	var result_stack: Variant = return_result.get("stack_page", PackedByteArray())
	var live_ram: Variant = boundary.get("ram_image", PackedByteArray())
	var live_stack: Variant = boundary.get("stack_page", PackedByteArray())
	var physical_stack: PackedByteArray = live_stack if live_stack is PackedByteArray else PackedByteArray()
	var stack_return_word := int(physical_stack[(0x4E + 1) & 0xFF]) \
		| (int(physical_stack[(0x4E + 2) & 0xFF]) << 8) if physical_stack.size() == STACK_PAGE_SIZE else -1
	if _active_task_slot != 0x05 or context == null \
			or context.phase != ContextPhase.RUNNING or context.program_counter != 0xCBC1 \
			or context.source_label != "ROM-byte fresh scenario-$36 caller `$DB0E->$CBB0->$CB0F`" \
			or context.source_return_word != 0xD11D \
			or int(dispatch.get("pc", -1)) != 0xCBC1 or int(dispatch.get("sp", -1)) != 0x4E \
			or int(dispatch.get("source_return_word", -1)) != 0xD11D \
			or int(boundary.get("pc", -1)) != 0xCBC1 or int(boundary.get("sp", -1)) != 0x4E \
			or String(boundary.get("source_label", "")) != "ROM-byte fresh scenario-$36 caller `$DB0E->$CBB0->$CB0F`" \
			or stack_return_word != 0xDB12 \
			or String(return_result.get("rom_sha256", "")) != ROM_SHA256 \
			or String(return_result.get("source_manifest", "")) != "res://reference/rom_extract/gameplay/first_command_scenarios/manifest.json" \
			or String(return_result.get("status", "")) != "scenario36_queue_returned_to_e0df" \
			or int(return_result.get("return_word", -1)) != 0xDB12 \
			or int(return_result.get("entry_pc", -1)) != 0xCBC1 or int(return_result.get("exit_pc", -1)) != 0xE0DF \
			or int(return_result.get("entry_sp", -1)) != 0x4E or int(return_result.get("exit_sp", -1)) != 0x50 \
			or not registers is Dictionary or int(registers.get("pc", -1)) != 0xE0DF \
			or int(registers.get("sp", -1)) != 0x50 or int(registers.get("x", -1)) != 0x50 \
			or not mapper is Dictionary or int(mapper.get("bank_low", -1)) != 0x1C \
			or int(mapper.get("bank_high", -1)) != 0x1D \
			or not live_ram is PackedByteArray or live_ram.size() != RAM_SIZE \
			or not live_stack is PackedByteArray or live_stack.size() != STACK_PAGE_SIZE \
			or not result_ram is PackedByteArray or result_ram.size() != RAM_SIZE \
			or not result_stack is PackedByteArray or result_stack != live_stack:
		return _fail("Scenario-$36 queue return does not match the physical `$DB12` frame and `$DB13->$E0DF` source handoff.")
	var expected_ram: PackedByteArray = (live_ram as PackedByteArray).duplicate()
	var writes: Array = return_result.get("writes", [])
	for write_variant in writes:
		if not write_variant is Dictionary:
			return _fail("Scenario-$36 `$DB13` handoff contains a malformed RAM write.")
		var write: Dictionary = write_variant
		var address := int(write.get("address", -1))
		var value := int(write.get("value", -1))
		if (address == 0x0441 and (int(write.get("pc", -1)) != 0xDB16 or value != int(expected_ram[0x05FC]))) \
				or (address == 0x05FD and (int(write.get("pc", -1)) != 0xDB1B or value != 0x01)) \
				or address not in [0x0441, 0x05FD]:
			return _fail("Scenario-$36 `$DB13` RAM write differs from the source `$05FC->$0441`/`$05FD=1` transfer.")
		expected_ram[address] = value
	if writes.size() != 2 or result_ram != expected_ram:
		return _fail("Scenario-$36 `$DB13` output RAM differs from its two source-owned stores.")
	_ram = expected_ram
	_stack_page = (result_stack as PackedByteArray).duplicate()
	context.accumulator = int(registers["a"]) & 0xFF
	context.x_register = int(registers["x"]) & 0xFF
	context.y_register = int(registers["y"]) & 0xFF
	context.status_register = int(registers.get("p", context.status_register)) & 0xFF
	context.status_known_mask = int(registers.get("p_known_mask", context.status_known_mask)) & 0xFF
	context.program_counter = 0xE0DF
	context.stack_pointer = 0x50
	context.source_label = "ROM-byte scenario-$36 handoff `$CBC1->$DB13->$E0DF`"
	return true


## Adopts the source-executed first `$E0DF->$EF7F->$800C` renderer call.
## Only its physical stack pushes may differ from the accepted `$E0DF` handoff.
func adopt_slot05_field_entry_worker_entry(handoff_result: Dictionary,
		worker_entry: Dictionary) -> bool:
	if not _require_initialized():
		return false
	var context: TaskContext = _contexts.get(0x05)
	var registers_variant: Variant = worker_entry.get("registers", {})
	var mapper_variant: Variant = worker_entry.get("mapper", {})
	var ram_variant: Variant = worker_entry.get("ram_image", PackedByteArray())
	var stack_variant: Variant = worker_entry.get("stack_page", PackedByteArray())
	var handoff_ram_variant: Variant = handoff_result.get("ram_image", PackedByteArray())
	var is_scenario1c_handoff := String(handoff_result.get("status", "")) \
		== "scenario1c_pass_handoff_returned_to_e0df"
	var expected_handoff_label := "ROM-byte scenario-$1C PASS handoff `$DE90->$E0DF`" \
		if is_scenario1c_handoff else "ROM-byte scenario-$36 handoff `$CBC1->$DB13->$E0DF`"
	if _active_task_slot != 0x05 or context == null \
			or context.phase != ContextPhase.RUNNING or context.program_counter != 0xE0DF \
			or context.source_label != expected_handoff_label \
			or String(worker_entry.get("rom_sha256", "")) != ROM_SHA256 \
			or String(worker_entry.get("source_manifest", "")) != "res://reference/rom_extract/gameplay/fresh_daaa_continuation/manifest.json" \
			or String(worker_entry.get("status", "")) != "field_entry_first_renderer_wrapper_returned_to_bank18" \
			or String((worker_entry.get("source_context", {}) as Dictionary).get("kind", "")) != "field_entry_e0df_first_renderer" \
			or int(worker_entry.get("entry_pc", -1)) != 0xE0DF \
			or int(worker_entry.get("exit_pc", -1)) != 0x800C \
			or int(worker_entry.get("exit_bank", -1)) != 0x18 \
			or not registers_variant is Dictionary or not mapper_variant is Dictionary \
			or not ram_variant is PackedByteArray or not stack_variant is PackedByteArray \
			or not handoff_ram_variant is PackedByteArray:
		return _fail("Field-entry worker adoption requires the live source `$E0DF->$EF7F->$800C` result.")
	var registers: Dictionary = registers_variant
	var mapper: Dictionary = mapper_variant
	var result_ram: PackedByteArray = ram_variant
	var result_stack: PackedByteArray = stack_variant
	var handoff_ram: PackedByteArray = handoff_ram_variant
	var p_known_mask := int(registers.get("p_known_mask", -1))
	if result_ram.size() != RAM_SIZE or result_stack.size() != STACK_PAGE_SIZE \
			or handoff_ram.size() != RAM_SIZE \
			or result_ram.slice(0x0100, 0x0200) != result_stack \
			or int(registers.get("a", -1)) != 0x00 \
			or int(registers.get("x", -1)) != 0x50 \
			or int(registers.get("y", -1)) != 0x00 \
			or p_known_mask < 0 \
			or ((int(registers.get("p", -1)) ^ 0x33) & p_known_mask) != 0 \
			or int(registers.get("sp", -1)) != 0x4A \
			or int(registers.get("pc", -1)) != 0x800C \
			or int(mapper.get("bank_low", -1)) != 0x18 \
			or int(mapper.get("bank_high", -1)) != 0x19 \
			or int(mapper.get("select", -1)) != 0x07:
		return _fail("The `$800C` renderer entry registers or mapper state do not match the source trace.")
	var saw_low_bank_shadow := false
	var saw_high_bank_shadow := false
	var selector_shadow_values: Array[int] = []
	for write_variant in worker_entry.get("writes", []):
		if not write_variant is Dictionary:
			return _fail("The `$E0DF->$800C` wrapper contains a malformed RAM write.")
		var write: Dictionary = write_variant
		var address := int(write.get("address", -1))
		var value := int(write.get("value", -1))
		var source_pc := int(write.get("pc", -1))
		if address == 0x0024:
			if source_pc != 0xEF8C or value != 0x18 or saw_low_bank_shadow:
				return _fail("The fixed wrapper's `$24=$18` bank-shadow store differs from ROM bytes.")
			saw_low_bank_shadow = true
		elif address == 0x0025:
			if source_pc != 0xEF90 or value != 0x19 or saw_high_bank_shadow:
				return _fail("The fixed wrapper's `$25=$19` bank-shadow store differs from ROM bytes.")
			saw_high_bank_shadow = true
		elif address == 0x0023:
			var expected_shadow := (int(handoff_ram[0x0022]) | (0x06 if selector_shadow_values.is_empty() else 0x07)) & 0xFF
			var expected_pc := 0xCE31 if selector_shadow_values.is_empty() else 0xCE3F
			if source_pc != expected_pc or value != expected_shadow or selector_shadow_values.size() >= 2:
				return _fail("The `$CE2D` mapper-helper `$23` shadow stores differ from ROM bytes.")
			selector_shadow_values.append(value)
		elif address < 0x014A or address > 0x0150:
			return _fail("The `$E0DF->$800C` wrapper wrote unsupported RAM `$%04X`." % address)
	if not saw_low_bank_shadow or not saw_high_bank_shadow \
			or selector_shadow_values.size() != 2 \
			or int(result_ram[0x0023]) != selector_shadow_values[1] \
			or int(result_ram[0x0024]) != 0x18 or int(result_ram[0x0025]) != 0x19:
		return _fail("The first renderer wrapper did not retain its source `$23/$24/$25` mapper shadows.")
	var mapper_writes: Array = worker_entry.get("mapper_writes", [])
	var expected_mapper_contract := [
		{"pc": 0xCE33, "address": 0x8000,
			"value": (int(handoff_ram[0x0022]) | 0x06) & 0xFF, "select": 0x06},
		{"pc": 0xCE38, "address": 0x8001, "value": 0x18, "select": 0x06},
		{"pc": 0xCE41, "address": 0x8000,
			"value": (int(handoff_ram[0x0022]) | 0x07) & 0xFF, "select": 0x07},
		{"pc": 0xCE46, "address": 0x8001, "value": 0x19, "select": 0x07},
	]
	if mapper_writes.size() != expected_mapper_contract.size():
		return _fail("The first renderer wrapper mapper writes do not match the four `$CE2D` stores.")
	for write_index in range(expected_mapper_contract.size()):
		var actual_mapper_write: Dictionary = mapper_writes[write_index]
		var expected_mapper_write: Dictionary = expected_mapper_contract[write_index]
		for key: String in ["pc", "address", "value", "select"]:
			if int(actual_mapper_write.get(key, -1)) != int(expected_mapper_write[key]):
				return _fail("The first renderer wrapper mapper write %d differs at %s." % [write_index, key])
	for address in range(RAM_SIZE):
		if address in [0x0023, 0x0024, 0x0025] \
				or (address >= 0x014A and address <= 0x0150):
			continue
		if int(result_ram[address]) != int(handoff_ram[address]):
			return _fail("The `$E0DF->$800C` wrapper changed non-stack RAM at `$%04X`." % address)
	var stack_top: String = String(worker_entry.get("stack_top_sp_plus_1_to_8", ""))
	if not stack_top.begins_with("98ef"):
		return _fail("The `$800C` physical JSR stack does not return to the `$EF98` wrapper continuation.")
	_ram = result_ram.duplicate()
	_stack_page = result_stack.duplicate()
	context.accumulator = int(registers["a"]) & 0xFF
	context.x_register = int(registers["x"]) & 0xFF
	context.y_register = int(registers["y"]) & 0xFF
	context.status_register = int(registers["p"]) & 0xFF
	context.status_known_mask = int(registers.get("p_known_mask", 0xFF)) & 0xFF
	context.program_counter = 0x800C
	context.stack_pointer = 0x4A
	context.bank_low = 0x18
	context.bank_high = 0x19
	context.mapper_state = mapper.duplicate(true)
	context.source_label = "ROM-byte field renderer entry `$E0DF->$EF7F->$800C` descriptor `$00`"
	return true


