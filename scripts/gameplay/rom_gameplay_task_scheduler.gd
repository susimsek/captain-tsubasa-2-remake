	if not parsed is Dictionary:
		return _fail("Actor-$6D stream manifest is malformed.")
	var manifest: Dictionary = parsed
	var source_rom: Dictionary = manifest.get("source_rom", {})
	var stream_span: Dictionary = {}
	var spans: Variant = manifest.get("spans", [])
	if spans is Array:
		for span_variant: Variant in spans:
			if span_variant is Dictionary \
					and String(span_variant.get("name", "")) == "actor_parameter_6D_stream":
				stream_span = span_variant
				break
	var stream_path := "res://reference/rom_extract/gameplay/slot11_actor_parameter_6d/bank18_actor_parameter_6d_stream_9be3_9c70.bin"
	var expected_hash := "0b787ded174d6496196c978f5b835c4e89c9858a8499617b02bacc5b3f7b7d1e"
	var stream_bytes := FileAccess.get_file_as_bytes(stream_path)
	if String(manifest.get("schema", "")) != "ct2-slot11-actor-parameter-6d-source-v1" \
			or String(source_rom.get("sha256", "")) != ROM_SHA256 \
			or String(stream_span.get("file", "")) != "bank18_actor_parameter_6d_stream_9be3_9c70.bin" \
			or String(stream_span.get("cpu_start", "")) != "0x9BE3" \
			or int(stream_span.get("length_bytes", -1)) != 142 \
			or String(stream_span.get("sha256", "")) != expected_hash \
			or stream_bytes.size() != 142 or _sha256(stream_bytes) != expected_hash:
