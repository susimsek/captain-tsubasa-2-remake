		return shared_waiter.size() == 140 \
				and _sha256(shared_waiter) == "21a4cd33eb56fe3d4da516e0eff910ff375a8d7c3ff42bfa46dfb691a846d5cc" \
				and shared_waiter.slice(0x0A, 0x0D) == PackedByteArray([0x20, 0x0F, 0xCB]) \
				and _sources.get("yield_trampoline", PackedByteArray()) == PackedByteArray([0x4C, 0x0F, 0xCB])
	if source_pc == 0xD5BD:
		var field_update := FileAccess.get_file_as_bytes(
				"res://reference/rom_extract/gameplay/fresh_bank18_worker_prefix/fixed_field_update_dispatch_D565_D600.bin")
		return field_update.size() == 0x9B \
				and _sha256(field_update) == "fef8713ab595c20f8a968c5771fcb94ab929e3092349f3d73340462b22be1947" \
				and field_update.slice(0x58, 0x5B) == PackedByteArray([0x20, 0x0F, 0xCB]) \
				and _sources.get("yield_trampoline", PackedByteArray()) == PackedByteArray([0x4C, 0x0F, 0xCB])
	if source_pc == 0xD5E7:
		var field_update := FileAccess.get_file_as_bytes(
				"res://reference/rom_extract/gameplay/fresh_bank18_worker_prefix/fixed_field_update_dispatch_D565_D600.bin")
		return field_update.size() == 0x9B \
				and _sha256(field_update) == "fef8713ab595c20f8a968c5771fcb94ab929e3092349f3d73340462b22be1947" \
				and field_update.slice(0x82, 0x85) == PackedByteArray([0x20, 0x0F, 0xCB]) \
				and _sources.get("yield_trampoline", PackedByteArray()) == PackedByteArray([0x4C, 0x0F, 0xCB])
	if source_pc == 0xDADF:
		var scenario_wait := FileAccess.get_file_as_bytes(
