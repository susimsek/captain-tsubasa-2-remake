			or int(result.get("final_sp", -1)) != ((entry_sp - 4) & 0xFF) \
			or result.get("executed_source_pcs", []) != [0xD7E8, 0xD7EA, 0xCBB0,
				0xCBB3, 0xCBB5, 0xCBB8, 0xCBBA, 0xCBBC, 0xCBBE] \
