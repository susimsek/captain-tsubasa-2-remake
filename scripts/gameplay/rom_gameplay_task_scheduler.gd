	if not bool(proof.get("ok", false)):
		_fail(String(proof.get("reason", "Invalid slot-$11 waiter result.")))
		return {}
	var entry_pc := int(worker_result.get("entry_pc", -1))
	var callsite_pc := int(worker_result.get("yield_callsite_pc", -1))
