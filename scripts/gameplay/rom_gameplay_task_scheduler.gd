			or int(mapper.get("bank_high", -1)) != 0x19 \
			or int(save.get("slot_base", -1)) != 0x11 \
			or int(save.get("delay_in_a", -1)) != 0x01 \
			or int(save.get("callsite_pc", -1)) != callsite_pc \
			or int(save.get("target_pc", -1)) != 0xCB0F \
			or int(save.get("resume_pc", -1)) != resume_pc \
			or int(save.get("pre_jsr_sp", -1)) != callsite_sp \
			or int(save.get("cb0f_entry_sp", -1)) != cb0f_sp \
			or int(save.get("expected_saved_sp_after_cb0f_pushes", -1)) != saved_sp \
			or save.get("mapper_low_high", PackedByteArray()) != PackedByteArray([0x18, 0x19]):
		return {"ok": false, "reason": "The slot-$11 waiter source CPU/mapper/save contract is inconsistent: entry=%s callsite=%s cb0f=%s mapper=%s save=%s." % [
			str(entry), str(callsite), str(cb0f), str(mapper), str(save)]}
	if is_event_payload_result:
		if scenario2e_actor6d_type5_entry_profile:
			var decoded_event: Variant = result.get("decoded_event", {})
			if not decoded_event is Dictionary \
					or int(decoded_event.get("address", -1)) != 0x9BFF \
					or int(decoded_event.get("byte", -1)) != 0x52 \
					or int(decoded_event.get("type", -1)) != 0x05 \
					or int(decoded_event.get("type_value", -1)) != 0x0E \
					or int(decoded_event.get("dispatch_index", -1)) != 0x01 \
					or int(decoded_event.get("payload_address", -1)) != 0x8FBF \
					or decoded_event.get("payload", []) != PackedByteArray([0x2C, 0x22, 0x14]) \
					or int(decoded_event.get("wait_counter", -1)) != 0x06:
				return {"ok": false, "reason": "The actor-$6D decoded event metadata differs from the ROM `$9BFF/$8218/$8FBF` path."}
		var event_reads: Array[Array] = [
			[0xA3CA, 0x20, "actor_event_byte"],
			[0x86BA, 0x0E, "actor_event_type_value"],
			[0x8DC6, 0x94, "actor_event_payload_pointer_low"],
			[0x8DC7, 0x8E, "actor_event_payload_pointer_high"],
			[0x8E94, 0x2C, "actor_event_payload_byte_0"],
			[0x8E95, 0x22, "actor_event_payload_byte_1"],
			[0x8E96, 0x14, "actor_event_payload_byte_2"],
		]
		if parameter47_f2_entry_profile:
			event_reads = [
				[0x9919, 0x51, "actor_event_byte"],
				[0x86BD, 0x0E, "actor_event_type_value"],
				[0x8DCC, 0xBF, "actor_event_payload_pointer_low"],
				[0x8DCD, 0x8F, "actor_event_payload_pointer_high"],
				[0x8FBF, 0x2C, "actor_event_payload_byte_0"],
				[0x8FC0, 0x22, "actor_event_payload_byte_1"],
				[0x8FC1, 0x14, "actor_event_payload_byte_2"],
			]
		elif scenario2e_actor6d_type5_entry_profile:
			event_reads = [
				[0x9BFF, 0x52, "actor_event_byte"],
				[0x86BD, 0x0E, "actor_event_type_value"],
				[0x8DCC, 0xBF, "actor_event_payload_pointer_low"],
				[0x8DCD, 0x8F, "actor_event_payload_pointer_high"],
				[0x8FBF, 0x2C, "actor_event_payload_byte_0"],
				[0x8FC0, 0x22, "actor_event_payload_byte_1"],
				[0x8FC1, 0x14, "actor_event_payload_byte_2"],
			]
		elif scenario1c_parameter58_event_profile or scenario1c_callback63_parameter58_event_profile:
			event_reads = [
				[0x9A63, 0x10, "actor_event_byte"],
				[0x86B9, 0x0E, "actor_event_type_value"],
				[0x8DC4, 0x37, "actor_event_payload_pointer_low"],
				[0x8DC5, 0x8E, "actor_event_payload_pointer_high"],
				[0x8E37, 0x2C, "actor_event_payload_byte_0"],
				[0x8E38, 0x22, "actor_event_payload_byte_1"],
				[0x8E39, 0x14, "actor_event_payload_byte_2"],
			]
		elif is_a439_event_payload:
			event_reads = [
				[0xA43A, 0x10, "actor_event_byte"],
				[0x86B9, 0x0E, "actor_event_type_value"],
				[0x8DC4, 0x37, "actor_event_payload_pointer_low"],
				[0x8DC5, 0x8E, "actor_event_payload_pointer_high"],
				[0x8E37, 0x2C, "actor_event_payload_byte_0"],
				[0x8E38, 0x22, "actor_event_payload_byte_1"],
				[0x8E39, 0x14, "actor_event_payload_byte_2"],
			]
		event_reads.append([0xC515, 0x4C, "task_yield_dispatch_opcode"])
		for expected_read: Array in event_reads:
			if not _slot11_source_read_present(source_reads, int(expected_read[0]),
					int(expected_read[1]), String(expected_read[2])):
				return {"ok": false, "reason": "The event payload route omits a ROM-derived source read."}
		if int(output_ram[0x05F3]) != (0x02 if scenario2e_actor6d_type5_entry_profile \
				else 0x01 if parameter47_f2_entry_profile else 0x00) \
				or int(output_ram[0x05F4]) != 0x80 \
				or int(output_ram[0x05E6]) != 0x0E or int(output_ram[0x05E7]) != 0x14 \
				or int(output_ram[0x05E8]) != 0x06 \
				or int(output_ram[0x0061]) != (0xBF if parameter47_f2_entry_profile or scenario2e_actor6d_type5_entry_profile else 0x37 if is_a439_event_payload or scenario1c_parameter58_event_profile or scenario1c_callback63_parameter58_event_profile else 0x94) \
				or int(output_ram[0x0062]) != (0x8F if parameter47_f2_entry_profile or scenario2e_actor6d_type5_entry_profile else 0x8E) \
				or int(output_stack[0xC6]) != 0x22 or int(output_stack[0xC7]) != 0x2C \
				or int(output_stack[0xC8]) != (0x0A if parameter47_f2_entry_profile or scenario2e_actor6d_type5_entry_profile else 0x02 if is_a439_event_payload or scenario1c_parameter58_event_profile or scenario1c_callback63_parameter58_event_profile else 0x04):
			return {"ok": false, "reason": "The event payload RAM/stack output does not match the ROM trace at `$8266`."}
		if scenario2e_actor6d_type5_entry_profile \
				and (output_ram.slice(0x05E3, 0x05EB) \
					!= PackedByteArray([0x01, 0x01, 0x01, 0x0E, 0x14, 0x06, 0x00, 0x6D]) \
					or output_ram.slice(0x05F3, 0x05F6) != PackedByteArray([0x02, 0x80, 0x01]) \
					or output_ram.slice(0x0061, 0x0063) != PackedByteArray([0xBF, 0x8F]) \
					or output_ram.slice(0x04A5, 0x04A8) != PackedByteArray([0x20, 0xE0, 0x23])):
			return {"ok": false, "reason": "The actor-$6D `$52` event differs from the traced payload flags, cursor, countdown, or pending packet."}
	elif is_event_queue_result:
		var queue_was_clear := int(entry_ram[0x0515]) == 0
		for expected_read: Array in [
			[0x0515, 0x00, "actor_event_ram_read"],
			[0xC515, 0x4C, "task_yield_dispatch_opcode"],
		]:
			if not _slot11_source_read_present(source_reads, int(expected_read[0]),
					int(expected_read[1]), String(expected_read[2])):
				return {"ok": false, "reason": "The event queue result omits a ROM-derived source read."}
		var expected_counter := int(entry_ram[0x05E8]) - (1 if queue_was_clear else 0)
		if queue_was_clear:
			var read_event_stream_data := false
			var read_type5_live_cursor := false
			var is_type5_payload_queue := is_parameter47_f2_event_queue \
				or is_scenario2e_actor6d_type5_event_queue
			for read_variant in source_reads:
				if not read_variant is Dictionary:
					continue
				var read: Dictionary = read_variant
				var address := int(read.get("address", -1))
				var payload_start := int(entry_ram[0x0061]) | (int(entry_ram[0x0062]) << 8)
				var payload_end := 0x9015 if is_type5_payload_queue \
					else 0x8E94 if payload_start == 0x8E37 else 0x8F14
				if is_type5_payload_queue \
						and String(read.get("kind", "")) == "actor_event_rom_data" \
						and address >= payload_start and address >= payload_end:
					return {"ok": false, "reason": "The type-5 queue decoder read beyond the bounded `$8FBF-$9014` payload span."}
				if String(read.get("kind", "")) == "actor_event_rom_data" \
						and address >= payload_start and address < payload_end:
					read_event_stream_data = true
					if is_type5_payload_queue and entry is Dictionary \
							and address == payload_start + int(entry.get("y", -1)):
						read_type5_live_cursor = true
			if not read_event_stream_data or (is_type5_payload_queue and not read_type5_live_cursor):
				return {"ok": false, "reason": "The event queue builder did not read the ROM decompression byte at its live payload cursor."}
		if int(output_ram[0x0515]) != 0x80 or expected_counter <= 0 \
				or int(output_ram[0x05E8]) != expected_counter \
				or (queue_was_clear and int(output_ram[0x04A5]) != 0x14):
			return {"ok": false, "reason": "The ROM event decompressor's first `$04A5` packet and `$0515/$05E8` queue state differ."}
		if (is_parameter47_f2_event_queue or is_scenario2e_actor6d_type5_event_queue) \
				and (not queue_was_clear \
				or int(output_ram[0x05E6]) != 0x0E or int(output_ram[0x05E7]) != 0x14 \
				or int(output_ram[0x0061]) != 0xBF or int(output_ram[0x0062]) != 0x8F \
			or int(output_ram[0x04A5]) != 0x14):
			return {"ok": false, "reason": "The type-5 batch must consume the bounded `$8FBF-$9014` source while preserving its pointer and ROM-defined packet length."}
		if scenario2e_actor6d_type5_queue_entry_profile:
			var decoded_queue: Variant = result.get("decoded_event_queue", {})
			if not decoded_queue is Dictionary \
					or int(decoded_queue.get("entry_flag_0515", -1)) != int(entry_ram[0x0515]) \
					or int(decoded_queue.get("ready_flag_after_build", -1)) != int(output_ram[0x0515]) \
					or int(decoded_queue.get("remaining_packet_count", -1)) != int(output_ram[0x05E8]) \
					or int(decoded_queue.get("source_pointer", -1)) != 0x8FBF \
					or int(decoded_queue.get("actor_parameter", -1)) != 0x6D \
					or int(decoded_queue.get("event_stream_pointer", -1)) != 0x9BFE \
					or int(decoded_queue.get("type5_payload_source", -1)) != 0x8FBF:
				return {"ok": false, "reason": "The actor-$6D decoded queue metadata omits its source stream, payload, or queue result state."}
			if queue_was_clear and f2_queue_remaining == 0x06:
				var expected_next_ppu_address := 0x222C + 0x40
				var expected_next_address := PackedByteArray([
					(expected_next_ppu_address >> 8) & 0xFF,
					expected_next_ppu_address & 0xFF,
					0x0A,
				])
				var decoded_packet: Variant = decoded_queue.get("packet_buffer", PackedByteArray())
				if int(output_ram[0x05E8]) != 0x05 \
						or output_ram.slice(0x04A5, 0x04A8) != PackedByteArray([0x14, 0x2C, 0x22]) \
						or not decoded_packet is PackedByteArray \
						or decoded_packet.slice(0, 3) != PackedByteArray([0x14, 0x2C, 0x22]) \
						or callsite_stack.slice(0xC6, 0xC9) != expected_next_address \
						or output_stack.slice(0xC6, 0xC9) != expected_next_address:
					return {"ok": false, "reason": "The first actor-$6D queue chunk must emit `$14,$2C,$22`, decrement `$06->$05`, and advance destination `$222C->$226C`."}
			if decoded_queue.get("packet_buffer", PackedByteArray()) != output_ram.slice(0x04A5, 0x04C0):
				return {"ok": false, "reason": "The actor-$6D decoded queue bytes differ from the live packet buffer."}
	else:
		var expected_read_pc := 0xCC53 if entry_pc == 0xCC53 else 0xCCA3
		var expected_read_kind := "ppu_queue_pending_flag" if entry_pc == 0xCC53 else "counter_tail_queue_flag"
		if source_reads.is_empty() or source_reads[0] != {
				"pc": expected_read_pc, "address": 0x0515,
				"value": int(entry_ram[0x0515]), "kind": expected_read_kind}:
			return {"ok": false, "reason": "The waiter result did not branch from its live `$0515` input."}
	return {"ok": true}


func apply_slot11_actor_worker_resume_result(worker_result: Dictionary) -> Dictionary:
	if not _require_initialized():
		return {}
	var is_parameter47_f2 := String(worker_result.get("stream_route", "")) == "parameter47_f2"
	var is_scenario1c_parameter00_f2 := \
		String(worker_result.get("stream_route", "")) == "scenario1c_parameter00_f2_terminal"
	var is_scenario2e_parameter6d_f2 := \
		String(worker_result.get("stream_route", "")) == "scenario2e_callback36_map2f_parameter6d_f2_waiter"
	var is_f2_waiter := is_parameter47_f2 or is_scenario1c_parameter00_f2 or is_scenario2e_parameter6d_f2
	var expected_callsite_sp := 0xC5 if is_f2_waiter else 0xC3
	var expected_callsite_x := 0x00 if is_scenario1c_parameter00_f2 else (0x17 if is_parameter47_f2 else (0xE3 if is_scenario2e_parameter6d_f2 else 0x52))
	var expected_callsite_y := 0x06 if is_f2_waiter else 0x0C
	var expected_cb0f_sp := (expected_callsite_sp - 2) & 0xFF
	var expected_saved_sp := (expected_callsite_sp - 4) & 0xFF
	var proof := _validate_slot11_actor_worker_resume_result(worker_result)
	if not bool(proof.get("ok", false)):
		_fail(String(proof.get("reason", "Invalid slot-$11 resume result.")))
		return {}
	var context: TaskContext = _contexts.get(0x11)
	if context == null or _active_task_slot != 0x11 or context.phase != ContextPhase.RUNNING \
			or context.program_counter != 0x804A or context.stack_pointer != 0xCA \
			or int(_ram[0x0000]) != 0x11 or _record_bytes(0x11) != PackedByteArray([0x00, 0xC6, 0x18, 0x19]) \
			or context.bank_low != 0x18 or context.bank_high != 0x19:
		_fail("Slot-$11 resume adoption requires the live dispatched `$804A` scheduler boundary.")
		return {}
	var entry_record: Variant = worker_result.get("entry_record", PackedByteArray())
	var entry_ram: Variant = worker_result.get("entry_ram_image", PackedByteArray())
	var entry_stack: Variant = worker_result.get("entry_stack_page", PackedByteArray())
	var entry_registers: Variant = worker_result.get("entry_registers", {})
	var source_ram: Variant = worker_result.get("ram_image", PackedByteArray())
	var source_stack: Variant = worker_result.get("stack_page", PackedByteArray())
	var source_writes: Variant = worker_result.get("ram_writes", [])
	var source_stack_writes: Variant = worker_result.get("stack_writes", [])
	var callsite_stack: Variant = worker_result.get("yield_callsite_stack_page", PackedByteArray())
	if not entry_record is PackedByteArray or entry_record != _record_bytes(0x11) \
			or not entry_ram is PackedByteArray or entry_ram != _ram \
			or not entry_stack is PackedByteArray or entry_stack != _stack_page \
			or not entry_registers is Dictionary or entry_registers != _register_snapshot(context) \
			or not source_ram is PackedByteArray or not source_stack is PackedByteArray \
			or not source_writes is Array or not source_stack_writes is Array \
			or not callsite_stack is PackedByteArray:
		_fail("Slot-$11 resume result does not start from the current live task, RAM, stack, and registers.")
		return {}
	var callsite_registers: Dictionary = worker_result["yield_callsite_registers"]
	var cb0f_registers: Dictionary = worker_result["cb0f_entry_registers"]
	var mapper: Dictionary = worker_result["mapper"]
	var save_contract: Dictionary = worker_result["scheduler_save_contract"]
	if callsite_registers.get("pc", -1) != 0xCC50 \
			or callsite_registers.get("sp", -1) != expected_callsite_sp \
			or callsite_registers.get("a", -1) != 0x01 \
			or callsite_registers.get("x", -1) != expected_callsite_x \
			or callsite_registers.get("y", -1) != expected_callsite_y \
			or cb0f_registers.get("pc", -1) != 0xCB0F \
			or cb0f_registers.get("sp", -1) != expected_cb0f_sp \
			or callsite_registers.get("p", -1) != cb0f_registers.get("p", -2) \
			or callsite_registers.get("p_known_mask", -1) != cb0f_registers.get("p_known_mask", -2) \
			or mapper != context.mapper_state \
			or int(mapper.get("bank_low", -1)) != 0x18 \
			or int(mapper.get("bank_high", -1)) != 0x19 \
			or int(save_contract.get("pre_jsr_sp", -1)) != expected_callsite_sp \
			or int(save_contract.get("cb0f_entry_sp", -1)) != expected_cb0f_sp \
			or int(save_contract.get("expected_saved_sp_after_cb0f_pushes", -1)) != expected_saved_sp:
		_fail("Slot-$11 resume callsite registers, mapper, or CB0F save contract differs from the live source path.")
		return {}
	var writes: Array = source_writes
	var stack_writes: Array = source_stack_writes
	var pre_call_stack_writes: Array[Dictionary] = []
	var cc50_frame_writes: Array[Dictionary] = []
	for write_variant in stack_writes:
		if not write_variant is Dictionary:
			_fail("Slot-$11 resume contains a malformed stack-write event.")
			return {}
		var write: Dictionary = write_variant
		if int(write.get("pc", -1)) == 0xCC50:
			cc50_frame_writes.append(write)
		else:
			pre_call_stack_writes.append(write)
	if cc50_frame_writes != [
			{"pc": 0xCC50, "address": 0x0100 + expected_callsite_sp, "value": 0xCC, "kind": "JSR_high"},
			{"pc": 0xCC50, "address": 0x0100 + expected_callsite_sp - 1, "value": 0x52, "kind": "JSR_low"}]:
		_fail("The source result does not contain exactly one `$CC50->$CB0F` pre-pushed return frame.")
		return {}
	var replay := _replay_actor_source_writes(writes, stack_writes, _ram, _stack_page)
	var pre_call_replay := _replay_actor_source_writes(writes, pre_call_stack_writes, _ram, _stack_page)
	if not bool(replay.get("ok", false)) or not bool(pre_call_replay.get("ok", false)) \
			or replay.get("ram_image", PackedByteArray()) != source_ram \
			or replay.get("stack_page", PackedByteArray()) != source_stack \
			or pre_call_replay.get("stack_page", PackedByteArray()) != callsite_stack:
		_fail("Slot-$11 resume output RAM/stack does not equal the replayed ROM writes and JSR frame.")
		return {}
	# Adopt only ordered writes from the ROM executor; do not replace scheduler
	# state with its whole returned RAM image.
	for write_variant in writes:
		var write: Dictionary = write_variant
		_ram[int(write["address"])] = int(write["value"])
	for write_variant in stack_writes:
		var write: Dictionary = write_variant
		_write_stack_byte(int(write["address"]) & 0xFF, int(write["value"]))
	context.accumulator = int(callsite_registers["a"])
	context.x_register = int(callsite_registers["x"])
	context.y_register = int(callsite_registers["y"])
	context.status_register = int(callsite_registers["p"])
	context.status_known_mask = int(callsite_registers["p_known_mask"])
	context.program_counter = 0xCC50
	context.stack_pointer = expected_callsite_sp
	context.source_label = "ROM-byte slot-$11 scenario-$2E actor-$6D F2 waiter `$804A->$CC50->$CB0F`" \
		if is_scenario2e_parameter6d_f2 else ("ROM-byte slot-$11 scenario-$1C parameter-$00 F2 waiter `$804A->$CC50->$CB0F`" \
		if is_scenario1c_parameter00_f2 else ("ROM-byte slot-$11 parameter-$47 F2 waiter `$804A->$CC50->$CB0F`" \
		if is_parameter47_f2 else "ROM-byte slot-$11 actor stream `$804A->$CC50->$CB0F`"))
	_slot11_actor_resume_yield_in_progress = true
	var saved := yield_at_verified_callsite(0x11, 0xCC50,
		context.accumulator, context.stack_pointer, context.x_register, context.y_register,
		context.bank_low, context.bank_high, true)
	_slot11_actor_resume_yield_in_progress = false
	if not saved:
		return {}
	var boundary := get_task_boundary_snapshot(0x11)
	return {
		"ok": true,
		"status": "slot11_actor_resume_saved_at_cb0f",
		"rom_sha256": ROM_SHA256,
		"source_manifest": SLOT11_RESUME_MANIFEST,
		"callsite_pc": 0xCC50,
		"handler_entry_pc": 0xCB0F,
		"resume_pc": 0xCC53,
		"task_record": _record_bytes(0x11),
		"saved_boundary": boundary,
		"scheduler_scan_cursor": _scheduler_scan_cursor,
		"scheduler_y_register": _scheduler_y_register,
		"active_task_slot": _active_task_slot,
		"preexisting_jsr_frame_reused": true,
		"source_ram_image_copied": false,
		"source_ram_write_count": writes.size(),
		"source_stack_write_count": stack_writes.size(),
	}


## Adopts the ROM-derived `$CC53` waiter continuation after scheduler dispatch.
## This is separate from the first `$804A` actor-stream resume because the
## second boundary has a different saved SP and stack-resident packet counter.
func apply_slot11_actor_waiter_resume_result(worker_result: Dictionary) -> Dictionary:
	if not _require_initialized():
		return {}
