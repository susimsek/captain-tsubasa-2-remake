	var output_ram: Variant = result.get("ram_image", PackedByteArray())
	var entry_stack: Variant = result.get("entry_stack_page", PackedByteArray())
	var output_stack: Variant = result.get("stack_page", PackedByteArray())
	var registers: Dictionary = result.get("registers", {})
	var mapper: Dictionary = result.get("mapper", {})
	var source_return_word := int(context.source_return_word) if context != null else -1
	var writes: Variant = result.get("ram_writes", [])
	var stack_writes: Variant = result.get("stack_writes", [])
	var instruction_pcs: Variant = result.get("source_instruction_pcs", [])
	var entry_word := (int(live_stack[0x4E]) << 8) | int(live_stack[0x4D]) \
		if live_stack is PackedByteArray and live_stack.size() == STACK_PAGE_SIZE else -1
	var outer_word := (int(live_stack[0x50]) << 8) | int(live_stack[0x4F]) \
		if live_stack is PackedByteArray and live_stack.size() == STACK_PAGE_SIZE else -1
	if not _slot05_pass_selection_adopted or _slot05_pass_handler_dispatch_pending \
			or _active_task_slot != 0x05 or context == null \
			or context.phase != ContextPhase.RUNNING or context.program_counter != 0x8188 \
			or context.stack_pointer != 0x4E or context.bank_low != 0x1A or context.bank_high != 0x1B \
			or source_return_word != 0xE944 or int(_ram[0x0518]) != 0x18 \
			or not live_ram is PackedByteArray or live_ram.size() != RAM_SIZE or live_ram != _ram \
			or not live_stack is PackedByteArray or live_stack.size() != STACK_PAGE_SIZE \
			or live_stack != _stack_page or entry_word != 0x8187 or outer_word != 0x8111 \
			or not bool(result.get("ok", false)) \
			or String(result.get("status", "")) != "scenario18_post_queue_caller_returned" \
			or String(result.get("rom_sha256", "")) != ROM_SHA256 \
			or String(result.get("source_manifest", "")) != "res://reference/rom_extract/gameplay/pass_scenario_18/manifest.json" \
			or bool(result.get("trace_state_used", true)) or bool(result.get("emulator_data_used", true)) \
			or bool(result.get("source_cycle_timing_modeled", true)) \
			or int(result.get("slot_base", -1)) != 0x05 or int(result.get("entry_pc", -1)) != 0x8188 \
			or int(result.get("entry_sp", -1)) != 0x4E or int(result.get("exit_pc", -1)) != 0x8112 \
			or int(result.get("source_return_word", -1)) != source_return_word \
			or int(result.get("popped_cbc1_return_word", -1)) != 0x8187 \
			or int(result.get("popped_caller_return_word", -1)) != 0x8111 \
			or int(result.get("helper_return_word", -1)) != 0x8192 \
			or int(registers.get("pc", -1)) != 0x8112 or int(registers.get("sp", -1)) != 0x50 \
			or int(registers.get("bank_low", -1)) != 0x1A or int(registers.get("bank_high", -1)) != 0x1B \
			or not entry_ram is PackedByteArray or entry_ram != live_ram \
			or not output_ram is PackedByteArray or output_ram.size() != RAM_SIZE \
			or not entry_stack is PackedByteArray or entry_stack != live_stack \
			or not output_stack is PackedByteArray or output_stack.size() != STACK_PAGE_SIZE \
			or not writes is Array or not stack_writes is Array or not instruction_pcs is Array \
			or instruction_pcs.is_empty() or int(instruction_pcs[0]) != 0x8188 \
			or not instruction_pcs.has(0xC624) or not instruction_pcs.has(0xDCDF) \
			or int(instruction_pcs[instruction_pcs.size() - 1]) != 0x819B \
			or result.get("ppu_bus_events", ["unexpected"]) != [] \
			or result.get("apu_register_writes", ["unexpected"]) != []:
		return _fail("Scenario-$18 post-queue caller does not match the live `$8188->$8112` source contract.")
	var expected_hashes := {
		"slot05_scenario18_post_queue_caller_8188_819b.bin": "fea79dbe1bb2ce4aa401d7b4df6c6cfd4574aa0ee0bf0fac643005b42f428245",
		"fixed_C624_dispatch_vectors_C624_C64E.bin": "481b6bc076bd7c8d9073cfa46949fe6548c58dedb6fac84067a5c4a8effb5968",
		"fixed_C624_vector0_target_DCDF_DCF0.bin": "a43a68c0bdbf3333d386bf74dd3f201bae308948f8ea3e58bd173c32bdc46a8d",
	}
	if result.get("source_span_hashes", {}) != expected_hashes \
			or int(mapper.get("bank_low", -1)) != 0x1A or int(mapper.get("bank_high", -1)) != 0x1B:
		return _fail("Scenario-$18 post-queue caller omitted its pinned ROM-span or mapper proof.")
	var expected_ram := _ram.duplicate()
	var expected_stack := _stack_page.duplicate()
	var expected_writes: Array[Dictionary] = []
	var first_mode := int(expected_ram[0x0444]) & 0x03
	_append_expected_scenario18_write(expected_writes, 0x818D, 0x044E, first_mode)
	_append_expected_scenario18_write(expected_writes, 0x8190, 0x014E, 0x81)
	_append_expected_scenario18_write(expected_writes, 0x8190, 0x014D, 0x92)
	if first_mode == 0:
		_append_expected_scenario18_write(expected_writes, 0xDCEC, 0x044E,
			1 + (int(expected_ram[0x00E2]) & 0x01))
	_append_expected_scenario18_write(expected_writes, 0x8198, 0x0617,
		int(expected_ram[0x0617]) | 0x80)
	if writes != expected_writes:
		return _fail("Scenario-$18 caller RAM/stack writes differ from the ROM `$8188->$819B` instruction order.")
	for write_variant: Variant in writes:
		if not write_variant is Dictionary:
			return _fail("Scenario-$18 caller produced a malformed source write.")
		var write: Dictionary = write_variant
		var address := int(write.get("address", -1))
		var value := int(write.get("value", -1))
		if address < 0 or address >= RAM_SIZE or value < 0 or value > 0xFF:
