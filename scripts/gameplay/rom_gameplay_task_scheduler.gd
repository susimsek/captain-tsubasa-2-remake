			or context.phase != ContextPhase.RUNNING or context.program_counter != 0xE238 \
			or context.source_label != "ROM-byte slot-$05 scenario return `$CBC1 RTS->$E238`" \
			or not bool(return_result.get("ok", false)) \
			or int((return_result.get("entry", {}) as Dictionary).get("scenario_id", -1)) != 0x1E \
			or int(return_registers.get("pc", -1)) != 0xE238 \
