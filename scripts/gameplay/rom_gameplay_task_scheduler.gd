			or scenario2e_map2f_phase29_countdown \
			or scenario2e_map2f_phase29_zero_return else (0x36 if scenario36_countdown else (
		0x1E if scenario1e_callback_countdown or scenario1e_root_terminator_countdown \
			or scenario1e_terminal_idle or scenario1e_callback45_zero_phase_vector else 0x35))))))
	var expected_scenario_cursor := 0x01 if scenario1c_root_terminator_countdown \
		or scenario1c_callback63_root_terminator_countdown or scenario18_root_terminator_countdown \
		or scenario36_root_terminator_countdown \
		or scenario1e_root_terminator_countdown or scenario44_root_terminator_countdown \
		or scenario38_root_terminator_countdown \
		or scenario2e_map2f_root_fb_countdown else (int(_ram[0x003A]) \
		if scenario18_callback72_countdown or scenario1c_callback1f_countdown \
			or scenario1c_callback63_countdown \
			or scenario1c_callback63_actor_chain_countdown \
			or scenario1c_callback01_countdown \
			or scenario1c_callback01_phase29_cursor10_return \
			or scenario18_post_terminator_countdown \
			or scenario2e_callback36_map2f_countdown \
			or scenario2e_map2f_phase29_countdown \
			or scenario2e_map2f_phase29_zero_return else (
		int(source_ram[0x003A]) if scenario1e_callback45_zero_phase_vector else (
		int(_ram[0x003A]) if continued_countdown or terminal_idle or scenario36_countdown \
			or scenario1e_callback_countdown or scenario1e_callback45_zero_phase_vector else 0x01))
		)
	var expected_event_pointer := int(_ram[0x005D]) | (int(_ram[0x005E]) << 8)
	var entry_p_known_mask_raw := int(entry.get("p_known_mask", -1))
	var entry_p_known_mask := entry_p_known_mask_raw & 0xFF
	var entry_status_matches_live_known_bits := entry_p_known_mask_raw >= 0 \
		and (((int(entry.get("p", -1)) ^ context.status_register) \
			& entry_p_known_mask & context.status_known_mask) == 0)
	var entry_cpu_matches_live := int(entry.get("pc", -1)) == context.program_counter \
		and int(entry.get("sp", -1)) == context.stack_pointer \
		and int(entry.get("a", -1)) == context.accumulator \
		and int(entry.get("x", -1)) == context.x_register \
		and int(entry.get("y", -1)) == context.y_register \
		and entry_status_matches_live_known_bits
	if String(worker_state.get("rom_sha256", "")) != ROM_SHA256 \
			or String(worker_state.get("source_manifest", "")) != "res://reference/rom_extract/gameplay/slot09_eb8b_continuation/manifest.json" \
			or String(worker_state.get("status", "")) != "stopped_before_worker_body" \
			or int(worker_state.get("entry_pc", -1)) != 0xEB8B \
			or int(worker_state.get("exit_pc", -1)) != 0x86F8 \
			or not (route_executed or scenario36_followup_countdown \
				or scenario18_callback72_countdown \
				or scenario1c_callback1f_countdown \
				or scenario1c_callback63_countdown \
				or scenario1c_callback63_actor_chain_countdown \
				or scenario1c_callback01_countdown \
				or scenario1e_callback_countdown or scenario1e_root_terminator_countdown \
			or scenario2e_callback36_map2f_countdown \
			or scenario2e_map2f_root_fb_countdown \
			or scenario2e_map2f_phase29_countdown \
			or scenario2e_map2f_phase29_zero_return) \
			or not (first_root_termination or scenario1c_root_terminator_countdown \
				or scenario1c_callback63_root_terminator_countdown or scenario18_root_terminator_countdown \
				or scenario18_post_terminator_countdown or scenario44_root_terminator_countdown \
				or continued_countdown or terminal_idle \
				or scenario36_countdown or scenario38_root_terminator_countdown \
				or scenario18_callback72_countdown \
				or scenario1c_callback1f_countdown \
				or scenario1c_callback63_countdown \
				or scenario1c_callback63_actor_chain_countdown \
				or scenario1c_callback01_countdown \
				or scenario1e_callback_countdown \
				or scenario1e_root_terminator_countdown or scenario1e_callback45_zero_phase_vector \
			or scenario2e_callback36_map2f_countdown \
			or scenario2e_map2f_root_fb_countdown \
			or scenario2e_map2f_phase29_countdown \
			or scenario2e_map2f_phase29_zero_return) \
			or bool(worker_state.get("scenario_active", true)) \
			or bool(worker_state.get("trace_state_used", true)) \
			or bool(worker_state.get("worker_body_executed", true)) \
			or source_ram.size() != RAM_SIZE or source_stack.size() != STACK_PAGE_SIZE \
			or int(entry.get("pc", -1)) != 0xEB8B or int(entry.get("sp", -1)) != 0x7A \
			or int(mapper.get("bank_low", -1)) != 0x18 \
			or int(mapper.get("bank_high", -1)) != 0x19 \
			or int(mapper.get("select", -1)) != 7 \
			or int(source_ram[0x0000]) != 0x09 \
			or int(source_ram[0x0516]) != expected_scenario_flag \
			or int(source_ram[0x0518]) != expected_scenario_id \
			or int(source_ram[0x0519]) != maxi(0, entry_wait - 1) \
			or int(source_ram[0x0522]) != (0x02 if scenario1c_callback1f_countdown else 0x00) \
			or ((scenario1c_callback1f_countdown or scenario1c_callback01_countdown) \
				and (int(source_ram[0x0517]) != int(_ram[0x0517]) \
				or int(source_ram[0x051B]) != int(_ram[0x051B]))) \
			or (int(source_ram[0x005D]) | (int(source_ram[0x005E]) << 8)) != expected_event_pointer \
			or int(source_ram[0x003A]) != expected_scenario_cursor:
		return _fail("Scenario continuation output differs from the source wait/FB terminal phase selected by live RAM. " \
				+ JSON.stringify({"root_fb_countdown": scenario1c_root_terminator_countdown \
					or scenario1c_callback63_root_terminator_countdown or scenario18_root_terminator_countdown \
					or scenario18_post_terminator_countdown or scenario36_root_terminator_countdown \
					or scenario1e_root_terminator_countdown,
					"expected": {"flag": expected_scenario_flag, "scenario": expected_scenario_id,
						"wait": maxi(0, entry_wait - 1), "cursor": expected_scenario_cursor,
						"event_pointer": expected_event_pointer},
					"candidate": {"flag": entry_flag, "scenario": int(_ram[0x0518]),
						"wait": entry_wait, "depth": int(_ram[0x0522]),
						"pointer": int(_ram[0x005D]) | (int(_ram[0x005E]) << 8),
						"event": _ram.slice(0x0523, 0x052A).hex_encode()},
					"actual": {"flag": int(source_ram[0x0516]), "scenario": int(source_ram[0x0518]),
						"wait": int(source_ram[0x0519]), "cursor": int(source_ram[0x003A]),
						"event_pointer": int(source_ram[0x005D]) | (int(source_ram[0x005E]) << 8)}}))
	if terminal_idle and not scenario2e_map2f_phase29_zero_return:
		for address in [0x0532, 0x0534, 0x0536, 0x0538, 0x0539]:
			if int(source_ram[address]) != 0:
				return _fail("The zero-count `$EC3C` terminal-phase path did not clear source-written `$%04X`." % address)
	if not entry_cpu_matches_live \
			or int(registers.get("pc", -1)) != 0x86F8 \
			or int(registers.get("sp", -1)) != 0x78:
		return _fail("Scenario wait entry/exit CPU state does not match the live slot-$09 route boundary. " \
				+ JSON.stringify({"entry": entry, "live": _register_snapshot(context),
					"exit": registers, "expected_exit_pc": 0x86F8, "expected_exit_sp": 0x78}))
	if not _validate_slot09_source_manifest_hashes(
			String(worker_state["source_manifest"]), hashes):
		return false
	var expected_ram := _ram.duplicate()
	var expected_stack := _stack_page.duplicate()
	for write_variant in writes_variant:
		if not write_variant is Dictionary:
			return _fail("Scenario wait RAM write stream contains a malformed event.")
		var write: Dictionary = write_variant
		var address := int(write.get("address", -1))
		var value := int(write.get("value", -1))
		var source_slot05_delay := address == 0x0005 and value == ((int(expected_ram[0x0005]) + 1) & 0xFF) \
				and int(write.get("pc", -1)) == 0xCB0A
		var phase29_tail_zero_page_clear := (scenario1c_callback01_phase29_cursor10_return \
				or scenario35_callback3a_phase29_return \
				or scenario1e_callback45_phase29_return or scenario44_callback70_phase29_return \
				or scenario38_callback34_phase29_return \
				or scenario2e_map2f_phase29_zero_return) \
				and value == 0 and ((address == 0x000D and int(write.get("pc", -1)) == 0xEC82) \
				or (address == 0x000E and int(write.get("pc", -1)) == 0xEC84))
		if address < 0 or address >= RAM_SIZE or value < 0 or value > 0xFF \
				or (_is_scheduler_owned_ram_address(address) \
					and not source_slot05_delay and not phase29_tail_zero_page_clear):
			return _fail("Scenario wait source write conflicts with scheduler-owned RAM `$%04X` at `$%04X`." % [address, int(write.get("pc", -1))])
		expected_ram[address] = value
		if address >= 0x0100 and address < 0x0200:
			expected_stack[address & 0xFF] = value
	for write_variant in stack_writes_variant:
		if not write_variant is Dictionary:
			return _fail("Scenario wait stack write stream contains a malformed event.")
		var write: Dictionary = write_variant
		var address := int(write.get("address", -1))
		var value := int(write.get("value", -1))
		if address < 0x0100 or address >= 0x0200 or value < 0 or value > 0xFF:
			return _fail("Scenario wait stack write is outside the CPU stack page.")
		expected_ram[address] = value
		expected_stack[address & 0xFF] = value
	if expected_ram != source_ram or expected_stack != source_stack:
		return _fail("Scenario wait RAM/stack differs from replaying the ordered ROM-source writes.")
	var mapper_result := _replay_actor_source_mapper_writes(mapper_writes_variant,
			context.bank_low, context.bank_high, mapper,
			int(context.mapper_state.get("select", -1)))
	if not bool(mapper_result.get("ok", false)):
		return _fail(String(mapper_result.get("reason", "Scenario wait mapper replay failed.")))
	for slot_base: int in SLOT_BASES:
		if slot_base != 0x05 and source_ram.slice(slot_base, slot_base + 4) != _record_bytes(slot_base):
			return _fail("Scenario wait source changed unrelated scheduler task record `$%02X`." % slot_base)
	if source_ram.slice(0x0006, 0x0009) != _record_bytes(0x05).slice(1, 4):
		return _fail("Scenario finish helper changed slot-$05 task fields beyond its source delay byte.")
	_ram = expected_ram
	_stack_page = expected_stack
	context.accumulator = int(registers.get("a", -1)) & 0xFF
	context.x_register = int(registers.get("x", -1)) & 0xFF
	context.y_register = int(registers.get("y", -1)) & 0xFF
	context.status_register = int(registers.get("p", context.status_register)) & 0xFF
	context.status_known_mask = int(registers.get("p_known_mask", context.status_known_mask)) & 0xFF
	context.stack_pointer = int(registers.get("sp", -1))
	context.program_counter = int(registers.get("pc", -1))
	context.bank_low = int(mapper["bank_low"])
	context.bank_high = int(mapper["bank_high"])
	context.mapper_state = mapper.duplicate(true)
	context.ready_delay = int(_ram[0x0009])
	var slot05: TaskContext = _contexts.get(0x05)
	if slot05 != null:
		slot05.ready_delay = int(_ram[0x0005])
	context.source_label = "ROM-byte slot-$09 wait tick for scenario `$%02X` phase `$%02X`" % [expected_scenario_id, expected_scenario_flag]
	return true


## Adopts the ordinary-input PASS scenario-$38 source prefix at the first
## bank-$18 worker vector. The source result is replayed against the scheduler's
## live `$EB8B` state so later worker adoption sees the matching `$86F8` PC.
func adopt_slot09_live_pass_scenario38_worker_vector_state(worker_state: Dictionary) -> bool:
	if not _require_initialized():
		return false
	var context: TaskContext = _contexts.get(0x09)
	if _active_task_slot != 0x09 or int(_ram[0x0000]) != 0x09 \
			or context == null or context.phase != ContextPhase.RUNNING \
			or context.program_counter != 0xEB8B:
		return _fail("Live PASS scenario-$38 adoption requires active slot-$09 `$EB8B`.")
	var entry_variant: Variant = worker_state.get("entry_registers", {})
	var registers_variant: Variant = worker_state.get("registers", {})
	var mapper_variant: Variant = worker_state.get("mapper", {})
	var ram_variant: Variant = worker_state.get("ram_image", PackedByteArray())
	var stack_variant: Variant = worker_state.get("stack_page", PackedByteArray())
	var writes_variant: Variant = worker_state.get("writes", [])
	var stack_writes_variant: Variant = worker_state.get("stack_writes", [])
	var mapper_writes_variant: Variant = worker_state.get("mapper_writes", [])
	var hashes_variant: Variant = worker_state.get("source_span_hashes", {})
	var pending_variant: Variant = worker_state.get("pending_worker_call", {})
	if not entry_variant is Dictionary or not registers_variant is Dictionary \
			or not mapper_variant is Dictionary or not ram_variant is PackedByteArray \
			or not stack_variant is PackedByteArray or not writes_variant is Array \
			or not stack_writes_variant is Array or not mapper_writes_variant is Array \
			or not hashes_variant is Dictionary or not pending_variant is Dictionary:
		return _fail("Live PASS prefix omits its source CPU, memory, mapper, write, or call receipt.")
	var entry: Dictionary = entry_variant
	var registers: Dictionary = registers_variant
	var mapper: Dictionary = mapper_variant
	var source_ram: PackedByteArray = ram_variant
	var source_stack: PackedByteArray = stack_variant
	var hashes: Dictionary = hashes_variant
	var pending: Dictionary = pending_variant
	var live_queue := PackedByteArray([0x00, 0x6C, 0x04, 0x00, 0x6C, 0x04, 0x00])
	var live_pass_pointer := (int(_ram[0x0079]) | (int(_ram[0x007A]) << 8)) if _ram.size() == RAM_SIZE else -1
	var live_pass_countdown := int(_ram[0x0533]) if _ram.size() == RAM_SIZE else -1
	var live_pass_stream_phase := (live_pass_pointer == 0xAFE9 \
			and live_pass_countdown in [0x00, 0x01, 0x02, 0x03]) \
		or (live_pass_pointer == 0xAFEE and live_pass_countdown in [0x00, 0x01]) \
		or (live_pass_pointer == 0xAFF1 \
			and live_pass_countdown in [0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07]) \
		or (live_pass_pointer == 0xAFF4 and live_pass_countdown in [0x00, 0x01, 0x02, 0x03])
	var source_pass_pointer := (int(source_ram[0x0079]) | (int(source_ram[0x007A]) << 8)) if source_ram.size() == RAM_SIZE else -1
	var source_pass_countdown := int(source_ram[0x0533]) if source_ram.size() == RAM_SIZE else -1
	var source_pass_stream_phase := (source_pass_pointer == 0xAFE9 \
			and source_pass_countdown in [0x00, 0x01, 0x02, 0x03]) \
		or (source_pass_pointer == 0xAFEE and source_pass_countdown in [0x00, 0x01]) \
		or (source_pass_pointer == 0xAFF1 \
			and source_pass_countdown in [0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07]) \
		or (source_pass_pointer == 0xAFF4 and source_pass_countdown in [0x00, 0x01, 0x02, 0x03])
	var live_profile_matches := _ram.size() == RAM_SIZE \
		and _ram.slice(0x0516, 0x051A) == PackedByteArray([0x00, 0x40, 0x38, 0x00]) \
		and int(_ram[0x0441]) == 0x06 and int(_ram[0x0532]) == 0x01 \
		and live_pass_stream_phase \
		and (int(_ram[0x0079]) | (int(_ram[0x007A]) << 8)) in [0xAFE9, 0xAFEE, 0xAFF1, 0xAFF4] \
		and int(_ram[0x0498]) == 0x00 \
		and _ram.slice(0x0499, 0x04A0) == live_queue and int(_ram[0x047F]) == 0x0F
	var output_profile_matches := source_ram.size() == RAM_SIZE \
		and source_stack.size() == STACK_PAGE_SIZE \
		and source_ram.slice(0x0516, 0x051A) == PackedByteArray([0x00, 0x40, 0x38, 0x00]) \
		and int(source_ram[0x0441]) == 0x06 and int(source_ram[0x0532]) == 0x01 \
		and source_pass_stream_phase \
		and (int(source_ram[0x0079]) | (int(source_ram[0x007A]) << 8)) in [0xAFE9, 0xAFEE, 0xAFF1, 0xAFF4] \
		and int(source_ram[0x0498]) == 0x00 \
		and source_ram.slice(0x0499, 0x04A0) == live_queue \
		and int(source_ram[0x047F]) == 0x0F
	if String(worker_state.get("rom_sha256", "")) != ROM_SHA256 \
			or String(worker_state.get("source_manifest", "")) != "res://reference/rom_extract/gameplay/slot09_eb8b_continuation/manifest.json" \
			or String(worker_state.get("status", "")) != "stopped_before_worker_body" \
			or int(worker_state.get("entry_pc", -1)) != 0xEB8B \
			or int(worker_state.get("exit_pc", -1)) != 0x86F8 \
			or int(worker_state.get("exit_bank", -1)) != 0x18 \
			or bool(worker_state.get("scenario_active", true)) \
			or bool(worker_state.get("trace_state_used", true)) \
			or bool(worker_state.get("worker_body_executed", true)) \
			or bool(worker_state.get("worker_body_bytes_read", true)) \
			or bool(worker_state.get("runtime_integrated", true)) \
			or int(pending.get("source_pc", -1)) != 0xEBB0 \
			or int(pending.get("return_word", -1)) != 0xEBB2 \
			or int(pending.get("return_pc", -1)) != 0xEBB3 \
			or int(pending.get("target_pc", -1)) != 0x86F8 \
			or int(pending.get("target_bank", -1)) != 0x18 \
			or not live_profile_matches or not output_profile_matches:
		return _fail("Prefix is not the live PASS scenario-$38 `$EB8B->$86F8` source boundary: " \
				+ JSON.stringify({"live_flags": _ram.slice(0x0516, 0x051A).hex_encode(),
					"output_flags": source_ram.slice(0x0516, 0x051A).hex_encode() if source_ram.size() == RAM_SIZE else "invalid",
					"countdown": int(_ram[0x0533]) if _ram.size() == RAM_SIZE else -1,
					"pointer": ((int(_ram[0x0079]) | (int(_ram[0x007A]) << 8)) if _ram.size() == RAM_SIZE else -1),
					"live_profile": live_profile_matches, "output_profile": output_profile_matches,
					"status": worker_state.get("status", ""),
					"pending": pending, "runtime_integrated": worker_state.get("runtime_integrated", "missing"),
					"trace_state_used": worker_state.get("trace_state_used", "missing"),
					"worker_body": worker_state.get("worker_body_executed", "missing")}))
	if not _slot09_registers_match_context(entry, context, 0xEB8B) \
			or int(context.bank_low) != 0x18 or int(context.bank_high) != 0x19 \
			or int(context.mapper_state.get("select", -1)) != 0x07 \
			or source_ram.slice(0x0100, 0x0200) != source_stack \
			or int(registers.get("pc", -1)) != 0x86F8 \
			or int(registers.get("sp", -1)) != 0x78 \
			or not registers.has_all(["a", "x", "y", "p", "p_known_mask"]) \
			or int(mapper.get("bank_low", -1)) != 0x18 \
			or int(mapper.get("bank_high", -1)) != 0x19 \
			or int(mapper.get("select", -1)) != 0x07:
		return _fail("Live PASS prefix CPU or MMC3 entry/exit state differs from the active slot-$09 context.")
	var manifest_path := String(worker_state["source_manifest"])
	var manifest_file := FileAccess.open(manifest_path, FileAccess.READ)
	if manifest_file == null:
		return _fail("Live PASS prefix source manifest is unavailable.")
	var manifest_variant: Variant = JSON.parse_string(manifest_file.get_as_text())
	if not manifest_variant is Dictionary:
		return _fail("Live PASS prefix source manifest is malformed.")
	var manifest: Dictionary = manifest_variant
	var rom_variant: Variant = manifest.get("rom", {})
	var spans_variant: Variant = manifest.get("spans", [])
	if String(manifest.get("schema", "")) != "ct2-slot09-eb8b-continuation-source-v1" \
			or not rom_variant is Dictionary or String(rom_variant.get("sha256", "")) != ROM_SHA256 \
			or bool(manifest.get("trace_state_included", true)) \
			or bool(manifest.get("runtime_rom_dependency", true)) \
			or not spans_variant is Array:
		return _fail("Live PASS prefix manifest has unsupported ROM, schema, or dependency metadata.")
	for span_variant: Variant in spans_variant:
		if not span_variant is Dictionary:
			return _fail("Live PASS prefix manifest contains a malformed source span.")
		var span: Dictionary = span_variant
		var filename := String(span.get("file", ""))
		if filename.is_empty() or not hashes.has(filename) \
				or String(hashes[filename]).to_lower() != String(span.get("sha256", "")).to_lower():
			return _fail("Live PASS prefix result omits or changes manifest span hash `%s`." % filename)
	if not _validate_slot09_source_manifest_hashes(manifest_path, hashes):
		return false
	var replay := _replay_actor_source_writes(writes_variant, stack_writes_variant,
			_ram, _stack_page)
	if not bool(replay.get("ok", false)):
		return _fail(String(replay.get("reason", "Live PASS prefix RAM/stack replay failed.")))
	var expected_ram: PackedByteArray = replay["ram_image"]
	var expected_stack: PackedByteArray = replay["stack_page"]
	if expected_ram != source_ram or expected_stack != source_stack:
		return _fail("Live PASS prefix RAM/stack differs from full ordered replay of ROM-source writes.")
	var mapper_result := _replay_actor_source_mapper_writes(mapper_writes_variant,
			context.bank_low, context.bank_high, mapper,
			int(context.mapper_state.get("select", -1)))
	if not bool(mapper_result.get("ok", false)):
		return _fail(String(mapper_result.get("reason", "Live PASS prefix MMC3 replay failed.")))
	for slot_base: int in SLOT_BASES:
		if source_ram.slice(slot_base, slot_base + 4) != _record_bytes(slot_base):
			return _fail("Live PASS prefix changed scheduler-owned task record `$%02X`." % slot_base)
	_ram = expected_ram
	_stack_page = expected_stack
	context.accumulator = int(registers["a"]) & 0xFF
	context.x_register = int(registers["x"]) & 0xFF
	context.y_register = int(registers["y"]) & 0xFF
	context.status_register = int(registers["p"]) & 0xFF
	context.status_known_mask = int(registers["p_known_mask"]) & 0xFF
	context.stack_pointer = int(registers["sp"])
	context.program_counter = 0x86F8
	context.bank_low = int(mapper["bank_low"])
	context.bank_high = int(mapper["bank_high"])
	context.mapper_state = mapper.duplicate(true)
	context.source_label = "ROM-byte ordinary PASS scenario-$38 prefix at `$86F8`"
	return true


## Adopts a bounded source executor's return from the two verified slot-$01
## callees. Replays its ordered RAM writes instead of trusting/copying a whole
## foreign RAM image, preserving scheduler-owned task records and latches.
func adopt_root_slot01_callee_return_state(source_pc: int, target_cpu_address: int,
		callee_result: Dictionary) -> bool:
	if not _require_initialized():
		return false
	var call_contracts := {
		0xCA52: {"target": 0xEE9F, "return_pc": 0xCA55},
		0xCA55: {"target": 0xE3CA, "return_pc": 0xCA58},
	}
	if not call_contracts.has(source_pc):
		return _fail("Root slot-$01 callee adoption was requested from an unsupported caller PC.")
	var contract: Dictionary = call_contracts[source_pc]
	var context: TaskContext = _contexts.get(0x01)
	if _active_task_slot != 0x01 or context == null or context.phase != ContextPhase.RUNNING \
			or context.program_counter != source_pc or target_cpu_address != int(contract["target"]):
		return _fail("Callee return must match the active source slot-$01 caller boundary.")
	if String(callee_result.get("rom_sha256", "")) != "4f1f74d495e86025a5ad17fec2c171f37a94541a7d8ff7034c580d7d5111a097" \
			or String(callee_result.get("status", "")) != "returned_to_source_caller" \
			or not bool(callee_result.get("returned_to_caller", false)):
		return _fail("Callee result is not a successful bounded return for this ROM.")
	var entry_variant: Variant = callee_result.get("entry", {})
	var registers_variant: Variant = callee_result.get("registers", {})
	var mapper_variant: Variant = callee_result.get("mapper", {})
	var ram_variant: Variant = callee_result.get("ram_image", PackedByteArray())
	var stack_variant: Variant = callee_result.get("stack_page", PackedByteArray())
	var writes_variant: Variant = callee_result.get("memory_writes", [])
	if not entry_variant is Dictionary or not registers_variant is Dictionary \
			or not mapper_variant is Dictionary or not ram_variant is PackedByteArray \
			or not stack_variant is PackedByteArray or not writes_variant is Array:
		return _fail("Callee result omits its source call, CPU, mapper, RAM, stack, or ordered writes.")
	var entry: Dictionary = entry_variant
	var registers: Dictionary = registers_variant
	var mapper: Dictionary = mapper_variant
	var result_ram: PackedByteArray = ram_variant
	var result_stack: PackedByteArray = stack_variant
	var writes: Array = writes_variant
	if int(entry.get("slot_base", -1)) != 0x01 \
			or int(entry.get("call_pc", -1)) != source_pc \
			or int(entry.get("target_pc", -1)) != target_cpu_address \
			or int(entry.get("expected_return_pc", -1)) != int(contract["return_pc"]) \
			or int(registers.get("pc", -1)) != int(contract["return_pc"]) \
			or result_ram.size() != RAM_SIZE or result_stack.size() != STACK_PAGE_SIZE \
			or int(mapper.get("task_bank_low", -1)) != int(registers.get("bank_low", -2)) \
			or int(mapper.get("task_bank_high", -1)) != int(registers.get("bank_high", -2)):
		return _fail("Callee return does not match the caller PC, task-bank pair, or byte-array sizes.")
	for name: String in ["a", "x", "y", "sp", "bank_low", "bank_high"]:
		var value := int(registers.get(name, -1))
		if value < 0 or value > 0xFF:
			return _fail("Callee return has an invalid 6502/task register `%s`." % name)
	if int(registers["sp"]) != context.stack_pointer:
		return _fail("Callee RTS did not restore the task's incoming stack pointer.")
	var expected_ram := _ram.duplicate()
	var expected_stack := _stack_page.duplicate()
	for write_variant in writes:
		if not write_variant is Dictionary:
			return _fail("Callee ordered write stream contains a malformed event.")
		var write: Dictionary = write_variant
		var space := String(write.get("space", ""))
		var address := int(write.get("address", -1))
		var value := int(write.get("value", -1))
		if value < 0 or value > 0xFF:
			return _fail("Callee ordered write stream contains a non-byte value.")
		if space == "cpu_ram":
			if address < 0 or address >= RAM_SIZE or _is_scheduler_owned_ram_address(address):
				return _fail("Callee write touches invalid or scheduler-owned RAM `$%04X`." % address)
			expected_ram[address] = value
			if address >= 0x0100 and address < 0x0200:
				expected_stack[address & 0xFF] = value
		elif space == "mmc3":
			if address != 0x8000 and address != 0x8001:
				return _fail("Callee mapper write is outside the verified MMC3 register window.")
		else:
			return _fail("Callee ordered write stream contains an unsupported address space.")
	if expected_ram != result_ram or expected_stack != result_stack:
		return _fail("Callee RAM/stack image does not equal replaying its ordered writes over live scheduler state.")
	for index in range(STACK_PAGE_SIZE):
		if result_ram[0x0100 + index] != result_stack[index]:
			return _fail("Callee returned RAM and stack mirrors disagree at `$%04X`." % (0x0100 + index))
	_ram = expected_ram
	_stack_page = expected_stack
	context.accumulator = int(registers["a"])
	context.x_register = int(registers["x"])
	context.y_register = int(registers["y"])
	context.stack_pointer = int(registers["sp"])
	context.program_counter = int(contract["return_pc"])
	context.bank_low = int(registers["bank_low"])
	context.bank_high = int(registers["bank_high"])
	context.source_label = "ROM-byte slot-$01 callee return `$%04X->$%04X`" % [source_pc, target_cpu_address]
	return true


## Adopts a ROM `$CBC1 RTS` result from a narrowly supported slot-$05
## scenario caller. Caller return words and saved bank pairs remain profile-gated.
func adopt_slot05_scenario35_return_state(dispatch: Dictionary, boundary: Dictionary,
		return_result: Dictionary) -> bool:
	if not _require_initialized():
		return false
	var context: TaskContext = _contexts.get(0x05)
	var entry: Dictionary = return_result.get("entry", {})
	var registers: Dictionary = return_result.get("registers", {})
	var mapper: Dictionary = return_result.get("mapper", {})
	var result_ram: Variant = return_result.get("ram_image", PackedByteArray())
	var result_stack: Variant = return_result.get("stack_page", PackedByteArray())
	var live_ram: Variant = boundary.get("ram_image", PackedByteArray())
	var live_stack: Variant = boundary.get("stack_page", PackedByteArray())
	var scenario_id := int(live_ram[0x0518]) if live_ram is PackedByteArray and live_ram.size() == RAM_SIZE else -1
	var return_profile: Variant = {
		0x35: {"return_pc": 0xDADD, "return_word": 0xDADC, "entry_sp": 0x4E,
			"source_return_word": 0xD11D, "bank_low": 0x1C, "bank_high": 0x1D},
		0x1E: [
			{"return_pc": 0xE238, "return_word": 0xE237, "entry_sp": 0x4C,
				"source_return_word": 0xD11D, "bank_low": 0x1C, "bank_high": 0x1D},
			{"return_pc": 0xE238, "return_word": 0xE237, "entry_sp": 0x4C,
				"source_return_word": 0xE944, "bank_low": 0x1A, "bank_high": 0x1B},
		],
		0x44: {"return_pc": 0xE38F, "return_word": 0xE38E, "entry_sp": 0x4C,
			"source_return_word": 0xD11D, "bank_low": 0x1A, "bank_high": 0x1B},
		0x38: {"return_pc": 0xD7ED, "return_word": 0xD7EC, "entry_sp": 0x48,
			"source_return_word": 0xE944, "bank_low": 0x1C, "bank_high": 0x1D},
		0x18: {"return_pc": 0x8188, "return_word": 0x8187, "entry_sp": 0x4C,
			"source_return_word": 0xE944, "bank_low": 0x1A, "bank_high": 0x1B},
		0x1C: {"return_pc": 0xDE90, "return_word": 0xDE8F, "entry_sp": 0x4E,
			"source_return_word": 0xE944, "bank_low": 0x1A, "bank_high": 0x1B},
	}.get(scenario_id, {})
	if return_profile is Array:
		var candidates: Array = return_profile
		return_profile = {}
		for candidate_variant in candidates:
			if not candidate_variant is Dictionary:
				continue
			var candidate: Dictionary = candidate_variant
			if int(candidate.get("source_return_word", -1)) == int(dispatch.get("source_return_word", -2)) \
					and int(candidate.get("bank_low", -1)) == int(dispatch.get("bank_low", -2)) \
					and int(candidate.get("bank_high", -1)) == int(dispatch.get("bank_high", -2)):
				return_profile = candidate
				break
	if _active_task_slot != 0x05 or context == null \
			or context.phase != ContextPhase.RUNNING or context.program_counter != 0xCBC1 \
			or int(dispatch.get("slot_base", -1)) != 0x05 \
			or int(dispatch.get("pc", -1)) != 0xCBC1 \
			or return_profile.is_empty() \
			or int(dispatch.get("sp", -1)) != int(return_profile.get("entry_sp", -2)) \
			or int(boundary.get("active_task_slot", -1)) != 0x05 \
			or int(boundary.get("pc", -1)) != 0xCBC1 \
			or int(boundary.get("sp", -1)) != int(dispatch.get("sp", -2)) \
			or context.source_return_word != int(return_profile.get("source_return_word", -2)) \
			or int(dispatch.get("source_return_word", -1)) != int(return_profile.get("source_return_word", -2)) \
			or String(return_result.get("rom_sha256", "")) != ROM_SHA256 \
			or String(return_result.get("source_manifest", "")) != "res://reference/rom_extract/gameplay/scenario_task_runtime/manifest.json" \
			or String(return_result.get("status", "")) != "returned_to_source_caller" \
			or not bool(return_result.get("returned_to_caller", false)) \
			or not entry is Dictionary or int(entry.get("call_pc", -1)) != 0xCBC1 \
			or int(entry.get("scenario_id", -1)) != scenario_id \
			or int(entry.get("return_word", -1)) != int(return_profile.get("return_word", -2)) \
			or int(entry.get("expected_return_pc", -1)) != int(return_profile.get("return_pc", -2)) \
			or not registers is Dictionary or int(registers.get("pc", -1)) != int(return_profile.get("return_pc", -2)) \
			or int(registers.get("sp", -1)) != ((int(dispatch.get("sp", -1)) + 2) & 0xFF) \
			or not mapper is Dictionary \
			or int(dispatch.get("bank_low", -1)) != int(return_profile.get("bank_low", -2)) \
			or int(dispatch.get("bank_high", -1)) != int(return_profile.get("bank_high", -2)) \
			or int(mapper.get("bank_low", -1)) != int(return_profile.get("bank_low", -2)) \
			or int(mapper.get("bank_high", -1)) != int(return_profile.get("bank_high", -2)) \
			or not live_ram is PackedByteArray or live_ram.size() != RAM_SIZE \
			or not live_stack is PackedByteArray or live_stack.size() != STACK_PAGE_SIZE \
			or not result_ram is PackedByteArray or result_ram != live_ram \
			or not result_stack is PackedByteArray or result_stack != live_stack \
			or return_result.get("memory_writes", []) != []:
		return _fail("Slot-$05 `$CBC1 RTS` does not match the live scenario `$%02X` caller/stack profile." % scenario_id)
	var result_ram_image: PackedByteArray = result_ram
	var source_register_select := int(mapper.get("register_select", -1))
	var live_register_select := int(result_ram_image[0x0022]) & 0x07
	if source_register_select != live_register_select:
		return _fail("Slot-$05 `$CBC1 RTS` mapper selector does not match source RAM `$0022`: mapper=$%02X RAM=$%02X." % [
			source_register_select, live_register_select])
	context.accumulator = int(registers["a"]) & 0xFF
	context.x_register = int(registers["x"]) & 0xFF
	context.y_register = int(registers["y"]) & 0xFF
	context.status_register = int(registers.get("p", context.status_register)) & 0xFF
	context.status_known_mask = int(registers.get("p_known_mask", context.status_known_mask)) & 0xFF
	context.program_counter = int(return_profile["return_pc"])
	context.stack_pointer = int(registers["sp"]) & 0xFF
	var return_mapper_state := context.mapper_state.duplicate(true)
	return_mapper_state["register_select"] = source_register_select
	return_mapper_state["select"] = source_register_select
	context.mapper_state = return_mapper_state
	context.source_label = "ROM-byte slot-$05 scenario return `$CBC1 RTS->$%04X`" % context.program_counter
	return true


## Adopts the ROM `$DE90-$DE95` stack-reset/jump tail after the scenario-$1C
## physical `$DE8F` return. `$E944` remains scheduler metadata, not the stack word.
func adopt_slot05_scenario1c_handoff_tail(return_result: Dictionary,
		tail_result: Dictionary) -> bool:
	if not _require_initialized():
		return false
	var context: TaskContext = _contexts.get(0x05)
	var return_registers: Variant = return_result.get("registers", {})
	var tail_registers: Variant = tail_result.get("registers", {})
	var mapper: Variant = tail_result.get("mapper", {})
	var return_ram: Variant = return_result.get("ram_image", PackedByteArray())
	var tail_ram: Variant = tail_result.get("ram_image", PackedByteArray())
	var return_stack: Variant = return_result.get("stack_page", PackedByteArray())
	var tail_stack: Variant = tail_result.get("stack_page", PackedByteArray())
	if _active_task_slot != 0x05 or context == null \
			or context.phase != ContextPhase.RUNNING or context.program_counter != 0xDE90 \
			or context.source_return_word != 0xE944 \
			or context.source_label != "ROM-byte slot-$05 scenario return `$CBC1 RTS->$DE90`" \
			or not bool(return_result.get("ok", false)) \
			or String(return_result.get("status", "")) != "returned_to_source_caller" \
			or String(return_result.get("rom_sha256", "")) != ROM_SHA256 \
			or String(return_result.get("source_manifest", "")) != "res://reference/rom_extract/gameplay/scenario_task_runtime/manifest.json" \
			or int((return_result.get("entry", {}) as Dictionary).get("scenario_id", -1)) != 0x1C \
			or int((return_result.get("entry", {}) as Dictionary).get("return_word", -1)) != 0xDE8F \
			or not return_registers is Dictionary or int(return_registers.get("pc", -1)) != 0xDE90 \
			or String(tail_result.get("status", "")) != "scenario1c_pass_handoff_returned_to_e0df" \
			or String(tail_result.get("source_manifest", "")) != "res://reference/rom_extract/gameplay/pass_receiver_holder_transfer/manifest.json" \
			or String(tail_result.get("source_span_sha256", "")) != "d6ab96667636645baf440cfa35b81c05279f471ee3de570af7adbea241867cfa" \
			or int(tail_result.get("entry_pc", -1)) != 0xDE90 \
			or int(tail_result.get("entry_sp", -1)) != 0x50 \
			or int(tail_result.get("exit_pc", -1)) != 0xE0DF \
			or int(tail_result.get("exit_sp", -1)) != 0x50 \
			or tail_result.get("source_instruction_pcs", []) != [0xDE90, 0xDE92, 0xDE93] \
			or not tail_registers is Dictionary or int(tail_registers.get("pc", -1)) != 0xE0DF \
			or int(tail_registers.get("sp", -1)) != 0x50 \
			or int(tail_registers.get("x", -1)) != 0x50 \
			or not mapper is Dictionary or int(mapper.get("bank_low", -1)) != 0x1A \
			or int(mapper.get("bank_high", -1)) != 0x1B \
			or not return_ram is PackedByteArray or return_ram.size() != RAM_SIZE \
			or not tail_ram is PackedByteArray or tail_ram != return_ram \
			or not return_stack is PackedByteArray or return_stack.size() != STACK_PAGE_SIZE \
			or not tail_stack is PackedByteArray or tail_stack != return_stack \
			or tail_result.get("writes", ["unexpected"]) != [] \
			or tail_result.get("mapper_writes", ["unexpected"]) != []:
		return _fail("Scenario-$1C `$DE90->$E0DF` tail did not follow the live `$CBC1` return state.")
	var return_register_set: Dictionary = return_registers
	var next_register_set: Dictionary = tail_registers
	if int(next_register_set.get("a", -1)) != int(return_register_set.get("a", -2)) \
			or int(next_register_set.get("y", -1)) != int(return_register_set.get("y", -2)) \
			or (int(next_register_set.get("p", -1)) & 0x82) != 0 \
			or (int(next_register_set.get("p_known_mask", -1)) & 0x82) != 0x82:
		return _fail("Scenario-$1C tail did not preserve Y or apply the ROM LDX `$50` N/Z flags.")
	_ram = (tail_ram as PackedByteArray).duplicate()
	_stack_page = (tail_stack as PackedByteArray).duplicate()
	context.accumulator = int(next_register_set.get("a", context.accumulator)) & 0xFF
	context.x_register = int(next_register_set.get("x", context.x_register)) & 0xFF
	context.y_register = int(next_register_set.get("y", context.y_register)) & 0xFF
	context.status_register = int(next_register_set.get("p", context.status_register)) & 0xFF
	context.status_known_mask = int(next_register_set.get("p_known_mask", context.status_known_mask)) & 0xFF
	context.program_counter = 0xE0DF
	context.stack_pointer = 0x50
	context.bank_low = 0x1A
	context.bank_high = 0x1B
	context.mapper_state = mapper.duplicate(true)
	context.source_label = "ROM-byte scenario-$1C PASS handoff `$DE90->$E0DF`"
	return true


## Replays the ROM-owned scenario-$18 caller after `$CBC1 RTS` returns to
## `$8188`; the `$819B RTS` consumes `$8111`, separate from `$E944` metadata.
func adopt_slot05_scenario18_post_queue_caller_result(boundary: Dictionary,
		result: Dictionary) -> bool:
	if not _require_initialized():
		return false
	var context: TaskContext = _contexts.get(0x05)
	var live_ram: Variant = boundary.get("ram_image", PackedByteArray())
	var live_stack: Variant = boundary.get("stack_page", PackedByteArray())
