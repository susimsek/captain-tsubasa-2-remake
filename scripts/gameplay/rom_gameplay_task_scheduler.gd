			or int(registers.get("pc", -1)) != 0xCB0F:
		return _fail_pass_waiter_field("The PASS scenario queue omitted its source `$8185->$C54E->$CBB0->$CBBE->$CB0F` stack path.")
	var queue_writes := {"$CBB0:$0518=$18": false,
		"$CBB5:$0516=$80": false, "$CBBA:$0005=$00": false}
	for write_variant: Variant in writes:
		if write_variant is Dictionary:
			var write: Dictionary = write_variant
			var signature := "$%04X:$%04X=$%02X" % [int(write.get("pc", -1)),
				int(write.get("address", -1)), int(write.get("value", -1))]
			if queue_writes.has(signature): queue_writes[signature] = true
	for signature: String in queue_writes:
		if not bool(queue_writes[signature]):
