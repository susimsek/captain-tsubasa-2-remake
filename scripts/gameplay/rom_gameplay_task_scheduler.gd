			"%s (%s)" % [str(result_stack is PackedByteArray and expected_stack.size() == STACK_PAGE_SIZE and result_stack == expected_stack), first_stack_mismatch],
			int(registers.get("sp", -1)), int(resume_result.get("exit_sp", -1)),
			int(mapper.get("bank_low", -1)), int(mapper.get("bank_high", -1)),
			(writes as Array).size() if writes is Array else -1, rejected_write,
			(result_ram as PackedByteArray).size() if result_ram is PackedByteArray else -1,
			expected_ram.size(),
			(result_stack as PackedByteArray).size() if result_stack is PackedByteArray else -1,
			expected_stack.size(),
		])
	_ram = result_ram.duplicate()
	_stack_page = result_stack.duplicate()
	context.accumulator = int(registers.get("a", context.accumulator)) & 0xFF
	context.x_register = int(registers.get("x", context.x_register)) & 0xFF
	context.y_register = int(registers.get("y", context.y_register)) & 0xFF
	context.status_register = int(registers.get("p", context.status_register)) & 0xFF
	context.status_known_mask = int(registers.get("p_known_mask", context.status_known_mask)) & 0xFF
	context.program_counter = expected_exit_pc
	context.stack_pointer = int(registers["sp"]) & 0xFF
	context.bank_low = expected_bank_low
	context.bank_high = expected_bank_high
	context.mapper_state = mapper.duplicate(true)
