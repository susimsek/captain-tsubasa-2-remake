		{"pc": 0xCE38, "address": 0x8001, "value": 0x1A, "select": 6, "kind": "register_data"},
		{"pc": 0xCE41, "address": 0x8000, "value": int(_ram[0x0022]) | 0x07, "select": 7, "kind": "register_select"},
		{"pc": 0xCE46, "address": 0x8001, "value": 0x1B, "select": 7, "kind": "register_data"},
