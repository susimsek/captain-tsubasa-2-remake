## Adopts only the ordered CPU writes from the ROM-derived PASS continuation.
## The caller must supply the scheduler's current `$D7ED` input snapshot and
## the executor's source-status report; all endpoint RAM is recomputed here.
## The returned `$CB0F` call frame is then saved only by the one-use verified
## `$D80C` yield contract in `yield_at_verified_callsite()`.
func adopt_slot05_pass_receiver_wait_call_entry_result(boundary: Dictionary,
		continuation_result: Dictionary, executor_source_status: Dictionary) -> bool:
	if not _require_initialized():
		return false
	var context: TaskContext = _contexts.get(0x05)
	var entry_ram_variant: Variant = boundary.get("ram_image", PackedByteArray())
	var entry_stack_variant: Variant = boundary.get("stack_page", PackedByteArray())
	var mapper_variant: Variant = boundary.get("mapper", {})
	var mapper_proof_variant: Variant = boundary.get("mapper_proof", {})
	var entry_sp := int(boundary.get("sp", -1))
	for forbidden_key in ["fceux_ram", "captured_ram", "trace_ram_image", "emulator_snapshot", "screenshot"]:
		if boundary.has(forbidden_key) or continuation_result.has(forbidden_key):
			return _fail("Emulator/trace state cannot seed the PASS receiver continuation.")
	if _active_task_slot != 0x05 or context == null \
			or context.phase != ContextPhase.RUNNING or context.program_counter != 0xD7ED \
			or context.bank_low != 0x1A or context.bank_high != 0x1B \
			or int(_ram[0x0000]) != 0x05 \
			or String(boundary.get("rom_sha256", "")) != ROM_SHA256 \
			or int(boundary.get("slot_base", -1)) != 0x05 \
			or int(boundary.get("active_task_slot", -1)) != 0x05 \
			or int(boundary.get("phase", -1)) != ContextPhase.RUNNING \
			or int(boundary.get("pc", -1)) != 0xD7ED \
			or entry_sp != context.stack_pointer \
			or int(boundary.get("a", -1)) != context.accumulator \
			or int(boundary.get("x", -1)) != context.x_register \
			or int(boundary.get("y", -1)) != context.y_register \
			or int(boundary.get("p", -1)) != context.status_register \
			or int(boundary.get("p_known_mask", -1)) != context.status_known_mask \
			or int(boundary.get("bank_low", -1)) != context.bank_low \
			or int(boundary.get("bank_high", -1)) != context.bank_high \
			or not entry_ram_variant is PackedByteArray or entry_ram_variant.size() != RAM_SIZE \
			or not entry_stack_variant is PackedByteArray or entry_stack_variant.size() != STACK_PAGE_SIZE \
			or entry_ram_variant != _ram or entry_stack_variant != _stack_page \
			or (entry_ram_variant as PackedByteArray).slice(0x0100, 0x0200) != entry_stack_variant \
			or entry_sp < 2 or entry_sp > 0xFF \
			or int((entry_stack_variant as PackedByteArray)[(entry_sp + 1) & 0xFF]) != 0x34 \
			or int((entry_stack_variant as PackedByteArray)[(entry_sp + 2) & 0xFF]) != 0xD6 \
			or int(_ram[0x0518]) != 0x38 or int(_ram[0x0441]) >= 22 \
			or bool(boundary.get("trace_state_used", true)) \
			or bool(boundary.get("test_fixture", false)) \
			or String(boundary.get("source_label", "")).is_empty() \
			or not mapper_variant is Dictionary or mapper_variant != context.mapper_state \
			or not mapper_proof_variant is Dictionary \
			or mapper_proof_variant.get("banks_at_fixed_dispatch", []) != [0x1C, 0x1D] \
			or int(mapper_proof_variant.get("fixed_bank", -1)) != 0x1E \
			or int(boundary.get("executing_cpu_bank", -1)) != 0x1E:
		return _fail("PASS continuation adoption requires the live scheduler-owned slot-$05 `$D7ED` boundary.")
	if not _pass_post_scenario_source_package_matches(executor_source_status):
		return false
	if _slot05_pass_receiver_wait_yield_in_progress:
		return _fail("A prior PASS receiver `$D80C` yield receipt is still pending.")

	var result_status := String(continuation_result.get("status", ""))
	var renderer_receipt_variant: Variant = continuation_result.get("renderer_return_receipt", {})
	var writes_variant: Variant = continuation_result.get("source_writes", [])
	var stack_writes_variant: Variant = continuation_result.get("source_stack_writes", [])
	var reads_variant: Variant = continuation_result.get("source_reads", [])
	var stack_reads_variant: Variant = continuation_result.get("source_stack_reads", [])
	var calls_variant: Variant = continuation_result.get("calls", [])
	var instructions_variant: Variant = continuation_result.get("entry_to_yield_instructions", [])
	var registers_variant: Variant = continuation_result.get("registers", {})
	var holder_variant: Variant = continuation_result.get("holder_copy", {})
	var cursor_variant: Variant = continuation_result.get("cursor", {})
	var descriptor_packets_variant: Variant = continuation_result.get("descriptor_panel_packets", [])
	var renderer_source_valid := false
	if renderer_receipt_variant is Dictionary:
		var renderer_receipt: Dictionary = renderer_receipt_variant
		renderer_source_valid = bool(renderer_receipt.get("ok", false)) \
			and String(renderer_receipt.get("rom_sha256", "")) == ROM_SHA256 \
			and int(renderer_receipt.get("callsite_pc", -1)) == 0xD7EF \
			and int(renderer_receipt.get("entry_pc", -1)) == 0xEF7F \
			and int(renderer_receipt.get("descriptor_id", -1)) == 0x0F \
			and int(renderer_receipt.get("return_pc", -1)) == 0xD7F2 \
			and bool(renderer_receipt.get("returned_via_rts", false)) \
			and bool(renderer_receipt.get("renderer_source_executed", false)) \
			and String(renderer_receipt.get("source_kind", "")) == "rom_byte_renderer_execution" \
			and not bool(renderer_receipt.get("fixture_only", false)) \
			and not bool(renderer_receipt.get("trace_state_used", true))
	if not bool(continuation_result.get("ok", false)) \
			or result_status != "pass_receiver_wait_yield_at_cb0f_call_entry" \
			or String(continuation_result.get("rom_sha256", "")) != ROM_SHA256 \
			or int(continuation_result.get("entry_pc", -1)) != 0xD7ED \
			or int(continuation_result.get("entry_sp", -1)) != entry_sp \
			or int(continuation_result.get("renderer_entry_pc", -1)) != 0xEF7F \
			or int(continuation_result.get("renderer_descriptor_id", -1)) != 0x0F \
			or int(continuation_result.get("renderer_return_pc", -1)) != 0xD7F2 \
			or not renderer_source_valid \
			or bool(continuation_result.get("renderer_return_fixture", true)) \
			or bool(continuation_result.get("renderer_body_executed_by_this_component", true)) \
			or int(continuation_result.get("exit_pc", -1)) != 0xCB0F \
			or int(continuation_result.get("resume_pc_after_yield", -1)) != 0xD80F \
			or bool(continuation_result.get("scheduler_yield_executed", true)) \
			or bool(continuation_result.get("receiver_input_poll_executed", true)) \
			or bool(continuation_result.get("ppu_effects_applied", true)) \
			or bool(continuation_result.get("apu_effects_applied", true)) \
			or bool(continuation_result.get("trace_state_used", true)) \
			or bool(continuation_result.get("emulator_data_used", true)) \
			or bool(continuation_result.get("runtime_integrated", true)) \
			or bool(continuation_result.get("source_cycle_timing_modeled", true)) \
			or not writes_variant is Array or writes_variant.size() != 9 \
			or not stack_writes_variant is Array or stack_writes_variant.size() != 10 \
			or not reads_variant is Array or reads_variant.size() != 5 \
			or not stack_reads_variant is Array or stack_reads_variant.size() != 6 \
			or not calls_variant is Array or calls_variant.size() != 5 \
			or not instructions_variant is Array \
			or not registers_variant is Dictionary or not holder_variant is Dictionary \
			or not cursor_variant is Dictionary or not descriptor_packets_variant is Array \
			or descriptor_packets_variant.size() != 10:
		return _fail("PASS continuation result lacks the exact ROM-source, renderer, call, or bounded-stop contract.")

	var registers: Dictionary = registers_variant
	var holder: Dictionary = holder_variant
	var cursor: Dictionary = cursor_variant
	var holder_slot := int(_ram[0x0441])
	var record_pointer := 0x0300 + holder_slot * 0x0C
	var record_x := int(_ram[(record_pointer + 0x06) & 0x07FF])
	var record_y := int(_ram[(record_pointer + 0x08) & 0x07FF])
	var tile_index := int(holder.get("tile_index_05fe", -1))
	if int(holder.get("holder_slot_0441", -1)) != holder_slot \
			or int(holder.get("record_pointer", -1)) != record_pointer \
			or int(holder.get("x_0635", -1)) != record_x \
			or int(holder.get("y_0637", -1)) != record_y \
			or tile_index < 0 or tile_index > 0xFF \
			or int(cursor.get("tile_index_0624", -1)) != tile_index \
			or int(cursor.get("candidate_count_0430", -1)) != int(_ram[0x0430]) \
			or int(cursor.get("selectable_count_0625", -1)) != 0 \
			or int(registers.get("pc", -1)) != 0xCB0F \
			or int(registers.get("sp", -1)) != ((entry_sp - 2) & 0xFF) \
			or int(registers.get("a", -1)) != 0x01 \
			or int(registers.get("x", -1)) < 0 or int(registers.get("x", -1)) > 0xFF \
			or int(registers.get("y", -1)) < 0 or int(registers.get("y", -1)) > 0xFF \
			or int(registers.get("p", -1)) < 0 or int(registers.get("p", -1)) > 0xFF \
			or int(registers.get("p_known_mask", -1)) < 0 \
			or int(registers.get("p_known_mask", -1)) > 0xFF:
		return _fail("PASS continuation result registers or holder coordinates disagree with the live slot-$05 state.")

	var expected_reads := [
		{"source_pc": 0xE6EC, "address": 0x0441, "value": holder_slot, "role": "holder_slot"},
		{"source_pc": 0xCD80, "cpu_address": 0xCD89 + holder_slot * 2,
			"value": record_pointer & 0xFF, "role": "record_pointer_low"},
		{"source_pc": 0xCD83, "cpu_address": 0xCD8A + holder_slot * 2,
			"value": (record_pointer >> 8) & 0xFF, "role": "record_pointer_high"},
		{"source_pc": 0xE6F4, "address": record_pointer + 0x06,
			"value": record_x, "role": "holder_record_x_plus_06"},
		{"source_pc": 0xE6FC, "address": record_pointer + 0x08,
			"value": record_y, "role": "holder_record_y_plus_08"},
	]
	if reads_variant != expected_reads:
		return _fail("PASS continuation source reads differ from the live holder slot/ROM pointer/record values.")

	var expected_writes := [
		{"source_pc": 0xD7F4, "address": 0x062D, "value": 0x81},
		{"source_pc": 0xD7F9, "address": 0x0494, "value": 0x1F},
		{"source_pc": 0xCD80, "address": 0x0034, "value": record_pointer & 0xFF},
		{"source_pc": 0xCD83, "address": 0x0035, "value": (record_pointer >> 8) & 0xFF},
		{"source_pc": 0xE6F6, "address": 0x0635, "value": record_x},
		{"source_pc": 0xE6FE, "address": 0x0637, "value": record_y},
		{"source_pc": 0xE705, "address": 0x05FE, "value": tile_index},
		{"source_pc": 0xD801, "address": 0x0625, "value": 0x00},
		{"source_pc": 0xD807, "address": 0x0624, "value": tile_index},
