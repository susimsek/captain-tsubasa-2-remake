	if result_stack is PackedByteArray and result_stack.size() == STACK_PAGE_SIZE \
			and expected_stack.size() == STACK_PAGE_SIZE:
		for address in STACK_PAGE_SIZE:
			if result_stack[address] != expected_stack[address]:
				first_stack_mismatch = "$%02X:%02X!=%02X" % [address, result_stack[address], expected_stack[address]]
