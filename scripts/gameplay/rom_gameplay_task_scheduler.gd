				or int(_stack_page[(pass_frame_sp + 2) & 0xFF]) != 0xD8:
			return _fail("The PASS receiver `$D80C` call frame must preserve return `$D80F` on the live stack.")
	if slot05_pass_field_caller_wait and (context.program_counter != 0xE086 \
			or not String(context.source_label).begins_with("ROM-byte PASS field caller") \
			or delay_in_a != context.accumulator or saved_x != context.x_register \
			or saved_y != context.y_register or caller_stack_pointer != context.stack_pointer \
			or current_bank_low != 0x1A or current_bank_high != 0x1B \
			or context.bank_low != 0x1A or context.bank_high != 0x1B \
			or int(_ram[0x0000]) != 0x05 or call_frame_already_pushed):
		return _fail("PASS field caller wait yield requires its adopted live `$E086` callsite and scheduler-owned `$E088` JSR frame.")
	if source_pc == 0x8047 and (not _slot11_actor_worker_yield_in_progress \
			or slot_base != 0x11 or context.program_counter != source_pc \
			or delay_in_a != context.accumulator or caller_stack_pointer != context.stack_pointer \
			or saved_x != context.x_register or saved_y != context.y_register \
			or current_bank_low != 0x18 or current_bank_high != 0x19):
		return _fail("Slot-$11 `$8047` yield must be reached through its bounded actor-worker source executor.")
	if slot_base == 0x05 and call_frame_already_pushed \
			and source_pc in [0xF018, 0xF0A8, 0xD5BD, 0xCC50, 0xCCA0, 0xCCCE] \
			and (not _slot05_scenario44_field_entry_yield_in_progress \
			or context.program_counter != 0xCB0F \
			or delay_in_a != context.accumulator or saved_x != context.x_register \
			or saved_y != context.y_register \
			or caller_stack_pointer != ((context.stack_pointer + 2) & 0xFF) \
			or current_bank_low != 0x1A or current_bank_high != 0x1B \
			or context.bank_low != 0x1A or context.bank_high != 0x1B \
			or not call_frame_already_pushed):
		return _fail("Slot-$05 scenario-$44 packet-producer yield requires its live ROM worker and pre-pushed call frame.")
	var slot05_scenario44_field_entry_jsr_already_executed := source_pc in [0xF018, 0xF0A8, 0xD5BD, 0xCC50, 0xCCA0, 0xCCCE] \
		and slot_base == 0x05 and _slot05_scenario44_field_entry_yield_in_progress
	var slot05_field_loop_jsr_already_executed := source_pc == 0xE147 and slot_base == 0x05
	var slot05_source_mapper_field_jsr_already_executed := source_pc == 0xE147 \
			and slot_base == 0x05 and _slot05_source_mapper_field_yield_in_progress
	var slot05_scenario2e_enqueue_jsr_already_executed := source_pc == 0xCBBE \
			and slot_base == 0x05 and _slot05_field_loop_yield_in_progress \
			and int(_ram[0x0518]) == 0x2E
	var slot05_field_input_loop_jsr_already_executed := source_pc == 0xE40F \
			and slot_base == 0x05 and call_frame_already_pushed
	if slot05_field_loop_jsr_already_executed and not slot05_source_mapper_field_jsr_already_executed \
			and (not _slot05_field_loop_yield_in_progress \
			or context.program_counter != 0xCB0F \
			or delay_in_a != context.accumulator or saved_x != context.x_register \
			or saved_y != context.y_register \
			or caller_stack_pointer != ((context.stack_pointer + 2) & 0xFF) \
			or current_bank_low != 0x1C or current_bank_high != 0x1D \
			or not call_frame_already_pushed):
		return _fail("Slot-$05 `$E147->$CB0F` field-loop yield must follow its live ROM-byte worker and pushed call frame.")
	if slot05_source_mapper_field_jsr_already_executed and (not _slot05_field_loop_yield_in_progress \
			or context.program_counter != 0xCB0F \
			or delay_in_a != context.accumulator or saved_x != context.x_register \
			or saved_y != context.y_register \
			or caller_stack_pointer != ((context.stack_pointer + 2) & 0xFF) \
			or current_bank_low != 0x1A or current_bank_high != 0x1B \
			or context.bank_low != 0x1A or context.bank_high != 0x1B \
			or not call_frame_already_pushed):
		return _fail("Slot-$05 `$E147->$CB0F` input-iteration yield requires the source-verified `$1A/$1B` field mapper and pushed frame.")
	if slot05_field_input_loop_jsr_already_executed and (not _slot05_field_loop_yield_in_progress \
			or context.program_counter != 0xCB0F \
			or delay_in_a != context.accumulator or saved_x != context.x_register \
			or saved_y != context.y_register \
			or caller_stack_pointer != ((context.stack_pointer + 2) & 0xFF) \
			or not ((current_bank_low == 0x1A and current_bank_high == 0x1B) \
				or (current_bank_low == 0x1C and current_bank_high == 0x1D)) \
			or context.bank_low != current_bank_low or context.bank_high != current_bank_high \
			or not call_frame_already_pushed):
		return _fail("Slot-$05 `$E40F->$CB0F` field-input yield must follow the ROM-byte loop and its pushed call frame.")
	var slot05_minimap_resume_callsite := source_pc in [0xCC50, 0xCCA0, 0xCCCE, 0x82E0] \
		and slot_base == 0x05 and not _slot05_scenario44_field_entry_yield_in_progress \
		and not slot05_pass_confirmation_wait_callsite
	if slot05_minimap_resume_callsite and (not _slot05_field_minimap_yield_in_progress \
			or context.program_counter != source_pc or delay_in_a != context.accumulator \
			or caller_stack_pointer != context.stack_pointer or saved_x != context.x_register \
			or saved_y != context.y_register or current_bank_low != 0x1C \
			or current_bank_high != 0x1D):
		return _fail("Slot-$05 `$CC50` minimap wait yield must follow the ROM-byte `$E247->$8024->$82CA->$C52D->$CC46` path.")
	var is_slot11_resume_callsite := source_pc in [0x82F4, 0x8266, 0xCC50, 0xCCA0, 0xCCCE, 0xA217] \
		and slot_base == 0x11
	var expected_slot11_low := 0x1A if source_pc == 0xA217 else 0x18
	var expected_slot11_high := 0x1B if source_pc == 0xA217 else 0x19
	if is_slot11_resume_callsite and (not _slot11_actor_resume_yield_in_progress \
			and not (source_pc == 0xA217 and _slot11_f5_animation_yield_in_progress) \
			or slot_base != 0x11 or context.program_counter != source_pc \
			or delay_in_a != context.accumulator or caller_stack_pointer != context.stack_pointer \
			or saved_x != context.x_register or saved_y != context.y_register \
			or current_bank_low != expected_slot11_low or current_bank_high != expected_slot11_high \
			or not call_frame_already_pushed):
		return _fail("Slot-$11 continuation yield requires its bounded ROM consumer and pre-pushed JSR frame.")
	if source_pc == 0xEB88 and (not _root_slot09_yield_in_progress or slot_base != 0x09 \
			or delay_in_a != context.accumulator or caller_stack_pointer != context.stack_pointer \
			or saved_x != context.x_register or saved_y != context.y_register \
			or current_bank_low != context.bank_low or current_bank_high != context.bank_high):
		return _fail("Root slot `$09` yield must be reached through its bounded ROM-prefix executor.")
	var slot05_clock_tick_jsr_already_executed := source_pc == 0x8886 \
		and slot_base == 0x05 and _slot05_clock_tick_yield_in_progress
	if slot05_clock_tick_jsr_already_executed and (context.program_counter != 0xCB0F \
			or delay_in_a != context.accumulator or saved_x != context.x_register \
			or saved_y != context.y_register \
			or caller_stack_pointer != ((context.stack_pointer + 2) & 0xFF) \
			or current_bank_low != context.bank_low or current_bank_high != context.bank_high \
			or not call_frame_already_pushed):
		return _fail("Slot-$05 clock-tick yield requires the live `$CB0F` boundary and its pre-pushed `$8886->$C515` frame.")
	var slot05_action_menu_wait_jsr_already_executed := source_pc == 0xD5E7 \
		and slot_base == 0x05
	var slot05_scenario18_field_update_jsr_already_executed := source_pc == 0xE775 \
		and slot_base == 0x05 and _slot05_scenario18_field_update_yield_in_progress
	if _slot05_scenario18_field_update_yield_in_progress \
			and not slot05_scenario18_field_update_jsr_already_executed:
		return _fail("The adopted scenario-$18 field update must yield through its ROM `$E775->$CB0F` callsite.")
	if slot05_scenario18_field_update_jsr_already_executed \
			and (context.program_counter != 0xCB0F \
			or not String(context.source_label).begins_with("ROM-byte PASS scenario-$18 field update") \
			or delay_in_a != context.accumulator or saved_x != context.x_register \
			or saved_y != context.y_register or caller_stack_pointer != ((context.stack_pointer + 2) & 0xFF) \
			or current_bank_low != 0x1A or current_bank_high != 0x1B \
			or context.bank_low != 0x1A or context.bank_high != 0x1B \
			or int(_ram[0x0518]) != 0x18 or not call_frame_already_pushed):
		return _fail("Scenario-$18 `$E775->$CB0F` requires its adopted live field-update state and pushed return frame.")
	if slot05_action_menu_wait_jsr_already_executed \
			and (context.program_counter != 0xCB0F \
			or delay_in_a != context.accumulator or saved_x != context.x_register \
			or saved_y != context.y_register \
			or caller_stack_pointer != ((context.stack_pointer + 2) & 0xFF) \
			or current_bank_low != 0x1A or current_bank_high != 0x1B \
			or context.bank_low != 0x1A or context.bank_high != 0x1B \
			or not call_frame_already_pushed):
		return _fail("Slot-$05 `$D5E7->$CB0F` wait yield requires the live worker boundary, `$1A/$1B` mapper, and pre-pushed call frame.")
	var worker_jsr_already_executed := source_pc == 0x8886 \
		and not slot05_clock_tick_jsr_already_executed
	var scenario_jsr_already_executed := source_pc == 0xCBBE and slot_base == 0x05
	var field_loop_jsr_already_executed := slot05_field_loop_jsr_already_executed \
			or slot05_field_input_loop_jsr_already_executed \
			or slot05_source_mapper_field_jsr_already_executed \
			or slot05_scenario2e_enqueue_jsr_already_executed
	var slot11_resume_jsr_already_executed := source_pc in [0x82F4, 0x8266, 0xCC50, 0xCCA0, 0xCCCE, 0xA217] and slot_base == 0x11
	if scenario_jsr_already_executed and (not call_frame_already_pushed \
			or delay_in_a != context.accumulator or saved_x != context.x_register \
			or saved_y != context.y_register or current_bank_low != context.bank_low \
			or current_bank_high != context.bank_high):
		return _fail("Slot-$05 `$CBBE` save inputs must match the adopted worker's post-JSR state.")
	var expected_context_pc := 0xCB0F if (slot05_clock_tick_jsr_already_executed \
		or slot05_scenario44_field_entry_jsr_already_executed \
		or slot05_action_menu_wait_jsr_already_executed \
		or slot05_pass_receiver_wait_jsr_already_executed \
		or slot05_scenario18_field_update_jsr_already_executed) else \
		(0xC515 if worker_jsr_already_executed else \
		(0xCB0F if scenario_jsr_already_executed or field_loop_jsr_already_executed else source_pc))
	if context.program_counter != expected_context_pc or not _supported_yield_callsite(source_pc) or not _byte_arguments([
		delay_in_a, caller_stack_pointer, saved_x, saved_y, current_bank_low, current_bank_high,
	]):
		return _fail("Yield requires a packaged ROM-verified callsite and byte-valued CPU/task inputs.")
	if not _callsite_matches_source(source_pc):
		return false
	var sp := caller_stack_pointer
	if worker_jsr_already_executed:
		if call_frame_already_pushed:
			return _fail("The `$8886` worker handoff uses its existing C515 frame contract.")
		if delay_in_a != context.accumulator or saved_x != context.x_register \
				or saved_y != context.y_register or current_bank_low != context.bank_low \
				or current_bank_high != context.bank_high:
			return _fail("The `$8886` save inputs must match the adopted worker's live A/X/Y and mapper state.")
		# `$8886` has already executed inside RomFreshBank18WorkerPrefix. The
		# resulting `$C515` state has the JSR return word on the real task stack;
		# validate it instead of pushing that same call frame a second time.
