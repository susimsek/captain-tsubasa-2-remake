			pre_jsr_sp = (int(call.get("sp_after_push", -1)) + 2) & 0xFF
			call_cb0f_seen = true
	if not call_c54e_seen or not call_cb0f_seen or pre_jsr_sp < 0 \
			or int(result_stack[(pre_jsr_sp - 1) & 0xFF]) != 0xC0 \
