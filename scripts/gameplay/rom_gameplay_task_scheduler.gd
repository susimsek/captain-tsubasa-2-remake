		and _is_scenario2e_callback36_map2f_actor_seed_profile(request_ram_variant)
	var scenario36_f9_actor_request := int(_ram[0x0518]) == 0x36 \
			and int(_ram[0x0528]) == 0xE6 and int(_ram[0x0529]) == 0x75
	var expected_actor_parameter := -1
	if scenario18_callback72_actor_request:
		expected_actor_parameter = 0x47
	elif scenario1c_callback1f_actor_request:
		expected_actor_parameter = 0x00
	elif scenario1c_callback01_actor_request:
		expected_actor_parameter = 0x58
	elif scenario1c_callback63_actor_request:
		expected_actor_parameter = 0x58
	elif int(_ram[0x0518]) == 0x35:
		expected_actor_parameter = 0x73
	elif scenario36_f9_actor_request:
		expected_actor_parameter = 0x75
	elif int(_ram[0x0518]) == 0x36:
		expected_actor_parameter = 0x74
	elif scenario2e_callback36_map2f_actor_request:
		expected_actor_parameter = 0x6D
	if String(request.get("schema", "")) != "rom-slot11-actor-seed-request-v1" \
			or String(request.get("rom_sha256", "")) != ROM_SHA256 \
			or String(request.get("source_manifest", "")) != "res://reference/rom_extract/gameplay/slot09_eb8b_continuation/manifest.json" \
			or String(request.get("source_sha256", "")) != String(SOURCE_SPANS["scenario_actor_worker_seed"]["sha256"]) \
			or String(request.get("helper_sha256", "")) != String(SOURCE_SPANS["task_seed"]["sha256"]) \
			or int(request.get("source_pc", -1)) != 0xED15 \
			or int(request.get("call_pc", -1)) != 0xED2A \
			or int(request.get("return_pc", -1)) != 0xED2D \
			or int(request.get("active_slot", -1)) != 0x09 \
			or (request_actor_parameter not in [0x73, 0x74, 0x75] \
				and not (scenario18_callback72_actor_request and request_actor_parameter == 0x47) \
				and not (scenario1c_callback1f_actor_request and request_actor_parameter == 0x00) \
				and not (scenario1c_callback01_actor_request and request_actor_parameter == 0x58) \
				and not (scenario1c_callback63_actor_request and request_actor_parameter == 0x58) \
				and not (scenario2e_callback36_map2f_actor_request and request_actor_parameter == 0x6D)) \
			or int(request.get("a", -1)) != request_actor_parameter \
			or bool(request.get("trace_state_used", true)) \
			or bool(request.get("fixture_only", true)) \
			or not request_registers_variant is Dictionary \
			or not request_mapper_variant is Dictionary \
			or not request_ram_variant is PackedByteArray \
			or not request_stack_variant is PackedByteArray \
			or not request_hashes_variant is Dictionary:
