			and int(boundary.get("sp", -1)) == context.stack_pointer \
			and banks_match \
			and int(boundary.get("menu_context", -1)) == int(_ram[0x0621]) \
			and int(boundary.get("source_selected_action_id", -1)) == int(_ram[0x043B]) \
