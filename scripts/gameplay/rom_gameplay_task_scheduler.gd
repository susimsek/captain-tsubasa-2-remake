## Applies one source-frame controller sample at a stable task boundary. `$001C`
## is the held-button mask; `$001E` is the ROM's newly-pressed mask:
## `($previous ^ current) & current`. Callers provide actual pad state, never
## captured RAM values.
func arm_slot05_pass_receiver_input_wait(dispatch: Dictionary,
		boundary: Dictionary) -> bool:
	if not _require_initialized():
		return false
	var context: TaskContext = _contexts.get(0x05)
	var ram_variant: Variant = boundary.get("ram_image", PackedByteArray())
	var stack_variant: Variant = boundary.get("stack_page", PackedByteArray())
	var mapper_variant: Variant = boundary.get("mapper", {})
	if not _slot05_pass_receiver_input_wait_dispatch_pending \
			or _slot05_pass_receiver_input_wait_ready \
			or context == null or _active_task_slot != 0x05 \
			or int(_ram[0x0000]) != 0x05 \
			or context.phase != ContextPhase.RUNNING \
			or context.program_counter != 0xD80F \
			or context.bank_low != 0x1C or context.bank_high != 0x1D \
			or int(dispatch.get("slot_base", -1)) != 0x05 \
			or String(dispatch.get("resume_path", "")) != "yielded_rts" \
			or int(dispatch.get("pc", -1)) != 0xD80F \
			or int(dispatch.get("bank_low", -1)) != 0x1C \
			or int(dispatch.get("bank_high", -1)) != 0x1D \
			or int(dispatch.get("sp", -1)) != context.stack_pointer \
			or int(dispatch.get("a", -1)) != context.accumulator \
			or int(dispatch.get("x", -1)) != context.x_register \
			or int(dispatch.get("y", -1)) != context.y_register \
			or not ram_variant is PackedByteArray or ram_variant != _ram \
			or not stack_variant is PackedByteArray or stack_variant != _stack_page \
			or (ram_variant as PackedByteArray).slice(0x0100, 0x0200) != stack_variant \
			or int(_ram[0x0024]) != 0x1C or int(_ram[0x0025]) != 0x1D \
			or not mapper_variant is Dictionary or mapper_variant != context.mapper_state:
		return _fail("PASS receiver input sampling requires the exact live scheduler restore to slot `$05` `$D80F` from the saved `$D80C->$CB0F` wait.")
	var mapper: Dictionary = mapper_variant
	var bank_registers_variant: Variant = mapper.get("bank_registers", {})
	if int(mapper.get("fixed_bank", -1)) != 0x1E \
			or not bank_registers_variant is Dictionary \
			or int(bank_registers_variant.get(6, bank_registers_variant.get("6", -1))) != 0x1C \
			or int(bank_registers_variant.get(7, bank_registers_variant.get("7", -1))) != 0x1D:
		return _fail("PASS receiver `$D80F` restore lacks its fixed-bank `$1E` and saved task-bank `$1C/$1D` mapper proof.")
	_slot05_pass_receiver_input_wait_dispatch_pending = false
	_slot05_pass_receiver_input_wait_ready = true
	context.source_label = "ROM-byte PASS receiver live input poll at `$D80F`"
	return true


## Applies one bounded `$D80F` PASS receiver poll result to the live slot-$05
## state. The executor's RAM/stack endpoint is checked against scheduler-replayed
## ordered writes; it is never copied into scheduler memory.
func adopt_slot05_pass_receiver_input_result(entry_boundary: Dictionary,
		source_result: Dictionary, input_sample_receipt: Dictionary) -> Dictionary:
	if not _require_initialized():
		return _first_action_input_adoption_failure("Scheduler is not initialized for PASS receiver input.")
	var context: TaskContext = _contexts.get(0x05)
	var entry_ram_variant: Variant = entry_boundary.get("ram_image", PackedByteArray())
	var entry_stack_variant: Variant = entry_boundary.get("stack_page", PackedByteArray())
	var registers_variant: Variant = source_result.get("registers", {})
	var writes_variant: Variant = source_result.get("source_writes", [])
	var stack_writes_variant: Variant = source_result.get("source_stack_writes", [])
	var stack_reads_variant: Variant = source_result.get("source_stack_reads", [])
	var instructions_variant: Variant = source_result.get("source_instruction_pcs", [])
	var endpoint_variant: Variant = source_result.get("next_boundary_snapshot", {})
	if not _slot05_pass_receiver_input_wait_ready \
			or _active_task_slot != 0x05 or int(_ram[0x0000]) != 0x05 \
			or context == null or context.phase != ContextPhase.RUNNING \
			or context.program_counter != 0xD80F \
			or context.bank_low != 0x1C or context.bank_high != 0x1D \
			or int(_ram[0x0024]) != 0x1C or int(_ram[0x0025]) != 0x1D \
			or int(entry_boundary.get("slot_base", -1)) != 0x05 \
			or int(entry_boundary.get("active_task_slot", -1)) != 0x05 \
			or int(entry_boundary.get("phase", -1)) != ContextPhase.RUNNING \
			or int(entry_boundary.get("pc", -1)) != 0xD80F \
			or int(entry_boundary.get("sp", -1)) != context.stack_pointer \
			or int(entry_boundary.get("bank_low", -1)) != 0x1C \
			or int(entry_boundary.get("bank_high", -1)) != 0x1D \
			or not entry_ram_variant is PackedByteArray or entry_ram_variant != _ram \
			or not entry_stack_variant is PackedByteArray or entry_stack_variant != _stack_page \
			or (entry_ram_variant as PackedByteArray).slice(0x0100, 0x0200) != entry_stack_variant:
		return _first_action_input_adoption_failure(
			"PASS receiver input result requires the unchanged live slot-$05 `$D80F` boundary and its scheduler-owned RAM/stack snapshot.")
	for forbidden_key in ["fceux_ram", "captured_ram", "trace_ram", "emulator_snapshot",
			"screenshot", "capture_image", "entry_ram_image", "entry_stack_page"]:
		if source_result.has(forbidden_key):
			return _first_action_input_adoption_failure(
				"PASS receiver input adoption rejects emulator/capture memory and detached entry images.")
	if not bool(source_result.get("ok", false)) \
			or String(source_result.get("rom_sha256", "")) != ROM_SHA256 \
			or String(source_result.get("source_manifest", "")) != PASS_RECEIVER_INPUT_MANIFEST_PATH \
			or bool(source_result.get("trace_state_used", true)) \
			or bool(source_result.get("emulator_data_used", true)) \
			or bool(source_result.get("ppu_effects_applied", true)) \
			or bool(source_result.get("apu_effects_applied", true)) \
			or bool(source_result.get("holder_transfer_applied", true)) \
			or bool(source_result.get("source_cycle_timing_modeled", true)) \
			or bool(source_result.get("instruction_level_parity_claimed", true)) \
			or not registers_variant is Dictionary or not writes_variant is Array \
			or not stack_writes_variant is Array or not stack_reads_variant is Array \
			or not instructions_variant is Array or not endpoint_variant is Dictionary:
		return _first_action_input_adoption_failure(
			"PASS receiver result is missing pinned-ROM provenance, the bounded source contract, or ordered CPU events.")
	var receipt_id := int(input_sample_receipt.get("sample_receipt_id", -1))
	if receipt_id <= 0 or receipt_id != _controller_sample_receipt_id \
			or receipt_id <= _last_adopted_controller_sample_receipt_id \
			or not _first_action_sample_receipt_matches(input_sample_receipt):
		return _first_action_input_adoption_failure(
			"PASS receiver input result must echo the latest unused ordinary controller-sample receipt.")
	var held := int(input_sample_receipt.get("held_ram_001c", -1))
	var edge := int(input_sample_receipt.get("edge_ram_001e", -1))
	var previous := int(input_sample_receipt.get("previous", -1))
	var current := int(input_sample_receipt.get("current", -1))
	var result_status := String(source_result.get("status", ""))
	var down_result := result_status == "receiver_down_scan_stopped_at_renderer_call"
	var confirm_result := result_status == "receiver_confirmed_at_d70c_before_holder_transfer"
	if down_result:
		if held != 0x04 or edge != 0x04 or current != 0x04 \
				or (previous & 0x04) != 0 \
				or int(_ram[0x0624]) != 0x77 or int(_ram[0x0430]) != 0 \
				or int(_ram[0x0441]) != 0x06 \
				or int(source_result.get("entry_pc", -1)) != 0xD80F \
				or int(source_result.get("exit_pc", -1)) != 0xEF7F:
			return _first_action_input_adoption_failure(
				"Down adoption requires the trace-proven fresh `$001C/$001E=$04/$04` edge and the live `$77`/empty-candidate/holder-$06 state.")
	elif confirm_result:
		if held != 0x80 or edge != 0x80 or current != 0x80 \
				or (previous & 0x80) != 0 \
				or int(_ram[0x0624]) != 0x78 or int(_ram[0x0441]) != 0x06 \
				or int(_ram[0x0430]) != 1 or int(_ram[0x0431]) != 0x0A \
				or int(_ram[0x0625]) != 1 or int(_ram[0x05FC]) != 0x0A \
				or int(source_result.get("entry_pc", -1)) != 0xD80F \
				or int(source_result.get("exit_pc", -1)) != 0xD70C:
			return _first_action_input_adoption_failure(
				"Receiver confirmation requires a fresh A edge and the live `$78`/candidate-$0A state; it remains bounded at `$D70C`.")
	else:
		return _first_action_input_adoption_failure(
			"Only source-supported receiver Down or fresh-A results can be adopted at `$D80F`.")
	var source_writes: Array = writes_variant
	var source_stack_writes: Array = stack_writes_variant
	var source_instruction_pcs: Array = instructions_variant
	if not source_instruction_pcs.has(0xD80F) \
			or (down_result and (not source_instruction_pcs.has(0xD8F7) \
				or not source_instruction_pcs.has(0xD96C))) \
			or (confirm_result and (not source_instruction_pcs.has(0xD852) \
				or not source_instruction_pcs.has(0xD849) \
				or not source_instruction_pcs.has(0xD84B))):
		return _first_action_input_adoption_failure(
			"PASS receiver instruction receipt does not contain its selected ROM path.")
	var expected_ram := _ram.duplicate()
	var expected_stack := _stack_page.duplicate()
	for write_variant: Variant in source_writes:
		if not write_variant is Dictionary:
			return _first_action_input_adoption_failure("PASS receiver emitted a malformed RAM write.")
		var write: Dictionary = write_variant
		var address := int(write.get("address", -1))
		var value := int(write.get("value", -1))
		var source_pc := int(write.get("source_pc", -1))
		if address < 0 or address >= RAM_SIZE or value < 0 or value > 0xFF \
				or source_pc < 0 or int(write.get("trace_pc", -1)) != ((source_pc + 3) & 0xFFFF):
			return _first_action_input_adoption_failure("PASS receiver RAM write escaped its internal source contract.")
		expected_ram[address] = value
		if address >= 0x0100 and address < 0x0200:
			expected_stack[address & 0xFF] = value
	for write_variant: Variant in source_stack_writes:
		if not write_variant is Dictionary:
			return _first_action_input_adoption_failure("PASS receiver emitted a malformed stack write.")
		var write: Dictionary = write_variant
		var address := int(write.get("address", -1))
		var value := int(write.get("value", -1))
		if address < 0x0100 or address >= 0x0200 or value < 0 or value > 0xFF:
			return _first_action_input_adoption_failure("PASS receiver stack write escaped the live CPU stack page.")
		expected_stack[address & 0xFF] = value
		expected_ram[address] = value
	var registers: Dictionary = registers_variant
	var endpoint: Dictionary = endpoint_variant
	var endpoint_ram: Variant = endpoint.get("ram_image", PackedByteArray())
	var endpoint_stack: Variant = endpoint.get("stack_page", PackedByteArray())
	var expected_exit := 0xEF7F if down_result else 0xD70C
	if int(registers.get("pc", -1)) != expected_exit \
			or int(endpoint.get("pc", -1)) != expected_exit \
			or int(registers.get("sp", -1)) != int(endpoint.get("sp", -2)) \
			or not endpoint_ram is PackedByteArray or endpoint_ram != expected_ram \
			or not endpoint_stack is PackedByteArray or endpoint_stack != expected_stack \
			or expected_ram.slice(0x0100, 0x0200) != expected_stack \
			or int(expected_ram[0x0024]) != 0x1C or int(expected_ram[0x0025]) != 0x1D:
		return _first_action_input_adoption_failure(
			"PASS receiver endpoint differs from scheduler replay of its ordered RAM/stack events.")
	var requests_variant: Variant = source_result.get("renderer_requests", [])
	if down_result:
		if not requests_variant is Array or requests_variant.size() != 1 \
				or not requests_variant[0] is Dictionary:
			return _first_action_input_adoption_failure("Down result must expose one pending ROM renderer request.")
		var request: Dictionary = requests_variant[0]
		var request_registers: Variant = request.get("entry_registers", {})
		if int(request.get("source_pc", -1)) != 0xD96C \
				or int(request.get("callee_pc", -1)) != 0xEF7F \
				or int(request.get("descriptor_id", -1)) != 0x1D \
				or not request_registers is Dictionary \
				or int(request_registers.get("pc", -1)) != 0xEF7F \
				or int(request_registers.get("a", -1)) != 0x1D \
				or int(request_registers.get("x", -1)) != 0 \
				or int(request_registers.get("y", -1)) != int(registers.get("y", -2)):
			return _first_action_input_adoption_failure("Down result's descriptor-$1D `$D96C->$EF7F` renderer request is invalid.")
		if int(expected_ram[0x0624]) != 0x78 or int(expected_ram[0x0430]) != 1 \
				or int(expected_ram[0x0431]) != 0x0A or int(expected_ram[0x0625]) != 1 \
				or int(expected_ram[0x05FC]) != 0x0A:
			return _first_action_input_adoption_failure("Down source writes do not produce cursor `$78` and candidate `$0A`.")
	else:
		if not requests_variant is Array or not requests_variant.is_empty() \
				or int(expected_ram[0x05FC]) != 0x0A \
				or int(expected_ram[0x0638]) != 0x78 \
				or int(expected_ram[0x02FC]) != 0xF8:
			return _first_action_input_adoption_failure("A source writes do not stop at the `$D70C` receiver-confirmation state.")
	var source_mapper := context.mapper_state.duplicate(true)
	_ram = expected_ram
	_stack_page = expected_stack
	context.accumulator = int(registers.get("a", -1)) & 0xFF
	context.x_register = int(registers.get("x", -1)) & 0xFF
	context.y_register = int(registers.get("y", -1)) & 0xFF
	context.status_register = int(registers.get("p", 0x20)) | 0x20
	context.status_known_mask = int(registers.get("p_known_mask", 0)) & 0xFF
	context.stack_pointer = int(registers.get("sp", -1)) & 0xFF
	context.program_counter = expected_exit
	context.mapper_state = source_mapper
	context.source_label = "ROM-byte PASS receiver Down `$D80F->$D96C->$EF7F`; descriptor-$1D renderer request pending" \
		if down_result else "ROM-byte PASS receiver A confirmation stopped at `$D70C`; holder transfer pending"
	_slot05_pass_receiver_input_wait_ready = false
	_slot05_pass_receiver_descriptor_1d_worker_pending = down_result
	_last_adopted_controller_sample_receipt_id = receipt_id
	var next_boundary := get_task_boundary_snapshot(0x05)
	return {
		"ok": true,
		"status": "pass_receiver_down_renderer_request_adopted" if down_result \
			else "pass_receiver_confirmation_stopped_at_d70c",
		"source_exit_pc": expected_exit,
		"source_frame_label": int(source_result.get("source_frame_label", -1)),
		"sample_receipt_id": receipt_id,
		"source_writes_applied": source_writes.duplicate(true),
		"source_stack_writes_applied": source_stack_writes.duplicate(true),
		"renderer_requests": requests_variant.duplicate(true),
		"holder_transfer_executed": false,
		"fceux_full_ram_compared": false,
		"next_boundary_snapshot": next_boundary,
		"trace_state_used": false,
	}


## Adopts the ordinary-input PASS continuation after the descriptor renderer's
## ROM `$D96F` RTS and the caller's `$D837->$D70C` A branch. The fixed-bank RTS
## receipt proves the task's worker stack returned to the receiver handler;
## ordered handler writes then rebuild the final confirmation boundary.
func adopt_slot05_pass_receiver_scan_return_result(dispatch: Dictionary,
		boundary: Dictionary, worker_result: Dictionary, bridge_result: Dictionary,
		continuation_result: Dictionary, input_sample_receipt: Dictionary) -> Dictionary:
	if not _require_initialized():
		return _first_action_input_adoption_failure("Scheduler is not initialized for PASS scan-return adoption.")
	var context: TaskContext = _contexts.get(0x05)
	var boundary_ram_variant: Variant = boundary.get("ram_image", PackedByteArray())
	var boundary_stack_variant: Variant = boundary.get("stack_page", PackedByteArray())
	var worker_ram_variant: Variant = worker_result.get("ram_image", PackedByteArray())
	var worker_stack_variant: Variant = worker_result.get("stack_page", PackedByteArray())
	var worker_writes_variant: Variant = worker_result.get("writes", [])
	var bridge_ram_variant: Variant = bridge_result.get("ram_image", PackedByteArray())
	var bridge_stack_variant: Variant = bridge_result.get("stack_page", PackedByteArray())
	var bridge_boundary_variant: Variant = bridge_result.get("next_boundary_snapshot", {})
	var continuation_boundary_variant: Variant = continuation_result.get("next_boundary_snapshot", {})
	var continuation_registers_variant: Variant = continuation_result.get("registers", {})
	var bridge_receipt_variant: Variant = bridge_result.get("return_receipt", {})
	var continuation_boundary_for_images: Dictionary = continuation_boundary_variant \
		if continuation_boundary_variant is Dictionary else {}
	var continuation_ram_variant: Variant = continuation_result.get("ram_image",
		continuation_boundary_for_images.get("ram_image", PackedByteArray()))
	var continuation_stack_variant: Variant = continuation_result.get("stack_page",
		continuation_boundary_for_images.get("stack_page", PackedByteArray()))
	if not boundary_ram_variant is PackedByteArray \
			or not boundary_stack_variant is PackedByteArray \
			or not worker_ram_variant is PackedByteArray \
			or not worker_stack_variant is PackedByteArray \
			or not worker_writes_variant is Array \
			or not bridge_ram_variant is PackedByteArray \
			or not bridge_stack_variant is PackedByteArray \
			or not bridge_boundary_variant is Dictionary \
			or not continuation_ram_variant is PackedByteArray \
			or not continuation_stack_variant is PackedByteArray \
			or not continuation_boundary_variant is Dictionary \
			or not continuation_registers_variant is Dictionary \
			or not bridge_receipt_variant is Dictionary:
		return _first_action_input_adoption_failure("PASS scan-return adoption is missing its live RAM, stack, CPU, or source receipts.")
	var entry_ram: PackedByteArray = boundary_ram_variant
	var entry_stack: PackedByteArray = boundary_stack_variant
	var worker_ram: PackedByteArray = worker_ram_variant
	var worker_stack: PackedByteArray = worker_stack_variant
	var worker_writes: Array = worker_writes_variant
	var bridge_ram: PackedByteArray = bridge_ram_variant
	var bridge_stack: PackedByteArray = bridge_stack_variant
	var continuation_ram: PackedByteArray = continuation_ram_variant
	var continuation_stack: PackedByteArray = continuation_stack_variant
	var continuation_boundary: Dictionary = continuation_boundary_variant
	var registers: Dictionary = continuation_registers_variant
	var bridge_receipt: Dictionary = bridge_receipt_variant
	if _active_task_slot != 0x05 or int(_ram[0x0000]) != 0x05 \
			or context == null or context.phase != ContextPhase.RUNNING \
			or context.program_counter != 0x8889 \
			or int(dispatch.get("slot_base", -1)) != 0x05 \
			or String(dispatch.get("resume_path", "")) != "yielded_rts" \
			or int(dispatch.get("pc", -1)) != 0x8889 \
			or int(dispatch.get("bank_low", -1)) != 0x18 \
			or int(dispatch.get("bank_high", -1)) != 0x19 \
			or int(boundary.get("slot_base", -1)) != 0x05 \
			or int(boundary.get("active_task_slot", -1)) != 0x05 \
			or int(boundary.get("pc", -1)) != 0x8889 \
			or entry_ram.size() != RAM_SIZE or entry_stack.size() != STACK_PAGE_SIZE \
			or _ram != entry_ram or _stack_page != entry_stack \
			or entry_ram.slice(0x0100, 0x0200) != entry_stack:
		return _first_action_input_adoption_failure("PASS scan-return adoption requires the unchanged live slot-$05 `$8889` dispatch boundary.")
	if String(worker_result.get("rom_sha256", "")) != ROM_SHA256 \
			or String(worker_result.get("source_manifest", "")) != "res://reference/rom_extract/gameplay/fresh_bank18_worker_prefix/manifest.json" \
			or String(worker_result.get("source_manifest_sha256", "")) != FRESH_BANK18_WORKER_MANIFEST_SHA256 \
			or bool(worker_result.get("ok", true)) \
			or String(worker_result.get("exit_kind", "")) != "unresolved_source_span" \
			or int(worker_result.get("exit_pc", -1)) != 0xD96F \
			or String(bridge_result.get("status", "")) != "pass_receiver_scan_returned_to_d837" \
			or String(bridge_result.get("rom_sha256", "")) != ROM_SHA256 \
			or String(bridge_result.get("source_manifest", "")) != PASS_RECEIVER_INPUT_MANIFEST_PATH \
			or String(bridge_result.get("source_manifest_sha256", "")) != PASS_RECEIVER_INPUT_MANIFEST_SHA256 \
			or int(bridge_result.get("entry_pc", -1)) != 0xD96F \
			or int(bridge_result.get("exit_pc", -1)) != 0xD837 \
			or int(bridge_receipt.get("opcode", -1)) != 0x60 \
			or int(bridge_receipt.get("target_pc", -1)) != 0xD837 \
			or bridge_receipt.get("consumed_return_word", PackedByteArray()) != PackedByteArray([0x36, 0xD8]) \
			or bridge_receipt.get("stale_renderer_return_word", PackedByteArray()) != PackedByteArray([0x6E, 0xD9]):
		return _first_action_input_adoption_failure("PASS scan-return receipt does not prove the unchanged `$D96F->$D837` ROM RTS boundary.")
	var expected_worker_ram := entry_ram.duplicate()
	var expected_worker_stack := entry_stack.duplicate()
	for write_variant: Variant in worker_writes:
		if not write_variant is Dictionary:
			return _first_action_input_adoption_failure("PASS receiver worker source writes contain a malformed event.")
		var write: Dictionary = write_variant
		var address := int(write.get("address", -1))
		var value := int(write.get("value", -1))
		if address < 0 or address >= RAM_SIZE or value < 0 or value > 0xFF:
			return _first_action_input_adoption_failure("PASS receiver worker source write escaped RAM.")
		expected_worker_ram[address] = value
		if address >= 0x0100 and address < 0x0200:
			expected_worker_stack[address & 0xFF] = value
	if worker_ram != expected_worker_ram or worker_stack != expected_worker_stack \
			or worker_ram.slice(0x0100, 0x0200) != worker_stack \
			or bridge_ram != worker_ram or bridge_stack != worker_stack:
		return _first_action_input_adoption_failure("PASS receiver worker/RTS RAM or stack differs from replaying its source writes over the live dispatch.")
	var continuation_instructions_variant: Variant = continuation_result.get("source_instruction_pcs", [])
	if String(continuation_result.get("status", "")) != "receiver_confirmed_at_d70c_from_renderer_return" \
			or String(continuation_result.get("rom_sha256", "")) != ROM_SHA256 \
			or String(continuation_result.get("source_manifest", "")) != PASS_RECEIVER_INPUT_MANIFEST_PATH \
			or bool(continuation_result.get("trace_state_used", true)) \
			or bool(continuation_result.get("emulator_data_used", true)) \
			or int(continuation_result.get("entry_pc", -1)) != 0xD837 \
			or int(continuation_result.get("exit_pc", -1)) != 0xD70C \
			or int(continuation_boundary.get("pc", -1)) != 0xD70C \
			or continuation_ram.size() != RAM_SIZE or continuation_stack.size() != STACK_PAGE_SIZE \
			or not continuation_instructions_variant is Array \
			or not continuation_instructions_variant.has(0xD837) \
			or not continuation_instructions_variant.has(0xD846) \
			or not continuation_instructions_variant.has(0xD852):
		return _first_action_input_adoption_failure("PASS scan-return handler result is not the supported ROM `$D837->$D70C` A path.")
	var receipt_id := int(input_sample_receipt.get("sample_receipt_id", -1))
	var sampled_pad_state := int(input_sample_receipt.get("current", -1))
	if receipt_id <= 0 or receipt_id != _controller_sample_receipt_id \
			or receipt_id <= _last_adopted_controller_sample_receipt_id \
			or not _first_action_sample_receipt_matches(input_sample_receipt) \
			or sampled_pad_state != 0x80 \
			or int(input_sample_receipt.get("held_ram_001c", -1)) != sampled_pad_state \
			or int(input_sample_receipt.get("edge_ram_001e", -1)) != 0x80 \
			or int(input_sample_receipt.get("newly_pressed", -1)) != 0x80 \
			or (int(input_sample_receipt.get("previous", 0)) & 0x80) != 0:
		return _first_action_input_adoption_failure("PASS scan-return confirmation requires the latest unused fresh A receipt with `$001C=$80` and `$001E=$80`.")
	var source_writes_variant: Variant = continuation_result.get("source_writes", [])
	var source_stack_writes_variant: Variant = continuation_result.get("source_stack_writes", [])
	if not source_writes_variant is Array or not source_stack_writes_variant is Array:
		return _first_action_input_adoption_failure("PASS scan-return handler omitted ordered RAM or stack writes.")
	var expected_ram := bridge_ram.duplicate()
	var expected_stack := bridge_stack.duplicate()
	for write_variant: Variant in source_writes_variant:
		if not write_variant is Dictionary:
			return _first_action_input_adoption_failure("PASS scan-return handler contains a malformed RAM write.")
		var write: Dictionary = write_variant
		var address := int(write.get("address", -1))
		var value := int(write.get("value", -1))
		var source_pc := int(write.get("source_pc", -1))
		if address < 0 or address >= RAM_SIZE or value < 0 or value > 0xFF \
				or not continuation_instructions_variant.has(source_pc) \
				or int(write.get("trace_pc", -1)) != ((source_pc + 3) & 0xFFFF):
			return _first_action_input_adoption_failure("PASS scan-return handler RAM write has no executed ROM-instruction receipt.")
		expected_ram[address] = value
		if address >= 0x0100 and address < 0x0200:
			expected_stack[address & 0xFF] = value
	for write_variant: Variant in source_stack_writes_variant:
		if not write_variant is Dictionary:
			return _first_action_input_adoption_failure("PASS scan-return handler contains a malformed stack write.")
		var write: Dictionary = write_variant
		var address := int(write.get("address", -1))
		var value := int(write.get("value", -1))
		if address < 0x0100 or address >= 0x0200 or value < 0 or value > 0xFF:
			return _first_action_input_adoption_failure("PASS scan-return handler stack write escaped the live CPU stack page.")
		expected_stack[address & 0xFF] = value
		expected_ram[address] = value
	if continuation_ram != expected_ram or continuation_stack != expected_stack \
			or continuation_ram.slice(0x0100, 0x0200) != continuation_stack \
			or int(expected_ram[0x05FC]) != 0x0A \
			or int(expected_ram[0x0638]) != 0x78 \
			or int(expected_ram[0x02FC]) != 0xF8:
		return _first_action_input_adoption_failure("PASS scan-return handler endpoint differs from replayed source writes or the selected receiver state.")
	var bridge_boundary: Dictionary = bridge_boundary_variant
	var mapper_variant: Variant = bridge_boundary.get("mapper", {})
	if not mapper_variant is Dictionary \
			or int(registers.get("pc", -1)) != 0xD70C \
			or int(registers.get("sp", -1)) != int(continuation_boundary.get("sp", -2)) \
			or int(continuation_boundary.get("sp", -1)) != int(bridge_boundary.get("sp", -2)) \
			or continuation_boundary.get("ram_image", PackedByteArray()) != expected_ram \
			or continuation_boundary.get("stack_page", PackedByteArray()) != expected_stack:
		return _first_action_input_adoption_failure("PASS scan-return endpoint CPU or boundary does not match its source writes and popped RTS frame.")
	var mapper: Dictionary = mapper_variant
	_ram = expected_ram
	_stack_page = expected_stack
	context.accumulator = int(registers.get("a", -1)) & 0xFF
	context.x_register = int(registers.get("x", -1)) & 0xFF
	context.y_register = int(registers.get("y", -1)) & 0xFF
	context.status_register = (int(registers.get("p", 0x20)) | 0x20) & 0xFF
	context.status_known_mask = int(registers.get("p_known_mask", 0)) & 0xFF
	context.stack_pointer = int(registers.get("sp", -1)) & 0xFF
	context.program_counter = 0xD70C
	context.bank_low = int(mapper.get("bank_low", -1))
	context.bank_high = int(mapper.get("bank_high", -1))
	context.mapper_state = mapper.duplicate(true)
	context.source_label = "ROM-byte PASS receiver A confirmation `$D96F->$D837->$D70C`; holder transfer pending"
	_slot05_pass_receiver_input_wait_ready = false
	_slot05_pass_receiver_descriptor_1d_worker_pending = false
	_last_adopted_controller_sample_receipt_id = receipt_id
	return {"ok": true, "status": "pass_receiver_confirmation_stopped_at_d70c",
		"source_exit_pc": 0xD70C,
		"source_frame_label": int(continuation_result.get("source_frame_label", -1)),
		"sample_receipt_id": receipt_id,
		"scan_return_receipt": bridge_receipt.duplicate(true),
		"source_writes_applied": source_writes_variant.duplicate(true),
		"source_stack_writes_applied": source_stack_writes_variant.duplicate(true),
		"holder_transfer_executed": false,
		"next_boundary_snapshot": get_task_boundary_snapshot(0x05),
		"trace_state_used": false}


## Adopts the shared descriptor-$1D renderer's source-byte execution from the
## live `$EF7F` Down call through its first `$8886->$C515` yield. RAM, stack,
## and MMC3 state are reconstructed from ordered writes; no endpoint image is
## copied from the worker.
func adopt_slot05_pass_receiver_descriptor_1d_first_yield(boundary: Dictionary,
		down_result: Dictionary, worker_result: Dictionary) -> Dictionary:
	if not _require_initialized():
		return _first_action_input_adoption_failure("Scheduler is not initialized for descriptor-$1D adoption.")
	var context: TaskContext = _contexts.get(0x05)
	var boundary_ram_variant: Variant = boundary.get("ram_image", PackedByteArray())
	var boundary_stack_variant: Variant = boundary.get("stack_page", PackedByteArray())
	var boundary_mapper_variant: Variant = boundary.get("mapper", {})
	var down_boundary_variant: Variant = down_result.get("next_boundary_snapshot", {})
	var result_ram_variant: Variant = worker_result.get("ram_image", PackedByteArray())
	var result_stack_variant: Variant = worker_result.get("stack_page", PackedByteArray())
	var result_mapper_variant: Variant = worker_result.get("mapper", {})
	var registers_variant: Variant = worker_result.get("registers", {})
	var writes_variant: Variant = worker_result.get("writes", [])
	var mapper_writes_variant: Variant = worker_result.get("mapper_writes", [])
	var calls_variant: Variant = worker_result.get("calls", [])
	var spans_variant: Variant = worker_result.get("executed_source_spans", [])
	var down_entry_sp := int(down_result.get("entry_sp", -1))
	var down_final_sp := int(down_result.get("final_sp", -1))
	var down_boundary: Dictionary = down_boundary_variant if down_boundary_variant is Dictionary else {}
	var down_registers_variant: Variant = down_result.get("registers", {})
	var down_source_y := int((down_registers_variant as Dictionary).get("y", -1)) \
		if down_registers_variant is Dictionary else -1
	var down_bank_low := int(down_boundary.get("bank_low", -1))
	var down_bank_high := int(down_boundary.get("bank_high", -1))
	var down_mapper_variant: Variant = down_boundary.get("mapper", {})
	var mapper: Dictionary = boundary_mapper_variant if boundary_mapper_variant is Dictionary else {}
	var bank_registers_variant: Variant = mapper.get("bank_registers", {})
	var pointer_variant: Variant = worker_result.get("descriptor_source", {})
	var pointer: Dictionary = pointer_variant if pointer_variant is Dictionary else {}
	var sample_receipt_id := int(down_result.get("sample_receipt_id", -1))
	if not _slot05_pass_receiver_descriptor_1d_worker_pending \
			or _active_task_slot != 0x05 or context == null \
			or not down_boundary_variant is Dictionary \
			or context.phase != ContextPhase.RUNNING or context.program_counter != 0xEF7F \
			or context.bank_low != down_bank_low or context.bank_high != down_bank_high \
			or int(_ram[0x0000]) != 0x05 \
			or int(boundary.get("slot_base", -1)) != 0x05 \
			or int(boundary.get("active_task_slot", -1)) != 0x05 \
			or int(boundary.get("phase", -1)) != ContextPhase.RUNNING \
			or int(boundary.get("pc", -1)) != 0xEF7F \
			or int(boundary.get("a", -1)) != 0x1D \
			or int(boundary.get("x", -1)) != 0 \
			or int(boundary.get("y", -1)) != down_source_y \
			or not _pass_receiver_down_scan_y_source_matches(down_result, down_source_y) \
			or down_entry_sp < 4 or down_final_sp != down_entry_sp - 4 \
			or int(boundary.get("sp", -1)) != down_final_sp \
			or int((down_boundary_variant as Dictionary).get("sp", -1)) != down_final_sp \
			or context.stack_pointer != down_final_sp \
			or int(boundary.get("bank_low", -1)) != down_bank_low \
			or int(boundary.get("bank_high", -1)) != down_bank_high \
			or int(boundary.get("phase", -1)) != int(down_boundary.get("phase", -2)) \
			or not boundary_mapper_variant is Dictionary or mapper != context.mapper_state \
			or not down_mapper_variant is Dictionary \
			or not _pass_receiver_descriptor_1d_mapper_proof_matches(mapper,
				down_mapper_variant as Dictionary, down_bank_low, down_bank_high) \
			or int(mapper.get("fixed_bank", -1)) != 0x1E \
			or not bank_registers_variant is Dictionary \
			or int((bank_registers_variant as Dictionary).get(6,
				(bank_registers_variant as Dictionary).get("6", -1))) != down_bank_low \
			or int((bank_registers_variant as Dictionary).get(7,
				(bank_registers_variant as Dictionary).get("7", -1))) != down_bank_high \
			or not boundary_ram_variant is PackedByteArray or boundary_ram_variant != _ram \
			or not boundary_stack_variant is PackedByteArray or boundary_stack_variant != _stack_page \
			or (down_boundary_variant as Dictionary).get("ram_image", PackedByteArray()) != boundary_ram_variant \
			or (down_boundary_variant as Dictionary).get("stack_page", PackedByteArray()) != boundary_stack_variant \
			or String(down_result.get("status", "")) != "receiver_down_scan_stopped_at_renderer_call" \
			or String(down_result.get("rom_sha256", "")) != ROM_SHA256 \
			or sample_receipt_id <= 0 or sample_receipt_id != _last_adopted_controller_sample_receipt_id \
			or int(down_result.get("source_frame_label", -1)) < 0 \
			or int(boundary_ram_variant[0x0624]) != 0x78 \
			or int(boundary_ram_variant[0x0430]) != 1 \
			or int(boundary_ram_variant[0x0431]) != 0x0A \
			or int(boundary_ram_variant[0x05FC]) != 0x0A \
			or not _pass_receiver_down_jsr_stack_proof_matches(down_result,
				boundary_stack_variant, down_entry_sp, down_final_sp) \
			or int(boundary_ram_variant[0x0024]) != down_bank_low \
			or int(boundary_ram_variant[0x0025]) != down_bank_high:
		return _first_action_input_adoption_failure(
			"Descriptor-$1D adoption requires the one-use ordinary Down result, exact live slot-$05 `$EF7F` `$1D/0/source-Y`, two dynamically validated JSR frames, mapper, and RAM.")
	for forbidden_key in ["fceux_ram", "captured_ram", "trace_ram_image", "emulator_snapshot", "screenshot"]:
		if boundary.has(forbidden_key) or down_result.has(forbidden_key) or worker_result.has(forbidden_key):
			return _first_action_input_adoption_failure("Emulator captures cannot seed descriptor-$1D worker adoption.")
	if not bool(worker_result.get("ok", false)) \
			or String(worker_result.get("status", "")) != "pass_receiver_descriptor_1d_first_yield" \
			or String(worker_result.get("rom_sha256", "")) != ROM_SHA256 \
			or String(worker_result.get("source_manifest", "")) != "res://reference/rom_extract/gameplay/fresh_bank18_worker_prefix/manifest.json" \
			or String(worker_result.get("source_manifest_sha256", "")) != FRESH_BANK18_WORKER_MANIFEST_SHA256 \
			or String(worker_result.get("descriptor_source_manifest", "")) != "res://reference/rom_extract/gameplay/menus/pass_receiver_down_menu/manifest.json" \
			or String(worker_result.get("descriptor_source_manifest_sha256", "")) != "a992da14cb1ed1aede98098928a1f496949ab0927b479190e393cc8883d0a7aa" \
			or int(worker_result.get("entry_pc", -1)) != 0xEF7F \
			or int(worker_result.get("entry_bank", -1)) != 0x1E \
			or String(worker_result.get("entry_source_label", "")) != String(boundary.get("source_label", "")) \
			or int(worker_result.get("input_sample_receipt_id", -1)) != sample_receipt_id \
			or int(worker_result.get("source_frame_label", -1)) != int(down_result.get("source_frame_label", -2)) \
			or int(worker_result.get("exit_pc", -1)) != 0xC515 \
			or int(worker_result.get("exit_bank", -1)) != 0x1E \
			or not bool(worker_result.get("route_boundary_observed", false)) \
			or not bool(worker_result.get("source_execution_executed", false)) \
			or not bool(worker_result.get("renderer_source_executed", false)) \
			or bool(worker_result.get("descriptor_body_executed", true)) \
			or bool(worker_result.get("descriptor_text_rows_executed", true)) \
			or bool(worker_result.get("trace_state_used", true)) \
			or bool(worker_result.get("scheduler_yield_executed", true)) \
			or bool(worker_result.get("nmi_queue_consumed", true)) \
			or bool(worker_result.get("ppu_packet_applied", true)):
		return _first_action_input_adoption_failure("Descriptor-$1D worker result is not the pinned live `$EF7F->$C515` source execution.")
	if not result_ram_variant is PackedByteArray or not result_stack_variant is PackedByteArray \
			or not result_mapper_variant is Dictionary or not registers_variant is Dictionary \
			or not writes_variant is Array or not mapper_writes_variant is Array \
			or not calls_variant is Array or not spans_variant is Array \
			or not bool(pointer.get("pointer_read_by_source", false)) \
			or bool(pointer.get("descriptor_read_by_source", true)) \
			or pointer.get("pointer_table_entry", -1) != 0xB409 \
			or pointer.get("descriptor_pointer", -1) != 0xB6C7 \
			or pointer.get("pointer_bytes", []) != [0xC7, 0xB6]:
		return _first_action_input_adoption_failure("Descriptor-$1D worker omitted its executed pointer, descriptor, ordered writes, or CPU state.")
	var descriptor_rows_variant: Variant = pointer.get("text_rows_read_by_source", [])
	if not descriptor_rows_variant is Array or not (descriptor_rows_variant as Array).is_empty():
		return _first_action_input_adoption_failure("Descriptor-$1D `$C515` first-yield receipt must precede descriptor-body and text-row reads.")
	var result_ram: PackedByteArray = result_ram_variant
	var result_stack: PackedByteArray = result_stack_variant
	var result_mapper: Dictionary = result_mapper_variant
	var registers: Dictionary = registers_variant
	var calls: Array = calls_variant
	var observed_calls: Array = []
	for call_variant: Variant in calls:
		if call_variant is Dictionary:
			var call: Dictionary = call_variant
			observed_calls.append([int(call.get("callsite", -1)), int(call.get("target", -1))])
	var c515_sp := int(registers.get("sp", -1))
	if result_ram.size() != RAM_SIZE or result_stack.size() != STACK_PAGE_SIZE \
			or result_ram.slice(0x0100, 0x0200) != result_stack \
			or int(registers.get("pc", -1)) != 0xC515 \
			or int(result_mapper.get("bank_low", -1)) != 0x18 \
			or int(result_mapper.get("bank_high", -1)) != 0x19 \
			or int(result_mapper.get("select", -1)) != 0x07 \
			or int(result_ram[0x0050]) != 0xC7 or int(result_ram[0x0051]) != 0xB6 \
			or c515_sp < 0 or c515_sp > 0xFF \
			or int(result_stack[(c515_sp + 1) & 0xFF]) != 0x88 \
			or int(result_stack[(c515_sp + 2) & 0xFF]) != 0x88 \
			or not observed_calls.has([0xEF92, 0xCE2D]) \
			or not observed_calls.has([0xEF96, 0x800C]) \
			or not observed_calls.has([0x8886, 0xC515]):
		return _first_action_input_adoption_failure("Descriptor-$1D worker differs from the ROM `$B409->$B6C7` / `$8886->$C515` CPU and mapper signature.")
	var replay := _replay_actor_source_writes(writes_variant, [], _ram, _stack_page)
	if not bool(replay.get("ok", false)) \
			or replay.get("ram_image", PackedByteArray()) != result_ram \
			or replay.get("stack_page", PackedByteArray()) != result_stack:
		return _first_action_input_adoption_failure("Descriptor-$1D endpoint differs from replaying ordered ROM RAM/stack writes: " + String(replay.get("reason", "endpoint mismatch")))
	var mapper_replay := _replay_actor_source_mapper_writes(mapper_writes_variant,
			context.bank_low, context.bank_high, result_mapper,
			int(mapper.get("select", mapper.get("register_select", -1))))
	if not bool(mapper_replay.get("ok", false)):
		return _first_action_input_adoption_failure("Descriptor-$1D endpoint differs from replaying ordered MMC3 writes: " + String(mapper_replay.get("reason", "mapper mismatch")))
	for write_variant: Variant in writes_variant:
		var write: Dictionary = write_variant
		var address := int(write.get("address", -1))
		_ram[address] = int(write.get("value", -1))
		if address >= 0x0100 and address < 0x0200:
			_stack_page[address & 0xFF] = int(write.get("value", -1))
	var next_mapper := context.mapper_state.duplicate(true)
	var bank_registers_copy_variant: Variant = next_mapper.get("bank_registers", {})
	var bank_registers_copy: Dictionary = bank_registers_copy_variant.duplicate(true) \
			if bank_registers_copy_variant is Dictionary else {}
	bank_registers_copy[6] = int(result_mapper["bank_low"])
	bank_registers_copy[7] = int(result_mapper["bank_high"])
	next_mapper["bank_registers"] = bank_registers_copy
	next_mapper["bank_low"] = int(result_mapper["bank_low"])
	next_mapper["bank_high"] = int(result_mapper["bank_high"])
	next_mapper["select"] = int(result_mapper["select"])
	next_mapper["register_select"] = int(result_mapper["select"])
	next_mapper["register_pair_provenance"] = "ROM-byte PASS descriptor-$1D worker `$EF7F->$C515`"
	context.accumulator = int(registers.get("a", context.accumulator)) & 0xFF
	context.x_register = int(registers.get("x", context.x_register)) & 0xFF
	context.y_register = int(registers.get("y", context.y_register)) & 0xFF
	context.status_register = int(registers.get("p", context.status_register)) & 0xFF
	context.status_known_mask = int(registers.get("p_known_mask", context.status_known_mask)) & 0xFF
	context.stack_pointer = c515_sp
	context.program_counter = 0xC515
	context.bank_low = int(result_mapper["bank_low"])
	context.bank_high = int(result_mapper["bank_high"])
	context.mapper_state = next_mapper
	context.source_label = "ROM-byte PASS descriptor-$1D first worker yield `$EF7F->$800C->$8886->$C515`; queue/NMI pending"
	_slot05_pass_receiver_descriptor_1d_worker_pending = false
	return {"ok": true, "status": "pass_receiver_descriptor_1d_first_yield_adopted",
		"source_exit_pc": 0xC515, "source_frame_label": int(down_result.get("source_frame_label", -1)),
		"sample_receipt_id": sample_receipt_id,
		"c515_receipt": {"pc": int(registers.get("pc", -1)), "bank": int(worker_result.get("exit_bank", -1)),
			"sp": c515_sp, "stack_return": [int(result_stack[(c515_sp + 1) & 0xFF]),
				int(result_stack[(c515_sp + 2) & 0xFF])],
			"mapper": result_mapper.duplicate(true),
			"queue_0515_0518": result_ram.slice(0x0515, 0x0519),
			"descriptor_source": pointer.duplicate(true), "calls": observed_calls.duplicate(true)},
		"executed_source_spans": spans_variant.duplicate(true),
		"source_writes_applied": writes_variant.duplicate(true),
		"source_mapper_writes_applied": mapper_writes_variant.duplicate(true),
		"renderer_returned": false, "nmi_queue_consumed": false,
		"ppu_packet_applied": false, "trace_state_used": false,
		"next_boundary_snapshot": get_task_boundary_snapshot(0x05)}


func _pass_receiver_descriptor_1d_mapper_proof_matches(scheduler_mapper: Dictionary,
		down_mapper: Dictionary, active_bank_low: int, active_bank_high: int) -> bool:
	if active_bank_low < 0 or active_bank_high < 0:
		return false
	for candidate in [scheduler_mapper, down_mapper]:
		if int(candidate.get("fixed_bank", -1)) != 0x1E \
				or int(candidate.get("bank_low", -1)) != active_bank_low \
				or int(candidate.get("bank_high", -1)) != active_bank_high \
				or int(candidate.get("select", candidate.get("register_select", -1))) != 0x07 \
				or int(candidate.get("register_select", candidate.get("select", -1))) != 0x07:
			return false
		var registers_variant: Variant = candidate.get("bank_registers", {})
		if not registers_variant is Dictionary:
			return false
		var registers: Dictionary = registers_variant
		if int(registers.get(6, registers.get("6", -1))) != active_bank_low \
				or int(registers.get(7, registers.get("7", -1))) != active_bank_high:
			return false
	for mapped_field in ["cpu_c000_bank", "cpu_e000_bank"]:
		if scheduler_mapper.has(mapped_field) and down_mapper.has(mapped_field) \
				and int(scheduler_mapper[mapped_field]) != int(down_mapper[mapped_field]):
			return false
		if scheduler_mapper.has(mapped_field):
			var scheduler_expected := 0x1E if mapped_field == "cpu_c000_bank" else 0x1F
			if int(scheduler_mapper[mapped_field]) != scheduler_expected:
				return false
		if down_mapper.has(mapped_field):
			var down_expected := 0x1E if mapped_field == "cpu_c000_bank" else 0x1F
			if int(down_mapper[mapped_field]) != down_expected:
				return false
	return true


func _pass_receiver_down_jsr_stack_proof_matches(down_result: Dictionary,
		stack_variant: Variant, entry_sp: int, final_sp: int) -> bool:
	if not stack_variant is PackedByteArray or entry_sp < 4 or entry_sp > 0xFF \
			or final_sp != entry_sp - 4 or final_sp > 0xFB:
		return false
	var stack: PackedByteArray = stack_variant
	if stack.size() != 0x100 \
			or int(stack[final_sp + 1]) != 0x6E or int(stack[final_sp + 2]) != 0xD9 \
			or int(stack[final_sp + 3]) != 0x36 or int(stack[final_sp + 4]) != 0xD8:
		return false
	var writes_variant: Variant = down_result.get("source_stack_writes", [])
	if not writes_variant is Array:
		return false
	var writes: Array = writes_variant
	if writes.size() < 6:
		return false
	return _pass_receiver_jsr_stack_write_matches(writes[0], 0xD834, 0xD8F7,
		0x0100 + entry_sp, 0xD8, "jsr_push_high") \
		and _pass_receiver_jsr_stack_write_matches(writes[1], 0xD834, 0xD8F7,
		0x0100 + entry_sp - 1, 0x36, "jsr_push_low") \
		and _pass_receiver_jsr_stack_write_matches(writes[writes.size() - 2],
			0xD96C, 0xEF7F, 0x0100 + final_sp + 2, 0xD9, "jsr_push_high") \
		and _pass_receiver_jsr_stack_write_matches(writes[writes.size() - 1],
			0xD96C, 0xEF7F, 0x0100 + final_sp + 1, 0x6E, "jsr_push_low")


func _pass_receiver_down_scan_y_source_matches(down_result: Dictionary,
		source_y: int) -> bool:
	if source_y < 0 or source_y > 0xFF:
		return false
	var reads_variant: Variant = down_result.get("source_reads", [])
	var instruction_pcs_variant: Variant = down_result.get("source_instruction_pcs", [])
	var boundary_variant: Variant = down_result.get("next_boundary_snapshot", {})
	var request_variant: Variant = down_result.get("renderer_requests", [])
	if not reads_variant is Array or not instruction_pcs_variant is Array \
			or not boundary_variant is Dictionary or not request_variant is Array \
			or request_variant.size() != 1 or not request_variant[0] is Dictionary:
		return false
	var expected_tail := [0xD949, 0xD94C, 0xD954, 0xD957, 0xD961,
		0xD962, 0xD964, 0xD967, 0xD96A, 0xD96C]
	var instruction_pcs: Array = instruction_pcs_variant
	if instruction_pcs.size() < expected_tail.size():
		return false
	for index in expected_tail.size():
		if int(instruction_pcs[instruction_pcs.size() - expected_tail.size() + index]) \
				!= expected_tail[index]:
			return false
	var last_y_read: Dictionary = {}
	for read_variant: Variant in reads_variant:
		if read_variant is Dictionary \
				and int((read_variant as Dictionary).get("source_pc", -1)) == 0xD918:
			last_y_read = read_variant
	if last_y_read.is_empty():
		return false
	var address := int(last_y_read.get("address", -1))
	var ram_variant: Variant = (boundary_variant as Dictionary).get("ram_image", PackedByteArray())
	var down_registers_variant: Variant = down_result.get("registers", {})
	var request: Dictionary = request_variant[0]
	var request_registers_variant: Variant = request.get("entry_registers", {})
	if not ram_variant is PackedByteArray or not down_registers_variant is Dictionary \
			or not request_registers_variant is Dictionary:
		return false
	var ram: PackedByteArray = ram_variant
	return int(last_y_read.get("value", -1)) == source_y \
		and address >= 0x0308 and address < ram.size() \
		and int(ram[address]) == source_y \
		and int((down_registers_variant as Dictionary).get("y", -1)) == source_y \
		and int((boundary_variant as Dictionary).get("y", -1)) == source_y \
		and int((request_registers_variant as Dictionary).get("y", -1)) == source_y \
		and int(request.get("source_pc", -1)) == 0xD96C \
		and int(request.get("callee_pc", -1)) == 0xEF7F \
		and int(request.get("descriptor_id", -1)) == 0x1D


func _pass_receiver_jsr_stack_write_matches(write_variant: Variant, source_pc: int,
		target_pc: int, address: int, value: int, operation: String) -> bool:
	if not write_variant is Dictionary:
		return false
	var write: Dictionary = write_variant
	return int(write.get("source_pc", -1)) == source_pc \
		and int(write.get("target_pc", -1)) == target_pc \
		and int(write.get("address", -1)) == address \
		and int(write.get("value", -1)) == value \
		and String(write.get("operation", "")) == operation


func adopt_slot05_pass_confirmation_wait_callsite(boundary: Dictionary,
		waiter_result: Dictionary) -> bool:
	if not _require_initialized():
		return false
	var context: TaskContext = _contexts.get(0x05)
	var entry_ram_variant: Variant = boundary.get("ram_image", PackedByteArray())
	var entry_stack_variant: Variant = boundary.get("stack_page", PackedByteArray())
	var boundary_mapper_variant: Variant = boundary.get("mapper", {})
	var result_boundary_variant: Variant = waiter_result.get("next_boundary_snapshot", {})
	var result_ram_variant: Variant = (result_boundary_variant as Dictionary).get("ram_image", PackedByteArray()) \
		if result_boundary_variant is Dictionary else PackedByteArray()
	var result_stack_variant: Variant = (result_boundary_variant as Dictionary).get("stack_page", PackedByteArray()) \
		if result_boundary_variant is Dictionary else PackedByteArray()
	var result_mapper_variant: Variant = (result_boundary_variant as Dictionary).get("mapper", {}) \
		if result_boundary_variant is Dictionary else {}
	var registers_variant: Variant = waiter_result.get("registers", {})
	var writes_variant: Variant = waiter_result.get("source_writes", [])
	var stack_writes_variant: Variant = waiter_result.get("source_stack_writes", [])
	var instructions_variant: Variant = waiter_result.get("source_instruction_pcs", [])
	var calls_variant: Variant = waiter_result.get("calls", [])
	var call_request_variant: Variant = waiter_result.get("call_request", {})
	if context == null or _active_task_slot != 0x05 \
			or context.phase != ContextPhase.RUNNING or context.program_counter != 0xD70C \
			or context.bank_low != 0x1C or context.bank_high != 0x1D \
			or int(_ram[0x0000]) != 0x05 \
			or int(boundary.get("slot_base", -1)) != 0x05 \
			or int(boundary.get("active_task_slot", -1)) != 0x05 \
			or int(boundary.get("phase", -1)) != ContextPhase.RUNNING \
			or int(boundary.get("pc", -1)) != 0xD70C \
			or int(boundary.get("sp", -1)) != context.stack_pointer \
			or int(boundary.get("bank_low", -1)) != 0x1C \
			or int(boundary.get("bank_high", -1)) != 0x1D \
			or not entry_ram_variant is PackedByteArray or entry_ram_variant != _ram \
			or not entry_stack_variant is PackedByteArray or entry_stack_variant != _stack_page \
			or (entry_ram_variant as PackedByteArray).slice(0x0100, 0x0200) != entry_stack_variant \
			or not boundary_mapper_variant is Dictionary \
			or boundary_mapper_variant != context.mapper_state \
			or int((entry_ram_variant as PackedByteArray)[0x0000]) != 0x05 \
			or int((entry_ram_variant as PackedByteArray)[0x0441]) != 0x06 \
			or int((entry_ram_variant as PackedByteArray)[0x05FC]) != 0x0A \
			or int((entry_ram_variant as PackedByteArray)[0x0638]) != 0x78 \
			or int((entry_ram_variant as PackedByteArray)[0x062D]) != 0x81 \
			or int((entry_ram_variant as PackedByteArray)[0x0024]) != 0x1C \
			or int((entry_ram_variant as PackedByteArray)[0x0025]) != 0x1D \
			or bool(boundary.get("trace_state_used", true)) \
			or bool(boundary.get("test_fixture", false)) \
			or not String(boundary.get("source_label", "")).begins_with("ROM-byte PASS receiver A confirmation"):
		return _fail("PASS confirmation-wait adoption requires the live scheduler-owned `$D70C` boundary after the ordinary A result.")
	for forbidden_key in ["fceux_ram", "captured_ram", "trace_ram_image", "emulator_snapshot", "screenshot"]:
		if boundary.has(forbidden_key) or waiter_result.has(forbidden_key):
			return _fail("Emulator/trace state cannot seed the ROM-byte PASS confirmation waiter.")
	var mapper: Dictionary = boundary_mapper_variant
	var mapper_result: Dictionary = result_mapper_variant if result_mapper_variant is Dictionary else {}
	var registers: Dictionary = registers_variant if registers_variant is Dictionary else {}
	var call_request: Dictionary = call_request_variant if call_request_variant is Dictionary else {}
	var entry_sp := int(boundary.get("sp", -1))
	if not bool(waiter_result.get("ok", false)) \
			or String(waiter_result.get("status", "")) != "pass_confirmation_wait_callsite_ready" \
			or String(waiter_result.get("rom_sha256", "")) != ROM_SHA256 \
			or String(waiter_result.get("source_manifest", "")) != "res://reference/rom_extract/gameplay/pass_receiver_holder_transfer/manifest.json" \
			or String(waiter_result.get("source_manifest_sha256", "")) != "a5222fd8d3573e27fb2f530ea9c9baebe9eeb091f26a52ae9f861f8dd9a4f403" \
			or int(waiter_result.get("entry_pc", -1)) != 0xD70C \
			or int(waiter_result.get("entry_bank", -1)) != 0x1E \
			or int(waiter_result.get("entry_sp", -1)) != entry_sp \
			or int(waiter_result.get("exit_pc", -1)) != 0xCC50 \
			or int(waiter_result.get("exit_bank", -1)) != 0x1E \
			or bool(waiter_result.get("input_boundary_fixture", true)) \
			or bool(waiter_result.get("trace_state_used", true)) \
			or bool(waiter_result.get("emulator_data_used", true)) \
			or bool(waiter_result.get("ppu_effects_applied", true)) \
			or bool(waiter_result.get("apu_effects_applied", true)) \
			or bool(waiter_result.get("task_save_executed", true)) \
			or bool(waiter_result.get("external_nmi_consumed", true)) \
			or not registers_variant is Dictionary or not result_ram_variant is PackedByteArray \
			or not result_stack_variant is PackedByteArray or not result_mapper_variant is Dictionary \
			or not writes_variant is Array or not stack_writes_variant is Array \
			or not instructions_variant is Array or not calls_variant is Array \
			or calls_variant.size() != 1 or not calls_variant[0] is Dictionary \
			or not call_request_variant is Dictionary:
		return _fail("ROM confirmation-wait result lacks its pinned `$D70C->$CC46->$CC50` source receipt.")
	var instructions: Array = instructions_variant
	if instructions != [0xD70C, 0xCC46, 0xCC48, 0xCC4B, 0xCC4D, 0xCC4E, 0xCC50]:
		return _fail("Confirmation waiter instruction sequence differs from the executed `$D70C->$CC50` ROM prefix.")
	var call: Dictionary = calls_variant[0]
	if int(call.get("callsite", -1)) != 0xD70C \
			or int(call.get("target", -1)) != 0xCC46 \
			or int(call.get("return_pc", -1)) != 0xD70F \
			or int(call.get("sp_after_push", -1)) != ((entry_sp - 2) & 0xFF) \
			or int(call_request.get("callsite_pc", -1)) != 0xCC50 \
			or int(call_request.get("target_pc", -1)) != 0xCB0F \
			or int(call_request.get("target_bank", -1)) != 0x1E \
			or int(call_request.get("return_pc", -1)) != 0xCC53 \
			or int(call_request.get("sp_before_push", -1)) != int(registers.get("sp", -2)) \
			or bool(call_request.get("scheduler_must_push_call_frame", false)) != true \
			or int(registers.get("pc", -1)) != 0xCC50 \
			or int(registers.get("a", -1)) != 1 \
			or int(registers.get("sp", -1)) != ((entry_sp - 3) & 0xFF) \
			or int(mapper_result.get("bank_low", -1)) != 0x1C \
			or int(mapper_result.get("bank_high", -1)) != 0x1D \
			or mapper_result != mapper:
		return _fail("Confirmation waiter callsite state does not preserve its ROM-generated CPU, mapper, and return contract.")
	var instruction_records_variant: Variant = waiter_result.get("instructions", [])
	if not instruction_records_variant is Array or instruction_records_variant.is_empty() \
			or not instruction_records_variant[instruction_records_variant.size() - 1] is Dictionary \
			or int(instruction_records_variant[instruction_records_variant.size() - 1].get("pc", -1)) != 0xCC50 \
			or instruction_records_variant[instruction_records_variant.size() - 1].get("bytes", PackedByteArray()) \
				!= PackedByteArray([0x20, 0x0F, 0xCB]):
		return _fail("Confirmation waiter callsite does not carry ROM bytes `$20 $0F $CB` at `$CC50`.")
	if not _pass_confirmation_wait_ordered_writes_match(boundary, waiter_result,
			entry_sp, result_ram_variant, result_stack_variant):
		return _fail("Confirmation waiter endpoint differs from replaying its ordered `$05F4` and stack writes.")
	_ram = (result_ram_variant as PackedByteArray).duplicate()
	_stack_page = (result_stack_variant as PackedByteArray).duplicate()
	context.accumulator = int(registers.get("a", context.accumulator)) & 0xFF
	context.x_register = int(registers.get("x", context.x_register)) & 0xFF
	context.y_register = int(registers.get("y", context.y_register)) & 0xFF
	context.status_register = int(registers.get("p", context.status_register)) & 0xFF
	context.status_known_mask = int(registers.get("p_known_mask", context.status_known_mask)) & 0xFF
	context.stack_pointer = int(registers.get("sp", -1)) & 0xFF
	context.program_counter = 0xCC50
	context.mapper_state = mapper_result.duplicate(true)
	context.source_label = "ROM-byte PASS confirmation waiter `$D70C->$CC46->$CC50`; scheduler JSR/save pending"
	_slot05_pass_confirmation_wait_yield_in_progress = true
	return true


## Adopts one ROM-built PASS waiter packet at its scheduler callsite. The normal
## NMI consumer remains responsible for draining the live queue on a later
## route frame; this function never consumes NMI or applies PPU bus events.
func adopt_slot05_pass_confirmation_wait_packet(dispatch: Dictionary,
		boundary: Dictionary, packet_result: Dictionary) -> bool:
	if not _require_initialized():
		return false
	var context: TaskContext = _contexts.get(0x05)
	var source_pc := int(dispatch.get("pc", -1))
	var exit_pc := int(packet_result.get("exit_pc", -1))
	var expected_exit_pc := exit_pc
	var expected_resume_pc := 0xCC53 if exit_pc == 0xCC50 else \
		0xCCA3 if exit_pc == 0xCCA0 else 0xCCD1
	var boundary_ram: Variant = boundary.get("ram_image", PackedByteArray())
	var boundary_stack: Variant = boundary.get("stack_page", PackedByteArray())
	var next_boundary_variant: Variant = packet_result.get("next_boundary_snapshot", {})
	var result_ram: Variant = next_boundary_variant.get("ram_image", PackedByteArray()) \
		if next_boundary_variant is Dictionary else PackedByteArray()
	var result_stack: Variant = next_boundary_variant.get("stack_page", PackedByteArray()) \
		if next_boundary_variant is Dictionary else PackedByteArray()
	var mapper: Variant = next_boundary_variant.get("mapper", {}) \
		if next_boundary_variant is Dictionary else {}
	var registers_variant: Variant = packet_result.get("registers", {})
	var call_variant: Variant = packet_result.get("call_request", {})
	var writes_variant: Variant = packet_result.get("source_writes", [])
	var stack_writes_variant: Variant = packet_result.get("source_stack_writes", [])
	var reads_variant: Variant = packet_result.get("source_reads", [])
	var stack_reads_variant: Variant = packet_result.get("source_stack_reads", [])
	var instruction_pcs_variant: Variant = packet_result.get("source_instruction_pcs", [])
	if not boundary_ram is PackedByteArray or not boundary_stack is PackedByteArray \
			or not next_boundary_variant is Dictionary or not result_ram is PackedByteArray \
			or not result_stack is PackedByteArray or not mapper is Dictionary \
			or not registers_variant is Dictionary or not call_variant is Dictionary \
			or not writes_variant is Array or not stack_writes_variant is Array \
			or not reads_variant is Array or not stack_reads_variant is Array \
			or not instruction_pcs_variant is Array:
		return _fail("PASS waiter packet omitted its live RAM/stack, ordered source writes, mapper, or call contract.")
	var boundary_mapper: Variant = boundary.get("mapper", {})
	var registers: Dictionary = registers_variant
	var call: Dictionary = call_variant
	var instruction_pcs: Array = instruction_pcs_variant
	var allowed_source_label := String(boundary.get("source_label", "")).begins_with(
		"ROM-byte PASS confirmation waiter")
	var entry_counter := int((boundary_stack as PackedByteArray)[0x48]) \
		if boundary_stack is PackedByteArray and (boundary_stack as PackedByteArray).size() > 0x48 else -1
	var exit_matches_entry := (source_pc == 0xCC53 \
		and ((entry_counter > 0 and exit_pc == 0xCC50) \
			or (entry_counter == 0 and exit_pc == 0xCCA0))) \
		or (source_pc == 0xCCA3 and exit_pc == 0xCCCE)
	if _active_task_slot != 0x05 or int(_ram[0x0000]) != 0x05 \
			or context == null or context.phase != ContextPhase.RUNNING \
			or context.program_counter != source_pc or source_pc not in [0xCC53, 0xCCA3] \
			or not exit_matches_entry \
			or int(dispatch.get("slot_base", -1)) != 0x05 \
			or int(boundary.get("active_task_slot", -1)) != 0x05 \
			or int(boundary.get("slot_base", -1)) != 0x05 \
			or int(boundary.get("pc", -1)) != source_pc \
			or int(boundary.get("sp", -1)) != context.stack_pointer \
			or not allowed_source_label or not boundary_mapper is Dictionary \
			or boundary_mapper != context.mapper_state \
			or bool(boundary.get("test_fixture", false)) \
			or bool(boundary.get("trace_state_used", true)) \
			or String(boundary.get("rom_sha256", "")) != ROM_SHA256 \
			or int(boundary.get("bank_low", -1)) != 0x1C \
			or int(boundary.get("bank_high", -1)) != 0x1D \
			or int((boundary_ram as PackedByteArray)[0x0024]) != 0x1C \
			or int((boundary_ram as PackedByteArray)[0x0025]) != 0x1D \
			or boundary_ram != _ram or boundary_stack != _stack_page \
			or (boundary_ram as PackedByteArray).slice(0x0100, 0x0200) != boundary_stack \
			or not bool(packet_result.get("ok", false)) \
			or String(packet_result.get("rom_sha256", "")) != ROM_SHA256 \
			or String(packet_result.get("source_manifest", "")) != \
				"res://reference/rom_extract/gameplay/pass_receiver_holder_transfer/manifest.json" \
			or String(packet_result.get("source_manifest_sha256", "")) != \
				"a5222fd8d3573e27fb2f530ea9c9baebe9eeb091f26a52ae9f861f8dd9a4f403" \
			or int(packet_result.get("entry_pc", -1)) != source_pc \
			or int(packet_result.get("entry_bank", -1)) != 0x1E \
			or int(packet_result.get("entry_sp", -1)) != context.stack_pointer \
			or int(packet_result.get("exit_pc", -1)) != expected_exit_pc \
			or int(packet_result.get("exit_bank", -1)) != 0x1E \
			or int(packet_result.get("resume_pc_after_scheduler_jsr", -1)) != expected_resume_pc \
			or int(next_boundary_variant.get("pc", -1)) != expected_exit_pc \
			or int(registers.get("pc", -1)) != expected_exit_pc \
			or int(registers.get("sp", -1)) != int(next_boundary_variant.get("sp", -2)) \
			or int(registers.get("a", -1)) != 1 \
			or int(next_boundary_variant.get("a", -1)) != int(registers.get("a", -2)) \
			or int(next_boundary_variant.get("x", -1)) != int(registers.get("x", -2)) \
			or int(next_boundary_variant.get("y", -1)) != int(registers.get("y", -2)) \
			or int(next_boundary_variant.get("p", -1)) != int(registers.get("p", -2)) \
			or int(next_boundary_variant.get("p_known_mask", -1)) != int(registers.get("p_known_mask", -2)) \
			or int(next_boundary_variant.get("bank_low", -1)) != 0x1C \
			or int(next_boundary_variant.get("bank_high", -1)) != 0x1D \
			or mapper != boundary_mapper \
			or int(call.get("callsite_pc", -1)) != expected_exit_pc \
			or int(call.get("target_pc", -1)) != 0xCB0F \
			or int(call.get("target_bank", -1)) != 0x1E \
			or int(call.get("return_word", -1)) != ((expected_exit_pc + 2) & 0xFFFF) \
			or int(call.get("return_pc", -1)) != expected_resume_pc \
			or int(call.get("sp_before_push", -1)) != int(registers.get("sp", -2)) \
			or not bool(call.get("scheduler_must_push_call_frame", false)) \
			or bool(packet_result.get("scheduler_save_executed", true)) \
			or bool(packet_result.get("external_nmi_consumed", true)) \
			or bool(packet_result.get("trace_state_used", true)) \
			or bool(packet_result.get("emulator_data_used", true)) \
			or bool(packet_result.get("test_fixture", true)) \
			or not bool(packet_result.get("input_boundary_unchanged", false)) \
			or bool(packet_result.get("ppu_effects_applied", true)) \
			or bool(packet_result.get("apu_effects_applied", true)) \
			or bool(packet_result.get("holder_transfer_applied", true)):
		return _fail("PASS waiter packet result did not match the active source task boundary, callsite, or non-trace contract.")
	for forbidden_key in ["fceux_ram", "captured_ram", "trace_ram_image", "emulator_snapshot", "screenshot"]:
		if boundary.has(forbidden_key) or packet_result.has(forbidden_key):
			return _fail("FCEUX captures cannot seed the production PASS waiter packet.")
	if instruction_pcs.is_empty() or int(instruction_pcs[0]) != source_pc \
			or int(instruction_pcs[instruction_pcs.size() - 1]) != expected_exit_pc \
			or int((boundary_ram as PackedByteArray)[0x0515]) != 0:
		return _fail("PASS waiter packet did not begin at the cleared source queue flag and reach its real yield instruction.")
	var expected_ram: PackedByteArray = (boundary_ram as PackedByteArray).duplicate()
	for write_variant: Variant in writes_variant:
		if not write_variant is Dictionary:
			return _fail("PASS waiter packet RAM writes must retain ordered source instruction records.")
		var write: Dictionary = write_variant
		var address := int(write.get("address", -1))
		var value := int(write.get("value", -1))
		if address not in [0x0515] and (address < 0x04A5 or address > 0x04F4) \
				or value < 0 or value > 0xFF or int(write.get("source_pc", -1)) not in instruction_pcs:
			return _fail("PASS waiter packet wrote outside the ROM-bounded PPU buffer/ready flag.")
		expected_ram[address] = value
	var expected_stack: PackedByteArray = (boundary_stack as PackedByteArray).duplicate()
	for stack_write_variant: Variant in stack_writes_variant:
		if not stack_write_variant is Dictionary:
			return _fail("PASS waiter packet stack writes must retain their ROM PHA records.")
		var stack_write: Dictionary = stack_write_variant
		var stack_address := int(stack_write.get("address", -1))
		if String(stack_write.get("operation", "")) != "PHA" \
				or int(stack_write.get("source_pc", -1)) not in instruction_pcs \
				or stack_address < 0x0100 or stack_address >= 0x0200 \
				or int(stack_write.get("value", -1)) < 0 \
				or int(stack_write.get("value", -1)) > 0xFF:
			return _fail("PASS waiter packet stack writes do not match the source push order.")
		expected_stack[stack_address - 0x0100] = int(stack_write["value"])
		expected_ram[stack_address] = int(stack_write["value"])
	var reads: Array = reads_variant
	var stack_reads: Array = stack_reads_variant
	var expected_sp := 0x47 if exit_pc == 0xCC50 else 0x48
	if reads.is_empty() or int(reads[0].get("source_pc", -1)) != source_pc \
			or int(reads[0].get("address", -1)) != 0x0515 \
			or int(reads[0].get("value", -1)) != 0 \
			or result_ram != expected_ram or result_stack != expected_stack \
			or result_ram.slice(0x0100, 0x0200) != result_stack \
			or int(result_ram[0x0515]) != 0x80 \
			or int(registers.get("sp", -1)) != expected_sp:
		var mismatched_ram: Array[String] = []
		for address in RAM_SIZE:
			if int(expected_ram[address]) != int(result_ram[address]):
				mismatched_ram.append("$%04X:%02X>%02X" % [address,
					int(expected_ram[address]), int(result_ram[address])])
				if mismatched_ram.size() >= 12:
					break
		return _fail("PASS waiter packet replay mismatch: RAM/stack=%s queue=$%02X SP=$%02X expected=$%02X reads=%s stack_reads=%s stack_writes=%s." % [
			str(mismatched_ram), int(result_ram[0x0515]), int(registers.get("sp", -1)),
			expected_sp, JSON.stringify(reads), JSON.stringify(stack_reads),
			JSON.stringify(stack_writes_variant)])
	if source_pc == 0xCC53:
		var input_counter := int((boundary_stack as PackedByteArray)[0x48])
		var expected_write_count := 2 if exit_pc == 0xCC50 else 1
		if stack_reads.size() != 2 or int(stack_reads[0].get("address", -1)) != 0x0148 \
				or int(stack_reads[0].get("source_pc", -1)) != 0xCC76 \
				or int(stack_reads[0].get("value", -1)) != input_counter \
				or int(stack_reads[1].get("address", -1)) != 0x0148 \
				or int(stack_reads[1].get("source_pc", -1)) != 0xCC98 \
				or int(stack_reads[1].get("value", -1)) != input_counter \
				or stack_writes_variant.size() != expected_write_count \
				or int(stack_writes_variant[0].get("address", -1)) != 0x0148 \
				or int(stack_writes_variant[0].get("source_pc", -1)) != 0xCC77 \
				or int(stack_writes_variant[0].get("value", -1)) != input_counter:
			return _fail("Counted PASS waiter packet did not restore the source counter after its packet construction.")
		if exit_pc == 0xCC50 and (int(stack_writes_variant[1].get("address", -1)) != 0x0148 \
				or int(stack_writes_variant[1].get("source_pc", -1)) != 0xCC4D \
				or int(stack_writes_variant[1].get("value", -1)) != input_counter - 1):
			return _fail("Counted PASS waiter packet did not push the decremented source counter back.")
	if source_pc == 0xCCA3 and (not stack_reads.is_empty() \
			or not stack_writes_variant.is_empty()):
		return _fail("Terminal PASS waiter packet must not touch the already-restored scheduler stack.")
	_ram = result_ram.duplicate()
	_stack_page = result_stack.duplicate()
	context.accumulator = int(registers.get("a", context.accumulator)) & 0xFF
	context.x_register = int(registers.get("x", context.x_register)) & 0xFF
	context.y_register = int(registers.get("y", context.y_register)) & 0xFF
	context.status_register = int(registers.get("p", context.status_register)) & 0xFF
	context.status_known_mask = int(registers.get("p_known_mask", context.status_known_mask)) & 0xFF
	context.stack_pointer = int(registers.get("sp", -1)) & 0xFF
	context.program_counter = expected_exit_pc
	context.mapper_state = mapper.duplicate(true)
	context.source_label = "ROM-byte PASS confirmation waiter packet `$%04X->$%04X`; scheduler JSR/save pending" % [source_pc, expected_exit_pc]
	_slot05_pass_confirmation_wait_yield_in_progress = true
	return true


