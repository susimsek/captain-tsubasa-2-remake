				and scenario_wait.slice(2, 5) == PackedByteArray([0x20, 0x0F, 0xCB])
	if source_pc == 0xE147:
		var field_loop := FileAccess.get_file_as_bytes(
				"res://reference/rom_extract/gameplay/field_entry_renderer_wrapper/fixed_field_entry_setup_E0E9_E349.bin")
		return field_loop.size() == 0x260 \
				and _sha256(field_loop) == "069aa6c733b9de0a6070e280f89277a4ec192f1c551001fb787e9038244806de" \
				and field_loop.slice(0x5E, 0x61) == PackedByteArray([0x20, 0x0F, 0xCB])
	if source_pc == 0xE40F:
		var field_input_caller := FileAccess.get_file_as_bytes(
				"res://reference/rom_extract/gameplay/fresh_bank18_worker_prefix/fixed_field_loop_caller_E407_E4D7.bin")
		return field_input_caller.size() == 0xD0 \
				and _sha256(field_input_caller) == "e07bde65678d6656908c6e7e9bb06a806d8839f864f756e8240c0381a1662593" \
				and field_input_caller.slice(0x08, 0x0B) == PackedByteArray([0x20, 0x0F, 0xCB])
	if source_pc == 0xCA4F:
		var root_code: PackedByteArray = _sources.get("root_slot01_startup", PackedByteArray())
		return root_code.size() == 48 and root_code.slice(0x2D, 0x30) == PackedByteArray([0x20, 0x0F, 0xCB])
	if source_pc == 0x8886:
		var worker_call: PackedByteArray = _sources.get("bank18_worker_yield_callsite", PackedByteArray())
		var trampoline: PackedByteArray = _sources.get("yield_trampoline", PackedByteArray())
