	if source_pc == 0x85BE:
		var map_worker := FileAccess.get_file_as_bytes(MAP42_WORKER_SOURCE_PATH)
		return map_worker.size() == 0x50 and _sha256(map_worker) == MAP42_WORKER_SOURCE_SHA256 \
