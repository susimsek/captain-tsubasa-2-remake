## Replays the verified `$804A->$CC50` actor-stream continuation into the live
## slot-$11 context, then runs the existing `$CB0F` task-save contract. The
## worker has already pushed `$CC52` on its stack, so the save reuses that frame.
func _validate_slot11_actor_worker_resume_result(result: Dictionary) -> Dictionary:
	var is_parameter47_f2 := String(result.get("stream_route", "")) == "parameter47_f2"
	var is_scenario1c_parameter00_f2 := \
		String(result.get("stream_route", "")) == "scenario1c_parameter00_f2_terminal"
	var is_scenario2e_parameter6d_f2 := \
		String(result.get("stream_route", "")) == "scenario2e_callback36_map2f_parameter6d_f2_waiter"
	var is_parameter00_f2 := is_parameter47_f2 or is_scenario1c_parameter00_f2
	var is_f2_waiter := is_parameter00_f2 or is_scenario2e_parameter6d_f2
	var route_metadata_valid := false
	if is_f2_waiter:
		route_metadata_valid = int(result.get("stream_command", -1)) == 0xF2 \
			and int(result.get("resolved_dispatch_target", -1)) == 0x80B5 \
			and not result.has("resolved_f4_target") and not result.has("resolved_f5_handler")
	else:
		route_metadata_valid = int(result.get("resolved_f4_target", -1)) == 0x9F52 \
			and int(result.get("resolved_f5_handler", -1)) == 0x81FD
	var expected_hashes: Dictionary = SLOT11_RESUME_PARAMETER47_F2_SOURCE_HASHES \
		if is_parameter47_f2 else (SLOT11_RESUME_SCENARIO1C_PARAMETER00_F2_SOURCE_HASHES \
		if is_scenario1c_parameter00_f2 else (SLOT11_RESUME_SCENARIO2E_PARAMETER6D_F2_SOURCE_HASHES \
		if is_scenario2e_parameter6d_f2 else SLOT11_RESUME_SOURCE_HASHES))
	if String(result.get("rom_sha256", "")) != ROM_SHA256 \
			or String(result.get("status", "")) != "slot11_actor_worker_at_cb0f_from_cc50" \
			or String(result.get("source_manifest", "")) != SLOT11_RESUME_MANIFEST \
			or int(result.get("slot_base", -1)) != 0x11 \
			or int(result.get("entry_pc", -1)) != 0x804A \
			or int(result.get("exit_pc", -1)) != 0xCB0F \
			or int(result.get("yield_callsite_pc", -1)) != 0xCC50 \
			or int(result.get("yield_target_pc", -1)) != 0xCB0F \
			or int(result.get("resume_pc_after_rts", -1)) != 0xCC53 \
			or not route_metadata_valid \
			or not bool(result.get("call_frame_already_pushed", false)) \
			or bool(result.get("trace_state_used", true)) \
			or bool(result.get("ppu_apu_effects_applied", true)) \
			or bool(result.get("source_timing_modeled", true)):
		return {"ok": false, "reason": "Input is not the bounded ROM-byte slot-$11 `$CC50->$CB0F` result."}
	if is_scenario2e_parameter6d_f2 \
			and (int(result.get("actor_parameter", -1)) != 0x6D \
				or String(result.get("actor_parameter_manifest", "")) != \
					"res://reference/rom_extract/gameplay/slot11_actor_parameter_6d/manifest.json"):
		return {"ok": false, "reason": "Scenario-$2E actor-$6D F2 result omits its pointer/stream manifest provenance."}
	if result.get("source_span_hashes", {}) != expected_hashes:
		return {"ok": false, "reason": "Slot-$11 resume source-span hashes differ from their verified manifest package."}
	var entry_record: Variant = result.get("entry_record", PackedByteArray())
	var entry_ram: Variant = result.get("entry_ram_image", PackedByteArray())
	var entry_stack: Variant = result.get("entry_stack_page", PackedByteArray())
	var entry_registers: Variant = result.get("entry_registers", {})
	var callsite_registers: Variant = result.get("yield_callsite_registers", {})
	var cb0f_registers: Variant = result.get("cb0f_entry_registers", {})
	var mapper: Variant = result.get("mapper", {})
	var save_contract: Variant = result.get("scheduler_save_contract", {})
	var source_reads: Variant = result.get("source_reads", [])
	var ram_writes: Variant = result.get("ram_writes", [])
	var stack_writes: Variant = result.get("stack_writes", [])
	var output_ram: Variant = result.get("ram_image", PackedByteArray())
	var output_stack: Variant = result.get("stack_page", PackedByteArray())
	var callsite_stack: Variant = result.get("yield_callsite_stack_page", PackedByteArray())
	var ppu_events: Variant = result.get("ppu_bus_events", [])
	var apu_writes: Variant = result.get("apu_register_writes", [])
	if not entry_record is PackedByteArray or entry_record != PackedByteArray([0x00, 0xC6, 0x18, 0x19]) \
			or not entry_ram is PackedByteArray or entry_ram.size() != RAM_SIZE \
			or not entry_stack is PackedByteArray or entry_stack.size() != STACK_PAGE_SIZE \
			or not entry_registers is Dictionary or not callsite_registers is Dictionary \
			or not cb0f_registers is Dictionary or not mapper is Dictionary \
			or not save_contract is Dictionary or not source_reads is Array \
			or not ram_writes is Array or not stack_writes is Array \
			or not output_ram is PackedByteArray or output_ram.size() != RAM_SIZE \
			or not output_stack is PackedByteArray or output_stack.size() != STACK_PAGE_SIZE \
			or not callsite_stack is PackedByteArray or callsite_stack.size() != STACK_PAGE_SIZE \
			or not ppu_events is Array or not ppu_events.is_empty() \
			or not apu_writes is Array or not apu_writes.is_empty():
		return {"ok": false, "reason": "Slot-$11 resume result omits its source boundary, writes, mapper, or side-effect fields."}
	var entry: Dictionary = entry_registers
	var callsite: Dictionary = callsite_registers
	var cb0f: Dictionary = cb0f_registers
	var source_mapper: Dictionary = mapper
	var save: Dictionary = save_contract
	var mapper_bank_registers: Variant = source_mapper.get("bank_registers", {})
	var is_scenario2e_frame9477_f2_entry: bool = is_scenario2e_parameter6d_f2 \
			and entry_ram.slice(0x0516, 0x051A) == PackedByteArray([0x01, 0x00, 0x2E, 0x77]) \
			and entry_stack.slice(0xC7, 0xCB) == PackedByteArray([0xDB, 0xE3, 0x49, 0x80]) \
			and int(entry.get("a", -1)) == 0xE3 \
			and int(entry.get("x", -1)) == 0xE3 \
			and int(entry.get("y", -1)) == 0xDB \
			and int(entry.get("p_known_mask", -1)) == 0x83 \
			and (int(entry.get("p", -1)) & 0x83) == 0x80
	var is_scenario2e_legacy_f2_entry: bool = is_scenario2e_parameter6d_f2 \
			and entry_ram.slice(0x0516, 0x051A) == PackedByteArray([0x01, 0x00, 0x2E, 0x78]) \
			and entry_stack.slice(0xC7, 0xCB) == PackedByteArray([0x04, 0x04, 0x49, 0x80]) \
			and int(entry.get("a", -1)) == 0x01 \
			and int(entry.get("p", -1)) == 0x30
	var expected_entry_a := 0x00 if is_scenario1c_parameter00_f2 else (0x17 if is_parameter47_f2 else (0x01 if is_scenario2e_parameter6d_f2 else 0x42))
	var expected_entry_a_resolved := 0xE3 if is_scenario2e_frame9477_f2_entry else expected_entry_a
	var expected_entry_x := 0x00 if is_scenario1c_parameter00_f2 else (0x17 if is_parameter47_f2 else (0xE3 if is_scenario2e_parameter6d_f2 else 0x42))
	var expected_entry_y := 0x01 if is_scenario1c_parameter00_f2 else (0x8F if is_parameter47_f2 else (0xDB if is_scenario2e_parameter6d_f2 else 0xE7))
	var expected_callsite_sp := 0xC5 if is_f2_waiter else 0xC3
	var expected_callsite_x := 0x00 if is_scenario1c_parameter00_f2 else (0x17 if is_parameter47_f2 else (0xE3 if is_scenario2e_parameter6d_f2 else 0x52))
	var expected_callsite_y := 0x06 if is_f2_waiter else 0x0C
	var expected_cb0f_sp := (expected_callsite_sp - 2) & 0xFF
	var expected_saved_sp := (expected_callsite_sp - 4) & 0xFF
	if int(entry.get("pc", -1)) != 0x804A or int(entry.get("sp", -1)) != 0xCA \
			or int(entry.get("a", -1)) != expected_entry_a_resolved \
			or int(entry.get("x", -1)) != expected_entry_x \
			or int(entry.get("y", -1)) != expected_entry_y \
			or (is_scenario2e_parameter6d_f2 and (not is_scenario2e_frame9477_f2_entry \
				and not is_scenario2e_legacy_f2_entry)) \
			or (is_scenario2e_parameter6d_f2 and (entry_ram.slice(0x051A, 0x051D) != PackedByteArray([0xE8, 0x9B, 0x00]) \
				or int(entry_ram[0x0522]) != 0x00 or int(entry_ram[0x052B]) != 0x00 \
				or entry_ram.slice(0x0523, 0x052B) != PackedByteArray([0x78, 0x36, 0x02, 0x3C, 0x4A, 0x8B, 0x6D, 0x00]) \
				or entry_ram.slice(0x005D, 0x0061) != PackedByteArray([0x53, 0xB7, 0xE3, 0x9B]) \
				or entry_ram.slice(0x05C7, 0x05D3) != PackedByteArray([0x24, 0xC0, 0x00, 0x01, 0x01, 0x2F, 0x80, 0xA0, 0x00, 0x02, 0x00, 0x00]) \
				or entry_ram.slice(0x05E3, 0x05EB) != PackedByteArray([0x01, 0x00, 0x00, 0x0E, 0x02, 0x02, 0x00, 0x6D]) \
				or int(entry_ram[0x003A]) != 0x06 \
				or entry_ram.slice(0x05F3, 0x05F6) != PackedByteArray([0x00, 0x00, 0x01]) \
				or entry_ram.slice(0x0063, 0x0065) != PackedByteArray([0xBA, 0xA2]) \
				or int(entry_ram[0x0515]) != 0x00 or int(entry_ram[0x0022]) != 0x00 \
				or int(entry_ram[0x0629]) != 0x00)) \
			or (is_parameter47_f2 and (int(entry_ram[0x05EA]) != 0x47 \
				or (int(entry_ram[0x005F]) | (int(entry_ram[0x0060]) << 8)) != 0x9917 \
				or int(entry_ram[0x05E3]) != 1 or int(entry_ram[0x05E4]) != 0 \
				or int(entry_ram[0x05E5]) != 0 or int(entry_ram[0x05E9]) != 0)) \
			or (is_scenario1c_parameter00_f2 and (int(entry_ram[0x05EA]) != 0x00 \
				or (int(entry_ram[0x005F]) | (int(entry_ram[0x0060]) << 8)) != 0x9400 \
				or not _is_scenario1c_callback1f_actor_seed_profile(entry_ram, 0x01, 0x2F) \
				or int(entry_ram[0x05E3]) != 0x01 or int(entry_ram[0x05E4]) != 0x00 \
				or int(entry_ram[0x05E5]) != 0x00 or int(entry_ram[0x05E9]) != 0x00)) \
			or int(callsite.get("pc", -1)) != 0xCC50 \
			or int(callsite.get("sp", -1)) != expected_callsite_sp \
			or int(callsite.get("a", -1)) != 0x01 \
			or int(callsite.get("x", -1)) != expected_callsite_x \
			or int(callsite.get("y", -1)) != expected_callsite_y \
			or int(cb0f.get("pc", -1)) != 0xCB0F \
			or int(cb0f.get("sp", -1)) != expected_cb0f_sp \
			or int(cb0f.get("a", -1)) != 0x01 \
			or int(cb0f.get("x", -1)) != expected_callsite_x \
			or int(cb0f.get("y", -1)) != expected_callsite_y \
			or int(callsite.get("p", -1)) != int(cb0f.get("p", -2)) \
			or int(callsite.get("p_known_mask", -1)) != int(cb0f.get("p_known_mask", -2)) \
			or int(source_mapper.get("bank_low", -1)) != 0x18 \
			or int(source_mapper.get("bank_high", -1)) != 0x19 \
			or (is_scenario2e_parameter6d_f2 and (int(source_mapper.get("select", -1)) != 0x07 \
				or not mapper_bank_registers is Dictionary \
				or int(mapper_bank_registers.get(6, -1)) != 0x18 \
				or int(mapper_bank_registers.get(7, -1)) != 0x19)) \
			or int(save.get("slot_base", -1)) != 0x11 \
			or int(save.get("delay_in_a", -1)) != 0x01 \
			or int(save.get("callsite_pc", -1)) != 0xCC50 \
			or int(save.get("target_pc", -1)) != 0xCB0F \
			or int(save.get("resume_pc", -1)) != 0xCC53 \
			or not bool(save.get("call_frame_already_pushed", false)) \
			or int(save.get("pre_jsr_sp", -1)) != expected_callsite_sp \
			or int(save.get("cb0f_entry_sp", -1)) != expected_cb0f_sp \
			or save.get("rom_cb0f_push_order", []) != ["X", "Y"] \
			or int(save.get("expected_saved_sp_after_cb0f_pushes", -1)) != expected_saved_sp \
			or save.get("mapper_low_high", PackedByteArray()) != PackedByteArray([0x18, 0x19]):
		return {"ok": false, "reason": "Slot-$11 resume CPU/mapper/save contract differs: record=%s entry=%s callsite=%s cb0f=%s mapper=%s save=%s." % [
			entry_record.hex_encode(), str(entry), str(callsite), str(cb0f), str(source_mapper), str(save)]}
	var expected_reads: Array[Array] = [
		[0x9F42, 0xF4, "actor_stream_command"],
		[0x9F43, 0x04, "F4_selector"],
		[0x9F44, 0x52, "F4_target_pointer_low"],
		[0x9F45, 0x9F, "F4_target_pointer_high"],
		[0x9F52, 0xF5, "actor_stream_command"],
	]
	if is_parameter47_f2:
		expected_reads = [
			[0x9917, 0xF2, "actor_stream_command"],
			[0x8090, 0xB5, "inline_vector_low"],
			[0x8091, 0x80, "inline_vector_high"],
			[0x80B5, 0x4C, "F2_direct_jmp_opcode"],
			[0xC52D, 0x4C, "shared_waiter_jmp_opcode"],
			[0xCC46, 0xA9, "waiter_entry_opcode"],
			[0xCC50, 0x20, "task_save_jsr_opcode"],
		]
		if int(output_ram[0x05EA]) != 0x47 \
				or (int(output_ram[0x005F]) | (int(output_ram[0x0060]) << 8)) != 0x9917 \
				or int(output_ram[0x05E5]) != 1 or int(output_ram[0x05F4]) != 0:
			return {"ok": false, "reason": "The parameter-$47 F2 waiter changed the ROM stream cursor or zeroed a different event mode."}
	elif is_scenario1c_parameter00_f2:
		expected_reads = [
			[0x9400, 0xF2, "actor_stream_command"],
			[0x8090, 0xB5, "inline_vector_low"],
			[0x8091, 0x80, "inline_vector_high"],
			[0x80B5, 0x4C, "F2_direct_jmp_opcode"],
			[0xC52D, 0x4C, "shared_waiter_jmp_opcode"],
			[0xCC46, 0xA9, "waiter_entry_opcode"],
			[0xCC50, 0x20, "task_save_jsr_opcode"],
		]
		if int(output_ram[0x05EA]) != 0x00 \
				or (int(output_ram[0x005F]) | (int(output_ram[0x0060]) << 8)) != 0x9400 \
				or int(output_ram[0x05E5]) != 0x01 or int(output_ram[0x05F4]) != 0x00:
			return {"ok": false, "reason": "The scenario-$1C parameter-$00 F2 waiter changed its ROM stream cursor or zeroed the wrong event mode."}
	elif is_scenario2e_parameter6d_f2:
		expected_reads = [
			[0x9BE3, 0xF2, "actor_stream_command"],
			[0x8090, 0xB5, "inline_vector_low"],
			[0x8091, 0x80, "inline_vector_high"],
			[0x80B5, 0x4C, "F2_direct_jmp_opcode"],
			[0xC52D, 0x4C, "shared_waiter_jmp_opcode"],
			[0xCC46, 0xA9, "waiter_entry_opcode"],
			[0xCC50, 0x20, "task_save_jsr_opcode"],
		]
		if int(output_ram[0x05EA]) != 0x6D \
				or (int(output_ram[0x005F]) | (int(output_ram[0x0060]) << 8)) != 0x9BE3 \
				or int(output_ram[0x05E5]) != 0x01 or int(output_ram[0x05F4]) != 0x00:
			return {"ok": false, "reason": "The scenario-$2E actor-$6D F2 waiter changed the source cursor, actor parameter, or waiter mode."}
		if ram_writes != [
				{"pc": 0xCB9C, "address": 0x0036, "value": 0x67},
				{"pc": 0xCBA0, "address": 0x0037, "value": 0x80},
				{"pc": 0xCBA8, "address": 0x0037, "value": 0x80},
				{"pc": 0xCBAB, "address": 0x0036, "value": 0x6E},
				{"pc": 0x8071, "address": 0x05E5, "value": 0x01},
				{"pc": 0xCB9C, "address": 0x0036, "value": 0x8B},
				{"pc": 0xCBA0, "address": 0x0037, "value": 0x80},
				{"pc": 0xCBA8, "address": 0x0037, "value": 0x80},
				{"pc": 0xCBAB, "address": 0x0036, "value": 0xB5},
				{"pc": 0xCC48, "address": 0x05F4, "value": 0x00},
			]:
			return {"ok": false, "reason": "The actor-$6D F2 route RAM writes differ from the inline-vector scratch, cursor, and waiter writes."}
		var waiter_stack_writes: Array[Dictionary] = []
		for write_variant in stack_writes:
			if write_variant is Dictionary and int(write_variant.get("pc", -1)) in [0xCC4D, 0xCC50]:
				waiter_stack_writes.append(write_variant)
		var expected_waiter_callsite_stack := PackedByteArray([0x06, 0x04, 0x04, 0x49, 0x80])
		if is_scenario2e_frame9477_f2_entry:
			# Frame 9477 `$804A` capture enters with the `$7C80` caller frame;
			# unlike the older parameter-$47 fixture, `$CC50` sees `$06 $7C $80 $4C $80`.
			expected_waiter_callsite_stack = PackedByteArray([0x06, 0x7C, 0x80, 0x4C, 0x80])
		if waiter_stack_writes != [
				{"pc": 0xCC4D, "address": 0x01C6, "value": 0x06, "kind": "PHA"},
				{"pc": 0xCC50, "address": 0x01C5, "value": 0xCC, "kind": "JSR_high"},
				{"pc": 0xCC50, "address": 0x01C4, "value": 0x52, "kind": "JSR_low"},
			] or callsite_stack.slice(0xC6, 0xCB) != expected_waiter_callsite_stack:
			return {"ok": false, "reason": "The actor-$6D F2 `$CC50->$CB0F` PHA/JSR stack writes or callsite stack differ from the audited bytes."}
		for read_variant in source_reads:
			if read_variant is Dictionary and (String(read_variant.get("kind", "")).begins_with("F4_") \
					or int(read_variant.get("address", -1)) == 0x9BE4):
				return {"ok": false, "reason": "The actor-$6D F2 waiter continued into an F4 selector or target read."}
	for expected_read: Array in expected_reads:
		if not _slot11_source_read_present(source_reads, int(expected_read[0]),
				int(expected_read[1]), String(expected_read[2])):
			return {"ok": false, "reason": "The slot-$11 source read stream omits a byte in the audited F4/F5 path."}
	return {"ok": true}


func _is_slot11_parameter47_waiter_lineage(result: Dictionary) -> bool:
	var status := String(result.get("status", ""))
	var callsite_pc := int(result.get("yield_callsite_pc", -1))
	var entry_pc := int(result.get("entry_pc", -1))
	var is_cc50_waiter := entry_pc == 0xCC53 \
		and status == "slot11_actor_waiter_at_cb0f_from_cc53" \
		and callsite_pc == 0xCC50
	var is_cca0_tail_waiter := entry_pc == 0xCC53 \
		and status == "slot11_actor_waiter_tail_at_cb0f_from_cca0" \
		and callsite_pc == 0xCCA0
	var is_f2_tail_poll_yield := entry_pc == 0xCCA3 \
		and ((status == "slot11_actor_waiter_tail_at_cb0f_from_cca0" and callsite_pc == 0xCCA0) \
			or (status == "slot11_actor_waiter_final_packet_at_cb0f_from_ccce" and callsite_pc == 0xCCCE))
	if not (is_cc50_waiter or is_cca0_tail_waiter or is_f2_tail_poll_yield):
		return false
	var record: Variant = result.get("entry_record", PackedByteArray())
	var ram: Variant = result.get("entry_ram_image", PackedByteArray())
	var stack: Variant = result.get("entry_stack_page", PackedByteArray())
	var registers: Variant = result.get("entry_registers", {})
	var expected_record := PackedByteArray([0x00, 0xC2, 0x18, 0x19]) \
		if is_f2_tail_poll_yield else PackedByteArray([0x00, 0xC1, 0x18, 0x19])
	if not record is PackedByteArray or record != expected_record \
			or not ram is PackedByteArray or ram.size() != RAM_SIZE \
			or not stack is PackedByteArray or stack.size() != STACK_PAGE_SIZE \
			or not registers is Dictionary:
		return false
	var count := int(stack[0xC6])
	var initial_count_profile := count == 0x06 \
		and int(registers.get("x", -1)) == 0x17 \
		and int(registers.get("y", -1)) == 0x06
	var packet_count_profile := count >= 0 and count < 0x06 \
		and int(registers.get("x", -1)) == 0x4F \
		and int(registers.get("y", -1)) == 0x00
	var tail_count_profile := count == 0x00 \
		and int(registers.get("x", -1)) == 0x4F \
		and int(registers.get("y", -1)) == 0x00
	var f2_tail_poll_profile := int(stack[0xC3]) == 0x00 \
		and int(stack[0xC4]) == 0x4F \
		and int(stack[0xC5]) == 0xA2 and int(stack[0xC6]) == 0xCC \
		and int(stack[0xC7]) == 0x7C and int(stack[0xC8]) == 0x80 \
		and int(registers.get("sp", -1)) == 0xC6 \
		and int(registers.get("x", -1)) == 0x4F \
		and int(registers.get("y", -1)) == 0x00
	var ram_lineage := int(ram[0x05EA]) == 0x47 \
		and (int(ram[0x005F]) | (int(ram[0x0060]) << 8)) == 0x9917 \
		and int(ram[0x05E3]) == 0x01 and int(ram[0x05E4]) == 0x00 \
		and int(ram[0x05E5]) == 0x01 and int(ram[0x05F4]) == 0x00
	var cc53_stack_profile := int(stack[0xC4]) == 0x52 \
		and int(stack[0xC5]) == 0xCC \
		and int(stack[0xC7]) == 0x7C and int(stack[0xC8]) == 0x80
	var cc53_wait_profile := int(registers.get("sp", -1)) == 0xC5 \
		and cc53_stack_profile \
		and ((is_cc50_waiter and (initial_count_profile or packet_count_profile)) \
			or (is_cca0_tail_waiter and tail_count_profile))
	return ram_lineage and ((is_cc50_waiter or is_cca0_tail_waiter) and cc53_wait_profile \
		or (is_f2_tail_poll_yield and f2_tail_poll_profile))


func _is_slot11_scenario1c_parameter00_f2_waiter_lineage(result: Dictionary) -> bool:
	var result_status := String(result.get("status", ""))
	var entry_pc := int(result.get("entry_pc", -1))
	var callsite_pc := int(result.get("yield_callsite_pc", -1))
	var record: Variant = result.get("entry_record", PackedByteArray())
	var ram: Variant = result.get("entry_ram_image", PackedByteArray())
	var stack: Variant = result.get("entry_stack_page", PackedByteArray())
	var registers: Variant = result.get("entry_registers", {})
	if not record is PackedByteArray or not ram is PackedByteArray \
			or not stack is PackedByteArray or not registers is Dictionary \
			or ram.size() != RAM_SIZE or stack.size() != STACK_PAGE_SIZE:
		return false
	var scenario1c_live_stream: bool = int(ram[0x05EA]) == 0x00 \
		and (int(ram[0x005F]) | (int(ram[0x0060]) << 8)) == 0x9400 \
		and ram.slice(0x003A, 0x003B) == PackedByteArray([0x06]) \
		and ram.slice(0x005D, 0x005F) == PackedByteArray([0x4F, 0xBB]) \
		and ram.slice(0x051A, 0x051D) == PackedByteArray([0xE8, 0x9B, 0x00]) \
		and ram.slice(0x0522, 0x052B) == PackedByteArray([0x02, 0x30, 0x1F, 0x02, 0x3C, 0x4A, 0x4C, 0x00, 0x40]) \
		and int(ram[0x0539]) == 0x00 \
		and ram.slice(0x05C7, 0x05D3) == PackedByteArray([0x40, 0xA0, 0x00, 0x00, 0x01, 0x52, 0xA0, 0x80, 0x00, 0x02, 0x80, 0x01]) \
		and ram.slice(0x05E3, 0x05EB) == PackedByteArray([0x01, 0x00, 0x01, 0x0E, 0x02, 0x02, 0x00, 0x00]) \
		and ram.slice(0x05F3, 0x05F6) == PackedByteArray([0x01, 0x00, 0x01]) \
		and stack.slice(0xC7, 0xC9) == PackedByteArray([0x7C, 0x80])
	# The ROM's final packet loop mutates its counter, cursor, and packet scratch
	# fields before yielding at $CCCE. Keep the stream/task identity checks, but
	# do not require the pre-loop live-stream snapshot at this later boundary.
	var scenario1c_tail_stream: bool = int(ram[0x05EA]) == 0x00 \
		and (int(ram[0x005F]) | (int(ram[0x0060]) << 8)) == 0x9400 \
		and ram.slice(0x05E3, 0x05EB) == PackedByteArray([0x01, 0x00, 0x01, 0x0E, 0x02, 0x02, 0x00, 0x00]) \
		and ram.slice(0x05F3, 0x05F6) == PackedByteArray([0x01, 0x00, 0x01]) \
		and stack.slice(0xC7, 0xC9) == PackedByteArray([0x7C, 0x80])
	var initial_wait_lineage: bool = result_status == "slot11_actor_waiter_at_cb0f_from_cc53" \
		and entry_pc == 0xCC53 and callsite_pc == 0xCC50 \
		and record == PackedByteArray([0x00, 0xC1, 0x18, 0x19]) \
		and scenario1c_live_stream \
		and ram.slice(0x0516, 0x0519) == PackedByteArray([0x01, 0x40, 0x1C])
	if initial_wait_lineage:
		var wait_count := int(stack[0xC6])
		var wait_registers := (wait_count == 0x06 \
			and int(registers.get("a", -1)) == 0x00 \
			and int(registers.get("x", -1)) == 0x00 \
			and int(registers.get("y", -1)) == 0x06) \
			or (wait_count >= 0 and wait_count < 0x06 \
				and int(registers.get("a", -1)) == 0x4F \
				and int(registers.get("x", -1)) == 0x4F \
				and int(registers.get("y", -1)) == 0x00)
		return wait_count >= 0 and wait_count <= 0x06 \
			and int(ram[0x0515]) == 0x00 \
			and int(ram[0x0519]) == 0x28 + wait_count \
			and stack.slice(0xC4, 0xC6) == PackedByteArray([0x52, 0xCC]) \
			and int(stack[0xC6]) == wait_count \
			and int(registers.get("sp", -1)) == 0xC5 and wait_registers
	var scenario1c_terminal_counter_wait: bool = result_status == "slot11_actor_waiter_tail_at_cb0f_from_cca0" \
		and entry_pc == 0xCC53 and callsite_pc == 0xCCA0 \
		and record == PackedByteArray([0x00, 0xC1, 0x18, 0x19]) \
		and scenario1c_live_stream \
		and ram.slice(0x0515, 0x051A) == PackedByteArray([0x00, 0x01, 0x40, 0x1C, 0x28]) \
		and stack.slice(0xC4, 0xC9) == PackedByteArray([0x52, 0xCC, 0x00, 0x7C, 0x80]) \
		and int(registers.get("sp", -1)) == 0xC5 \
		and int(registers.get("a", -1)) == 0x4F \
		and int(registers.get("x", -1)) == 0x4F \
		and int(registers.get("y", -1)) == 0x00
	var scenario1c_terminal_packet: bool = result_status == "slot11_actor_waiter_final_packet_at_cb0f_from_ccce" \
		and entry_pc == 0xCCA3 and callsite_pc == 0xCCCE \
		and record == PackedByteArray([0x00, 0xC2, 0x18, 0x19]) \
		and scenario1c_tail_stream \
		and ram.slice(0x0515, 0x051A) == PackedByteArray([0x00, 0x61, 0x40, 0x1C, 0x27]) \
		and int(ram[0x05D1]) == 0x80 and int(ram[0x05D2]) == 0x01 \
		and ram.slice(0x04A5, 0x04A8) == PackedByteArray([0x18, 0x08, 0x22]) \
		and int(registers.get("sp", -1)) == 0xC6 \
		and int(registers.get("a", -1)) == 0x4F \
		and int(registers.get("x", -1)) == 0x4F \
		and int(registers.get("y", -1)) == 0x00 \
		and stack.slice(0xC3, 0xC9) == PackedByteArray([0x00, 0x4F, 0xA2, 0xCC, 0x7C, 0x80])
	return scenario1c_terminal_counter_wait or scenario1c_terminal_packet


func _is_slot11_scenario2e_actor6d_f2_waiter_lineage(result: Dictionary) -> bool:
	var status := String(result.get("status", ""))
	var entry_pc := int(result.get("entry_pc", -1))
	var callsite_pc := int(result.get("yield_callsite_pc", -1))
	var is_packet_wait_yield := status == "slot11_actor_waiter_at_cb0f_from_cc53" \
