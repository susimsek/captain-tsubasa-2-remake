				rejected_write = "non-dictionary"
				expected_ram.clear()
				break
			var write: Dictionary = write_variant
			var address := int(write.get("address", -1))
			var value := int(write.get("value", -1))
			var allowed_address := address in [0x0011, 0x0012, 0x0023, 0x0024, 0x0025, \
				0x0061, 0x0062, 0x05F4, 0x0515] \
				or (address >= 0x04A5 and address <= 0x04F4) \
					or (address >= 0x0100 and address < 0x0200)
			if value < 0 or value > 0xFF or not allowed_address:
				rejected_write = "$%04X=%02X" % [address, value]
				expected_ram.clear()
				break
			expected_ram[address] = value
			if address >= 0x0100 and address < 0x0200:
				expected_stack[address - 0x0100] = value
	var source_pc := int(dispatch.get("pc", -1))
	var callsite := int(call_request.get("callsite_pc", -1))
