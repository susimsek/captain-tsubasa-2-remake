	var expected_pop_low_address := 0x0100 + ((entry_sp - 3) & 0xFF)
	var expected_pop_high_address := 0x0100 + ((entry_sp - 2) & 0xFF)
	# The `$CDE2` return opcode is source-decoded inside the helper. Its actual PC
	# is checked against the pinned 38-byte span below; the two values must be the
	# `$E702` return word, followed by `$E6EC`'s caller return from `$E6EF`.
	var dynamic_cde2_reads: Array = []
	for read_variant in stack_reads_variant:
		var read: Dictionary = read_variant
		if int(read.get("pc", -1)) >= 0xCDE2 and int(read.get("pc", -1)) <= 0xCE07:
			dynamic_cde2_reads.append(read)
	if stack_reads_variant.size() != 6 \
			or int(stack_reads_variant[0].get("pc", -1)) != 0xCD89 \
			or int(stack_reads_variant[0].get("address", -1)) != expected_pop_low_address \
			or int(stack_reads_variant[0].get("value", -1)) != 0xF1 \
			or int(stack_reads_variant[1].get("pc", -1)) != 0xCD89 \
			or int(stack_reads_variant[1].get("address", -1)) != expected_pop_high_address \
			or int(stack_reads_variant[1].get("value", -1)) != 0xE6 \
			or dynamic_cde2_reads.size() != 2 \
			or int(dynamic_cde2_reads[0].get("address", -1)) != expected_pop_low_address \
			or int(dynamic_cde2_reads[0].get("value", -1)) != 0x04 \
			or int(dynamic_cde2_reads[1].get("address", -1)) != expected_pop_high_address \
			or int(dynamic_cde2_reads[1].get("value", -1)) != 0xE7 \
			or int(stack_reads_variant[4].get("pc", -1)) != 0xE708 \
			or int(stack_reads_variant[4].get("address", -1)) != 0x0100 + ((entry_sp - 1) & 0xFF) \
			or int(stack_reads_variant[4].get("value", -1)) != 0xFE \
			or int(stack_reads_variant[5].get("pc", -1)) != 0xE708 \
			or int(stack_reads_variant[5].get("address", -1)) != 0x0100 + entry_sp \
			or int(stack_reads_variant[5].get("value", -1)) != 0xD7:
