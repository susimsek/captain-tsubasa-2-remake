func yield_at_verified_callsite(slot_base: int, source_pc: int, delay_in_a: int,
		caller_stack_pointer: int, saved_x: int, saved_y: int,
		current_bank_low: int, current_bank_high: int,
		call_frame_already_pushed: bool = false) -> bool:
	if not _require_initialized():
		return false
	var context: TaskContext = _contexts.get(slot_base)
	if _active_task_slot != slot_base or context == null or context.phase != ContextPhase.RUNNING:
		return _fail("Yield requires the currently running source task context.")
	var slot05_pass_receiver_wait_jsr_already_executed := source_pc == 0xD80C and slot_base == 0x05
	var slot05_pass_field_caller_wait := source_pc == 0xE086 and slot_base == 0x05
	var slot05_pass_confirmation_wait_callsite := source_pc in [0xCC50, 0xCCA0, 0xCCCE] \
		and slot_base == 0x05 and _slot05_pass_confirmation_wait_yield_in_progress
	if _slot05_pass_confirmation_wait_yield_in_progress \
			and not slot05_pass_confirmation_wait_callsite:
		return _fail("The adopted PASS confirmation waiter must yield from its ROM `$CC50/$CCA0/$CCCE->$CB0F` callsite.")
	if slot05_pass_confirmation_wait_callsite \
			and (context.program_counter != source_pc \
			or not String(context.source_label).begins_with("ROM-byte PASS confirmation waiter") \
			or delay_in_a != context.accumulator or saved_x != context.x_register \
			or saved_y != context.y_register or caller_stack_pointer != context.stack_pointer \
			or current_bank_low != 0x1C or current_bank_high != 0x1D \
			or context.bank_low != 0x1C or context.bank_high != 0x1D \
			or call_frame_already_pushed):
		return _fail("PASS confirmation waiter packet yield requires its adopted live callsite and scheduler-owned JSR frame.")
	if _slot05_pass_receiver_wait_yield_in_progress and not slot05_pass_receiver_wait_jsr_already_executed:
		return _fail("The adopted PASS receiver `$D80C->$CB0F` call-entry must be saved at its verified yield callsite.")
	if slot05_pass_receiver_wait_jsr_already_executed and (not _slot05_pass_receiver_wait_yield_in_progress \
			or context.program_counter != 0xCB0F or context.bank_low != 0x1C \
			or context.bank_high != 0x1D or current_bank_low != 0x1C \
			or current_bank_high != 0x1D or int(_ram[0x0024]) != 0x1C \
			or int(_ram[0x0025]) != 0x1D or int(_ram[0x0000]) != 0x05 \
			or delay_in_a != context.accumulator or saved_x != context.x_register \
			or saved_y != context.y_register or not call_frame_already_pushed \
			or caller_stack_pointer != ((context.stack_pointer + 2) & 0xFF)):
		return _fail("Slot-$05 `$D80C->$CB0F` yield requires the wrapper-restored `$1C/$1D` pair and its source call frame.")
	if slot05_pass_receiver_wait_jsr_already_executed:
		var pass_frame_sp := (caller_stack_pointer - 2) & 0xFF
