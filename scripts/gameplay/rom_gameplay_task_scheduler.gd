func validate_slot05_field_input_iteration_worker_result(worker_result: Dictionary,
		live_boundary: Dictionary) -> bool:
	var blocked: Dictionary = worker_result.get("blocked_read", {})
	var registers: Dictionary = worker_result.get("registers", {})
	var mapper: Dictionary = worker_result.get("mapper", {})
	var dispatch: Dictionary = worker_result.get("source_dispatch", {})
	var ram: PackedByteArray = worker_result.get("ram_image", PackedByteArray())
	var stack: PackedByteArray = worker_result.get("stack_page", PackedByteArray())
	var calls: Array = worker_result.get("calls", [])
	var instructions: Array = worker_result.get("instructions", [])
	var spans: Array = worker_result.get("executed_source_spans", [])
	var entry_mapper_variant: Variant = worker_result.get("entry_mapper", {})
	var mapper_writes_variant: Variant = worker_result.get("mapper_writes", [])
	if not entry_mapper_variant is Dictionary or not mapper_writes_variant is Array:
		return false
	var entry_mapper: Dictionary = entry_mapper_variant
	var mapper_writes: Array = mapper_writes_variant
	var entry_bank_low := int(entry_mapper.get("bank_low", -1))
	var entry_bank_high := int(entry_mapper.get("bank_high", -1))
	var entry_select := int(entry_mapper.get("select", -1))
	var entry_mapper_pair_valid := (entry_bank_low == 0x1C and entry_bank_high == 0x1D) \
		or (entry_bank_low == 0x1A and entry_bank_high == 0x1B)
	var entry_mapper_matches_boundary := entry_bank_low == int(live_boundary.get("bank_low", -1)) \
		and entry_bank_high == int(live_boundary.get("bank_high", -1))
	var replay_bank_low := entry_bank_low
	var replay_bank_high := entry_bank_high
	var replay_select := entry_select
	var mapper_writes_valid := entry_select >= 0 and entry_select <= 7
	for mapper_write_variant in mapper_writes:
		if not mapper_write_variant is Dictionary:
			mapper_writes_valid = false
			break
		var mapper_write: Dictionary = mapper_write_variant
		var mapper_write_address := int(mapper_write.get("address", -1))
		var mapper_write_value := int(mapper_write.get("value", -1))
		if mapper_write_value < 0 or mapper_write_value > 0xFF:
			mapper_writes_valid = false
			break
		if mapper_write_address == 0x8000:
			replay_select = mapper_write_value & 0x07
		elif mapper_write_address == 0x8001:
			if replay_select == 6:
				replay_bank_low = mapper_write_value
			elif replay_select == 7:
				replay_bank_high = mapper_write_value
		else:
			mapper_writes_valid = false
			break
		if int(mapper_write.get("select", -1)) != replay_select:
			mapper_writes_valid = false
			break
	mapper_writes_valid = mapper_writes_valid \
		and replay_bank_low == int(mapper.get("bank_low", -1)) \
		and replay_bank_high == int(mapper.get("bank_high", -1)) \
		and replay_select == int(mapper.get("select", -1))
	var field_update_call_seen := false
	var field_update_vector_seen := false
	var field_update_body_seen := false
	for call_variant in calls:
		if call_variant is Dictionary:
			var field_call: Dictionary = call_variant
			if int(field_call.get("callsite", -1)) == 0xE44A \
					and int(field_call.get("target", -1)) == 0x8000 \
					and int(field_call.get("bank", -1)) == 0x1A:
				field_update_call_seen = true
	for span_variant in spans:
		if span_variant is Dictionary:
			var field_span: Dictionary = span_variant
			var field_file := String(field_span.get("file", ""))
			var field_hash := String(field_span.get("sha256", ""))
			if field_file == "bank1a_field_update_vector_8000_8003.bin" \
					and field_hash == "c0df1cc5bcf86345e2def10b6d19598ad9b60a0083c44c0cd85d3c6dd3b5ab60":
				field_update_vector_seen = true
			if field_file == "bank1b_field_update_A103_A1EB.bin" \
					and field_hash == "5dafe0a172016a8f0af211eacfe3771dc03a626102349b4e94980b407b7f3c9b":
				field_update_body_seen = true
	var mapper_is_entry_field_pair := int(mapper.get("bank_low", -1)) == 0x1C \
		and int(mapper.get("bank_high", -1)) == 0x1D
	var source_pair_inherited_from_valid_boundary := entry_bank_low == 0x1A \
		and entry_bank_high == 0x1B and entry_mapper_matches_boundary
	var mapper_is_source_field_pair := int(mapper.get("bank_low", -1)) == 0x1A \
		and int(mapper.get("bank_high", -1)) == 0x1B \
		and (source_pair_inherited_from_valid_boundary or (field_update_call_seen \
			and field_update_vector_seen and field_update_body_seen))
	var stopped_at_e147_yield := not bool(worker_result.get("ok", false)) \
		and String(worker_result.get("exit_kind", "")) == "unresolved_source_span" \
		and int(worker_result.get("exit_pc", -1)) == 0xCB0F \
		and int(blocked.get("instruction_pc", -1)) == 0xCB0F \
		and int(blocked.get("requested_address", -1)) == 0xCB0F \
		and int(blocked.get("bank", -1)) == 0x1E
	var stopped_before_e40f_yield := bool(worker_result.get("ok", false)) \
		and String(worker_result.get("status", "")) == "field_input_loop_before_yield" \
		and String(worker_result.get("exit_kind", "")) == "source_call_boundary" \
		and int(worker_result.get("exit_pc", -1)) == 0xE40F
	var expected_exit_pc := 0xCB0F if stopped_at_e147_yield else 0xE40F
	var expected_exit_bank := 0x1E if stopped_at_e147_yield else 0x1F
	if (not stopped_before_e40f_yield and not stopped_at_e147_yield) \
			or int(worker_result.get("exit_pc", -1)) != expected_exit_pc \
			or int(worker_result.get("exit_bank", -1)) != expected_exit_bank \
			or String(worker_result.get("source_manifest_sha256", "")) != FRESH_BANK18_WORKER_MANIFEST_SHA256 \
			or String(worker_result.get("rom_sha256", "")) != ROM_SHA256 \
			or String(worker_result.get("source_manifest", "")) != "res://reference/rom_extract/gameplay/fresh_bank18_worker_prefix/manifest.json" \
			or int(registers.get("pc", -1)) != expected_exit_pc \
			or int(registers.get("sp", -1)) < 0 or int(registers.get("sp", -1)) > 0xFF \
			or not entry_mapper_pair_valid or not entry_mapper_matches_boundary or not mapper_writes_valid \
			or (not mapper_is_entry_field_pair and not mapper_is_source_field_pair) \
			or int(dispatch.get("slot_base", -1)) != 0x05 \
			or String(dispatch.get("resume_path", "")) != "yielded_rts" \
			or int(dispatch.get("pc", -1)) != 0xE412 \
			or int(dispatch.get("bank", -1)) != 0x1F \
			or not bool(dispatch.get("source_dispatch_observed", false)) \
			or int(live_boundary.get("slot_base", -1)) != 0x05 \
			or int(live_boundary.get("active_task_slot", -1)) != 0x05 \
			or int(live_boundary.get("pc", -1)) != 0xE412 \
			or ram.size() != RAM_SIZE or stack.size() != STACK_PAGE_SIZE \
			or ram.slice(0x0100, 0x0200) != stack:
		return false
	var required_spans := {
		"fixed_field_loop_input_E349_E3CA.bin": "3a1a1c83d163815dce998784b05b41f3a58cda44c1569fea53667437bc353aa3",
		"fixed_field_loop_caller_E407_E4D7.bin": "e07bde65678d6656908c6e7e9bb06a806d8839f864f756e8240c0381a1662593",
	}
	if stopped_at_e147_yield:
		required_spans["bank1a_field_update_worker_vector_8033_8036.bin"] = "b8d46aa5989e7cbf82d3dc4084af85ddbce2093521597d3acfa54a188b0f40f6"
		required_spans["bank1a_field_update_dispatch_8E86_8EE9.bin"] = "49e8c3f18801c7d22107ca206ef219d6b0dd50d0ae7c5e736ad30487ed4a37ab"
	for name: String in required_spans:
		var found := false
		for span_variant in spans:
			if span_variant is Dictionary:
				var span: Dictionary = span_variant
				if String(span.get("file", "")) == name \
						and String(span.get("sha256", "")) == String(required_spans[name]):
					found = true
					break
		if not found:
			return false
	for span_variant in spans:
		if span_variant is Dictionary:
			var span: Dictionary = span_variant
			if String(span.get("file", "")) == "fixed_field_input_coordinate_scan_E4D7_E54C.bin" \
					and String(span.get("sha256", "")) != \
					"448596d4abd29afab035ed65bb2a2d7a1e3db71d4dd75b7fd4f298e3b8c86968":
				return false
	var field_input_call_seen := false
	for call_variant in calls:
		if call_variant is Dictionary:
			var call: Dictionary = call_variant
			if int(call.get("callsite", -1)) == 0xE412 \
					and int(call.get("target", -1)) == 0xE349:
				field_input_call_seen = true
	var input_routine_executed := false
	var e147_cb0f_call_seen := false
	var e22d_vector_call_seen := false
	for instruction_variant in instructions:
		if instruction_variant is Dictionary:
			var instruction: Dictionary = instruction_variant
			var pc := int(instruction.get("pc", -1))
			if pc >= 0xE349 and pc < 0xE3CA:
				input_routine_executed = true
	for call_variant in calls:
		if not call_variant is Dictionary:
			continue
		var call: Dictionary = call_variant
		var callsite := int(call.get("callsite", -1))
		var target := int(call.get("target", -1))
		if callsite == 0xE147 and target == 0xCB0F and stopped_at_e147_yield \
				and int(call.get("bank", -1)) == 0x1E \
				and int(call.get("sp_after_push", -1)) == int(registers.get("sp", -2)):
			e147_cb0f_call_seen = true
		if callsite == 0xE22D and target == 0x8033 and int(call.get("bank", -1)) == 0x1A:
			e22d_vector_call_seen = true
	if stopped_at_e147_yield:
		var sp := int(registers.get("sp", -1))
		if sp < 0 or int(stack[(sp + 1) & 0xFF]) != 0x49 \
				or int(stack[(sp + 2) & 0xFF]) != 0xE1:
			return false
	return field_input_call_seen and input_routine_executed \
		and (not stopped_at_e147_yield or (e147_cb0f_call_seen and e22d_vector_call_seen))


