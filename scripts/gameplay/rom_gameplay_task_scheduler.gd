		"ppu_queue_packets": packets.duplicate(true),
		"ppu_queue_buffer_bytes": result.get("ppu_queue_buffer_bytes", PackedByteArray()),
		"ppu_queue_buffer_length": int(result.get("ppu_queue_buffer_length", -1)),
		"next_boundary_snapshot": next_boundary,
		"trace_state_used": false,
	}


## Replays the source-owned PASS caller's ordered RAM/stack and MMC3 effects
## from live `$D68A` through its no-candidates `$D6C7` return.
func adopt_first_action_pass_no_candidates_result(result: Dictionary) -> Dictionary:
	if not _require_initialized():
		return {"ok": false, "status": "scheduler_not_ready", "error": error_message}
	var context: TaskContext = _contexts.get(0x05)
	if not _slot05_pass_selection_adopted or not _slot05_pass_handler_dispatch_pending \
			or _active_task_slot != 0x05 or int(_ram[0x0000]) != 0x05 \
			or context == null or context.phase != ContextPhase.RUNNING \
			or context.program_counter != 0xD68A \
			or context.bank_low != 0x1A or context.bank_high != 0x1B \
			or int(_ram[0x0024]) != 0x1A or int(_ram[0x0025]) != 0x1B \
			or int(_ram[0x043B]) != 0x01 or int(_ram[0x0441]) != 0x06:
		return _first_action_input_adoption_failure(
			"PASS caller adoption requires the live slot-$05 `$D68A` state after its label renderer return.")
	for forbidden_key in ["fceux_ram", "captured_ram", "trace_ram", "emulator_snapshot",
			"screenshot", "capture_image", "source_ram_image", "source_stack_page"]:
		if result.has(forbidden_key):
			return _first_action_input_adoption_failure(
				"PASS caller adoption uses ordered ROM events; emulator/capture state is forbidden.")
	var writes_variant: Variant = result.get("source_writes", [])
	var stack_writes_variant: Variant = result.get("source_stack_writes", [])
	var registers_variant: Variant = result.get("registers", {})
	var mapper_variant: Variant = result.get("mapper", {})
	var boundary_variant: Variant = result.get("d6c7_boundary", {})
	var instruction_pcs_variant: Variant = result.get("source_instruction_pcs", [])
	var reads_variant: Variant = result.get("source_reads", [])
	if not writes_variant is Array or not stack_writes_variant is Array \
			or not registers_variant is Dictionary or not mapper_variant is Dictionary \
			or not boundary_variant is Dictionary or not instruction_pcs_variant is Array \
			or not reads_variant is Array:
		return _first_action_input_adoption_failure(
			"PASS caller result omits source events, registers, mapper state, or its `$D6C7` boundary proof.")
	var registers: Dictionary = registers_variant
	var mapper: Dictionary = mapper_variant
	var d6c7_boundary: Dictionary = boundary_variant
	var instruction_pcs: Array = instruction_pcs_variant
	var renderer_receipt: Dictionary = result.get("renderer_return", {})
	var bank_registers_variant: Variant = mapper.get("bank_registers_at_d6c7", {})
	if not bank_registers_variant is Dictionary:
		return _first_action_input_adoption_failure("PASS caller mapper result omits MMC3 bank-register state.")
	var bank_registers: Dictionary = bank_registers_variant
	var source_contract_checks := {
		"ok": bool(result.get("ok", false)),
		"status": String(result.get("status", "")) == "pass_no_candidates_reached_live_d6c7",
		"rom_hash": String(result.get("rom_sha256", "")) == ROM_SHA256,
		"manifest_hash": String(result.get("source_manifest_sha256", "")) == "36dd9b74944ef15accef3ccc5cc4bce3b691af99856886fb7a2d89a03a178fa8",
		"trace_free": not bool(result.get("trace_state_used", true)) and not bool(result.get("emulator_data_used", true)),
		"scope": not bool(result.get("source_cycle_timing_modeled", true)) and not bool(result.get("ppu_apu_effects_applied", true)) and not bool(result.get("instruction_level_parity_claimed", true)),
		"no_ppu_apu_events": result.get("ppu_events", []) == [] and result.get("apu_events", []) == [],
		"source_pcs": int(result.get("source_boundary_pc", -1)) == 0xD68A and int(result.get("source_exit_pc", -1)) == 0xD6C7,
		"stack": int(result.get("entry_sp", -1)) == context.stack_pointer and int(result.get("final_sp", -1)) == int(registers.get("sp", -2)) and int(registers.get("sp", -1)) == 0x4A,
		"cpu": int(registers.get("pc", -1)) == 0xD6C7 and int(registers.get("a", -1)) == 0x01 and int(registers.get("x", -1)) == 0x04 and int(registers.get("y", -1)) == 0x02,
		"boundary": int(d6c7_boundary.get("pc", -1)) == 0xD6C7 and int(d6c7_boundary.get("sp", -1)) == int(registers.get("sp", -2)) and d6c7_boundary.get("bank_low", -1) == 0x1A and d6c7_boundary.get("bank_high", -1) == 0x1B,
		"mapper": int(bank_registers.get(6, bank_registers.get("6", -1))) == 0x1C and int(bank_registers.get(7, bank_registers.get("7", -1))) == 0x1D and int(mapper.get("fixed_bank", -1)) == 0x1E and mapper.get("saved_task_bank_pair", []) == [0x1A, 0x1B],
		"renderer_receipt": int(renderer_receipt.get("entry_pc", -1)) == 0xE945 and int(renderer_receipt.get("return_pc", -1)) == 0xD68A and bool(renderer_receipt.get("returned_via_rts", false)),
		"source_path": instruction_pcs.has(0xD68A) and instruction_pcs.has(0xD6C4),
	}
	var failed_source_contracts: Array[String] = []
	for contract_name: String in source_contract_checks:
		if not bool(source_contract_checks[contract_name]):
			failed_source_contracts.append(contract_name)
	if not failed_source_contracts.is_empty():
		return _first_action_input_adoption_failure(
			"PASS caller source contract failed: " + ", ".join(failed_source_contracts) + ".")
	var expected_ram := _ram.duplicate()
	var expected_stack := _stack_page.duplicate()
	for write_variant: Variant in writes_variant:
		if not write_variant is Dictionary:
			return _first_action_input_adoption_failure("PASS caller emitted a malformed source RAM write.")
		var write: Dictionary = write_variant
		var address := int(write.get("address", -1))
		var value := int(write.get("value", -1))
		if address < 0 or address >= RAM_SIZE or value < 0 or value > 0xFF:
			return _first_action_input_adoption_failure("PASS caller source write escaped scheduler-owned RAM.")
		expected_ram[address] = value
		if address >= 0x0100 and address < 0x0200:
			expected_stack[address & 0xFF] = value
	for write_variant: Variant in stack_writes_variant:
		if not write_variant is Dictionary:
			return _first_action_input_adoption_failure("PASS caller emitted a malformed stack write.")
		var write: Dictionary = write_variant
		var address := int(write.get("address", -1))
		var value := int(write.get("value", -1))
		if address < 0x0100 or address >= 0x0200 or value < 0 or value > 0xFF:
			return _first_action_input_adoption_failure("PASS caller stack write escaped the source stack page.")
		expected_stack[address & 0xFF] = value
		expected_ram[address] = value
	var result_ram: Variant = d6c7_boundary.get("ram_image", PackedByteArray())
	var result_stack: Variant = d6c7_boundary.get("stack_page", PackedByteArray())
	if not result_ram is PackedByteArray or result_ram != expected_ram \
			or not result_stack is PackedByteArray or result_stack != expected_stack \
			or expected_ram.slice(0x0100, 0x0200) != expected_stack \
			or int(expected_ram[0x0430]) != 0 or int(expected_ram[0x043B]) != 0x01 \
		or int(expected_ram[0x043C]) != 0 or int(expected_ram[0x0441]) != 0x06 \
		or int(expected_ram[0x0024]) != 0x1C or int(expected_ram[0x0025]) != 0x1D:
		return _first_action_input_adoption_failure(
			"PASS caller replay does not reproduce its complete `$D6C7` RAM/stack/mapper-shadow boundary while preserving task bank bytes `$1A/$1B` separately from the MMC3 `$1C/$1D` register pair.")
	_ram = expected_ram
	_stack_page = expected_stack
	context.program_counter = 0xD6C7
	context.stack_pointer = int(registers["sp"]) & 0xFF
	context.accumulator = int(registers["a"]) & 0xFF
	context.x_register = int(registers["x"]) & 0xFF
	context.y_register = int(registers["y"]) & 0xFF
	context.status_register = int(registers.get("p", 0x20)) | 0x20
	context.status_known_mask = int(registers.get("p_known_mask", 0)) & 0xFF
	context.mapper_state = mapper.duplicate(true)
	context.source_label = "ROM-byte PASS no-candidates continuation `$D68A->$D6C7`"
	var next_boundary := get_task_boundary_snapshot(0x05)
	next_boundary["executing_cpu_bank"] = 0x1E
	next_boundary["mapper_proof"] = {"bank_registers_at_d6c7": bank_registers.duplicate(true),
		"saved_task_bank_pair": [0x1A, 0x1B], "fixed_bank": 0x1E}
	return {"ok": true, "status": "pass_no_candidates_continuation_adopted",
		"source_pc": 0xD68A, "context_pc": context.program_counter,
		"context_sp": context.stack_pointer,
		"source_writes_applied": writes_variant.duplicate(true),
		"source_stack_writes_applied": stack_writes_variant.duplicate(true),
		"mapper_state_applied": mapper.duplicate(true),
		"next_boundary_snapshot": next_boundary, "trace_state_used": false}


## Replays the handler's ROM-owned scenario request and nested JSR frames from
