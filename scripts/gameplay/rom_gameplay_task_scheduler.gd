		callsite in [0xCC50, 0xCCA0, 0xCCCE, 0x82E0] \
		and int(call_request.get("target_pc", -1)) == expected_target \
		and int(call_request.get("target_bank", -1)) == 0x1E \
		and call_request.get("source_bytes", PackedByteArray()) == PackedByteArray([0x20,
			0x15 if expected_target == 0xC515 else 0x0F,
			0xC5 if expected_target == 0xC515 else 0xCB])
	var first_ram_mismatch := "none"
	if result_ram is PackedByteArray and result_ram.size() == RAM_SIZE and expected_ram.size() == RAM_SIZE:
		for address in RAM_SIZE:
			if result_ram[address] != expected_ram[address]:
				first_ram_mismatch = "$%04X:%02X!=%02X" % [address, result_ram[address], expected_ram[address]]
