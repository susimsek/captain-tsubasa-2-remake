			or int(source_registers.get("x", -1)) != 0x01 \
			or int(source_registers.get("sp", -1)) != 0x4E \
			or int(source_stack[0x4F]) != 0xF0 or int(source_stack[0x50]) != 0xE1 \
			or source_ram.slice(0x0100, 0x0200) != source_stack \
			or source_writes.size() != int(counts["field_e14a_to_d193"]) \
			or int(counts["field_e14a_to_d193"]) + int(counts["d193_to_ef7f"]) \
				+ int(counts["renderer_to_cb0f"]) != writes.size():
		return _fail("Clock-tick worker D193 entry registers, caller frame, or ordered write counts do not match.")
	if int(handoff.get("yield_jsr_callsite", -1)) < 0 \
			or not _clock_tick_call_seen(calls, 0xD1CF, 0xEF7F) \
			or not _clock_tick_call_seen(calls, 0xEF96, 0x800C) \
			or not _clock_tick_call_seen(calls, int(handoff.get("yield_jsr_callsite", -1)), 0xC515) \
			or not _clock_tick_instruction_seen(instructions, 0xD1CF, 0x20, 0xEF7F) \
			or not _clock_tick_instruction_seen(instructions, 0xEF96, 0x20, 0x800C) \
			or not _clock_tick_instruction_seen(instructions, 0xC515, 0x4C, 0xCB0F):
		return _fail("Clock-tick worker lacks the ordered `$D1CF->$EF7F->$800C->$C515->$CB0F` ROM control-flow proof.")
	var yield_call: Dictionary = {}
	for call_variant in calls:
		if call_variant is Dictionary:
			var call_record: Dictionary = call_variant
			if int(call_record.get("callsite", -1)) == int(handoff["yield_jsr_callsite"]) \
					and int(call_record.get("target", -1)) == 0xC515:
				yield_call = call_record
				break
	var final_sp := int(result_registers["sp"])
	var yield_return_minus_one := (int(handoff["yield_jsr_callsite"]) + 2) & 0xFFFF
	if yield_call.is_empty() or int(yield_call.get("sp_after_push", -1)) != final_sp \
			or int(result_stack[(final_sp + 1) & 0xFF]) != (yield_return_minus_one & 0xFF) \
			or int(result_stack[(final_sp + 2) & 0xFF]) != ((yield_return_minus_one >> 8) & 0xFF) \
			or int(result_stack[0x4F]) != 0xF0 or int(result_stack[0x50]) != 0xE1:
		return _fail("Clock-tick worker did not preserve its real C515 JSR frame and outer `$E1F0` return word.")
	if not _clock_tick_span_seen(spans, "fixed_clock_tick_D193_D299.bin",
			"0de1ae062da8a31a6c880faf16b20783941bad266539895c817d1fede1bf9e57") \
			or not _clock_tick_span_seen(spans, "fixed_record_pointer_resolver_CD7C_CD89.bin",
				"8d7d8153252420175055aa5ef041e0e9dd85f99bb9dae8e24200e9549487ed24") \
			or not _clock_tick_span_seen(spans, "fixed_record_pointer_table_CD89_CDB5.bin",
				"b09fe4a47e9910198fc6b2599caebe85071c4292d6f07f089d8dd7848b2e7185") \
			or not _clock_tick_span_seen(spans, "bank18_worker_entry_to_yield_call_800C_8889.bin",
				"3b6cea5d679e0a5aab87d7bd5a721658448463cec6062ad006c3d5d869aeb49e") \
			or not _clock_tick_span_seen(spans, "fixed_task_yield_trampoline_C515_C518.bin",
				"86545169e2c9775f9eb73d63e59343ec9fff70a55fb97b17b22b39ab2fcd1d1e") \
			or not _clock_tick_span_seen(spans, "fixed_bank18_wrapper_EF7F_EF99.bin",
				"8871a231231e221f0a7394c1a1762acdd8fe6d5a68babb454b5bbdb5f5192e0e"):
		return _fail("Clock-tick worker executed-source spans omit or mismatch its ROM source dependencies.")
	var expected_ram := live_ram.duplicate()
	var expected_stack := live_stack.duplicate()
	var expected_mapper: Dictionary = live_mapper.duplicate(true)
	var source_expected_ram := expected_ram.duplicate()
	var source_expected_stack := expected_stack.duplicate()
	var source_expected_mapper: Dictionary = expected_mapper.duplicate(true)
	for index in range(writes.size()):
		var write_variant: Variant = writes[index]
		if not write_variant is Dictionary:
			return _fail("Clock-tick worker ordered RAM writes contain a malformed event.")
		var write: Dictionary = write_variant
		var address := int(write.get("address", -1))
		var value := int(write.get("value", -1))
		if address < 0 or address >= RAM_SIZE or value < 0 or value > 0xFF \
				or _is_scheduler_owned_ram_address(address):
			return _fail("Clock-tick worker wrote invalid or scheduler-owned RAM `$%04X`." % address)
		expected_ram[address] = value
		if address >= 0x0100 and address < 0x0200:
			expected_stack[address & 0xFF] = value
		if index + 1 == source_writes.size():
			source_expected_ram = expected_ram.duplicate()
			source_expected_stack = expected_stack.duplicate()
	if source_writes.is_empty():
		source_expected_ram = expected_ram.duplicate()
		source_expected_stack = expected_stack.duplicate()
	for index in range(source_writes.size()):
		if writes[index] != source_writes[index]:
			return _fail("Clock-tick worker output does not preserve the live E14A-to-D193 write prefix.")
	if source_expected_ram != source_ram or source_expected_stack != source_stack \
			or expected_ram != result_ram or expected_stack != result_stack \
			or result_ram.slice(0x0100, 0x0200) != result_stack:
		return _fail("Clock-tick worker RAM/stack differs from replaying ordered ROM writes over live E14A state.")
	for index in range(source_mapper_writes.size()):
		if index >= mapper_writes.size() or mapper_writes[index] != source_mapper_writes[index]:
			return _fail("Clock-tick worker output does not preserve the live E14A-to-D193 mapper-write prefix.")
	for index in range(mapper_writes.size()):
		var mapper_write_variant: Variant = mapper_writes[index]
		if not mapper_write_variant is Dictionary:
			return _fail("Clock-tick worker ordered mapper writes contain a malformed event.")
		var mapper_write: Dictionary = mapper_write_variant
		var mapper_address := int(mapper_write.get("address", -1))
		var mapper_value := int(mapper_write.get("value", -1))
		if mapper_address == 0x8000 and mapper_value >= 0 and mapper_value <= 0xFF:
			expected_mapper["select"] = mapper_value & 0x07
		elif mapper_address == 0x8001 and mapper_value >= 0 and mapper_value <= 0xFF:
			if int(expected_mapper.get("select", -1)) == 6:
				expected_mapper["bank_low"] = mapper_value
			elif int(expected_mapper.get("select", -1)) == 7:
				expected_mapper["bank_high"] = mapper_value
		else:
			return _fail("Clock-tick worker mapper write is outside the MMC3 register contract.")
		if index + 1 == source_mapper_writes.size():
			source_expected_mapper = expected_mapper.duplicate(true)
	if source_mapper_writes.is_empty():
		source_expected_mapper = expected_mapper.duplicate(true)
	# Replaying the source-boundary prefix independently must reach the nested
	# `$D193` mapper snapshot before the remainder of the worker trace is applied.
	var source_expected_mapper_replay: Dictionary = live_mapper.duplicate(true)
	for mapper_write_variant in source_mapper_writes:
		var mapper_write: Dictionary = mapper_write_variant
		var mapper_address := int(mapper_write.get("address", -1))
		var mapper_value := int(mapper_write.get("value", -1))
		if mapper_address == 0x8000:
			source_expected_mapper_replay["select"] = mapper_value & 0x07
		elif mapper_address == 0x8001:
			if int(source_expected_mapper_replay.get("select", -1)) == 6:
				source_expected_mapper_replay["bank_low"] = mapper_value
			elif int(source_expected_mapper_replay.get("select", -1)) == 7:
				source_expected_mapper_replay["bank_high"] = mapper_value
	var source_mapper_variant: Variant = source_boundary.get("mapper", {})
	if not source_mapper_variant is Dictionary:
		return _fail("Clock-tick worker D193 entry omits its mapper snapshot.")
	var source_mapper: Dictionary = source_mapper_variant
	if int(source_expected_mapper_replay.get("bank_low", -1)) != int(source_mapper.get("bank_low", -2)) \
			or int(source_expected_mapper_replay.get("bank_high", -1)) != int(source_mapper.get("bank_high", -2)) \
			or int(source_expected_mapper_replay.get("select", -1)) != int(source_mapper.get("select", -2)) \
			or int(expected_mapper.get("bank_low", -1)) != int(result_mapper.get("bank_low", -2)) \
			or int(expected_mapper.get("bank_high", -1)) != int(result_mapper.get("bank_high", -2)) \
			or int(expected_mapper.get("select", -1)) != int(result_mapper.get("select", -2)):
		return _fail("Clock-tick worker mapper output differs from replaying ordered MMC3 writes.")
	_ram = expected_ram
	_stack_page = expected_stack
	context.accumulator = int(result_registers.get("a", 0)) & 0xFF
	context.x_register = int(result_registers.get("x", 0)) & 0xFF
	context.y_register = int(result_registers.get("y", 0)) & 0xFF
	context.status_register = int(result_registers.get("p", 0)) & 0xFF
	context.status_known_mask = int(result_registers.get("p_known_mask", 0)) & 0xFF
	context.stack_pointer = final_sp
	context.program_counter = 0xCB0F
	context.bank_low = int(result_mapper["bank_low"])
	context.bank_high = int(result_mapper["bank_high"])
	context.mapper_state = result_mapper.duplicate(true)
	context.source_label = "ROM-byte slot-$05 clock tick yielded at `$CB0F`; scheduler continuation pending"
	_slot05_clock_tick_yield_in_progress = true
	return true


func _clock_tick_call_seen(calls: Array, callsite: int, target: int) -> bool:
	for call_variant in calls:
		if call_variant is Dictionary:
			var call: Dictionary = call_variant
			if int(call.get("callsite", -1)) == callsite and int(call.get("target", -1)) == target:
				return true
	return false


func _clock_tick_instruction_seen(instructions: Array, pc: int, opcode: int,
		next_pc: int) -> bool:
	for instruction_variant in instructions:
		if instruction_variant is Dictionary:
			var instruction: Dictionary = instruction_variant
			if int(instruction.get("pc", -1)) == pc \
					and int(instruction.get("opcode", -1)) == opcode \
					and int(instruction.get("next_pc", -1)) == next_pc:
				return true
	return false


func _clock_tick_span_seen(spans: Array, file_name: String, sha256: String) -> bool:
	for span_variant in spans:
		if span_variant is Dictionary:
			var span: Dictionary = span_variant
			if String(span.get("file", "")) == file_name \
					and String(span.get("sha256", "")) == sha256:
				return true
	return false


## Adopts one source-worker continuation from the active slot-$05 `$BD9C`
## boundary. This method cannot dispatch, resume another slot, or alter the
## scheduler-owned task record / ready latch.
func adopt_active_slot05_worker_continuation_state(live_boundary: Dictionary,
		previous_worker_result: Dictionary, worker_result: Dictionary) -> bool:
	if not _require_initialized():
		return false
	var context: TaskContext = _contexts.get(0x05)
	var previous_blocked: Dictionary = previous_worker_result.get("blocked_read", {})
	var source_continuation: Dictionary = worker_result.get("source_continuation", {})
	var registers: Dictionary = worker_result.get("registers", {})
	var mapper: Dictionary = worker_result.get("mapper", {})
	var blocked: Dictionary = worker_result.get("blocked_read", {})
	var result_ram: PackedByteArray = worker_result.get("ram_image", PackedByteArray())
	var result_stack: PackedByteArray = worker_result.get("stack_page", PackedByteArray())
	var writes: Array = worker_result.get("writes", [])
	var mapper_writes: Array = worker_result.get("mapper_writes", [])
	var live_ram: PackedByteArray = live_boundary.get("ram_image", PackedByteArray())
	var live_stack: PackedByteArray = live_boundary.get("stack_page", PackedByteArray())
	if _active_task_slot != 0x05 or context == null or context.phase != ContextPhase.RUNNING \
			or context.program_counter != 0x89A0 \
			or int(live_boundary.get("slot_base", -1)) != 0x05 \
			or int(live_boundary.get("active_task_slot", -1)) != 0x05 \
			or int(live_boundary.get("pc", -1)) != 0x89A0 \
			or int(previous_blocked.get("requested_address", -1)) != 0xBD9C \
			or int(source_continuation.get("entry_pc", -1)) != 0x89A0 \
			or int(source_continuation.get("source_pointer", -1)) != 0xBD9C \
			or String(worker_result.get("exit_kind", "")) != "yield_at_c515" \
			or int(worker_result.get("exit_pc", -1)) != 0xC515 \
			or not blocked.is_empty() \
			or String(worker_result.get("rom_sha256", "")) != ROM_SHA256 \
			or live_ram.size() != RAM_SIZE or live_stack.size() != STACK_PAGE_SIZE \
			or result_ram.size() != RAM_SIZE or result_stack.size() != STACK_PAGE_SIZE \
			or _ram != live_ram or _stack_page != live_stack:
		return _fail("Slot-$05 worker adoption requires the unchanged active `$BD9C` boundary and a stop before `$BBE3`.")
	var previous_ram: PackedByteArray = previous_worker_result.get("ram_image", PackedByteArray())
	var previous_stack: PackedByteArray = previous_worker_result.get("stack_page", PackedByteArray())
	if previous_ram != live_ram or previous_stack != live_stack \
			or int(live_boundary.get("bank_low", -1)) != 0x18 \
			or int(live_boundary.get("bank_high", -1)) != 0x19 \
			or int(mapper.get("bank_low", -1)) != 0x18 \
			or int(mapper.get("bank_high", -1)) != 0x19 \
			or int(registers.get("pc", -1)) != 0xC515:
		return _fail("Slot-$05 continuation changed the live input snapshot or returned outside its bank pair.")
	var expected_ram := live_ram.duplicate()
	var expected_stack := live_stack.duplicate()
	for write_variant in writes:
		if not write_variant is Dictionary:
			return _fail("Slot-$05 continuation write stream contains a malformed event.")
		var write: Dictionary = write_variant
		var address := int(write.get("address", -1))
		var value := int(write.get("value", -1))
		if address < 0 or address >= RAM_SIZE or value < 0 or value > 0xFF \
				or _is_scheduler_owned_ram_address(address):
			return _fail("Slot-$05 continuation writes invalid or scheduler-owned RAM `$%04X`." % address)
		expected_ram[address] = value
		if address >= 0x0100 and address < 0x0200:
			expected_stack[address & 0xFF] = value
	for mapper_write_variant in mapper_writes:
		if not mapper_write_variant is Dictionary:
			return _fail("Slot-$05 continuation mapper write stream is malformed.")
		var mapper_write: Dictionary = mapper_write_variant
		if int(mapper_write.get("address", -1)) not in [0x8000, 0x8001] \
				or int(mapper_write.get("value", -1)) < 0 or int(mapper_write.get("value", -1)) > 0xFF:
			return _fail("Slot-$05 continuation mapper write is outside the MMC3 register contract.")
	if result_ram != expected_ram or result_stack != expected_stack \
			or result_ram.slice(0x0100, 0x0200) != result_stack:
		return _fail("Slot-$05 continuation output differs from ordered writes over live RAM/stack state.")
	_ram = expected_ram
	_stack_page = expected_stack
	context.accumulator = int(registers.get("a", 0)) & 0xFF
	context.x_register = int(registers.get("x", 0)) & 0xFF
	context.y_register = int(registers.get("y", 0)) & 0xFF
	context.status_register = int(registers.get("p", 0)) & 0xFF
	context.status_known_mask = int(registers.get("p_known_mask", 0)) & 0xFF
	context.stack_pointer = int(registers.get("sp", -1))
	context.program_counter = 0xC515
	context.bank_low = int(mapper["bank_low"])
	context.bank_high = int(mapper["bank_high"])
	context.source_label = "ROM-byte slot-$05 descriptor `$EE` continuation yielded at `$C515`"
	return true


func _slot05_ed_row00_boundary_matches(worker_result: Dictionary,
		worker_descriptor_contract: Dictionary) -> bool:
	var blocked_variant: Variant = worker_result.get("blocked_read", {})
	var registers_variant: Variant = worker_result.get("registers", {})
	var mapper_variant: Variant = worker_result.get("mapper", {})
	var ram_variant: Variant = worker_result.get("ram_image", PackedByteArray())
	var stack_variant: Variant = worker_result.get("stack_page", PackedByteArray())
	if not blocked_variant is Dictionary or not registers_variant is Dictionary \
			or not mapper_variant is Dictionary or not ram_variant is PackedByteArray \
			or not stack_variant is PackedByteArray:
		return false
	var blocked: Dictionary = blocked_variant
	var registers: Dictionary = registers_variant
	var mapper: Dictionary = mapper_variant
	var ram: PackedByteArray = ram_variant
	var stack: PackedByteArray = stack_variant
	var source_stop_variant: Variant = worker_result.get("source_boundary_stop", {})
	if not source_stop_variant is Dictionary:
		return false
	var source_stop: Dictionary = source_stop_variant
	var worker_manifest_sha256 := String(worker_result.get("source_manifest_sha256", ""))
	var descriptor_manifest_sha256 := String(worker_descriptor_contract.get("source_manifest_sha256", ""))
	if bool(worker_result.get("ok", true)) \
			or String(worker_result.get("exit_kind", "")) != "source_read_boundary" \
			or int(source_stop.get("address", -1)) != 0xBD9C \
			or not bool(source_stop.get("source_bytes_available", false)) \
			or worker_manifest_sha256.is_empty() \
			or worker_manifest_sha256 != descriptor_manifest_sha256 \
			or String(worker_descriptor_contract.get("status", "")) != "descriptor_source_validated_for_live_worker" \
			or int(worker_descriptor_contract.get("second_descriptor_pointer_cpu", -1)) != 0xB464 \
			or int(worker_descriptor_contract.get("descriptor01_text_pointer_cpu", -1)) != 0xBBE0 \
			or String(worker_descriptor_contract.get("descriptor01_row00_hex", "")) != "ed00fc" \
			or int(worker_descriptor_contract.get("descriptor01_next_row_pointer_cpu", -1)) != 0xBD9C \
			or bool(worker_descriptor_contract.get("descriptor01_next_row_executed", true)) \
			or int(worker_result.get("exit_pc", -1)) != 0x89A0 \
			or int(blocked.get("instruction_pc", -1)) != 0x89A0 \
			or int(blocked.get("requested_address", -1)) != 0xBD9C \
			or int(blocked.get("bank", -1)) != 0x19 \
			or int(registers.get("pc", -1)) != 0x89A0 \
			or int(mapper.get("bank_low", -1)) != 0x18 or int(mapper.get("bank_high", -1)) != 0x19 \
			or ram.size() != RAM_SIZE or stack.size() != STACK_PAGE_SIZE \
			or int(ram[0x003E]) != 0x9C or int(ram[0x003F]) != 0xBD \
			or int(ram[0x002A]) != 0 or int(ram[0x003C]) != 1 \
			or int(ram[0x0515]) != 1 or int(ram[0x05C5]) != 0:
		return false
	var required_spans := {
		"bank19_resumed_worker_descriptor01_row00_BBE0_BBE3.bin": false,
		"bank18_ed_team_handler_8AE7_8B0A.bin": false,
		"bank18_ed_text_loop_8A56_8A86.bin": false,
		"fixed_team_00_name_stream_F776_F77C.bin": false,
	}
	var spans_variant: Variant = worker_result.get("executed_source_spans", [])
	if not spans_variant is Array:
		return false
	for span_variant in spans_variant:
		if span_variant is Dictionary:
			var name := String((span_variant as Dictionary).get("file", ""))
			if required_spans.has(name):
				required_spans[name] = true
	for name in required_spans:
		if not bool(required_spans[name]):
			return false
	var row_clear_seen := false
	var row_increment_seen := false
	var writes_variant: Variant = worker_result.get("writes", [])
	if not writes_variant is Array:
		return false
	for write_variant in writes_variant:
		if write_variant is Dictionary:
			var write: Dictionary = write_variant
			if int(write.get("address", -1)) == 0x003C and int(write.get("pc", -1)) == 0x8954 \
					and int(write.get("value", -1)) == 0:
				row_clear_seen = true
			if int(write.get("address", -1)) == 0x003C and int(write.get("pc", -1)) == 0x8960 \
					and int(write.get("value", -1)) == 1:
				row_increment_seen = true
	return row_clear_seen and row_increment_seen


## Accepts only the live field-setup worker that executed
## `$E0E9->$E233->$CBB0` and reached `$CBBE->$CB0F` with field scenario `$1E` queued.
func validate_slot05_field_entry_enqueue_worker_result(worker_result: Dictionary) -> bool:
	var blocked_variant: Variant = worker_result.get("blocked_read", {})
	var registers_variant: Variant = worker_result.get("registers", {})
	var mapper_variant: Variant = worker_result.get("mapper", {})
	var entry_mapper_variant: Variant = worker_result.get("entry_mapper", {})
	var source_dispatch_variant: Variant = worker_result.get("source_dispatch", {})
	var ram_variant: Variant = worker_result.get("ram_image", PackedByteArray())
	var stack_variant: Variant = worker_result.get("stack_page", PackedByteArray())
	if not blocked_variant is Dictionary or not registers_variant is Dictionary \
			or not mapper_variant is Dictionary or not entry_mapper_variant is Dictionary \
			or not source_dispatch_variant is Dictionary \
			or not ram_variant is PackedByteArray or not stack_variant is PackedByteArray:
		return false
	var blocked: Dictionary = blocked_variant
	var registers: Dictionary = registers_variant
	var mapper: Dictionary = mapper_variant
	var entry_mapper: Dictionary = entry_mapper_variant
	var source_dispatch: Dictionary = source_dispatch_variant
	var ram: PackedByteArray = ram_variant
	var stack: PackedByteArray = stack_variant
	if bool(worker_result.get("ok", true)) \
			or String(worker_result.get("exit_kind", "")) != "unresolved_source_span" \
			or int(worker_result.get("exit_pc", -1)) != 0xCB0F \
			or String(worker_result.get("source_manifest_sha256", "")) != FRESH_BANK18_WORKER_MANIFEST_SHA256 \
			or int(blocked.get("instruction_pc", -1)) != 0xCB0F \
			or int(blocked.get("requested_address", -1)) != 0xCB0F \
			or int(blocked.get("bank", -1)) != 0x1E \
			or int(registers.get("pc", -1)) != 0xCB0F \
			or not ((int(mapper.get("bank_low", -1)) == 0x1C \
				and int(mapper.get("bank_high", -1)) == 0x1D) \
				or (int(entry_mapper.get("bank_low", -1)) == 0x18 \
				and int(entry_mapper.get("bank_high", -1)) == 0x19 \
				and int(mapper.get("bank_low", -1)) == 0x1A \
				and int(mapper.get("bank_high", -1)) == 0x1B)) \
			or String(worker_result.get("rom_sha256", "")) != ROM_SHA256 \
			or String(worker_result.get("source_manifest", "")) != "res://reference/rom_extract/gameplay/fresh_bank18_worker_prefix/manifest.json" \
			or int(source_dispatch.get("slot_base", -1)) != 0x05 \
			or String(source_dispatch.get("resume_path", "")) != "yielded_rts" \
			or int(source_dispatch.get("pc", -1)) != 0x8889 \
			or not bool(source_dispatch.get("source_dispatch_observed", false)) \
			or ram.size() != RAM_SIZE or stack.size() != STACK_PAGE_SIZE \
			or ram.slice(0x0100, 0x0200) != stack \
			or int(ram[0x0516]) != 0x80 or int(ram[0x0518]) != 0x1E \
			or int(ram[0x0005]) != 0 or int(ram[0x0629]) != 0:
		return false
