	if result_ram is PackedByteArray and expected_ram.size() == result_ram.size():
		for address in range(RAM_SIZE):
			if int(result_ram[address]) != int(expected_ram[address]):
				ram_differences.append("$%04X:%02X/%02X" % [address, int(expected_ram[address]), int(result_ram[address])])
				if ram_differences.size() >= 6:
