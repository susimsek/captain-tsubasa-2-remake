		== "slot11_actor_event_payload_at_cb0f"
	var is_event_queue_result := String(worker_result.get("status", "")) \
		== "slot11_actor_event_queue_at_cb0f"
	var is_parameter47_f2_waiter := _is_slot11_parameter47_waiter_lineage(worker_result)
	var is_scenario1c_parameter00_f2_waiter := \
		_is_slot11_scenario1c_parameter00_f2_waiter_lineage(worker_result)
	var is_scenario2e_actor6d_f2_waiter := \
		_is_slot11_scenario2e_actor6d_f2_waiter_lineage(worker_result)
	var is_scenario1c_f2_waiter := is_parameter47_f2_waiter or is_scenario1c_parameter00_f2_waiter
	var is_event_result := is_event_payload_result or is_event_queue_result
	var is_parameter47_f2_tail_entry := is_parameter47_f2_waiter and entry_pc == 0xCCA3
	var is_parameter47_f2_tail_callsite := is_parameter47_f2_waiter and callsite_pc in [0xCCA0, 0xCCCE]
	var is_scenario1c_f2_tail_entry := is_scenario1c_parameter00_f2_waiter and entry_pc == 0xCCA3
	var is_scenario1c_f2_tail_callsite := is_scenario1c_parameter00_f2_waiter \
		and callsite_pc in [0xCCA0, 0xCCCE]
	var is_scenario2e_actor6d_f2_tail_entry := is_scenario2e_actor6d_f2_waiter and entry_pc == 0xCCA3
	var is_scenario2e_actor6d_f2_tail_callsite := is_scenario2e_actor6d_f2_waiter \
		and callsite_pc in [0xCCA0, 0xCCCE]
