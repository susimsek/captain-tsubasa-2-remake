			or String(resume_result.get("source_manifest", "")) != "res://reference/rom_extract/gameplay/field_entry_renderer_wrapper/manifest.json" \
			or int(resume_result.get("entry_pc", -1)) != source_pc \
			or int(resume_result.get("exit_pc", -1)) != expected_exit_pc \
			or not call_request_matches \
			or (is_loader_return and (source_pc != 0x82E3 \
				or int(resume_result.get("exit_bank", -1)) != 0x18 \
				or not loader_return_instruction_matches)) \
			or expected_ram.size() != RAM_SIZE \
			or not entry_ram is PackedByteArray or entry_ram != _ram \
			or not entry_stack is PackedByteArray or entry_stack != _stack_page \
			or not result_ram is PackedByteArray or result_ram != expected_ram \
			or not result_stack is PackedByteArray or result_stack != expected_stack \
			or int(registers.get("sp", -1)) != int(resume_result.get("exit_sp", -2)) \
			or int(mapper.get("bank_low", -1)) != expected_bank_low \
