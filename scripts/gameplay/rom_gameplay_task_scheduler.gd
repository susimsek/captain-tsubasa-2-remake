func _is_scenario1c_callback01_entry_profile(ram: PackedByteArray) -> bool:
	return ram.size() == RAM_SIZE \
		and ram.slice(0x0516, 0x052C) == PackedByteArray([
			0x61, 0x40, 0x1C, 0x27, 0xE8, 0x9B, 0x00, 0x00,
