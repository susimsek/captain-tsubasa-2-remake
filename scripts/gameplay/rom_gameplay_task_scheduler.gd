		expected_ram[0x0100 + frame_sp] = high_byte
		frame_sp = (frame_sp - 1) & 0xFF
		expected_stack_writes.append({"source_pc": int(frame[0]),
			"address": 0x0100 + frame_sp, "value": low_byte,
			"operation": "jsr_push_low"})
