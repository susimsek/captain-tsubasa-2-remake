			or int(entry_mapper.get("bank_high", -1)) != 0x1B \
			or int(result_mapper.get("bank_low", -1)) != 0x1A \
			or int(result_mapper.get("bank_high", -1)) != 0x1B \
			or int(ram[0x043B]) != 0x01:
		return _fail_pass_waiter_field("The PASS action index or caller bank pair does not match its source-derived `$80F0` input.")
	var required_spans := {
		"bank1a_field_entry_8003_A000.bin": "cfcde4d67358fc36a7e7e67e039d7f36a046a215bcd55b962eb7decac6a7e5fd",
		"bank1c_field_action_secondary_vector_801E_8021.bin": "3eb6cb4e1f8aed126472f006a272096d9562fac395d42bed311e01c74951b634",
		"bank1c_field_action_secondary_handler_846A_84C1.bin": "97fac4056e1ab1fd81325768106e10b9bcb825e78396f8e3392d411babaae99a",
		"fixed_action_scenario_queue_vector_C54E_C551.bin": "f5a1c1976d25333a62295e0be9539a535cf8e739ddf8ff3625e4e4696f2bf5fd",
		"fixed_scenario_queue_CBB0_CBC1.bin": "bda16c7ced2834027dd6039a6c079a701dc8abd9c89179ba2d3c568aa0a16a32",
	}
	for span_variant: Variant in spans:
		if not span_variant is Dictionary:
			continue
		var span: Dictionary = span_variant
		var file_name := String(span.get("file", ""))
		if required_spans.has(file_name):
			if String(span.get("sha256", "")) != String(required_spans[file_name]):
				return _fail_pass_waiter_field("The PASS scenario handoff source span hash changed for %s." % file_name)
			required_spans.erase(file_name)
	if not required_spans.is_empty():
		return _fail_pass_waiter_field("The PASS scenario handoff omitted source spans: %s" % str(required_spans.keys()))
	var expected_ram := ram.duplicate()
	var expected_stack := stack.duplicate()
	for write_variant: Variant in writes:
		if not write_variant is Dictionary:
			return _fail_pass_waiter_field("The PASS scenario handoff contains a malformed ordered RAM write.")
		var write: Dictionary = write_variant
		var address := int(write.get("address", -1))
		var value := int(write.get("value", -1))
		if address < 0 or address >= RAM_SIZE or value < 0 or value > 0xFF:
			return _fail_pass_waiter_field("The PASS scenario handoff contains an invalid ordered RAM write.")
		expected_ram[address] = value
		if address >= 0x0100 and address < 0x0200:
			expected_stack[address - 0x0100] = value
	var expected_select := int(mapper.get("select", -1))
	var expected_low := int(mapper.get("bank_low", -1))
	var expected_high := int(mapper.get("bank_high", -1))
	for mapper_write_variant: Variant in mapper_writes:
		if not mapper_write_variant is Dictionary:
			return _fail_pass_waiter_field("The PASS scenario handoff mapper-write list is malformed.")
		var mapper_write: Dictionary = mapper_write_variant
		var address := int(mapper_write.get("address", -1))
		var value := int(mapper_write.get("value", -1))
		if address == 0x8000:
			expected_select = value & 0x07
		elif address == 0x8001:
			if expected_select == 6: expected_low = value
			elif expected_select == 7: expected_high = value
		else:
			return _fail_pass_waiter_field("The PASS scenario handoff wrote outside the MMC3 mapper registers.")
	if expected_ram != result_ram or expected_stack != result_stack \
			or result_ram.slice(0x0100, 0x0200) != result_stack \
			or expected_low != 0x1A or expected_high != 0x1B \
			or int(result_mapper.get("bank_low", -1)) != expected_low \
			or int(result_mapper.get("bank_high", -1)) != expected_high \
			or int(result_mapper.get("select", -1)) != expected_select \
			or int(result_ram[0x043B]) != 0x01 \
			or int(result_ram[0x0518]) != 0x18 \
			or int(result_ram[0x0516]) != 0x80 \
			or int(result_ram[0x0005]) != 0x00 \
			or int(registers.get("a", -1)) != 0 \
			or int(registers.get("sp", -1)) > 0xFF:
		return _fail_pass_waiter_field("The PASS `$18` queue state differs from source RAM/stack/mapper writes.")
	var call_c54e_seen := false
	var call_cb0f_seen := false
	var pre_jsr_sp := -1
	for call_variant: Variant in calls:
		if not call_variant is Dictionary:
			continue
		var call: Dictionary = call_variant
		if int(call.get("callsite", -1)) == 0x8185 and int(call.get("target", -1)) == 0xC54E:
			call_c54e_seen = true
		if int(call.get("callsite", -1)) == 0xCBBE and int(call.get("target", -1)) == 0xCB0F:
			if int(call.get("sp_after_push", -1)) != int(registers.get("sp", -2)):
