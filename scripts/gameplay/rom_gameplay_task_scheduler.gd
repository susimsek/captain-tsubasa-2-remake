	var yield_code: PackedByteArray = _sources.get("task_yield", PackedByteArray())
	var expected := PackedByteArray([
		0x85, 0x7F, 0x8A, 0x48, 0x98, 0x48, 0xA6, 0x00, 0xA5, 0x24,
		0x95, 0x02, 0xA5, 0x25, 0x95, 0x03, 0xA5, 0x7F, 0x95, 0x00,
