			0x3C, 0x4A, 0x78, 0x58, 0x40, 0x00]) \
		and int(ram[0x003A]) == 0x07 \
		and (int(ram[0x005D]) | (int(ram[0x005E]) << 8)) == 0xB4A5 \
		and int(ram[0x05CD]) == 0xA0 and int(ram[0x05FB]) == 0x00 \
		and int(ram[0x0635]) == 0x84 and int(ram[0x0637]) == 0x54


