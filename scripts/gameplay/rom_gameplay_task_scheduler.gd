	var map_f0_placement_branch := map_id in [0x00, 0x0E, 0x11, 0x12] and int(entry_ram[0x05C7]) == 0x24 \
		and int(entry_ram[0x05C8]) == 0xC0 and callback_placement == 0xA0
	var expected_map_selector := 0x02 if map_id in [0x2D, 0x56] else (0x00 if map_id in [0x00, 0x0E, 0x11, 0x12, 0x51, 0x52] else 0x01)
	if map_id not in [0x00, 0x0E, 0x11, 0x12, 0x2D, 0x2F, 0x36, 0x42, 0x43, 0x51, 0x52, 0x56] or int(entry_ram[0x05C9]) != 0 \
			or int(entry_ram[0x05CA]) != expected_map_selector \
			or (map_id == 0x51 and (int(entry_ram[0x0518]) != 0x1C \
				or int(entry_ram[0x0524]) != 0x63)) \
			or (map_id == 0x2D and (context.bank_low != 0x0B or context.bank_high != 0x13)) \
			or (map_id == 0x2F and (context.bank_low != 0x0B or context.bank_high != 0x12 \
				or _record_bytes(context.slot_base) != PackedByteArray([0x00, 0xEA, 0x0B, 0x12]))) \
			or not (map_f0_placement_branch or map42_placement_branch or map42_zero_branch \
				or map36_final_page_branch or map43_placement_branch or map52_placement_branch \
				or map51_final_page_branch or map52_final_page_branch \
				or map56_final_page_branch or map2d_final_page_branch \
				or map2f_final_page_branch):
		return _fail("Terminal-return entry RAM is outside the checked map-$%02X callback branches." % map_id)
	var expected_write_contract := [
		{"address": 0x05CB, "value": 0x01, "pc_after_write": 0x8339},
		{"address": 0x05CE, "value": expected_placement_page, "pc_after_write": 0x8345},
		{"address": 0x05CD, "value": expected_next_placement, "pc_after_write": 0x834C},
		{"address": 0x05DB, "value": 0x00, "pc_after_write": 0x8351},
		{"address": 0x05DC, "value": 0x00, "pc_after_write": 0x8354},
		{"address": 0x05DD, "value": 0x00, "pc_after_write": 0x8357},
	]
	if map_f0_placement_branch:
		expected_write_contract.append_array([
			{"address": 0x05D0, "value": 0x02, "pc_after_write": 0x8182},
			{"address": 0x0525, "value": 0x02, "pc_after_write": 0x8185},
		])
	expected_write_contract.append({"address": 0x0516,
		"value": int(entry_ram[0x0516]) | 0x10, "pc_after_write": 0x81A4})
	var expected_callback_return := 0x817D if map_f0_placement_branch else 0x819C
	var expected_dispatcher_tail := "f0_marker_then_819c" if map_f0_placement_branch else "direct_819c"
	var writes: Array = writes_variant
	if writes.size() != expected_write_contract.size() \
			or int(worker_result.get("callback_return_pc", -1)) != expected_callback_return \
			or String(worker_result.get("dispatcher_tail", "")) != expected_dispatcher_tail:
