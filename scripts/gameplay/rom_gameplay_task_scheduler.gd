		var low_byte := return_word & 0xFF
		var frame_sp := int(frame[2]) & 0xFF
		expected_stack_writes.append({"source_pc": int(frame[0]),
			"address": 0x0100 + frame_sp, "value": high_byte,
			"operation": "jsr_push_high"})
