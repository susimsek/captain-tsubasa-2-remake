				"mapper": mapper_variant, "mapper_matches_context": mapper_variant == (context.mapper_state if context != null else {}),
				"ram_stack_lengths": [(entry_ram_variant as PackedByteArray).size() if entry_ram_variant is PackedByteArray else -1,
