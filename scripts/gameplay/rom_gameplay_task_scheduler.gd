				"stack_equals_scheduler": entry_stack_variant is PackedByteArray and entry_stack_variant == _stack_page,
				"ram_stack_mirror_matches": entry_ram_variant is PackedByteArray and entry_stack_variant is PackedByteArray
					and (entry_ram_variant as PackedByteArray).size() == RAM_SIZE
					and (entry_stack_variant as PackedByteArray).size() == STACK_PAGE_SIZE
					and (entry_ram_variant as PackedByteArray).slice(0x0100, 0x0200) == entry_stack_variant,
				"ram_0000_0022_0441_0518": [(entry_ram_variant as PackedByteArray)[0x0000],
					(entry_ram_variant as PackedByteArray)[0x0022], (entry_ram_variant as PackedByteArray)[0x0441],
					(entry_ram_variant as PackedByteArray)[0x0518]] if entry_ram_variant is PackedByteArray
					and (entry_ram_variant as PackedByteArray).size() == RAM_SIZE else [],
