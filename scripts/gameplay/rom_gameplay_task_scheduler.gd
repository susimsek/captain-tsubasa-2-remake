		"source_stack_writes_applied": stack_writes_variant.duplicate(true),
		"next_boundary_snapshot": adopted_boundary,
		"scheduler_yield_executed": false, "trace_state_used": false}


## Applies the verified CB0F task-save yield from the latest consumed PASS A
## receipt. This adopts the actual CAA5 handoff state only; the caller must
## invoke scan_ready_tasks_once() separately to execute the next scheduler step.
func adopt_first_action_confirmation_bridge_yield(result: Dictionary) -> Dictionary:
	if not _require_initialized():
		return {"ok": false, "status": "scheduler_not_ready", "error": error_message}
	var context: TaskContext = _contexts.get(0x05)
	if not _slot05_pass_selection_adopted or not _slot05_pass_handler_dispatch_pending \
			or _active_task_slot != 0x05 or int(_ram[0x0000]) != 0x05 \
			or context == null or context.phase != ContextPhase.RUNNING \
			or context.program_counter != 0xD5EA \
			or context.bank_low != 0x1A or context.bank_high != 0x1B \
			or int(_ram[0x0024]) != 0x1A or int(_ram[0x0025]) != 0x1B \
			or int(_ram[0x0621]) != 0 or int(_ram[0x043B]) != 1 \
			or int(_ram[0x061E]) != 0x81:
		return _first_action_input_adoption_failure(
			"PASS CB0F adoption requires the pending live slot-$05 `$D5EA` continuation and adopted context-0 PASS selection.")
	for forbidden_key in ["ram_image", "stack_page", "entry_ram_image", "entry_stack_page",
			"source_ram_image", "source_stack_page", "fceux_ram", "captured_ram",
			"emulator_snapshot", "d6c7_boundary", "handler_entry_pc"]:
		if result.has(forbidden_key):
			return _first_action_input_adoption_failure(
				"PASS CB0F adoption accepts only source events, not supplied memory or a later handler boundary.")
	var receipt_id := int(result.get("consumed_sample_receipt_id", -1))
	var entry_y := context.y_register & 0xFF
	if receipt_id <= 0 or receipt_id != _controller_sample_receipt_id \
			or receipt_id != _last_adopted_controller_sample_receipt_id \
			or receipt_id != int(_last_controller_sample.get("sample_receipt_id", -2)) \
			or int(_last_controller_sample.get("newly_pressed", -1)) != 0x80 \
			or int(_last_controller_sample.get("current", -1)) != 0x80 \
			or (int(_last_controller_sample.get("previous", 0)) & 0x80) != 0 \
			or int(_last_controller_sample.get("held_ram_001c", -1)) != 0x80 \
			or int(_last_controller_sample.get("edge_ram_001e", -1)) != 0x80 \
			or ((int(_last_controller_sample.get("previous", 0)) \
			^ int(_last_controller_sample.get("current", 0))) \
			& int(_last_controller_sample.get("current", 0))) != 0x80:
		return _first_action_input_adoption_failure(
			"PASS CB0F adoption requires the latest consumed one-use A-edge receipt.")
	var hashes_variant: Variant = result.get("source_hashes", {})
	var writes_variant: Variant = result.get("source_writes", [])
	var stack_writes_variant: Variant = result.get("source_stack_writes", [])
	var registers_variant: Variant = result.get("registers", {})
	var record_variant: Variant = result.get("saved_task_record", [])
	var handoff_variant: Variant = result.get("scheduler_handoff", {})
	var mapper_variant: Variant = result.get("mapper_state", {})
	var history_variant: Variant = result.get("source_pc_history", [])
	var instruction_pcs_variant: Variant = result.get("source_instruction_pcs", [])
	if not hashes_variant is Dictionary or not writes_variant is Array \
			or not stack_writes_variant is Array or not registers_variant is Dictionary \
			or not record_variant is Array or not handoff_variant is Dictionary \
			or not mapper_variant is Dictionary or not history_variant is Array \
			or not instruction_pcs_variant is Array:
		return _first_action_input_adoption_failure(
			"PASS CB0F result omits its pinned hashes, ordered source events, registers, or task handoff.")
	if not bool(result.get("ok", false)) \
			or String(result.get("status", "")) != "pass_confirmation_yielded_waiting_for_scheduler_nmi" \
			or String(result.get("rom_sha256", "")) != ROM_SHA256 \
			or hashes_variant != FIRST_ACTION_CONFIRMATION_BRIDGE_HASHES \
			or bool(result.get("trace_state_used", true)) \
			or bool(result.get("emulator_data_used", true)) \
			or bool(result.get("source_cycle_timing_modeled", true)) \
			or bool(result.get("d6c7_reached", true)) \
			or bool(result.get("handler_dispatch_executed", true)) \
			or int(result.get("task_resume_pc_after_scheduler", -1)) != 0xE945 \
			or int(result.get("entry_sp", -1)) != context.stack_pointer \
			or not _first_action_confirmation_bridge_history_matches(history_variant) \
			or not _first_action_confirmation_bridge_instruction_pcs_match(instruction_pcs_variant):
		return _first_action_input_adoption_failure(
			"PASS CB0F result is not the pinned ROM-byte route from the live D5EA confirmation through CAA5.")
	var entry_sp := context.stack_pointer & 0xFF
	var saved_sp := (entry_sp - 10) & 0xFF
	var registers: Dictionary = registers_variant
	var handoff: Dictionary = handoff_variant
	var mapper: Dictionary = mapper_variant
	var mapper_writes_variant: Variant = mapper.get("mapper_writes_during_slice", [])
	if not mapper_writes_variant is Array:
		return _first_action_input_adoption_failure(
			"PASS CB0F mapper receipt has a malformed write list.")
	var mapper_writes: Array = mapper_writes_variant
	var expected_p := context.status_register & (0xFF ^ 0xC2)
	var expected_known_p := context.status_known_mask | 0xC2
	if int(result.get("saved_task_sp", -1)) != saved_sp \
			or int(result.get("final_sp", -1)) != saved_sp \
			or int(registers.get("pc", -1)) != 0xCAA5 \
			or int(registers.get("sp", -1)) != saved_sp \
			or int(registers.get("a", -1)) != 0x05 \
			or int(registers.get("x", -1)) != 0x05 \
			or int(registers.get("y", -1)) != 0x05 \
			or int(registers.get("p", -1)) != expected_p \
			or int(registers.get("p_known_mask", -1)) != expected_known_p \
			or record_variant != [0x01, saved_sp, 0x1A, 0x1B] \
			or int(handoff.get("pc", -1)) != 0xCAA5 \
			or int(handoff.get("active_task_slot", -1)) != -1 \
			or int(handoff.get("scheduler_x", -1)) != 0x05 \
			or int(handoff.get("yielded_slot", -1)) != 0x05 \
			or int(handoff.get("next_scan_slot_after_caa5", -1)) != 0x09 \
			or bool(handoff.get("nmi_wait_reached", true)) \
			or mapper.get("slot05_saved_bank_pair", []) != [0x1A, 0x1B] \
			or mapper.get("switchable_window_shadow_pair", []) != [0x1A, 0x1B] \
			or not mapper_writes.is_empty():
		return _first_action_input_adoption_failure(
			"PASS CB0F saved record, CAA5 registers, or mapper state differs from the ROM source contract.")
	if not _first_action_confirmation_bridge_ram_writes_match(writes_variant, saved_sp) \
			or not _first_action_confirmation_bridge_stack_writes_match(stack_writes_variant, entry_sp, entry_y):
		return _first_action_input_adoption_failure(
			"PASS CB0F ordered RAM or stack writes differ from the source instructions and live stack boundary.")
	if int(_ram[0x0000]) != 0x05 or int(_ram[0x0024]) != 0x1A \
			or int(_ram[0x0025]) != 0x1B \
			or _ram.slice(0x0100, 0x0200) != _stack_page:
		return _first_action_input_adoption_failure(
			"PASS CB0F adoption requires scheduler-owned live RAM, mapper shadows, and a synchronized stack mirror.")
	for write_variant: Variant in writes_variant:
		var write: Dictionary = write_variant
		_ram[int(write["address"])] = int(write["value"])
	for write_variant: Variant in stack_writes_variant:
		var write: Dictionary = write_variant
		var stack_index := int(write["address"]) & 0xFF
		_stack_page[stack_index] = int(write["value"])
		_ram[0x0100 + stack_index] = int(write["value"])
	context.ready_delay = 0x01
	context.pending_resume = ResumeKind.NONE
	context.phase = ContextPhase.YIELDED
	context.program_counter = 0xE945
	context.stack_pointer = saved_sp
	context.accumulator = 0
	context.x_register = 0
	context.y_register = entry_y
	context.bank_low = 0x1A
	context.bank_high = 0x1B
	context.source_return_word = 0xE944
	context.source_label = "ROM-byte PASS confirmation saved by `$CB0F`; yielded at `$CAA5`, continuation `$E945`"
	_scheduler_y_register = 0x05
	_scheduler_scan_cursor = 0x09
	_active_task_slot = -1
	var next_boundary := get_task_boundary_snapshot(0x05)
	return {
		"ok": true,
		"status": "pass_confirmation_yield_adopted",
		"accepted_status": String(result.get("status", "")),
		"sample_receipt_id": receipt_id,
		"source_handoff_pc": 0xCAA5,
		"source_resume_pc": 0xE945,
		"source_writes_applied": writes_variant.duplicate(true),
		"source_writes_applied_count": writes_variant.size(),
		"source_stack_writes_applied": stack_writes_variant.duplicate(true),
		"source_stack_writes_applied_count": stack_writes_variant.size(),
		"saved_task_record": _record_bytes(0x05),
		"active_task_slot": _active_task_slot,
		"scheduler_y_register": _scheduler_y_register,
		"scheduler_scan_cursor": _scheduler_scan_cursor,
		"source_scan_executed": false,
		"nmi_delivery_claimed": false,
		"next_boundary_snapshot": next_boundary,
	}


func _first_action_confirmation_bridge_history_matches(history: Array) -> bool:
	var expected: Array[int] = [0xD5EA, 0xD626, 0xD632, 0xD67C, 0xD687,
		0xE93D, 0xE942, 0xCB0F, 0xCAA5]
	if history.size() != expected.size():
		return false
	for index in expected.size():
		if int(history[index]) != expected[index]:
			return false
	return true


func _first_action_confirmation_bridge_instruction_pcs_match(pcs: Array) -> bool:
	var expected: Array[int] = [
		0xD5EA, 0xD5EC, 0xD5EF, 0xD626, 0xD628, 0xD62B, 0xD62D, 0xD630,
		0xD632, 0xD67C, 0xD67F, 0xD682, 0xD684, 0xD687, 0xE93D, 0xE93E,
		0xE93F, 0xE940, 0xE942, 0xCB0F, 0xCB11, 0xCB12, 0xCB13, 0xCB14,
		0xCB15, 0xCB17, 0xCB19, 0xCB1B, 0xCB1D, 0xCB1F, 0xCB21, 0xCB23,
		0xCB24, 0xCB25, 0xCB26, 0xCB28, 0xCB2A, 0xCAA5,
	]
	if pcs.size() != expected.size():
		return false
	for index in expected.size():
		if int(pcs[index]) != expected[index]:
			return false
	return true


func _first_action_confirmation_bridge_ram_writes_match(writes: Array, saved_sp: int) -> bool:
	var expected := [
		{"source_pc": 0xD684, "address": 0x043C, "value": 0x00},
		{"source_pc": 0xCB0F, "address": 0x007F, "value": 0x01},
		{"source_pc": 0xCB19, "address": 0x0007, "value": 0x1A},
		{"source_pc": 0xCB1D, "address": 0x0008, "value": 0x1B},
		{"source_pc": 0xCB21, "address": 0x0005, "value": 0x01},
		{"source_pc": 0xCB26, "address": 0x0006, "value": saved_sp},
	]
	if writes.size() != expected.size():
		return false
	for index in expected.size():
		if not writes[index] is Dictionary:
			return false
		var actual: Dictionary = writes[index]
		if actual.size() != 3:
			return false
		for key: String in ["source_pc", "address", "value"]:
			if int(actual.get(key, -1)) != int(expected[index][key]):
				return false
	return true


func _first_action_confirmation_bridge_stack_writes_match(writes: Array,
		entry_sp: int, saved_y: int) -> bool:
	var expected := [
		[0xD632, 0xD6, "jsr_push_high"], [0xD632, 0x34, "jsr_push_low"],
		[0xD687, 0xD6, "jsr_push_high"], [0xD687, 0x89, "jsr_push_low"],
		[0xE93D, 0x01, "pha"], [0xE93F, 0x00, "pha"],
		[0xE942, 0xE9, "jsr_push_high"], [0xE942, 0x44, "jsr_push_low"],
		[0xCB12, 0x00, "pha"], [0xCB14, saved_y & 0xFF, "pha"],
	]
	if writes.size() != expected.size() or entry_sp < 0 or entry_sp > 0xFF:
		return false
	var stack_pointer := entry_sp & 0xFF
	for index in expected.size():
		if not writes[index] is Dictionary:
			return false
		var actual: Dictionary = writes[index]
		if actual.size() != 4 \
				or int(actual.get("source_pc", -1)) != int(expected[index][0]) \
				or int(actual.get("address", -1)) != (0x0100 | stack_pointer) \
				or int(actual.get("value", -1)) != int(expected[index][1]) \
				or String(actual.get("operation", "")) != String(expected[index][2]):
			return false
		stack_pointer = (stack_pointer - 1) & 0xFF
	return true


func _first_action_menu_boundary_proof_matches(boundary: Dictionary,
		context: TaskContext) -> bool:
	var banks_variant: Variant = boundary.get("banks", [])
	var banks_match := int(boundary.get("bank_low", -1)) == 0x1A \
			and int(boundary.get("bank_high", -1)) == 0x1B
	if banks_variant is Array and banks_variant.size() == 2:
		banks_match = int(banks_variant[0]) == 0x1A and int(banks_variant[1]) == 0x1B
	elif banks_variant is Dictionary:
		banks_match = int(banks_variant.get("bank_low", -1)) == 0x1A \
				and int(banks_variant.get("bank_high", -1)) == 0x1B
	var held := int(boundary.get("held_ram_001c", boundary.get("held", -1)))
	var edge := int(boundary.get("edge_ram_001e", boundary.get("edge", -1)))
	return int(boundary.get("slot_base", -1)) == 0x05 \
			and int(boundary.get("active_task_slot", -1)) == 0x05 \
			and int(boundary.get("phase", -1)) == ContextPhase.RUNNING \
			and int(boundary.get("pc", -1)) == 0xD5EA \
			and banks_match \
			and int(boundary.get("menu_context", -1)) == 0 \
			and int(boundary.get("source_selected_action_id", -1)) == int(_ram[0x043B]) \
			and int(boundary.get("source_selection_latch", -1)) == int(_ram[0x061E]) \
			and held == int(_ram[0x001C]) and edge == int(_ram[0x001E]) \
			and int(boundary.get("pc", -1)) == context.program_counter


func _first_action_sample_receipt_matches(sample: Dictionary) -> bool:
	for key: String in ["sample_receipt_id", "previous", "current", "newly_pressed",
			"held_ram_001c", "edge_ram_001e"]:
		if not sample.has(key) or int(sample[key]) != int(_last_controller_sample.get(key, -1)):
			return false
	return int(sample.get("newly_pressed", -1)) \
			== ((int(sample["previous"]) ^ int(sample["current"])) & int(sample["current"])) \
			and int(sample["held_ram_001c"]) == int(_ram[0x001C]) \
			and int(sample["edge_ram_001e"]) == int(_ram[0x001E])


