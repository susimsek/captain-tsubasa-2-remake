			or String(worker_result.get("source_manifest_sha256", "")) != FRESH_BANK18_WORKER_MANIFEST_SHA256 \
			or int(blocked.get("instruction_pc", -1)) != 0xCB0F \
			or int(blocked.get("requested_address", -1)) != 0xCB0F \
			or int(blocked.get("bank", -1)) != 0x1E \
			or int(registers.get("pc", -1)) != 0xCB0F \
			or int(registers.get("sp", -1)) != 0x4E \
			or int(registers.get("a", -1)) != 0x01 \
			or int(registers.get("x", -1)) != int(input_boundary.get("x", -2)) \
			or int(registers.get("y", -1)) != int(input_boundary.get("y", -2)) \
			or int(mapper.get("bank_low", -1)) != input_bank_low \
			or int(mapper.get("bank_high", -1)) != input_bank_high \
			or int(entry_mapper.get("bank_low", -1)) != input_bank_low \
			or int(entry_mapper.get("bank_high", -1)) != input_bank_high \
			or not input_field_pair_valid \
			or String(worker_result.get("rom_sha256", "")) != ROM_SHA256 \
			or String(worker_result.get("source_manifest", "")) != "res://reference/rom_extract/gameplay/fresh_bank18_worker_prefix/manifest.json" \
			or int(dispatch.get("slot_base", -1)) != 0x05 \
			or String(dispatch.get("resume_path", "")) != "yielded_rts" \
			or int(dispatch.get("pc", -1)) != 0xE14A \
			or int(dispatch.get("bank", -1)) != 0x1F \
			or not bool(dispatch.get("source_dispatch_observed", false)) \
			or int(input_boundary.get("slot_base", -1)) != 0x05 \
			or int(input_boundary.get("active_task_slot", -1)) != 0x05 \
			or int(input_boundary.get("pc", -1)) != 0xE14A \
			or input_ram.size() != RAM_SIZE \
			or ram.size() != RAM_SIZE or stack.size() != STACK_PAGE_SIZE \
			or ram.slice(0x0100, 0x0200) != stack \
			or int(input_ram[0x0614]) < 0x01 or int(input_ram[0x0614]) > 0x0A \
			or int(ram[0x0614]) != int(input_ram[0x0614]) - 1 \
			or int(input_ram[0x05FB]) != 0 \
			or (int(input_ram[0x001C]) & 0x4F) != 0 \
			or int(ram[0x0532]) != 0 \
			or (int(ram[0x0615]) & 0x40) == 0 or (int(ram[0x001C]) & 0x0F) != 0 \
			or int(stack[0x4F]) != 0x49 or int(stack[0x50]) != 0xE1 \
			or not _callsite_matches_source(0xE147):
		return false
	var required_spans := {
		"fixed_field_entry_setup_E0E9_E349.bin": "069aa6c733b9de0a6070e280f89277a4ec192f1c551001fb787e9038244806de",
		"fixed_field_loop_input_E349_E3CA.bin": "3a1a1c83d163815dce998784b05b41f3a58cda44c1569fea53667437bc353aa3",
	}
	for span_variant in spans:
		if span_variant is Dictionary:
			var span: Dictionary = span_variant
			var file_name := String(span.get("file", ""))
			if required_spans.has(file_name) \
					and String(span.get("sha256", "")) == String(required_spans[file_name]):
				required_spans.erase(file_name)
	if not required_spans.is_empty():
		return false
	var source_calls := {0xE14A: 0xE349, 0xE147: 0xCB0F}
	for call_variant in calls:
		if call_variant is Dictionary:
			var call: Dictionary = call_variant
			var callsite := int(call.get("callsite", -1))
			if source_calls.has(callsite) \
					and int(call.get("target", -1)) == int(source_calls[callsite]):
				source_calls.erase(callsite)
	var path_pcs := {0xE14A: false, 0xE349: false, 0xE360: false,
		0xE362: false, 0xE367: false, 0xE3C9: false, 0xE14D: false,
		0xE152: false, 0xE155: false, 0xE145: false, 0xE147: false}
	for instruction_variant in instructions:
		if instruction_variant is Dictionary:
			var instruction: Dictionary = instruction_variant
			var pc := int(instruction.get("pc", -1))
			if path_pcs.has(pc):
				path_pcs[pc] = true
	if not source_calls.is_empty() or path_pcs.values().has(false):
		return false
	return _worker_write_seen(worker_result, 0xE34B, 0x0532, 0x00) \
		and _worker_write_seen(worker_result, 0xE152, 0x0614, int(ram[0x0614]))


