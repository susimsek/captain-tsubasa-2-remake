	var registers_variant_in_context: Variant = next_mapper.get("bank_registers", {})
	var bank_registers: Dictionary = registers_variant_in_context.duplicate(true) \
			if registers_variant_in_context is Dictionary else {}
	bank_registers[6] = int(result_mapper["bank_low"])
	bank_registers[7] = int(result_mapper["bank_high"])
	next_mapper["bank_registers"] = bank_registers
	next_mapper["bank_low"] = int(result_mapper["bank_low"])
	next_mapper["bank_high"] = int(result_mapper["bank_high"])
	next_mapper["select"] = int(result_mapper["select"])
	next_mapper["register_select"] = int(result_mapper["select"])
	next_mapper["register_pair_provenance"] = "ROM-byte PASS descriptor-$0F worker `$D7ED->$C515`"
	context.accumulator = int(registers["a"]) & 0xFF
	context.x_register = int(registers["x"]) & 0xFF
	context.y_register = int(registers["y"]) & 0xFF
	context.status_register = int(registers.get("p", context.status_register)) & 0xFF
	context.status_known_mask = int(registers.get("p_known_mask", context.status_known_mask)) & 0xFF
	context.stack_pointer = int(registers["sp"]) & 0xFF
	context.program_counter = 0xC515
	context.bank_low = int(result_mapper["bank_low"])
	context.bank_high = int(result_mapper["bank_high"])
