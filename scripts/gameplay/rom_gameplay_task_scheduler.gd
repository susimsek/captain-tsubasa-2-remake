		return _fail("PASS descriptor-$0F worker omitted required ROM spans: %s." % str(expected_span_hashes.keys()))
	var replay := _replay_actor_source_writes(writes, [], _ram, _stack_page)
	if not bool(replay.get("ok", false)) \
			or replay.get("ram_image", PackedByteArray()) != result_ram \
			or replay.get("stack_page", PackedByteArray()) != result_stack:
		return _fail("PASS descriptor-$0F worker RAM/stack output differs from replaying its ordered source writes: %s." % str(replay.get("reason", "output mismatch")))
