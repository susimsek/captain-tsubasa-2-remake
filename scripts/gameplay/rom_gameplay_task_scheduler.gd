		"fixed_field_coordinate_update_E709_E800.bin": "6768f99151f2f28bdd2b46ea5b257703125d180ecd55c83d73088c29a523ca10",
	}
	for name: String in required_spans:
		var found := false
		for span_variant in spans:
			if span_variant is Dictionary:
				var span: Dictionary = span_variant
				if String(span.get("file", "")) == name \
						and String(span.get("sha256", "")) == String(required_spans[name]):
					found = true
					break
		if not found:
			return false
