func _validate_slot11_actor_parameter_6d_source_hashes(hashes: Dictionary) -> bool:
	var manifest_file := FileAccess.open(SLOT11_ACTOR_PARAMETER_6D_MANIFEST_PATH, FileAccess.READ)
	if manifest_file == null:
		return _fail("Actor-$6D source manifest is unavailable.")
	var parsed: Variant = JSON.parse_string(manifest_file.get_as_text())
	if not parsed is Dictionary:
		return _fail("Actor-$6D source manifest is malformed.")
	var manifest: Dictionary = parsed
	var source_rom: Dictionary = manifest.get("source_rom", {})
	var spans: Variant = manifest.get("spans", [])
	if String(manifest.get("schema", "")) != "ct2-slot11-actor-parameter-6d-source-v1" \
			or String(source_rom.get("sha256", "")) != ROM_SHA256 or not spans is Array:
		return _fail("Actor-$6D source manifest targets an unsupported ROM revision.")
	var base_path := SLOT11_ACTOR_PARAMETER_6D_MANIFEST_PATH.get_base_dir()
	for filename_variant: Variant in hashes:
		var filename := String(filename_variant)
		var expected_hash := String(hashes[filename_variant]).to_lower()
		var found: Dictionary = {}
		for span_variant: Variant in spans:
			if span_variant is Dictionary and String(span_variant.get("file", "")) == filename:
				found = span_variant
				break
		var source_bytes := FileAccess.get_file_as_bytes(base_path.path_join(filename))
		if found.is_empty() or String(found.get("sha256", "")).to_lower() != expected_hash \
				or source_bytes.size() != int(found.get("length_bytes", -1)) \
				or _sha256(source_bytes) != expected_hash \
				or String(found.get("bytes_hex", "")).replace(" ", "").to_lower() != source_bytes.hex_encode():
			return _fail("Actor-$6D ROM-derived span failed manifest/byte validation: %s." % filename)
	return true


