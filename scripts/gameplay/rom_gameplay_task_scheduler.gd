				seen_opcodes[pc] = true
	for pc: int in expected_opcodes:
		if not seen_opcodes.has(pc):
			return _fail_pass_waiter_field("The PASS `$18` queue did not execute pinned ROM opcode `$%04X`." % pc)
	_ram = result_ram.duplicate()
	_stack_page = result_stack.duplicate()
	context.accumulator = int(registers.get("a", -1)) & 0xFF
	context.x_register = int(registers.get("x", -1)) & 0xFF
	context.y_register = int(registers.get("y", -1)) & 0xFF
	context.status_register = int(registers.get("p", -1)) & 0xFF
	context.status_known_mask = int(registers.get("p_known_mask", -1)) & 0xFF
	context.stack_pointer = int(registers.get("sp", -1)) & 0xFF
	context.program_counter = 0xCB0F
	context.bank_low = expected_low
	context.bank_high = expected_high
	context.mapper_state = result_mapper.duplicate(true)
	context.source_label = "ROM-byte PASS action `$043B=1->$0518=$18->$CBBE->$CB0F`"
	var call_contract := {"callsite_pc": 0xCBBE, "target_pc": 0xCB0F,
		"sp_before_push": pre_jsr_sp, "call_frame_already_pushed": true,
		"scenario_id": 0x18, "trace_state_used": false}
	return {"ok": true, "status": "pass_waiter_e081_scenario18_queue_adopted",
		"rom_sha256": ROM_SHA256, "entry_pc": 0x80F0, "exit_pc": 0xCB0F,
		"source_return_observed": false, "scenario_id": 0x18,
		"call_contract": call_contract,
		"next_boundary_snapshot": get_task_boundary_snapshot(0x05),
		"trace_state_used": false, "test_fixture": false}


## Adopts a ROM callee entered through a source-verified E081 caller JSR and
## returned naturally to that same caller's next instruction.
func adopt_slot05_pass_waiter_rom_call_return(boundary: Dictionary,
		call_contract: Dictionary, result: Dictionary) -> Dictionary:
	if not _require_initialized():
		return {"ok": false, "error": error_message}
	var context: TaskContext = _contexts.get(0x05)
	var ram_variant: Variant = boundary.get("ram_image", PackedByteArray())
	var stack_variant: Variant = boundary.get("stack_page", PackedByteArray())
	var mapper_variant: Variant = boundary.get("mapper", {})
	var result_ram_variant: Variant = result.get("ram_image", PackedByteArray())
	var result_stack_variant: Variant = result.get("stack_page", PackedByteArray())
	var result_mapper_variant: Variant = result.get("mapper", {})
	var registers_variant: Variant = result.get("registers", {})
	var writes_variant: Variant = result.get("writes", [])
	var mapper_writes_variant: Variant = result.get("mapper_writes", [])
	var instructions_variant: Variant = result.get("instructions", [])
	var spans_variant: Variant = result.get("executed_source_spans", [])
	var call_evidence_variant: Variant = result.get("caller_source_evidence", {})
	if context == null or not ram_variant is PackedByteArray \
			or not stack_variant is PackedByteArray or not mapper_variant is Dictionary \
			or not result_ram_variant is PackedByteArray \
			or not result_stack_variant is PackedByteArray \
			or not result_mapper_variant is Dictionary or not registers_variant is Dictionary \
			or not writes_variant is Array or not mapper_writes_variant is Array \
			or not instructions_variant is Array or not spans_variant is Array \
			or not call_evidence_variant is Dictionary:
		return _fail_pass_waiter_field("The E081 ROM callee omitted its live CPU, memory, mapper, or caller-byte provenance.")
	var ram: PackedByteArray = ram_variant
	var stack: PackedByteArray = stack_variant
	var mapper: Dictionary = mapper_variant
	var result_ram: PackedByteArray = result_ram_variant
	var result_stack: PackedByteArray = result_stack_variant
	var result_mapper: Dictionary = result_mapper_variant
	var registers: Dictionary = registers_variant
	var call_evidence: Dictionary = call_evidence_variant
	var callsite := int(call_contract.get("callsite_pc", -1))
	var target := int(call_contract.get("target_pc", -1))
	var return_pc := int(call_contract.get("return_pc", -1))
	if _active_task_slot != 0x05 or context.phase != ContextPhase.RUNNING \
			or int(boundary.get("active_task_slot", -1)) != 0x05 \
			or int(boundary.get("pc", -1)) != callsite \
			or context.program_counter != callsite \
			or int(boundary.get("sp", -1)) != context.stack_pointer \
			or ram.size() != RAM_SIZE or stack.size() != STACK_PAGE_SIZE \
			or ram != _ram or stack != _stack_page \
			or String(boundary.get("rom_sha256", "")) != ROM_SHA256 \
			or bool(boundary.get("trace_state_used", true)) \
			or bool(boundary.get("test_fixture", true)):
		return _fail_pass_waiter_field("The scheduler is not at the unchanged active slot-$05 E081 caller boundary.")
	if not bool(result.get("ok", false)) \
			or String(result.get("status", "")) != "pass_waiter_rom_call_returned" \
			or String(result.get("rom_sha256", "")) != ROM_SHA256 \
			or String(result.get("source_manifest_sha256", "")) != _worker_source_manifest_sha256() \
			or int(result.get("entry_pc", -1)) != callsite \
			or int(result.get("target_pc", -1)) != target \
			or int(result.get("exit_pc", -1)) != return_pc \
			or int(result.get("exit_bank", -1)) != 0x1F \
			or bool(result.get("trace_state_used", true)) \
			or bool(result.get("emulator_data_used", true)) \
			or bool(result.get("test_fixture", true)) \
			or not bool(result.get("call_return_verified", false)) \
			or String(call_evidence.get("path", "")) \
			!= "res://reference/rom_extract/gameplay/pass_waiter_field_caller_E081/fixed_field_caller_E081_E0DE.bin" \
			or String(call_evidence.get("sha256", "")) \
			!= "d5c9912b82292028e430cba0615751ec0f95c433df07b6738118c8f9c71261b9" \
			or int(call_evidence.get("cpu_address", -1)) != callsite:
		return _fail_pass_waiter_field("The E081 ROM callee did not prove its pinned source call and natural return contract.")
	var caller_bytes := FileAccess.get_file_as_bytes(String(call_evidence.get("path", "")))
	var caller_offset := callsite - 0xE081
	if caller_bytes.size() != 94 or _sha256(caller_bytes) != String(call_evidence.get("sha256", "")) \
			or caller_offset < 0 or caller_offset + 3 > caller_bytes.size() \
			or caller_bytes.slice(caller_offset, caller_offset + 3) \
			!= PackedByteArray([0x20, target & 0xFF, (target >> 8) & 0xFF]):
		return _fail_pass_waiter_field("The E081 JSR bytes do not match the accepted ROM callee contract.")
	if String(call_contract.get("rom_sha256", "")) != ROM_SHA256 \
			or bool(call_contract.get("trace_state_used", true)) \
			or bool(call_contract.get("test_fixture", true)) \
			or int(call_contract.get("return_word", -1)) != ((callsite + 2) & 0xFFFF) \
			or return_pc != ((callsite + 3) & 0xFFFF) \
			or int(call_contract.get("sp_before_push", -1)) != int(boundary.get("sp", -2)):
		return _fail_pass_waiter_field("The E081 callee input contract has a wrong return word, PC, or caller SP.")
	var instruction_records: Array = instructions_variant
	var calls_variant: Variant = result.get("calls", [])
	if instruction_records.is_empty() or not instruction_records[0] is Dictionary \
			or not instruction_records[-1] is Dictionary or not calls_variant is Array:
		return _fail_pass_waiter_field("The E081 callee omitted its executed source instruction records.")
	var first_instruction: Dictionary = instruction_records[0]
	var last_instruction: Dictionary = instruction_records[-1]
	var source_jsr_verified := false
	for call_variant: Variant in calls_variant:
		if call_variant is Dictionary:
			var source_call: Dictionary = call_variant
			if int(source_call.get("callsite", -1)) == callsite \
					and int(source_call.get("target", -1)) == target \
					and int(source_call.get("return_pc", -1)) == return_pc \
					and bool(source_call.get("source_call_contract_verified", false)):
				source_jsr_verified = true
	if int(first_instruction.get("pc", -1)) != callsite \
			or int(first_instruction.get("opcode", -1)) != 0x20 \
			or not source_jsr_verified \
			or int(last_instruction.get("opcode", -1)) != 0x60 \
			or int(last_instruction.get("next_pc", -1)) != return_pc \
			or int(registers.get("pc", -1)) != return_pc \
			or int(registers.get("sp", -1)) != int(boundary.get("sp", -2)):
		return _fail_pass_waiter_field("The E081 callee did not reach a natural RTS return with the original caller stack.")
	var expected_ram := ram.duplicate()
	var expected_stack := stack.duplicate()
	for write_variant: Variant in writes_variant:
		if not write_variant is Dictionary:
			return _fail_pass_waiter_field("The E081 callee emitted a malformed RAM write record.")
		var write: Dictionary = write_variant
		var address := int(write.get("address", -1))
		var value := int(write.get("value", -1))
		if address < 0 or address >= RAM_SIZE or value < 0 or value > 0xFF:
			return _fail_pass_waiter_field("The E081 callee wrote outside RAM or emitted a non-byte value.")
		expected_ram[address] = value
		if address >= 0x0100 and address < 0x0200:
			expected_stack[address - 0x0100] = value
	if expected_ram != result_ram or expected_stack != result_stack \
			or result_ram.slice(0x0100, 0x0200) != result_stack:
		return _fail_pass_waiter_field("The E081 callee RAM/stack output does not match its ordered ROM writes.")
	var expected_select := int(mapper.get("select", -1))
	var expected_low := int(mapper.get("bank_low", -1))
	var expected_high := int(mapper.get("bank_high", -1))
	for mapper_write_variant: Variant in mapper_writes_variant:
		if not mapper_write_variant is Dictionary:
			return _fail_pass_waiter_field("The E081 callee emitted a malformed MMC3 write record.")
		var mapper_write: Dictionary = mapper_write_variant
		var address := int(mapper_write.get("address", -1))
		var value := int(mapper_write.get("value", -1))
		if address == 0x8000:
			expected_select = value & 0x07
		elif address == 0x8001:
			if expected_select == 6: expected_low = value
			elif expected_select == 7: expected_high = value
		else:
			return _fail_pass_waiter_field("The E081 callee emitted a non-MMC3 mapper write.")
	if int(result_mapper.get("select", -1)) != expected_select \
			or int(result_mapper.get("bank_low", -1)) != expected_low \
			or int(result_mapper.get("bank_high", -1)) != expected_high \
			or int(result_mapper.get("fixed_low", -1)) != 0x1E \
			or int(result_mapper.get("fixed_high", -1)) != 0x1F:
		return _fail_pass_waiter_field("The E081 callee MMC3 result does not match its ordered register writes.")
	var required_span := ""
	match target:
		0xCE2D: required_span = "fixed_stamina_bank_switch_CE2D_CE4A.bin"
		0x8000: required_span = "bank1a_field_update_vector_8000_8003.bin"
		0xCD7C: required_span = "fixed_record_pointer_resolver_CD7C_CD89.bin"
		0xCE08: required_span = "fixed_stamina_evaluator_helper_CE08_CE2D.bin"
		0xE854: required_span = "fixed_field_neutral_update_E854_E980.bin"
	var has_required_span := false
	for span_variant: Variant in spans_variant:
		if span_variant is Dictionary and String((span_variant as Dictionary).get("file", "")) == required_span:
			has_required_span = true
	if not has_required_span:
		return _fail_pass_waiter_field("E081 callee target `$%04X` did not execute its required hash-pinned ROM source span." % target)
	_ram = result_ram.duplicate()
	_stack_page = result_stack.duplicate()
	context.accumulator = int(registers.get("a", -1)) & 0xFF
	context.x_register = int(registers.get("x", -1)) & 0xFF
	context.y_register = int(registers.get("y", -1)) & 0xFF
	context.status_register = int(registers.get("p", -1)) & 0xFF
	context.status_known_mask = int(registers.get("p_known_mask", -1)) & 0xFF
	context.stack_pointer = int(registers.get("sp", -1)) & 0xFF
	context.program_counter = return_pc
	context.bank_low = expected_low
	context.bank_high = expected_high
	context.mapper_state = result_mapper.duplicate(true)
	context.source_label = "ROM-byte PASS field caller callee `$%04X->$%04X->$%04X`" % [callsite, target, return_pc]
	var next_boundary := get_task_boundary_snapshot(0x05)
	return {"ok": true, "status": "pass_waiter_rom_call_return_adopted",
		"rom_sha256": ROM_SHA256, "entry_pc": callsite, "target_pc": target,
		"exit_pc": return_pc, "executed_source_spans": spans_variant.duplicate(true),
		"source_instruction_pcs": result.get("source_instruction_pcs", []).duplicate(),
		"next_boundary_snapshot": next_boundary,
		"call_return_verified": true, "trace_state_used": false,
		"test_fixture": false}


func _fail_pass_waiter_cleanup(message: String) -> Dictionary:
	_fail(message)
	return {"ok": false, "error": error_message}


func _fail_pass_waiter_field(message: String) -> Dictionary:
	_fail(message)
	return {"ok": false, "error": error_message}


func _pass_confirmation_wait_stack_read_matches(read_variant: Variant,
		source_pc: int, address: int, expected_value: int) -> bool:
	if not read_variant is Dictionary:
		return false
	var read: Dictionary = read_variant
	return int(read.get("source_pc", -1)) == source_pc \
		and int(read.get("address", -1)) == address \
		and (expected_value < 0 or int(read.get("value", -1)) == expected_value)


func _pass_confirmation_wait_source_write_matches(write_variant: Variant,
		source_pc: int, address: int, value: int, old_value: int) -> bool:
	if not write_variant is Dictionary:
		return false
	var write: Dictionary = write_variant
	return int(write.get("source_pc", -1)) == source_pc \
		and int(write.get("address", -1)) == address \
		and int(write.get("value", -1)) == value \
		and int(write.get("old", -1)) == old_value


func _pass_confirmation_wait_ordered_writes_match(boundary: Dictionary,
		waiter_result: Dictionary, entry_sp: int, result_ram_variant: Variant,
		result_stack_variant: Variant) -> bool:
	var entry_ram_variant: Variant = boundary.get("ram_image", PackedByteArray())
	var entry_stack_variant: Variant = boundary.get("stack_page", PackedByteArray())
	var writes_variant: Variant = waiter_result.get("source_writes", [])
	var stack_writes_variant: Variant = waiter_result.get("source_stack_writes", [])
	if not entry_ram_variant is PackedByteArray or not entry_stack_variant is PackedByteArray \
			or not result_ram_variant is PackedByteArray or not result_stack_variant is PackedByteArray \
			or not writes_variant is Array or not stack_writes_variant is Array:
		return false
	var entry_ram: PackedByteArray = entry_ram_variant
	var entry_stack: PackedByteArray = entry_stack_variant
	var result_ram: PackedByteArray = result_ram_variant
	var result_stack: PackedByteArray = result_stack_variant
	var writes: Array = writes_variant
	var stack_writes: Array = stack_writes_variant
	if entry_sp < 3 or entry_sp > 0xFF or writes.size() != 1 or stack_writes.size() != 3 \
			or result_ram.size() != RAM_SIZE or result_stack.size() != STACK_PAGE_SIZE \
			or result_ram.slice(0x0100, 0x0200) != result_stack:
		return false
	var ram_write: Dictionary = writes[0] if writes[0] is Dictionary else {}
	if ram_write.is_empty() or int(ram_write.get("source_pc", -1)) != 0xCC48 \
			or int(ram_write.get("address", -1)) != 0x05F4 \
			or int(ram_write.get("old", -1)) != int(entry_ram[0x05F4]) \
			or int(ram_write.get("value", -1)) != 0 \
			or int(ram_write.get("trace_pc", -1)) != 0xCC4B:
		return false
	if not _pass_confirmation_wait_stack_write_matches(stack_writes[0], 0xD70C,
			0x0100 + entry_sp, 0xD7, "jsr_push_high") \
			or not _pass_confirmation_wait_stack_write_matches(stack_writes[1], 0xD70C,
			0x0100 + entry_sp - 1, 0x0E, "jsr_push_low") \
			or not _pass_confirmation_wait_stack_write_matches(stack_writes[2], 0xCC4D,
			0x0100 + entry_sp - 2, 0x06, "pha"):
		return false
	var expected_ram := entry_ram.duplicate()
	var expected_stack := entry_stack.duplicate()
	expected_ram[0x05F4] = 0
	for write_variant: Variant in stack_writes:
		var write: Dictionary = write_variant
		var address := int(write.get("address", -1))
		var value := int(write.get("value", -1))
		if address < 0x0100 or address >= 0x0200 or value < 0 or value > 0xFF:
			return false
		expected_ram[address] = value
		expected_stack[address - 0x0100] = value
	return result_ram == expected_ram and result_stack == expected_stack \
		and int(result_stack[(entry_sp - 2) & 0xFF]) == 0x06 \
		and int(result_stack[(entry_sp - 1) & 0xFF]) == 0x0E \
		and int(result_stack[entry_sp]) == 0xD7


func _pass_confirmation_wait_stack_write_matches(write_variant: Variant,
		source_pc: int, address: int, value: int, role: String) -> bool:
	if not write_variant is Dictionary:
		return false
	var write: Dictionary = write_variant
	return int(write.get("source_pc", -1)) == source_pc \
		and int(write.get("address", -1)) == address \
		and int(write.get("value", -1)) == value \
		and String(write.get("role", "")) == role


func sample_controller_input(button_state: int) -> Dictionary:
	if not _require_initialized():
		return {"ok": false, "error": error_message}
	var action_menu_wait: TaskContext = _contexts.get(0x05)
	var active_slot05_action_menu_wait := _active_task_slot == 0x05 \
			and int(_ram[0x0000]) == 0x05 \
			and not _slot05_pass_handler_dispatch_pending \
			and action_menu_wait != null \
			and action_menu_wait.phase == ContextPhase.RUNNING \
			and action_menu_wait.program_counter == 0xD5EA \
			and action_menu_wait.bank_low == 0x1A \
			and action_menu_wait.bank_high == 0x1B
	var pass_receiver_wait: TaskContext = _contexts.get(0x05)
	var active_slot05_pass_receiver_wait := _slot05_pass_receiver_input_wait_ready \
			and _active_task_slot == 0x05 and int(_ram[0x0000]) == 0x05 \
			and pass_receiver_wait != null \
			and pass_receiver_wait.phase == ContextPhase.RUNNING \
			and pass_receiver_wait.program_counter == 0xD80F \
			and pass_receiver_wait.bank_low == 0x1C \
			and pass_receiver_wait.bank_high == 0x1D \
			and String(pass_receiver_wait.source_label) == \
				"ROM-byte PASS receiver live input poll at `$D80F`"
	if _active_task_slot != -1 and not active_slot05_action_menu_wait \
			and not active_slot05_pass_receiver_wait:
		return {"ok": false, "error": "Controller input can only be sampled between source-task executions."}
	if button_state < 0 or button_state > 0xFF:
		return {"ok": false, "error": "Controller state must be an 8-bit NES pad mask."}
	var previous := int(_ram[0x001C])
	var current := button_state & 0xFF
	var newly_pressed := (previous ^ current) & current
	_ram[0x001C] = current
	_ram[0x001E] = newly_pressed
	_controller_sample_receipt_id += 1
	_last_controller_sample = {
		"sample_receipt_id": _controller_sample_receipt_id,
		"previous": previous,
		"current": current,
		"newly_pressed": newly_pressed,
		"held_ram_001c": int(_ram[0x001C]),
		"edge_ram_001e": int(_ram[0x001E]),
	}
	return {"ok": true, "sample": _last_controller_sample.duplicate(true)}


## Applies the bounded ROM-derived D5EA action-menu poll result to scheduler
## state. The executor must echo the latest one-use controller sample receipt;
## caller-supplied RAM/stack images are never accepted.
func adopt_first_action_menu_input_result(result: Dictionary) -> Dictionary:
	if not _require_initialized():
		return {"ok": false, "status": "scheduler_not_ready", "error": error_message}
	var context: TaskContext = _contexts.get(0x05)
	if _active_task_slot != 0x05 or int(_ram[0x0000]) != 0x05 \
			or context == null or context.phase != ContextPhase.RUNNING \
			or context.program_counter != 0xD5EA \
			or context.bank_low != 0x1A or context.bank_high != 0x1B \
			or int(_ram[0x0024]) != 0x1A or int(_ram[0x0025]) != 0x1B \
			or int(_ram[0x0621]) != 0:
		return _first_action_input_adoption_failure(
			"PASS input adoption requires the live active slot-$05 `$D5EA` context-0 poll in banks `$1A/$1B`.")
	for forbidden_key in ["ram_image", "stack_page", "fceux_ram", "captured_ram", "emulator_snapshot"]:
		if result.has(forbidden_key):
			return _first_action_input_adoption_failure(
				"PASS input adoption does not consume RAM images or emulator snapshots.")
	if not bool(result.get("ok", false)) \
			or String(result.get("rom_sha256", result.get("source_rom_sha256", ""))) != ROM_SHA256 \
			or String(result.get("source_manifest_sha256", result.get("manifest_sha256", ""))) \
			!= FIRST_ACTION_MENU_INPUT_MANIFEST_SHA256 \
			or String(result.get("input_span_sha256", "")) != FIRST_ACTION_MENU_INPUT_SPAN_SHA256 \
			or String(result.get("direction_table_sha256", "")) != FIRST_ACTION_MENU_DIRECTION_TABLE_SHA256:
		return _first_action_input_adoption_failure(
			"PASS input result is not tied to the pinned ROM, action-input span, and context-0 direction table.")
	var boundary_variant: Variant = result.get("boundary_proof", {})
	var sample_variant: Variant = result.get("input_sample_receipt", {})
	var writes_variant: Variant = result.get("source_writes", [])
	if not boundary_variant is Dictionary or not sample_variant is Dictionary \
			or not writes_variant is Array:
		return _first_action_input_adoption_failure(
			"PASS input result omits its compact source boundary, input receipt, or ordered writes.")
	var boundary: Dictionary = boundary_variant
	var sample: Dictionary = sample_variant
	var source_writes: Array = writes_variant
	if not _first_action_menu_boundary_proof_matches(boundary, context):
		return _first_action_input_adoption_failure(
			"PASS input result does not describe the scheduler's current `$D5EA` RAM/task context.")
	var receipt_id := int(sample.get("sample_receipt_id", -1))
	if receipt_id <= 0 or receipt_id != _controller_sample_receipt_id \
			or receipt_id <= _last_adopted_controller_sample_receipt_id \
			or not _first_action_sample_receipt_matches(sample):
		return _first_action_input_adoption_failure(
			"PASS input result does not echo the latest unused controller-sample receipt.")
	var input_edge := int(_last_controller_sample.get("newly_pressed", -1))
	var result_status := String(result.get("status", ""))
	if result_status == "pass_selection_applied":
		if input_edge != 0x02 or (int(_last_controller_sample.get("current", 0)) & 0x02) == 0 \
				or (int(_last_controller_sample.get("current", 0)) & 0x80) != 0 \
				or int(result.get("resume_pc", -1)) != 0xD5E5 \
				or int(result.get("next_wait_pc", -1)) != 0xD5EA \
				or not _first_action_pass_selection_writes_match(source_writes):
			return _first_action_input_adoption_failure(
				"PASS selection result must be the separate Left edge, action ID 1, and exact ROM source writes.")
		for write_variant: Variant in source_writes:
			var write: Dictionary = write_variant
			_ram[int(write["address"])] = int(write["value"])
		_slot05_pass_selection_adopted = true
		_last_adopted_controller_sample_receipt_id = receipt_id
		return {
			"ok": true,
			"status": "pass_selection_adopted",
			"accepted_status": result_status,
			"selected_action_id": 1,
			"selected_direction_index": 1,
			"source_writes_applied": source_writes.duplicate(true),
			"source_writes_applied_count": source_writes.size(),
			"active_task_slot": _active_task_slot,
			"context_pc": context.program_counter,
			"next_source_poll_pc": 0xD5EA,
			"sample_receipt_id": receipt_id,
			"next_boundary_snapshot": _first_action_menu_adoption_snapshot(context),
		}
	if result_status == "pass_confirmation_handoff_resolved":
		if not _slot05_pass_selection_adopted or int(_ram[0x043B]) != 1 \
				or int(_ram[0x061E]) != 0x81 or input_edge != 0x80 \
				or (int(_last_controller_sample.get("current", 0)) & 0x80) == 0 \
				or not source_writes.is_empty() \
				or String(result.get("handler_span_sha256", "")) != PASS_RECEIVER_HANDLER_SPAN_SHA256:
			return _first_action_input_adoption_failure(
				"PASS confirmation needs a new A edge, the adopted PASS selection latch, and no poll writes.")
		_last_adopted_controller_sample_receipt_id = receipt_id
		_slot05_pass_handler_dispatch_pending = true
		context.source_label = "ROM-byte PASS A confirmation consumed at `$D5EA`; source execution remains pending"
		return {
			"ok": true,
			"status": "pass_confirmation_pending_source_execution",
			"accepted_status": result_status,
			"selected_action_id": 1,
			"active_task_slot": _active_task_slot,
			"source_boundary_pc": context.program_counter,
			"source_execution_pending": true,
			"handler_dispatch_executed": false,
			"source_writes_applied": [],
			"sample_receipt_id": receipt_id,
		}
	return _first_action_input_adoption_failure(
		"Only a source-verified PASS selection or PASS-confirmation result is accepted at `$D5EA`.")


## Applies CB99 only from the source executor's live `$D6C7` boundary. The
## D5EA confirmation does not create a D5C3 snapshot or claim the dispatch path.
func adopt_first_action_menu_handler_dispatch(result: Dictionary) -> Dictionary:
	if not _require_initialized():
		return {"ok": false, "status": "scheduler_not_ready", "error": error_message}
	var context: TaskContext = _contexts.get(0x05)
	if not _slot05_pass_handler_dispatch_pending \
			or not _slot05_pass_selection_adopted \
			or _active_task_slot != 0x05 or int(_ram[0x0000]) != 0x05 \
			or context == null or context.phase != ContextPhase.RUNNING \
			or context.program_counter != 0xD6C7 \
			or context.bank_low != 0x1A or context.bank_high != 0x1B \
			or int(_ram[0x0024]) != 0x1C or int(_ram[0x0025]) != 0x1D \
			or context.stack_pointer != 0x4A \
			or context.accumulator != 0x01 or context.y_register != 0x02 \
			or int(_ram[0x043B]) != 1 or int(_ram[0x061E]) != 0x81 \
			or int(_ram[0x0621]) != 0:
		return _first_action_input_adoption_failure(
			"PASS handler dispatch adoption requires live slot `$05` `$D6C7` state, task banks `$1A/$1B`, mapped-bank shadows `$1C/$1D`, and the adopted PASS confirmation.")
	for forbidden_key in ["ram_image", "stack_page", "entry_ram_image", "entry_stack_page",
			"fceux_ram", "captured_ram", "emulator_snapshot"]:
		if result.has(forbidden_key):
			return _first_action_input_adoption_failure(
				"PASS handler dispatch adoption replays source events into scheduler-owned state, never caller RAM/stack images.")
	if not bool(result.get("ok", false)) \
			or String(result.get("status", "")) != "pass_cb99_dispatched" \
			or String(result.get("rom_sha256", "")) != ROM_SHA256 \
			or String(result.get("source_manifest_sha256", "")) != FIRST_ACTION_MENU_INPUT_MANIFEST_SHA256 \
			or String(result.get("input_span_sha256", "")) != FIRST_ACTION_MENU_INPUT_SPAN_SHA256 \
			or String(result.get("direction_table_sha256", "")) != FIRST_ACTION_MENU_DIRECTION_TABLE_SHA256 \
			or String(result.get("handler_span_sha256", "")) != PASS_RECEIVER_HANDLER_SPAN_SHA256 \
			or String(result.get("inline_dispatch_span_sha256", "")) != FIRST_ACTION_INLINE_DISPATCH_SHA256 \
			or bool(result.get("trace_state_used", true)) \
			or bool(result.get("ppu_apu_effects_applied", true)) \
			or bool(result.get("handler_instructions_executed", true)) \
			or int(result.get("source_boundary_pc", -1)) != 0xD6C7 \
			or int(result.get("caller_return_pc", -1)) != 0xD6C9 \
			or int(result.get("outer_caller_return_pc", -1)) != 0xD634 \
			or int(result.get("resume_pc", -1)) != 0xD7E8 \
			or int(result.get("handler_entry_pc", -1)) != 0xD7E8 \
			or result.has("pre_dispatch_helper_bodies_executed") \
			or result.has("source_helper_boundary_limitation"):
		return _first_action_input_adoption_failure(
			"PASS handler dispatch result must prove the live ROM-byte `$D6C7->$CB99->$D7E8` sequence.")
	var boundary_variant: Variant = result.get("boundary_proof", {})
	var reads_variant: Variant = result.get("source_reads", [])
	var writes_variant: Variant = result.get("source_writes", [])
	var stack_writes_variant: Variant = result.get("source_stack_writes", [])
	var registers_variant: Variant = result.get("registers", {})
	var mapper_variant: Variant = result.get("mapper", {})
	if not boundary_variant is Dictionary or not reads_variant is Array \
			or not writes_variant is Array or not stack_writes_variant is Array \
			or not registers_variant is Dictionary or not mapper_variant is Dictionary:
		return _first_action_input_adoption_failure(
			"PASS handler dispatch result omits its boundary proof, source events, registers, or mapper.")
	var boundary: Dictionary = boundary_variant
	var registers: Dictionary = registers_variant
	var mapper: Dictionary = mapper_variant
	var entry_sp := int(result.get("entry_sp", -1))
	var final_sp := entry_sp
	var bank_registers_variant: Variant = mapper.get("bank_registers_at_d6c7", {})
	if not bank_registers_variant is Dictionary:
		return _first_action_input_adoption_failure(
			"PASS CB99 result omits the live MMC3 bank-register proof.")
	var bank_registers: Dictionary = bank_registers_variant
	var result_p := int(registers.get("p", -1))
	var expected_preserved_p := context.status_register & ~0x83
	if not _first_action_d6c7_boundary_proof_matches(boundary, context) \
			or entry_sp != context.stack_pointer \
			or int(result.get("final_sp", -1)) != final_sp \
			or (result_p & ~0x83) != expected_preserved_p \
			or int(registers.get("a", -1)) != 0xE8 \
			or int(registers.get("y", -1)) != 0x04 \
			or int(registers.get("sp", -1)) != final_sp \
			or int(registers.get("pc", -1)) != 0xD7E8 \
			or not bool(registers.get("x_known", false)) \
			or int(registers.get("x", -1)) != context.x_register \
			or int(registers.get("p_known_mask", -1)) != 0x83 \
			or (result_p & 0x83) != 0x80 \
			or mapper.get("banks_at_task_boundary", []) != [0x1A, 0x1B] \
			or int(bank_registers.get(6, bank_registers.get("6", -1))) != 0x1C \
			or int(bank_registers.get(7, bank_registers.get("7", -1))) != 0x1D \
			or int(mapper.get("fixed_bank", -1)) != 0x1E:
		return _first_action_input_adoption_failure(
			"PASS handler dispatch registers/SP/mapper do not match the live `$D6C7` boundary and CB99 result.")
	var history_variant: Variant = result.get("source_pc_history", [])
	if not history_variant is Array \
			or not _first_action_dispatch_history_matches(history_variant) \
			or not _first_action_dispatch_reads_match(reads_variant) \
			or not _first_action_dispatch_ram_writes_match(writes_variant) \
			or not _first_action_dispatch_stack_writes_match(stack_writes_variant, entry_sp) \
			or not _first_action_d6c7_outer_stack_frame_matches(entry_sp):
		return _first_action_input_adoption_failure(
			"PASS `$CB99` table reads, pointer writes, JSR/PHA pushes, or live outer frame differ from the checked dispatch contract.")
	var p_known_mask := int(registers.get("p_known_mask", -1))
	var p_value := int(registers.get("p", -1))
	if p_known_mask < 0 or p_known_mask > 0xFF or p_value < 0 or p_value > 0xFF \
			or (p_known_mask & 0x83) != 0x83 or (p_value & 0x83) != 0x80:
		return _first_action_input_adoption_failure(
			"PASS `$CB99` final flags do not establish A=$E8's expected N/Z and clear carry state.")
	for write_variant: Variant in writes_variant:
		var write: Dictionary = write_variant
		_ram[int(write["address"])] = int(write["value"])
	for write_variant: Variant in stack_writes_variant:
		var write: Dictionary = write_variant
		var stack_index := int(write["address"]) & 0xFF
		_stack_page[stack_index] = int(write["value"])
		_ram[0x0100 + stack_index] = int(write["value"])
	context.program_counter = 0xD7E8
	context.stack_pointer = final_sp
	context.accumulator = 0xE8
	context.y_register = 0x04
	context.x_register = int(registers["x"]) & 0xFF
	context.status_register = p_value | 0x20
	context.status_known_mask = p_known_mask | 0x83
	context.source_label = "ROM-byte live PASS dispatch `$D6C7->$CB99->$D7E8`"
	_slot05_pass_handler_dispatch_pending = false
	var next_boundary := get_task_boundary_snapshot(0x05)
	next_boundary["executing_cpu_bank"] = 0x1E
	next_boundary["mapper_proof"] = {
		"banks_at_fixed_dispatch": [0x1C, 0x1D], "fixed_bank": 0x1E,
	}
	return {
		"ok": true,
		"status": "pass_handler_entry_adopted",
		"accepted_status": String(result.get("status", "")),
		"handler_dispatch_executed": true,
		"source_boundary_pc": 0xD6C7,
		"source_pc_history": history_variant.duplicate(),
		"handler_body_executed": false,
		"selected_action_id": 1,
		"active_task_slot": _active_task_slot,
		"context_pc": context.program_counter,
		"context_sp": context.stack_pointer,
		"source_writes_applied": writes_variant.duplicate(true),
		"source_stack_writes_applied": stack_writes_variant.duplicate(true),
		"sample_receipt_id": _last_adopted_controller_sample_receipt_id,
		"next_boundary_snapshot": next_boundary,
		"trace_state_used": false,
	}


## Replays the ROM action-label renderer's ordered RAM writes after a real
## scheduler dispatch at `$E945`. The returned CPU boundary remains live slot-$05
## state; this method does not run an NMI or apply its queued PPU packets.
func adopt_first_action_pass_label_renderer_result(result: Dictionary) -> Dictionary:
	if not _require_initialized():
		return {"ok": false, "status": "scheduler_not_ready", "error": error_message}
	var context: TaskContext = _contexts.get(0x05)
	if not _slot05_pass_selection_adopted or not _slot05_pass_handler_dispatch_pending \
			or _active_task_slot != 0x05 or int(_ram[0x0000]) != 0x05 \
			or context == null or context.phase != ContextPhase.RUNNING \
			or context.program_counter != 0xE945 \
			or context.bank_low != 0x1A or context.bank_high != 0x1B \
			or int(_ram[0x0024]) != 0x1A or int(_ram[0x0025]) != 0x1B \
			or int(_ram[0x043B]) != 0x01 or int(_ram[0x0515]) != 0:
		return _first_action_input_adoption_failure(
			"PASS label adoption requires the live scheduler-dispatched slot-$05 `$E945` state and an empty PPU queue.")
	for forbidden_key in ["ram_image", "stack_page", "entry_ram_image", "entry_stack_page",
			"fceux_ram", "captured_ram", "emulator_snapshot", "screenshot", "capture_image"]:
		if result.has(forbidden_key):
			return _first_action_input_adoption_failure(
				"PASS label adoption replays ROM events into scheduler-owned memory; supplied captures are forbidden.")
	var writes_variant: Variant = result.get("source_writes", [])
	var packets_variant: Variant = result.get("ppu_queue_packets", [])
	var registers_variant: Variant = result.get("registers", {})
	var instruction_pcs_variant: Variant = result.get("source_instruction_pcs", [])
	var stack_writes_variant: Variant = result.get("stack_writes", [])
	if not writes_variant is Array or not packets_variant is Array \
			or not registers_variant is Dictionary or not instruction_pcs_variant is Array \
			or not stack_writes_variant is Array:
		return _first_action_input_adoption_failure(
			"PASS label renderer result omits its ordered writes, packet summary, CPU state, or instruction path.")
	var registers: Dictionary = registers_variant
	var instruction_pcs: Array = instruction_pcs_variant
	var packets: Array = packets_variant
	if not bool(result.get("ok", false)) \
			or String(result.get("status", "")) != "pass_action_label_queued" \
			or String(result.get("rom_sha256", "")) != ROM_SHA256 \
			or bool(result.get("trace_state_used", true)) \
			or bool(result.get("emulator_data_used", true)) \
			or bool(result.get("runtime_mutation_applied", true)) \
			or bool(result.get("ppu_bus_writes_applied", true)) \
			or bool(result.get("normal_nmi_applied", true)) \
			or bool(result.get("source_cycle_timing_modeled", true)) \
			or int(result.get("slot_base", -1)) != 0x05 \
			or String(result.get("dispatch_resume_path", "")) != "yielded_rts" \
			or int(result.get("entry_pc", -1)) != 0xE945 \
			or int(result.get("exit_pc", -1)) != 0xD68A \
			or int(result.get("entry_sp", -1)) != context.stack_pointer \
			or int(result.get("source_return_word", -1)) != 0xE944 \
			or int(result.get("rendered_action_id", -1)) != 0x01 \
			or int(result.get("registers", {}).get("pc", -1)) != 0xD68A \
			or int(result.get("registers", {}).get("sp", -1)) != ((context.stack_pointer + 4) & 0xFF) \
			or instruction_pcs.is_empty() or int(instruction_pcs[0]) != 0xE945 \
			or not stack_writes_variant.is_empty() \
			or int(result.get("queue_ready_flag_before", -1)) != int(_ram[0x0515]) \
			or int(result.get("queue_ready_flag_after", -1)) != 0x80 \
			or packets.size() != 2 \
			or int(packets[0].get("ppu_address", -1)) != 0x22AC \
			or int(packets[1].get("ppu_address", -1)) != 0x22CC \
			or int(packets[0].get("payload_width", -1)) != 5 \
			or int(packets[1].get("payload_width", -1)) != 5:
		return _first_action_input_adoption_failure(
			"PASS label renderer receipt does not match the ROM `$E945->$D68A` two-packet source contract.")
	for write_variant: Variant in writes_variant:
		if not write_variant is Dictionary:
			return _first_action_input_adoption_failure("PASS label renderer emitted a malformed RAM write.")
		var write: Dictionary = write_variant
		var address := int(write.get("address", -1))
		var value := int(write.get("value", -1))
		if address < 0 or address >= RAM_SIZE or value < 0 or value > 0xFF:
			return _first_action_input_adoption_failure("PASS label renderer write escaped scheduler-owned internal RAM.")
	for write_variant: Variant in writes_variant:
		var write: Dictionary = write_variant
		_ram[int(write["address"])] = int(write["value"])
	context.program_counter = 0xD68A
	context.stack_pointer = int(registers["sp"]) & 0xFF
	context.accumulator = int(registers.get("a", -1)) & 0xFF
	context.x_register = int(registers.get("x", -1)) & 0xFF
	context.y_register = int(registers.get("y", -1)) & 0xFF
	context.status_register = int(registers.get("p", 0x20)) | 0x20
	context.status_known_mask = int(registers.get("p_known_mask", 0)) & 0xFF
	context.source_label = "ROM-byte PASS label renderer queued packets `$22AC/$22CC`; returned `$D68A`"
	var next_boundary := get_task_boundary_snapshot(0x05)
	return {
		"ok": true,
