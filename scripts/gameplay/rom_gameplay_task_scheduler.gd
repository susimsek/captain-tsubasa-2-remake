## Adopts the live scenario-$44 field entry through its first `$F018->$CB0F`
## packet-producer yield, then applies the verified ROM task-save contract.
func adopt_slot05_scenario44_field_entry_yield(live_boundary: Dictionary,
		handoff_result: Dictionary, worker_result: Dictionary) -> Dictionary:
	if not _require_initialized():
		return {}
	var context: TaskContext = _contexts.get(0x05)
	var live_ram: PackedByteArray = live_boundary.get("ram_image", PackedByteArray())
	var live_stack: PackedByteArray = live_boundary.get("stack_page", PackedByteArray())
	var handoff_ram: PackedByteArray = handoff_result.get("ram_image", PackedByteArray())
	var handoff_stack: PackedByteArray = handoff_result.get("stack_page", PackedByteArray())
	var registers: Dictionary = worker_result.get("registers", {})
	var mapper: Dictionary = worker_result.get("mapper", {})
	var entry_mapper: Dictionary = worker_result.get("entry_mapper", {})
	var source_dispatch: Dictionary = worker_result.get("source_dispatch", {})
	var result_ram: PackedByteArray = worker_result.get("ram_image", PackedByteArray())
	var result_stack: PackedByteArray = worker_result.get("stack_page", PackedByteArray())
	var writes: Array = worker_result.get("writes", [])
	var mapper_writes: Array = worker_result.get("mapper_writes", [])
	var calls: Array = worker_result.get("calls", [])
	var spans: Array = worker_result.get("executed_source_spans", [])
	var source_boundary: Dictionary = worker_result.get("source_boundary", {})
	if _active_task_slot != 0x05 or context == null \
			or context.phase != ContextPhase.RUNNING or context.program_counter != 0x8003 \
			or String(context.source_label) != "ROM-byte scenario-$44 caller handoff `$E38F->$8003`" \
			or int(live_boundary.get("slot_base", -1)) != 0x05 \
			or int(live_boundary.get("active_task_slot", -1)) != 0x05 \
			or int(live_boundary.get("pc", -1)) != 0x8003 \
			or int(live_boundary.get("bank_low", -1)) != 0x1A \
			or int(live_boundary.get("bank_high", -1)) != 0x1B \
			or live_ram.size() != RAM_SIZE or live_stack.size() != STACK_PAGE_SIZE \
			or handoff_ram != live_ram or handoff_stack != live_stack \
			or _ram != live_ram or _stack_page != live_stack \
			or String(handoff_result.get("status", "")) != "scenario44_field_runtime_entered":
		_fail("Scenario-$44 field-entry adoption requires the unchanged live `$8003` slot-$05 handoff.")
		return {}
	if String(worker_result.get("rom_sha256", "")) != ROM_SHA256 \
			or String(worker_result.get("source_manifest", "")) != "res://reference/rom_extract/gameplay/fresh_bank18_worker_prefix/manifest.json" \
			or String(worker_result.get("source_manifest_sha256", "")) != FRESH_BANK18_WORKER_MANIFEST_SHA256 \
			or not bool(worker_result.get("ok", false)) \
			or String(worker_result.get("status", "")) != "scenario44_field_entry_source_call_boundary" \
			or String(worker_result.get("exit_kind", "")) != "source_call_boundary" \
			or int(worker_result.get("exit_pc", -1)) != 0xCB0F \
			or int(worker_result.get("exit_bank", -1)) != 0x1E \
			or int(registers.get("pc", -1)) != 0xCB0F \
			or int(mapper.get("bank_low", -1)) != 0x1A \
			or int(mapper.get("bank_high", -1)) != 0x1B \
			or int(entry_mapper.get("bank_low", -1)) != 0x1A \
			or int(entry_mapper.get("bank_high", -1)) != 0x1B \
			or int(source_dispatch.get("slot_base", -1)) != 0x05 \
			or String(source_dispatch.get("resume_path", "")) != "scenario44_rom_entry" \
			or int(source_dispatch.get("pc", -1)) != 0x8003 \
			or not bool(source_dispatch.get("source_dispatch_observed", false)) \
			or String(source_boundary.get("status", "")) != "scenario44_field_entry_source_call_boundary" \
			or result_ram.size() != RAM_SIZE or result_stack.size() != STACK_PAGE_SIZE \
			or result_ram.slice(0x0100, 0x0200) != result_stack \
			or int(result_ram[0x0518]) != 0x44 or int(result_ram[0x063D]) != 0x02 \
			or int(registers.get("a", -1)) != 0x01 \
			or int(registers.get("sp", -1)) < 0 or int(registers.get("sp", -1)) > 0xFF:
		_fail("Scenario-$44 field-entry result does not prove the source `$F018->$CB0F` yield state.")
		return {}
	var required_spans := {
		"bank1a_field_entry_8003_A000.bin": "cfcde4d67358fc36a7e7e67e039d7f36a046a215bcd55b962eb7decac6a7e5fd",
		"fixed_field_loop_dispatch_vector_C600_C603.bin": "957545b88a95935d7f51db3d20d2c8e47306e256632051a8c4b50157aea6a184",
		"fixed_field_update_dispatch_D565_D600.bin": "fef8713ab595c20f8a968c5771fcb94ab929e3092349f3d73340462b22be1947",
		"fixed_field_entry_bootstrap_EFA2_F015.bin": "00cae334d25606bc81860a2205549c2cfdc3dd98896e23f77d5134009069186e",
		"fixed_first_command_packet_code_F015_F15A.bin": "df7c650c952fb5dfc9a8a10de43f739c9fc4cbdef343bae7ba70c4921a281dc9",
	}
	for span_variant in spans:
		if span_variant is Dictionary:
			var span: Dictionary = span_variant
			var file_name := String(span.get("file", ""))
			if required_spans.has(file_name) \
					and String(span.get("sha256", "")) == String(required_spans[file_name]):
				required_spans.erase(file_name)
	if not required_spans.is_empty():
		_fail("Scenario-$44 field-entry execution omitted required ROM source spans: %s." % str(required_spans.keys()))
		return {}
	var field_yield_call_seen := false
	for call_variant in calls:
		if call_variant is Dictionary:
			var call: Dictionary = call_variant
			if int(call.get("callsite", -1)) == 0xF018 \
					and int(call.get("target", -1)) == 0xCB0F \
					and int(call.get("sp_after_push", -1)) == int(registers["sp"]):
				field_yield_call_seen = true
	var result_sp := int(registers["sp"]) & 0xFF
	if not field_yield_call_seen \
			or int(result_stack[(result_sp + 1) & 0xFF]) != 0x1A \
			or int(result_stack[(result_sp + 2) & 0xFF]) != 0xF0:
		_fail("Scenario-$44 field entry lacks the actual `$F018->$CB0F` call frame on the task stack.")
		return {}
	var expected_ram := live_ram.duplicate()
	var expected_stack := live_stack.duplicate()
	for write_variant in writes:
		if not write_variant is Dictionary:
			_fail("Scenario-$44 field-entry write stream contains a malformed event.")
			return {}
		var write: Dictionary = write_variant
		var address := int(write.get("address", -1))
		var value := int(write.get("value", -1))
		if address < 0 or address >= RAM_SIZE or value < 0 or value > 0xFF \
				or _is_scheduler_owned_ram_address(address):
			_fail("Scenario-$44 field-entry write is invalid or scheduler-owned at `$%04X`." % address)
			return {}
		expected_ram[address] = value
		if address >= 0x0100 and address < 0x0200:
			expected_stack[address & 0xFF] = value
	var expected_low := int(live_boundary["bank_low"])
	var expected_high := int(live_boundary["bank_high"])
	var expected_select := int(context.mapper_state.get("register_select", 7))
	for mapper_write_variant in mapper_writes:
		if not mapper_write_variant is Dictionary:
			_fail("Scenario-$44 field-entry mapper stream contains a malformed event.")
			return {}
		var mapper_write: Dictionary = mapper_write_variant
		var mapper_address := int(mapper_write.get("address", -1))
		var mapper_value := int(mapper_write.get("value", -1))
		if mapper_address == 0x8000:
			expected_select = mapper_value & 0x07
		elif mapper_address == 0x8001 and expected_select == 6:
			expected_low = mapper_value
		elif mapper_address == 0x8001 and expected_select == 7:
			expected_high = mapper_value
		else:
			_fail("Scenario-$44 field-entry mapper write is outside its MMC3 register path.")
			return {}
	if result_ram != expected_ram or result_stack != expected_stack \
			or int(mapper.get("bank_low", -1)) != expected_low \
			or int(mapper.get("bank_high", -1)) != expected_high \
			or int(mapper.get("select", -1)) != expected_select:
		_fail("Scenario-$44 field-entry CPU/mapper state differs from replaying its ordered ROM writes.")
		return {}
	_ram = expected_ram
	_stack_page = expected_stack
	context.accumulator = int(registers["a"]) & 0xFF
	context.x_register = int(registers["x"]) & 0xFF
	context.y_register = int(registers["y"]) & 0xFF
	context.status_register = int(registers.get("p", context.status_register)) & 0xFF
	context.status_known_mask = int(registers.get("p_known_mask", context.status_known_mask)) & 0xFF
	context.stack_pointer = result_sp
	context.program_counter = 0xCB0F
	context.bank_low = expected_low
	context.bank_high = expected_high
	context.mapper_state = mapper.duplicate(true)
	context.source_label = "ROM-byte scenario-$44 field packet producer yielded at `$F018->$CB0F`"
	_slot05_scenario44_field_entry_yield_in_progress = true
	var saved := yield_at_verified_callsite(0x05, 0xF018, context.accumulator,
		(result_sp + 2) & 0xFF, context.x_register, context.y_register,
		context.bank_low, context.bank_high, true)
	_slot05_scenario44_field_entry_yield_in_progress = false
	if not saved:
		return {}
	return {
		"ok": true,
		"status": "slot05_scenario44_field_entry_saved_at_cb0f",
		"callsite_pc": 0xF018,
		"handler_entry_pc": 0xCB0F,
		"resume_pc": 0xF01B,
		"task_record": _record_bytes(0x05),
		"saved_boundary": get_task_boundary_snapshot(0x05),
		"scheduler_scan_cursor": _scheduler_scan_cursor,
		"scheduler_y_register": _scheduler_y_register,
		"active_task_slot": _active_task_slot,
		"source_ram_replayed_from_live_boundary": true,
		"source_rom_sha256": ROM_SHA256,
		"task_yield_source_sha256": String(SOURCE_SPANS["task_yield"]["sha256"]),
	}


## Adopts a later ROM `$F018->$CB0F` yield after the scheduler resumes at `$F01B`.
