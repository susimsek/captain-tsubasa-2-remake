	if writes_variant != expected_writes:
		return _fail("PASS continuation RAM-write sequence is not the ordered `$D7F4->$D807` source path.")
	var expected_ram := _ram.duplicate()
	for write_variant in expected_writes:
		var write: Dictionary = write_variant
		expected_ram[int(write["address"])] = int(write["value"])

	var expected_stack := _stack_page.duplicate()
	var expected_stack_writes: Array[Dictionary] = []
	var call_frames := [
		[0xD7EF, 0xD7F1, entry_sp],
		[0xD7FC, 0xD7FE, entry_sp],
		[0xE6EF, 0xE6F1, (entry_sp - 2) & 0xFF],
		[0xE702, 0xE704, (entry_sp - 2) & 0xFF],
		[0xD80C, 0xD80E, entry_sp],
	]
	for frame_variant in call_frames:
		var frame: Array = frame_variant
		var return_word := int(frame[1])
