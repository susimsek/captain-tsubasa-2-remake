	var stack_differences: Array[String] = []
	if result_stack is PackedByteArray and expected_stack.size() == result_stack.size():
		for address in range(STACK_PAGE_SIZE):
			if int(result_stack[address]) != int(expected_stack[address]):
				stack_differences.append("$%02X:%02X/%02X" % [address, int(expected_stack[address]), int(result_stack[address])])
				if stack_differences.size() >= 6:
