			or String(result.get("scenario38_manifest_sha256", "")) != "8787974cbd268a91e36c5cc82783a348edf6132f21c2109a709d8b13a43a1162" \
			or String(result.get("scenario38_stream_sha256", "")) != "63ad2f03483843a538c92e33da4917356fce555fb8b69875b042be85fa77bc76" \
			or bool(result.get("trace_state_used", true)) \
