	for write_variant: Variant in stack_writes_variant:
		var write: Dictionary = write_variant
		var address := int(write.get("address", -1))
		var value := int(write.get("value", -1))
		if int(write.get("source_pc", -1)) not in [0xD7EA, 0xCBBE] \
				or address < 0x0100 or address >= 0x0200 or value < 0 or value > 0xFF:
			return _first_action_input_adoption_failure("PASS handler emitted an invalid source stack write.")
