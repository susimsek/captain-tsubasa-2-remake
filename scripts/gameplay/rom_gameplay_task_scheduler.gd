	else:
		var return_minus_one := source_pc + 2
		_write_stack_byte(sp, (return_minus_one >> 8) & 0xFF)
		sp = (sp - 1) & 0xFF
		_write_stack_byte(sp, return_minus_one & 0xFF)
		sp = (sp - 1) & 0xFF
