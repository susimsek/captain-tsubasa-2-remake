		0x02, 0xA9, 0x80, 0xA0, 0x08, 0x20, 0x0F, 0xC5, 0x60,
	]):
		return _fail("Bank-$10 callback task setup differs from the checked ROM sequence.")
	if _sources["task_create"] != PackedByteArray([0x4C, 0xE7, 0xCA]) \
			or _sources["task_seed"] != PackedByteArray([
				0x48, 0x98, 0xB4, 0x01, 0x99, 0x01, 0x01, 0x68,
				0x99, 0x02, 0x01, 0xA9, 0xFF, 0x95, 0x00, 0x60,
			]):
		return _fail("$C50F/$CAE7 task creation instructions changed.")
	if _sources["scenario_actor_worker_seed"] != PackedByteArray([
			0xC9, 0xFF, 0xF0, 0x14, 0x8D, 0xEA, 0x05, 0xA2, 0x11, 0xA9,
			0xC8, 0x95, 0x01, 0xA9, 0x18, 0x95, 0x02, 0xA9, 0x7F, 0xA0,
			0xFF, 0x20, 0xE7, 0xCA,
		]) \
			or _sources["slot11_actor_worker_prefix"].size() != 74 \
			or _sources["slot11_actor_worker_prefix"].slice(0, 3) != PackedByteArray([0x4C, 0x0F, 0x80]) \
			or _sources["slot11_actor_worker_prefix"].slice(0x47, 0x4A) != PackedByteArray([0x20, 0x15, 0xC5]) \
			or _sources["slot11_actor_parameter_00_pointer"] != PackedByteArray([0x00, 0x94]) \
			or _sources["slot11_actor_parameter_47_pointer"] != PackedByteArray([0x17, 0x99]) \
			or _sources["slot11_actor_parameter_58_pointer"] != PackedByteArray([0x62, 0x9A]) \
			or _sources["slot11_actor_parameter_6D_pointer"] != PackedByteArray([0xE3, 0x9B]) \
			or _sources["slot11_actor_parameter_73_pointer"] != PackedByteArray([0x42, 0x9F]) \
			or _sources["slot11_actor_parameter_74_pointer"] != PackedByteArray([0xBD, 0xA3]) \
			or _sources["slot11_actor_parameter_75_pointer"] != PackedByteArray([0x39, 0xA4]):
		return _fail("Scenario actor seed, bank-$18 setup/callsite, or actor pointer-table bytes changed.")
	if _sources["yield_callsite"] != PackedByteArray([0x20, 0x15, 0xC5]) \
			or _sources["yield_trampoline"] != PackedByteArray([0x4C, 0x0F, 0xCB]):
		return _fail("Verified `$856F→$C515→$CB0F` yield path changed.")
	if _sources["callback_entry"][0] != 0x4C:
		return _fail("Bank-$0B callback entry no longer uses its verified absolute jump.")
	if not _callsite_matches_source(0x856F) or not _callsite_matches_source(0x8886) \
			or not _callsite_matches_source(0xCA4F) \
			or not _callsite_matches_source(0xEB88) \
			or not _callsite_matches_source(0xCBBE) \
			or not _finish_handler_matches_source():
		return false
	var nmi_vectors: PackedByteArray = _sources["nmi_vectors"]
	if nmi_vectors[0] != 0x00 or nmi_vectors[1] != 0xC5 \
			or _sources["nmi_vector_entry"] != PackedByteArray([0x4C, 0x6E, 0xC7]):
		return _fail("Fixed NMI vector/entry no longer resolve to `$C500→$C76E`.")
	return true


func _decode_root_seed(seed: PackedByteArray) -> Dictionary:
	if seed.size() != 17 or seed[0] != 0xA2 or seed[2] != 0xA9 \
			or seed[4] != 0x95 or seed[5] != 0x01 or seed[6] != 0xA9 \
			or seed[8] != 0x95 or seed[9] != 0x02 or seed[10] != 0xA9 \
			or seed[12] != 0xA0 or seed[14] != 0x20 or seed[15] != 0xE7 or seed[16] != 0xCA:
		return {}
	return {
		"slot": int(seed[1]),
		"saved_sp": int(seed[3]),
		"bank_low": int(seed[7]),
		"bank_high": 0,
		"return_high": int(seed[11]),
		"return_low": int(seed[13]),
		"return_word": (int(seed[11]) << 8) | int(seed[13]),
	}


func _callsite_matches_source(source_pc: int) -> bool:
	if source_pc == 0xE775:
		var coordinate_update := FileAccess.get_file_as_bytes(
				"res://reference/rom_extract/gameplay/fresh_bank18_worker_prefix/fixed_field_coordinate_update_E709_E800.bin")
		return coordinate_update.size() == 0xF7 \
				and _sha256(coordinate_update) == "6768f99151f2f28bdd2b46ea5b257703125d180ecd55c83d73088c29a523ca10" \
				and coordinate_update.slice(0xE775 - 0xE709, 0xE775 - 0xE709 + 5) \
				== PackedByteArray([0x20, 0x0F, 0xCB, 0xAD, 0x39]) \
				and _sources.get("yield_trampoline", PackedByteArray()) == PackedByteArray([0x4C, 0x0F, 0xCB])
	if source_pc == 0xE086:
		var field_caller := FileAccess.get_file_as_bytes(
				"res://reference/rom_extract/gameplay/pass_waiter_field_caller_E081/fixed_field_caller_E081_E0DE.bin")
		return field_caller.size() == 94 \
				and _sha256(field_caller) == "d5c9912b82292028e430cba0615751ec0f95c433df07b6738118c8f9c71261b9" \
				and field_caller.slice(0x05, 0x08) == PackedByteArray([0x20, 0x0F, 0xCB]) \
				and _sources.get("yield_trampoline", PackedByteArray()) == PackedByteArray([0x4C, 0x0F, 0xCB])
	if source_pc == 0xD80C:
		var manifest_bytes := FileAccess.get_file_as_bytes(PASS_POST_SCENARIO_INPUT_MANIFEST_PATH)
		var handler := FileAccess.get_file_as_bytes(PASS_POST_SCENARIO_HANDLER_PATH)
		var parsed: Variant = JSON.parse_string(manifest_bytes.get_string_from_utf8()) \
				if not manifest_bytes.is_empty() else null
		if not parsed is Dictionary:
			return false
		var manifest: Dictionary = parsed
		var spans: Variant = manifest.get("source_spans", [])
		var handler_span: Dictionary = {}
		if spans is Array:
			for span_variant in spans:
				if span_variant is Dictionary \
						and String(span_variant.get("name", "")) == "pass_receiver_handler":
					handler_span = span_variant
					break
		return FileAccess.get_sha256(PASS_POST_SCENARIO_INPUT_MANIFEST_PATH) \
				== PASS_POST_SCENARIO_INPUT_MANIFEST_SHA256 \
			and String(manifest.get("schema", "")) == "ct2-first-action-menu-input-rom-data-v1" \
			and String(manifest.get("source_rom_sha256", "")) == ROM_SHA256 \
			and String(handler_span.get("resource", "")) == "pass_receiver_handler_D7E8_D8F6.bin" \
			and String(handler_span.get("sha256", "")) == PASS_RECEIVER_HANDLER_SPAN_SHA256 \
			and handler.size() == 271 and _sha256(handler) == PASS_RECEIVER_HANDLER_SPAN_SHA256 \
			and handler.slice(0xD80C - 0xD7E8, 0xD80C - 0xD7E8 + 3) \
				== PackedByteArray([0x20, 0x0F, 0xCB]) \
			and _sources.get("yield_trampoline", PackedByteArray()) \
				== PackedByteArray([0x4C, 0x0F, 0xCB])
	if source_pc == 0x8047:
		var actor_worker: PackedByteArray = _sources.get("slot11_actor_worker_prefix", PackedByteArray())
		return actor_worker.size() == 74 \
				and _sha256(actor_worker) == String(SOURCE_SPANS["slot11_actor_worker_prefix"]["sha256"]) \
				and actor_worker.slice(0x47, 0x4A) == PackedByteArray([0x20, 0x15, 0xC5]) \
				and _sources.get("yield_trampoline", PackedByteArray()) == PackedByteArray([0x4C, 0x0F, 0xCB])
	if source_pc == 0xCBBE:
		var scenario_code: PackedByteArray = _sources.get("scenario_queue", PackedByteArray())
		return scenario_code == PackedByteArray([0x8D, 0x18, 0x05, 0xA9, 0x80, 0x8D, 0x16, 0x05,
				0xA9, 0x00, 0x85, 0x05, 0xA9, 0x00, 0x20, 0x0F, 0xCB, 0x60]) \
				and scenario_code.slice(14, 17) == PackedByteArray([0x20, 0x0F, 0xCB])
	if source_pc == 0xEB88:
		var root_code: PackedByteArray = _sources.get("root_slot09_loop", PackedByteArray())
		return root_code.size() == 130 \
				and root_code.slice(0, 5) == PackedByteArray([0xA9, 0x01, 0x20, 0x0F, 0xCB])
	if source_pc in [0xF018, 0xF0A8]:
		var packet_code := FileAccess.get_file_as_bytes(
				"res://reference/rom_extract/gameplay/first_command_field/packet_producer/bank_1f_f015_f159_code.bin")
		return packet_code.size() == 325 \
				and _sha256(packet_code) == "df7c650c952fb5dfc9a8a10de43f739c9fc4cbdef343bae7ba70c4921a281dc9" \
				and packet_code.slice(source_pc - 0xF015, source_pc - 0xF015 + 3) \
				== PackedByteArray([0x20, 0x0F, 0xCB]) \
				and _sources.get("yield_trampoline", PackedByteArray()) == PackedByteArray([0x4C, 0x0F, 0xCB])
	if source_pc == 0xCC50:
