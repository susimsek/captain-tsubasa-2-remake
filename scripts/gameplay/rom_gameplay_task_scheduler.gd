	var expected_span_hashes := {
		"fixed_pass_receiver_handler_D7E8_D8F7.bin": "9ccc071c8af66e997b4fe1fe3613af4e764d756c35c6c96118ceba7faf034032",
		"fixed_bank18_wrapper_EF7F_EF99.bin": "8871a231231e221f0a7394c1a1762acdd8fe6d5a68babb454b5bbdb5f5192e0e",
		"bank18_worker_entry_to_yield_call_800C_8889.bin": "3b6cea5d679e0a5aab87d7bd5a721658448463cec6062ad006c3d5d869aeb49e",
		"bank19_pass_receiver_descriptor_pointer_B3ED_B3EF.bin": "8d6a9670a40f54c26c5298fc4b06cdb6c3ad84789484b6115765d9a6115bde15",
	}
	for span_variant in spans_variant:
		if span_variant is Dictionary:
