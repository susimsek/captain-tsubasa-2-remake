## Adopts the ROM's `$0515 != 0` branch from `$8572` to the `$856F` yield
## callsite. This path emits no map packet; it saves slot `$15` so the normal
## scheduler can run another ready task before the next externally observed NMI.
func adopt_slot15_map_busy_queue_yield_result(worker_result: Dictionary) -> bool:
	if not _require_initialized():
		return false
	var context: TaskContext = _contexts.get(0x15)
	if _active_task_slot != 0x15 or context == null \
			or context.phase != ContextPhase.RUNNING or context.program_counter != 0x8572:
		return _fail("Busy-queue yield adoption requires the running slot-$15 `$8572` context.")
	var entry_variant: Variant = worker_result.get("entry_registers", {})
	var registers_variant: Variant = worker_result.get("registers", {})
	var mapper_variant: Variant = worker_result.get("mapper", {})
	var entry_ram_variant: Variant = worker_result.get("entry_ram_image", PackedByteArray())
	var updated_ram_variant: Variant = worker_result.get("updated_ram", PackedByteArray())
	var entry_stack_variant: Variant = worker_result.get("entry_stack_page", PackedByteArray())
	var stack_variant: Variant = worker_result.get("stack_page", PackedByteArray())
	if not entry_variant is Dictionary or not registers_variant is Dictionary \
			or not mapper_variant is Dictionary or not entry_ram_variant is PackedByteArray \
			or not updated_ram_variant is PackedByteArray or not entry_stack_variant is PackedByteArray \
			or not stack_variant is PackedByteArray:
		return _fail("Busy-queue yield result omits source CPU, mapper, RAM, or stack state.")
	var entry: Dictionary = entry_variant
	var registers: Dictionary = registers_variant
	var mapper: Dictionary = mapper_variant
	var entry_ram: PackedByteArray = entry_ram_variant
	var updated_ram: PackedByteArray = updated_ram_variant
	var entry_stack: PackedByteArray = entry_stack_variant
	var result_stack: PackedByteArray = stack_variant
	var worker_source := FileAccess.get_file_as_bytes(MAP42_WORKER_SOURCE_PATH)
	var yield_source := FileAccess.get_file_as_bytes(
			"res://reference/rom_extract/gameplay/first_command_field/map_worker_8525/bank_0b_856f_8572_c515_callsite.bin")
	var map_id := int(worker_result.get("map_id", -1))
	var expected_p := int(entry.get("p", -1)) & 0x7D
	var expected_p_known := int(entry.get("p_known_mask", -1)) | 0x82
	var source_hashes: Dictionary = worker_result.get("source_hashes", {})
	var expected_busy_hashes := {
		"worker_8572_85c2": MAP42_WORKER_SOURCE_SHA256,
		"yield_callsite": "59653ff81dfe5c01f141d4ee69bb4832290c727091c41b92a71a6b0e2400a837",
	}
	if map_id == 0x2D and _expected_map2d_batch_source_hashes().is_empty():
		return _fail("Map-$2D busy-queue yield cannot adopt a callback whose pinned block/metatile sources failed validation.")
	if String(worker_result.get("rom_sha256", "")) != ROM_SHA256 \
			or String(worker_result.get("status", "")) != "map_worker_queue_busy_yield_at_856F" \
			or int(worker_result.get("entry_pc", -1)) != 0x8572 \
			or int(worker_result.get("exit_pc", -1)) != 0x856F \
			or int(worker_result.get("callsite_pc", -1)) != 0x856F \
			or worker_source.size() != 0x50 or FileAccess.get_sha256(MAP42_WORKER_SOURCE_PATH) != MAP42_WORKER_SOURCE_SHA256 \
			or worker_source.slice(0, 7) != PackedByteArray([0xAD, 0x15, 0x05, 0xD0, 0xF6, 0xA9, 0x01]) \
			or yield_source != PackedByteArray([0x20, 0x15, 0xC5]) \
			or FileAccess.get_sha256("res://reference/rom_extract/gameplay/first_command_field/map_worker_8525/bank_0b_856f_8572_c515_callsite.bin") != "59653ff81dfe5c01f141d4ee69bb4832290c727091c41b92a71a6b0e2400a837" \
			or source_hashes != expected_busy_hashes \
			or map_id not in [0x00, 0x0E, 0x11, 0x12, 0x2D, 0x2F, 0x36, 0x42, 0x43, 0x51, 0x52, 0x56] \
			or (map_id == 0x51 and (int(_ram[0x0518]) != 0x1C or int(_ram[0x0524]) != 0x63)) \
			or entry_ram.size() != RAM_SIZE or updated_ram.size() != RAM_SIZE \
			or entry_stack.size() != STACK_PAGE_SIZE or result_stack.size() != STACK_PAGE_SIZE \
			or entry_ram != _ram or updated_ram != entry_ram \
			or entry_stack != _stack_page or result_stack != entry_stack \
			or int(entry_ram[0x0000]) != 0x15 or int(entry_ram[0x0515]) == 0 \
			or int(entry_ram[0x05CC]) != map_id \
			or int(entry.get("pc", -1)) != context.program_counter \
			or int(entry.get("a", -1)) != context.accumulator \
			or int(entry.get("x", -1)) != context.x_register \
			or int(entry.get("y", -1)) != context.y_register \
			or int(entry.get("sp", -1)) != context.stack_pointer \
			or int(entry.get("p", -1)) != context.status_register \
			or int(entry.get("p_known_mask", -1)) != context.status_known_mask \
			or int(registers.get("pc", -1)) != 0x856F \
			or int(registers.get("a", -1)) != 0x01 \
			or int(registers.get("x", -1)) != int(entry.get("x", -2)) \
			or int(registers.get("y", -1)) != int(entry.get("y", -2)) \
			or int(registers.get("sp", -1)) != int(entry.get("sp", -2)) \
			or int(registers.get("p", -1)) != expected_p \
			or int(registers.get("p_known_mask", -1)) != expected_p_known \
			or int(mapper.get("bank_low", -1)) != context.bank_low \
			or int(mapper.get("bank_high", -1)) != context.bank_high \
			or not (worker_result.get("ram_writes", []) as Array).is_empty() \
			or not (worker_result.get("stack_writes", []) as Array).is_empty() \
			or not (worker_result.get("mapper_writes", []) as Array).is_empty() \
			or not (worker_result.get("calls", []) as Array).is_empty() \
			or bool(worker_result.get("trace_state_used", true)) \
			or bool(worker_result.get("source_cycle_timing_modeled", true)):
		return _fail("Busy-queue `$8572->$856F` result differs from the checked ROM branch, live task, or memory boundary.")
	context.accumulator = 0x01
	context.x_register = int(registers["x"])
	context.y_register = int(registers["y"])
	context.stack_pointer = int(registers["sp"])
	context.program_counter = 0x856F
	context.status_register = expected_p
	context.status_known_mask = expected_p_known
	context.source_label = "ROM-byte `$0515` busy branch from `$8572` to `$856F` yield"
	return true


