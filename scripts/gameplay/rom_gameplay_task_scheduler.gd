			or result_ram.slice(0x0100, 0x0200) != result_stack:
		return _fail("Slot-$05 minimap waiter resume mismatch: active=%d phase=%d source=$%04X boundary_pc=$%04X status=%s entry=$%04X exit=$%04X callsite=$%04X target=$%04X bank=$%02X source_bytes=%s RAM_match=%s stack_match=%s SP=$%02X/$%02X mapper=$%02X/$%02X writes=%d rejected_write=%s RAM sizes=%d/%d stack sizes=%d/%d." % [
			_active_task_slot, int(context.phase) if context != null else -1, source_pc,
			int(boundary.get("pc", -1)), String(resume_result.get("status", "")),
			int(resume_result.get("entry_pc", -1)), int(resume_result.get("exit_pc", -1)),
			callsite, int(call_request.get("target_pc", -1)),
			int(call_request.get("target_bank", -1)),
			(call_request.get("source_bytes", PackedByteArray()) as PackedByteArray).hex_encode(),
